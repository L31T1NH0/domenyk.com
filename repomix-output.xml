<file path="src/components/post/PostEngagementTracker.tsx">
 1: "use client"
 2: 
 3: import { useEffect } from "react"
 4: import { getPostEngagement } from "@/lib/post-engagement"
 5: 
 6: const CHECKPOINTS = [0.25, 0.5, 0.75, 0.9]
 7: 
 8: export function PostEngagementTracker({ publicId, readingTimeMinutes }: { publicId: string; readingTimeMinutes: number }) {
 9:   useEffect(() => {
10:     let token = getPostEngagement(publicId)?.token ?? null
11:     let activeSeconds = 0
12:     let nextCheckpoint = 0
13:     let maxProgress = 0
14:     let completed = false
15:     let frame = 0
16:     const minimumActiveSeconds = Math.max(45, Math.round(readingTimeMinutes * 60 * 0.4))
17: 
18:     function onToken(event: Event) {
19:       const detail = (event as CustomEvent<{ publicId?: string; token?: string }>).detail
20:       if (detail?.publicId === publicId && detail.token) token = detail.token
21:     }
22: 
23:     function measure() {
24:       frame = 0
25:       if (completed || document.visibilityState !== "visible" || !document.hasFocus()) return
26:       const content = document.querySelector<HTMLElement>("[data-post-content]")
27:       if (!content) return
28:       const rect = content.getBoundingClientRect()
29:       if (rect.height <= 0) return
30: 
31:       const wholeContentVisible = rect.height <= window.innerHeight * 0.8
32:       const position = Math.max(0, Math.min(1, (window.innerHeight * 0.5 - rect.top) / rect.height))
33:       maxProgress = Math.max(maxProgress, position)
34:       if (wholeContentVisible && activeSeconds >= minimumActiveSeconds) {
35:         nextCheckpoint = CHECKPOINTS.length
36:         maxProgress = 1
37:       }
38:       const checkpoint = CHECKPOINTS[nextCheckpoint]
39:       if (checkpoint !== undefined) {
40:         const enoughTime = activeSeconds >= minimumActiveSeconds * checkpoint * 0.5
41:         if (enoughTime && position >= checkpoint - 0.12 && position <= checkpoint + 0.15) {
42:           nextCheckpoint += 1
43:         }
44:       }
45: 
46:       const reachedEnd = wholeContentVisible || rect.bottom <= window.innerHeight * 0.9
47:       if (!token || !reachedEnd || nextCheckpoint < CHECKPOINTS.length || activeSeconds < minimumActiveSeconds) return
48:       completed = true
49:       void fetch("/api/engagement", {
50:         method: "PATCH",
51:         headers: { "Content-Type": "application/json" },
52:         body: JSON.stringify({
53:           token,
54:           event: "reading_completed",
55:           activeSeconds,
56:           progress: Math.round(maxProgress * 100),
57:         }),
58:         keepalive: true,
59:       }).catch(() => undefined)
60:     }
61: 
62:     function scheduleMeasure() {
63:       if (frame) return
64:       frame = requestAnimationFrame(measure)
65:     }
66: 
67:     const timer = window.setInterval(() => {
68:       if (document.visibilityState === "visible" && document.hasFocus()) activeSeconds += 1
69:       scheduleMeasure()
70:     }, 1000)
71: 
72:     window.addEventListener("post-engagement-ready", onToken)
73:     window.addEventListener("scroll", scheduleMeasure, { passive: true })
74:     window.addEventListener("resize", scheduleMeasure)
75:     scheduleMeasure()
76: 
77:     return () => {
78:       window.clearInterval(timer)
79:       if (frame) cancelAnimationFrame(frame)
80:       window.removeEventListener("post-engagement-ready", onToken)
81:       window.removeEventListener("scroll", scheduleMeasure)
82:       window.removeEventListener("resize", scheduleMeasure)
83:     }
84:   }, [publicId, readingTimeMinutes])
85: 
86:   return null
87: }
</file>

