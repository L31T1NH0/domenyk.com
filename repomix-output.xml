 48: export default clerkMiddleware(async (auth, req) => {
 49:   const requestHeaders = new Headers(req.headers)
 50:   requestHeaders.set("x-site-language", documentLanguage(req.nextUrl.pathname))
 51:   const continueRequest = () => NextResponse.next({ request: { headers: requestHeaders } })
 52: 
 53:   const clerkWebhook = req.nextUrl.pathname === "/api/webhooks/clerk"
 54:   if (!clerkWebhook && req.nextUrl.pathname.startsWith("/api/") && shouldBlockApiMutation(req)) {
 55:     return NextResponse.json({ error: "Origem não permitida." }, { status: 403 })
 56:   }
 57: 
