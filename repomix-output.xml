  3: import { useEffect, useId, useLayoutEffect, useRef, useState, type ReactNode } from "react"
  4: import { createPortal } from "react-dom"
  5: import { CheckIcon, ChevronDownIcon } from "@heroicons/react/20/solid"
  6: 
  7: export type EditorToolbarMenuOption<T extends string> = {
  8:   description?: string
  9:   icon?: ReactNode
 10:   label: string
 11:   value: T
 12: }
 13: 
 14: type Props<T extends string> = {
 15:   accessibleLabel: string
 16:   icon?: ReactNode
 17:   label: string
 18:   onChange: (value: T) => void
 19:   options: readonly EditorToolbarMenuOption<T>[]
 20:   value?: T
 21:   variant?: "default" | "compact" | "comment"
 22: }
 23: 
 24: export function EditorToolbarMenu<T extends string>({
 25:   accessibleLabel,
 26:   icon,
 27:   label,
 28:   onChange,
 29:   options,
 30:   value,
 31:   variant = "default",
 32: }: Props<T>) {
 33:   const [open, setOpen] = useState(false)
 34:   const [position, setPosition] = useState<{ left: number; top: number } | null>(null)
 35:   const triggerRef = useRef<HTMLButtonElement>(null)
 36:   const menuRef = useRef<HTMLDivElement>(null)
 37:   const focusOnOpen = useRef(false)
 38:   const id = useId()
 39:   const triggerSize = variant === "comment" ? "h-10 min-w-10" : "h-10 min-w-10 sm:h-9 sm:min-w-9"
 40: 
 41:   const close = (restoreFocus = false) => {
 42:     setOpen(false)
 43:     setPosition(null)
 44:     if (restoreFocus) requestAnimationFrame(() => triggerRef.current?.focus())
 45:   }
 46: 
 47:   useLayoutEffect(() => {
 48:     if (!open) return
 49:     const trigger = triggerRef.current
 50:     const menu = menuRef.current
 51:     if (!trigger || !menu) return
 52:     const triggerRect = trigger.getBoundingClientRect()
 53:     const menuRect = menu.getBoundingClientRect()
 54:     const margin = 10
 55:     const openAbove = triggerRect.bottom + menuRect.height + margin > window.innerHeight && triggerRect.top > menuRect.height
 56:     setPosition({
 57:       left: Math.max(margin, Math.min(triggerRect.left, window.innerWidth - menuRect.width - margin)),
 58:       top: openAbove ? triggerRect.top - menuRect.height - 6 : triggerRect.bottom + 6,
 59:     })
 60:   }, [open])
 61: 
 62:   useEffect(() => {
 63:     if (!open) return
 64:     if (position && focusOnOpen.current) {
 65:       focusOnOpen.current = false
 66:       requestAnimationFrame(() => menuRef.current?.querySelector<HTMLElement>('[aria-checked="true"], button')?.focus())
 67:     }
 68:     const dismiss = (event: PointerEvent) => {
 69:       const target = event.target as Node
 70:       if (!triggerRef.current?.contains(target) && !menuRef.current?.contains(target)) close()
 71:     }
 72:     const reposition = () => close()
 73:     document.addEventListener("pointerdown", dismiss, true)
 74:     window.addEventListener("resize", reposition)
 75:     window.addEventListener("scroll", reposition, true)
 76:     return () => {
 77:       document.removeEventListener("pointerdown", dismiss, true)
 78:       window.removeEventListener("resize", reposition)
 79:       window.removeEventListener("scroll", reposition, true)
 80:     }
 81:   }, [open, position])
 82: 
 83:   function menuKeyDown(event: React.KeyboardEvent<HTMLDivElement>) {
 84:     const items = Array.from(menuRef.current?.querySelectorAll<HTMLButtonElement>('button[role="menuitemradio"]') ?? [])
 85:     const current = items.indexOf(document.activeElement as HTMLButtonElement)
 86:     if (event.key === "Escape") {
 87:       event.preventDefault()
 88:       close(true)
 89:     } else if (event.key === "ArrowDown" || event.key === "ArrowUp") {
 90:       event.preventDefault()
 91:       const direction = event.key === "ArrowDown" ? 1 : -1
 92:       items[(current + direction + items.length) % items.length]?.focus()
 93:     } else if (event.key === "Home" || event.key === "End") {
 94:       event.preventDefault()
 95:       items[event.key === "Home" ? 0 : items.length - 1]?.focus()
 96:     }
 97:   }
 98: 
 99:   return <>
100:     <button
101:       ref={triggerRef}
102:       type="button"
103:       className={`editor-toolbar-menu-trigger inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap rounded-md border border-transparent px-2 text-xs font-semibold leading-none text-inherit transition-colors hover:border-neutral-500/15 hover:bg-neutral-500/10 hover:text-neutral-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-current/50 dark:hover:border-white/10 dark:hover:bg-white/[0.08] dark:hover:text-neutral-50 ${triggerSize}`}
104:       data-editor-variant={variant}
105:       aria-controls={id}
106:       aria-expanded={open}
107:       aria-haspopup="menu"
108:       aria-label={accessibleLabel}
109:       title={accessibleLabel}
110:       onMouseDown={event => event.preventDefault()}
111:       onClick={event => {
112:         if (open) return close()
113:         focusOnOpen.current = event.detail === 0
114:         setOpen(true)
115:       }}
116:     >
117:       {icon && <span className="editor-toolbar-menu-icon grid size-4 shrink-0 place-items-center" aria-hidden>{icon}</span>}
118:       <span className="editor-toolbar-menu-label">{label}</span>
119:       <ChevronDownIcon className="editor-toolbar-menu-chevron size-3 shrink-0 text-neutral-500" aria-hidden />
120:     </button>
121:     {open && createPortal(
122:       <div
123:         ref={menuRef}
124:         id={id}
125:         role="menu"
126:         aria-label={accessibleLabel}
127:         className="editor-toolbar-menu fixed z-[90] grid w-[min(17rem,calc(100vw-20px))] gap-0.5 rounded-xl border border-neutral-200 bg-white p-1.5 text-neutral-800 shadow-xl shadow-black/15 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-100 dark:shadow-black/40"
128:         onKeyDown={menuKeyDown}
129:         style={{ left: position?.left ?? 0, top: position?.top ?? 0, visibility: position ? "visible" : "hidden" }}
130:       >
131:         {options.map(option => <button
132:           key={option.value}
133:           type="button"
134:           role="menuitemradio"
135:           aria-checked={value === option.value}
136:           className="grid min-h-11 grid-cols-[1.5rem_minmax(0,1fr)_1rem] items-center gap-2 rounded-lg px-2 py-1.5 text-left hover:bg-neutral-100 focus-visible:bg-neutral-100 focus-visible:outline-none dark:hover:bg-white/[0.07] dark:focus-visible:bg-white/[0.07]"
137:           onMouseDown={event => event.preventDefault()}
138:           onClick={() => { onChange(option.value); close(true) }}
139:         >
140:           <span className="editor-toolbar-menu-option-icon grid min-w-0 place-items-center text-[10px] font-bold text-neutral-500" aria-hidden>{option.icon}</span>
141:           <span className="min-w-0"><strong className="block text-xs font-semibold">{option.label}</strong>{option.description && <small className="mt-0.5 block text-[10px] leading-snug text-neutral-500 dark:text-neutral-400">{option.description}</small>}</span>
142:           <CheckIcon className={`editor-toolbar-menu-check size-3.5 ${value === option.value ? "opacity-100" : "opacity-0"}`} aria-hidden />
143:         </button>)}
144:       </div>,
145:       document.body,
146:     )}
147:   </>
148: }
