20:   const rawPostIds = asStringArray(body?.postIds, 200, 24)
21:   const uniquePostIds = [...new Set(rawPostIds)]
22:   const postIds = uniquePostIds.map(toObjectId)
23:   if (postIds.some((id) => !id)) throw new Error("A seleção contém um post inválido.")
24: 
25:   return {
26:     title,
27:     slug,
28:     description,
29:     published: body?.published === true,
30:     postIds: postIds as ObjectId[],
31:   }
32: }
