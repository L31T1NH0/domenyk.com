<file path="src/app/api/admin/push/send/route.ts">
 1: import { randomUUID } from "crypto"
 2: import { NextRequest, NextResponse } from "next/server"
 3: import { adminOnly, getAuthUserId } from "@/lib/auth"
 4: import { getNote } from "@/lib/db/notes"
 5: import { getPostById } from "@/lib/db/posts"
 6: import { sendReaderPush } from "@/lib/push"
 7: import { asString } from "@/lib/validation"
 8: import { rateLimit } from "@/lib/rate-limit"
 9: 
10: export async function POST(req: NextRequest) {
11:   const denied = await adminOnly()
12:   if (denied) return denied
13:   const adminId = await getAuthUserId()
14:   if (!adminId || !(await rateLimit(`admin-push-send:${adminId}`, { limit: 5, windowMs: 60 * 60_000 }))) {
15:     return NextResponse.json({ error: "Limite de cinco disparos por hora atingido." }, { status: 429 })
16:   }
17:   const body = await req.json().catch(() => null) as {
18:     contentType?: unknown
19:     contentId?: unknown
20:     title?: unknown
21:     message?: unknown
22:     requestId?: unknown
23:   } | null
24:   const contentType = body?.contentType === "post" || body?.contentType === "note" ? body.contentType : null
25:   const contentId = asString(body?.contentId, 120)
26:   const requestId = asString(body?.requestId, 80) ?? randomUUID()
27:   const customTitle = asString(body?.title, 120)?.trim()
28:   const customMessage = asString(body?.message, 240)?.trim()
29:   if (!contentType || !contentId || !customTitle || !customMessage) {
30:     return NextResponse.json({ error: "Conteúdo, título e mensagem são obrigatórios." }, { status: 400 })
31:   }
32: 
33:   let url: string
34:   if (contentType === "post") {
35:     const post = await getPostById(contentId)
36:     if (!post?.published) return NextResponse.json({ error: "Escolha um post publicado." }, { status: 400 })
37:     url = `/posts/${post.slug}`
38:   } else {
39:     const note = await getNote(contentId)
40:     if (!note) return NextResponse.json({ error: "Escolha uma nota publicada." }, { status: 400 })
41:     url = `/notes/${note._id.toString()}`
42:   }
43: 
44:   const result = await sendReaderPush({
45:     dedupeKey: `manual:${requestId}`,
46:     source: "manual",
47:     topic: contentType === "post" ? "posts" : "notes",
48:     contentType,
49:     contentId,
50:     title: customTitle,
51:     body: customMessage,
52:     url,
53:   })
54:   if (!result.configured) {
55:     return NextResponse.json({ error: "Configure as chaves VAPID antes de enviar." }, { status: 503 })
56:   }
57:   if (result.deduplicated) {
58:     return NextResponse.json({ error: "Este disparo já foi processado." }, { status: 409 })
59:   }
60:   return NextResponse.json({ ok: true, sent: result.sentCount, failed: result.failedCount })
61: }
</file>

