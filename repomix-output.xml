238:     image.src = this.__src
239:     image.alt = this.__alt
240:     image.className = this.__formatting.imageClass ?? ""
241:     image.setAttribute("style", this.__formatting.imageStyle ?? "")
242:     figure.append(image)
243:     if (this.__caption) {
244:       const caption = document.createElement("figcaption")
245:       caption.textContent = this.__caption
246:       caption.className = this.__formatting.captionClass ?? ""
247:       caption.setAttribute("style", this.__formatting.captionStyle ?? "")
