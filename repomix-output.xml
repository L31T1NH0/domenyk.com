189:   if (state === "loading") return <p className={`${bodyTextClass} text-zinc-500 dark:text-zinc-400`}>Consultando este dispositivo…</p>
190:   if (state === "unsupported") return <p className={`${bodyTextClass} text-zinc-600 dark:text-zinc-300`}>Este navegador não oferece notificações para sites.</p>
