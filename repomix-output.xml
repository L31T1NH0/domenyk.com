  3: import { useEffect, useId, useRef, useState, type KeyboardEvent } from "react"
  4: import Link from "next/link"
  5: import { usePathname } from "next/navigation"
  6: import { useClerk, useUser } from "@clerk/nextjs"
  7: import {
  8:   ArrowLeftIcon,
  9:   ArrowRightStartOnRectangleIcon,
 10:   BellAlertIcon,
 11:   ChartBarSquareIcon,
 12:   ChatBubbleLeftRightIcon,
 13:   Cog6ToothIcon,
