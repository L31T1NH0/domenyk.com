<file path="src/lib/inline-css-hooks.js">
 1: const INLINE_CSS_HOOK_PATTERN = /::([^:\n]+?)::/g
 2: 
 3: /** @param {string} value */
 4: export function cssHookSlug(value) {
 5:   const slug = value
 6:     .normalize("NFKD")
 7:     .replace(/[\u0300-\u036f]/g, "")
 8:     .toLowerCase()
 9:     .replace(/[^a-z0-9]+/g, "-")
10:     .replace(/^-+|-+$/g, "")
11:     .slice(0, 40)
12:   return slug || "trecho"
13: }
14: 
15: /**
16:  * `::texto::` derives its hook from the text. `::nome|texto::` keeps a stable
17:  * hook even when the visible words change.
18:  * @param {string} inner
19:  */
20: export function inlineCssHookValue(inner) {
21:   const separator = inner.indexOf("|")
22:   const explicitName = separator > 0 ? inner.slice(0, separator).trim() : ""
23:   const text = (separator > 0 ? inner.slice(separator + 1) : inner).trim()
24:   if (!text) return null
25:   return {
26:     id: cssHookSlug(explicitName || text),
27:     label: explicitName || text,
28:     text,
29:   }
30: }
31: 
32: /**
33:  * @param {string} value
34:  * @param {Map<string, number>} [occurrences]
35:  * @returns {Array<{type:"text",value:string}|{type:"hook",id:string,label:string,text:string,source:string}>}
36:  */
37: export function splitInlineCssHooks(value, occurrences = new Map()) {
38:   const parts = []
39:   let cursor = 0
40:   let match
41:   const matcher = new RegExp(INLINE_CSS_HOOK_PATTERN.source, INLINE_CSS_HOOK_PATTERN.flags)
42: 
43:   while ((match = matcher.exec(value)) !== null) {
44:     const hook = inlineCssHookValue(match[1])
45:     if (!hook) continue
46:     if (match.index > cursor) parts.push({ type: "text", value: value.slice(cursor, match.index) })
47: 
48:     const count = (occurrences.get(hook.id) ?? 0) + 1
49:     occurrences.set(hook.id, count)
50:     parts.push({
51:       type: "hook",
52:       id: count === 1 ? hook.id : `${hook.id}-${count}`,
53:       label: hook.label,
54:       text: hook.text,
55:       source: match[0],
56:     })
57:     cursor = match.index + match[0].length
58:   }
59: 
60:   if (cursor === 0) return [{ type: "text", value }]
61:   if (cursor < value.length) parts.push({ type: "text", value: value.slice(cursor) })
62:   return parts
63: }
64: 
65: /** @param {string} value */
66: export function stripInlineCssHookSyntax(value) {
67:   return splitInlineCssHooks(value)
68:     .map(part => part.type === "hook" ? part.text : part.value)
69:     .join("")
70: }
</file>

<file path="src/lib/note-reading.ts">
 1: import { stripInlineCssHookSyntax } from "./inline-css-hooks.js"
 2: 
 3: export type NoteReadingEstimate = {
 4:   wordCount: number
 5:   sentenceCount: number
 6:   effectiveWordsPerMinute: number
 7:   estimatedReadingSeconds: number
 8:   impressionThresholdMs: number
 9:   impressionVisibleRatio: number
10:   complexity: "leve" | "moderada" | "densa"
11: }
12: 
13: function clamp(value: number, minimum: number, maximum: number) {
14:   return Math.min(maximum, Math.max(minimum, value))
15: }
16: 
17: function plainText(markdown: string) {
18:   return stripInlineCssHookSyntax(markdown)
19:     .replace(/```[\s\S]*?```/g, " ")
20:     .replace(/!\[[^\]]*]\([^)]*\)/g, " ")
21:     .replace(/\[([^\]]+)]\([^)]*\)/g, "$1")
22:     .replace(/<[^>]+>/g, " ")
23:     .replace(/https?:\/\/\S+/g, " ")
24:     .replace(/[*_~`>#|]/g, " ")
25: }
26: 
27: export function estimateNoteReading(markdown: string, galleryImages = 0): NoteReadingEstimate {
28:   const text = plainText(markdown)
29:   const words = text.match(/[\p{L}\p{N}]+(?:[-’'][\p{L}\p{N}]+)*/gu) ?? []
30:   const sentences = text.split(/[.!?]+(?:\s|$)/).map((sentence) => sentence.trim()).filter(Boolean)
31:   const wordCount = words.length
32:   const sentenceCount = sentences.length
33:   const averageSentenceWords = wordCount / Math.max(1, sentenceCount)
34:   const longWordRatio = words.filter((word) => word.replace(/[^\p{L}]/gu, "").length >= 9).length / Math.max(1, wordCount)
35:   const structuralMarkers = (markdown.match(/^(?:\s*[-*+]\s+|\s*\d+\.\s+|\s*>\s+|#{1,6}\s+)/gm) ?? []).length
36:     + (markdown.match(/<(?:h[1-6]|blockquote|li)\b/gi) ?? []).length
37:   const markdownImages = (markdown.match(/!\[[^\]]*]\([^)]*\)/g) ?? []).length
38:   const htmlImages = (markdown.match(/<img\b/gi) ?? []).length
39:   const imageCount = markdownImages + htmlImages + Math.max(0, galleryImages)
40: 
41:   const sentencePenalty = clamp((averageSentenceWords - 14) * 0.012, 0, 0.22)
42:   const lexicalPenalty = clamp((longWordRatio - 0.1) * 1.5, 0, 0.22)
43:   const structurePenalty = clamp(structuralMarkers / Math.max(8, wordCount) * 1.8, 0, 0.12)
44:   const effectiveWordsPerMinute = Math.round(clamp(225 / (1 + sentencePenalty + lexicalPenalty + structurePenalty), 150, 225))
45:   const estimatedReadingSeconds = Math.max(4, Math.ceil(wordCount / effectiveWordsPerMinute * 60 + imageCount * 4))
46:   const impressionThresholdMs = clamp(Math.round(estimatedReadingSeconds * 0.25), 7, 32) * 1000
47:   const impressionVisibleRatio = wordCount <= 90 ? 0.7 : wordCount <= 200 ? 0.55 : wordCount <= 350 ? 0.4 : 0.3
48:   const complexityScore = sentencePenalty + lexicalPenalty + structurePenalty
49:   const complexity = complexityScore >= 0.24 ? "densa" : complexityScore >= 0.1 ? "moderada" : "leve"
50: 
51:   return {
52:     wordCount,
53:     sentenceCount,
54:     effectiveWordsPerMinute,
55:     estimatedReadingSeconds,
56:     impressionThresholdMs,
57:     impressionVisibleRatio,
58:     complexity,
59:   }
60: }
</file>

