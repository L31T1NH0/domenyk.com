140: export async function getLocalizedPostMetadata(slug: string, locale: PostLocale): Promise<Metadata> {
141:   const post = await findPost(slug, locale)
142:   if (!post) return {}
143:   const version = getPostVersion(post, locale)
144:   if (!version) return {}
145: 
146:   const admin = await isAdmin()
147:   if (!version.published && !admin) {
148:     return { robots: { index: false, follow: false } }
149:   }
150: 
151:   const details = POST_LOCALE_DETAILS[locale]
152:   const canonicalPath = localizedPostPath(post, locale)
153:   const description = postSeoDescription(version, descriptionFromMarkdown(version.content)) || siteConfig.description
154:   const [preferredImage] = preferredContentImages({ cover: version.cover?.url, markdown: version.content })
155:   const publishedLocales = getPublishedPostLocales(post)
156: 
157:   return {
158:     ...buildPageMetadata({
159:       title: postSeoTitle(version),
160:       description,
161:       path: canonicalPath,
162:       image: preferredImage ?? `/og/posts/${encodeURIComponent(post.slug)}?locale=${locale}`,
163:       type: "article",
164:       publishedTime: version.publishedAt?.toISOString(),
165:       modifiedTime: version.updatedAt.toISOString(),
166:       tags: version.tags,
167:       noIndex: !isPostVersionIndexable(version),
168:       languages: languageUrls(post),
169:       openGraphLocale: details.openGraphLocale,
170:       openGraphAlternateLocales: publishedLocales
171:         .filter((availableLocale) => availableLocale !== locale)
172:         .map((availableLocale) => POST_LOCALE_DETAILS[availableLocale].openGraphLocale),
173:     }),
174:     other: articleMachineMetadata(),
175:   }
176: }
