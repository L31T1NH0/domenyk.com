<file path="src/lib/blob-upload-body.ts">
 1: export type ImageUploadBody = ArrayBuffer | Blob | Buffer
 2: 
 3: /**
 4:  * Vercel's fetch implementation rejects ArrayBufferViews backed by a
 5:  * SharedArrayBuffer. Native image processors can return buffers backed by
 6:  * shared memory, so copy their bytes into an ordinary ArrayBuffer before the
 7:  * body reaches @vercel/blob.
 8:  */
 9: export function unsharedImageUploadBody(data: ImageUploadBody): ArrayBuffer | Blob {
10:   if (data instanceof Blob) return data
11: 
12:   const source = data instanceof ArrayBuffer
13:     ? new Uint8Array(data)
14:     : new Uint8Array(data.buffer, data.byteOffset, data.byteLength)
15:   const copy = new Uint8Array(source.byteLength)
16:   copy.set(source)
17:   return copy.buffer
18: }
</file>

