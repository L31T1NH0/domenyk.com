43: function asHttpUrl(value: unknown, maxLength = 2048): string | undefined {
44:   if (typeof value !== "string") return undefined
45:   const trimmed = value.trim()
46:   if (!trimmed || trimmed.length > maxLength) return undefined
47: 
48:   try {
49:     const url = new URL(trimmed)
50:     if (url.protocol !== "http:" && url.protocol !== "https:") return undefined
51:     return url.toString()
52:   } catch {
53:     return undefined
54:   }
55: }
56: 
57: export function asHttpsUrl(value: unknown, maxLength = 2048): string | undefined {
58:   const valueUrl = asHttpUrl(value, maxLength)
59:   if (!valueUrl) return undefined
60:   return new URL(valueUrl).protocol === "https:" ? valueUrl : undefined
61: }
