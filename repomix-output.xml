 392: function getAdjacentMode(deltaX: number, mode: FeedMode) {
 393:   const currentIndex = feedModeOrder.indexOf(mode)
 394:   const nextIndex = deltaX < 0 ? currentIndex + 1 : currentIndex - 1
 395:   return feedModeOrder[nextIndex]
 396: }
