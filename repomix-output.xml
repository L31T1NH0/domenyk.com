 2: import type { NextRequest } from "next/server"
 3: import { getAdminUserId } from "@/lib/auth"
 4: import { createNotificationOnce } from "@/lib/admin-notifications"
 5: 
 6: export const runtime = "nodejs"
 7: 
 8: export async function POST(request: NextRequest) {
 9:   let event
10:   try {
11:     event = await verifyWebhook(request)
12:   } catch {
13:     return Response.json({ error: "Assinatura do webhook inválida." }, { status: 400 })
14:   }
15: 
16:   if (event.type !== "user.created") {
17:     return Response.json({ received: true, handled: false })
18:   }
19: 
20:   const adminId = getAdminUserId()
21:   if (!adminId) {
22:     return Response.json({ error: "Admin user is not configured" }, { status: 503 })
23:   }
24: 
25:   const user = event.data
26:   const fullName = [user.first_name, user.last_name].filter(Boolean).join(" ").trim()
27:   const name = fullName || user.username || user.email_addresses[0]?.email_address || "Uma nova pessoa"
28:   const notificationId = await createNotificationOnce({
29:     recipientId: adminId,
30:     actorId: user.id,
31:     actorImageUrl: user.image_url,
32:     aggregateKey: `account-created:${user.id}`,
33:     kind: "account",
34:     title: "Nova conta criada",
35:     description: `${name} criou uma conta.`,
36:     href: "/admin/users",
37:   }, "accounts")
38: 
39:   return Response.json({ received: true, handled: true, created: Boolean(notificationId) })
40: }
</file>

