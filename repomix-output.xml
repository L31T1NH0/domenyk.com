<file path="src/app/api/admin/database/download/route.ts">
 1: import { BSON, type CollectionInfo, type Document } from "mongodb"
 2: import { adminOnly } from "@/lib/auth"
 3: import { getDb } from "@/lib/db/client"
 4: import { siteDateKey } from "@/lib/datetime"
 5: 
 6: export const runtime = "nodejs"
 7: export const dynamic = "force-dynamic"
 8: 
 9: const encoder = new TextEncoder()
10: 
11: function asExtendedJson(value: unknown): string {
12:   return BSON.EJSON.stringify(value, { relaxed: false })
13: }
14: 
15: async function indexesFor(info: CollectionInfo, db: Awaited<ReturnType<typeof getDb>>) {
16:   if (info.type !== "collection" && info.type !== "timeseries") return []
17: 
18:   return db.collection(info.name).listIndexes().toArray()
19: }
20: 
21: async function* createBackup() {
22:   const db = await getDb()
23:   const collections = await db.listCollections({}, { nameOnly: false }).toArray()
24: 
25:   yield `{"format":"domenyk-mongodb-backup","version":1,"database":${JSON.stringify(db.databaseName)},"exportedAt":${JSON.stringify(new Date().toISOString())},"collections":[`
26: 
27:   for (let collectionIndex = 0; collectionIndex < collections.length; collectionIndex += 1) {
28:     const info = collections[collectionIndex]
29:     const collectionType = info.type ?? "collection"
30:     const indexes = await indexesFor(info, db)
31:     const cursor = db.collection<Document>(info.name).find({})
32: 
33:     if (collectionIndex > 0) yield ","
34:     yield `{"name":${JSON.stringify(info.name)},"type":${JSON.stringify(collectionType)},"options":${asExtendedJson(info.options ?? {})},"indexes":${asExtendedJson(indexes)},"documents":[`
35: 
36:     let documentIndex = 0
37:     try {
38:       for await (const document of cursor) {
39:         if (documentIndex > 0) yield ","
40:         yield asExtendedJson(document)
41:         documentIndex += 1
42:       }
43:     } finally {
44:       await cursor.close()
45:     }
46: 
47:     yield "]}"
48:   }
49: 
50:   yield "]}"
51: }
52: 
53: function backupStream() {
54:   const chunks = createBackup()
55: 
56:   return new ReadableStream<Uint8Array>({
57:     async pull(controller) {
58:       try {
59:         const next = await chunks.next()
60:         if (next.done) {
61:           controller.close()
62:           return
63:         }
64:         controller.enqueue(encoder.encode(next.value))
65:       } catch (error) {
66:         controller.error(error)
67:       }
68:     },
69:     async cancel() {
70:       await chunks.return(undefined)
71:     },
72:   })
73: }
74: 
75: export async function POST() {
76:   const unauthorized = await adminOnly()
77:   if (unauthorized) return unauthorized
78: 
79:   const compressor = new CompressionStream("gzip") as unknown as TransformStream<Uint8Array, Uint8Array>
80:   const compressed = backupStream().pipeThrough(compressor)
81: 
82:   return new Response(compressed, {
83:     headers: {
84:       "Cache-Control": "private, no-store, max-age=0, must-revalidate",
85:       "Content-Type": "application/gzip",
86:       "Content-Disposition": `attachment; filename="mongodb-completo-${siteDateKey()}.json.gz"`,
87:       "X-Content-Type-Options": "nosniff",
88:     },
89:   })
90: }
</file>

