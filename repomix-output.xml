<file path="src/app/admin/escrevendo/WritingManager.tsx">
  1: "use client"
  2: 
  3: import { useId, useState, type FormEvent } from "react"
  4: import type { AdminWritingEntry } from "@/lib/db/writing-progress"
  5: 
  6: const fieldClass = "w-full rounded-md border border-neutral-300 bg-transparent px-3 py-2 text-sm text-neutral-950 outline-none focus-visible:ring-2 focus-visible:ring-neutral-500 disabled:opacity-60 dark:border-neutral-700 dark:text-neutral-100"
  7: const buttonClass = "min-h-10 rounded-md border border-neutral-300 px-3 py-2 text-sm outline-none hover:bg-neutral-100 focus-visible:ring-2 focus-visible:ring-neutral-500 disabled:cursor-wait disabled:opacity-50 dark:border-neutral-700 dark:hover:bg-white/5"
  8: 
  9: function WritingForm({ entry, onSaved }: {
 10:   entry?: AdminWritingEntry
 11:   onSaved: (entry: AdminWritingEntry) => void
 12: }) {
 13:   const id = useId()
 14:   const [title, setTitle] = useState(entry?.title ?? "")
 15:   const [progress, setProgress] = useState(String(entry?.progress ?? 0))
 16:   const [busy, setBusy] = useState(false)
 17:   const [error, setError] = useState("")
 18:   const [notice, setNotice] = useState("")
 19:   const dirty = entry ? title.trim() !== entry.title || Number(progress) !== entry.progress : true
 20: 
 21:   async function save(completed = entry?.completed ?? false) {
 22:     if (busy) return
 23:     const percentage = Number(progress)
 24:     if (!title.trim() || title.trim().length > 180 || progress.trim() === "" || !Number.isInteger(percentage) || percentage < 0 || percentage > 100) {
 25:       setError("Informe um título e uma porcentagem inteira entre 0 e 100.")
 26:       return
 27:     }
 28:     setBusy(true)
 29:     setError("")
 30:     setNotice("")
 31:     try {
 32:       const response = await fetch(entry ? `/api/admin/writing/${entry.id}` : "/api/admin/writing", {
 33:         method: entry ? "PATCH" : "POST",
 34:         headers: { "Content-Type": "application/json" },
 35:         body: JSON.stringify({ title: title.trim(), progress: percentage, completed }),
 36:       })
 37:       const data = await response.json().catch(() => null)
 38:       if (!response.ok) throw new Error(data?.error ?? "Não foi possível salvar. Tente novamente.")
 39:       if (entry) {
 40:         onSaved({ ...entry, title: title.trim(), progress: percentage, completed })
 41:         setTitle(title.trim())
 42:         setNotice(completed ? "Concluído. O texto saiu da home." : "Salvo. O progresso aparece na home.")
 43:       } else {
 44:         onSaved(data as AdminWritingEntry)
 45:         setTitle("")
 46:         setProgress("0")
 47:         setNotice("Texto adicionado à home.")
 48:       }
 49:     } catch (error) {
 50:       setError(error instanceof Error ? error.message : "Não foi possível salvar. Tente novamente.")
 51:     } finally {
 52:       setBusy(false)
 53:     }
 54:   }
 55: 
 56:   function submit(event: FormEvent<HTMLFormElement>) {
 57:     event.preventDefault()
 58:     void save()
 59:   }
 60: 
 61:   return (
 62:     <form onSubmit={submit} aria-label={entry ? `Editar ${entry.title}` : "Adicionar texto"} aria-busy={busy} className="flex min-w-0 flex-col gap-3">
 63:       <fieldset disabled={busy} className="grid min-w-0 gap-3 sm:grid-cols-[minmax(0,1fr)_7rem]">
 64:         <div className="min-w-0">
 65:           <label htmlFor={`${id}-title`} className="mb-1 block text-xs text-neutral-600 dark:text-neutral-400">Título</label>
 66:           <input id={`${id}-title`} required maxLength={180} value={title} onChange={(event) => { setTitle(event.target.value); setNotice("") }} className={fieldClass} />
 67:         </div>
 68:         <div>
 69:           <label htmlFor={`${id}-progress`} className="mb-1 block text-xs text-neutral-600 dark:text-neutral-400">Progresso (%)</label>
 70:           <input id={`${id}-progress`} type="number" required min={0} max={100} step={1} value={progress} onChange={(event) => { setProgress(event.target.value); setNotice("") }} className={`${fieldClass} tabular-nums`} />
 71:         </div>
 72:       </fieldset>
 73:       <div className="flex flex-wrap items-center gap-2">
 74:         <button type="submit" disabled={busy || !dirty} className={buttonClass}>{busy ? "Salvando…" : entry ? "Salvar alterações" : "Adicionar texto"}</button>
 75:         {entry && <button type="button" disabled={busy} onClick={() => void save(!entry.completed)} className={buttonClass}>
 76:           {entry.completed ? "Retomar escrita" : "Marcar como concluído"}
 77:         </button>}
 78:       </div>
 79:       {error && <p role="alert" className="text-sm text-red-700 dark:text-red-400">{error}</p>}
 80:       {notice && <p role="status" className="text-sm text-neutral-600 dark:text-neutral-400">{notice}</p>}
 81:     </form>
 82:   )
 83: }
 84: 
 85: export function WritingManager({ initialEntries }: { initialEntries: AdminWritingEntry[] }) {
 86:   const [entries, setEntries] = useState(initialEntries)
 87:   const active = entries.filter((entry) => !entry.completed)
 88:   const completed = entries.filter((entry) => entry.completed)
 89: 
 90:   function handleSaved(entry: AdminWritingEntry) {
 91:     setEntries((current) => current.some((item) => item.id === entry.id)
 92:       ? current.map((item) => item.id === entry.id ? entry : item)
 93:       : [entry, ...current])
 94:   }
 95: 
 96:   return (
 97:     <div className="flex max-w-3xl flex-col gap-8">
 98:       <section aria-labelledby="writing-new-title" className="flex flex-col gap-4">
 99:         <h2 id="writing-new-title" className="text-base font-semibold">Adicionar texto</h2>
100:         <WritingForm onSaved={handleSaved} />
101:         <p className="text-xs leading-5 text-neutral-600 dark:text-neutral-400">O título e a porcentagem aparecem junto de Arquivos e Categorias. Chegar a 100% mantém o texto na lista até você marcar como concluído.</p>
102:       </section>
103:       <section aria-labelledby="writing-active-title" className="border-t border-neutral-200 pt-6 dark:border-neutral-800">
104:         <h2 id="writing-active-title" className="mb-4 text-base font-semibold">Em andamento</h2>
105:         {active.length === 0 ? <p className="text-sm text-neutral-600 dark:text-neutral-400">Nenhum texto em andamento. Adicione o primeiro acima.</p> : (
106:           <ul className="flex flex-col gap-6">{active.map((entry) => <li key={entry.id} className="border-b border-neutral-200 pb-6 dark:border-neutral-800"><WritingForm entry={entry} onSaved={handleSaved} /></li>)}</ul>
107:         )}
108:       </section>
109:       {completed.length > 0 && <section aria-labelledby="writing-completed-title">
110:         <h2 id="writing-completed-title" className="mb-4 text-base font-semibold">Concluídos</h2>
111:         <ul className="flex flex-col gap-6">{completed.map((entry) => <li key={entry.id} className="border-b border-neutral-200 pb-6 dark:border-neutral-800"><WritingForm entry={entry} onSaved={handleSaved} /></li>)}</ul>
112:       </section>}
113:     </div>
114:   )
115: }
</file>

