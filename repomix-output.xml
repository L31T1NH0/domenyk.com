 23: function Result({result,onReview,onReset}:{result:QuizResult;onReview:()=>void;onReset:()=>void}) {
 24:   function download() {
 25:     const url = URL.createObjectURL(new Blob([JSON.stringify(result,null,2)],{type:"application/json"}))
 26:     const link = document.createElement("a");link.href=url;link.download=`mapa-politico-${result.quiz_version}.json`;link.click();URL.revokeObjectURL(url)
 27:   }
 28:   return <>
 29:     <h1>Seu mapa político</h1>
 30:     <p className={styles.muted}>Modelo {result.quiz_version} · {new Date(result.created_at).toLocaleDateString("pt-BR")}</p>
 31:     <Compass x={result.x} y={result.y} />
 32:     <h2>{result.quadrant}</h2>
 33:     <p className={styles.profile}>Perfil mais próximo: <strong>{result.closest_profile}</strong></p>
 34:     {result.nearby_profiles.length>0&&<p className={styles.muted}>Referências próximas: {result.nearby_profiles.filter(p=>p!==result.closest_profile).join(" · ")}</p>}
 35:     <p className={styles.description}>{result.description}</p>
 36:     <h2>Como sua posição se forma</h2>
 37:     <p className={styles.muted}>Cada dimensão vai de −10 a +10. Os polos abaixo explicam o sinal.</p>
 38:     <dl className={styles.dimensions}>{(Object.keys(DIMENSIONS) as Dimension[]).map(key=>{
 39:       const value=result.dimensions[key], [label,low,high]=DIMENSIONS[key]
 40:       return <div key={key}><dt>{label}</dt><dd><strong>{format(value)}</strong></dd><div className={styles.track} aria-hidden><span style={{left:value!==null&&value<0?`${50+value*5}%`:"50%",width:`${Math.abs(value??0)*5}%`}} /></div><small>{low}<span>{high}</span></small></div>
 41:     })}</dl>
 42:     <h2>Diagnósticos</h2>
 43:     <dl className={styles.diagnostics}>{[["Consistência interna",result.consistency],["Simetria institucional",result.symmetry],["Cobertura posicional",result.coverage],["Cobertura dos diagnósticos",result.diagnosticCoverage],["Cobertura econômica",result.axisCoverage.x],["Cobertura de autoridade",result.axisCoverage.y]].map(([label,value])=><div key={String(label)}><dt>{label}</dt><dd>{value===null?"Dados insuficientes":`${value}/100`}</dd></div>)}</dl>
 44:     <p className={styles.muted}>“Depende” foi escolhido {result.conditional} {result.conditional===1?"vez":"vezes"}. Respostas condicionais e “Não sei” não entram nas médias. Neutralidade entra como zero. Cobertura mede respostas numéricas, não precisão científica.</p>
 45:     <details className={styles.details}><summary>Princípios e aplicações concretas</summary><p>Diferença de 0 a 6 entre respostas relacionadas, ajustada pela relação esperada. Uma diferença pode indicar um limite contextual, sem ser uma contradição. A consistência usa tolerâncias editoriais; exige ao menos duas comparações.</p><ul>{result.comparisons.map(pair=><li key={pair.label}>{pair.label}: <strong>{pair.gap===null?"sem dados":`${pair.gap}/6`}</strong><small>{pair.relationship}</small></li>)}</ul></details>
