<file path="src/lib/rehype-html-math.js">
  1: import { unified } from "unified"
  2: import remarkParse from "remark-parse"
  3: import remarkMath from "remark-math"
  4: import { visit } from "unist-util-visit"
  5: 
  6: /** @typedef {import('hast').Element} Element
  7:  * @typedef {import('hast').Root} Root
  8:  * @typedef {import('hast').RootContent} RootContent
  9:  * @typedef {import('hast').Text} Text
 10:  * @typedef {{ node: Text | Element, start: number, end: number }} Segment
 11:  * @typedef {{ start: number, end: number, element: Element }} Formula
 12:  */
 13: 
 14: const mathParser = unified().use(remarkParse).use(remarkMath)
 15: const literalElements = new Set(["code", "pre", "kbd", "samp", "script", "style", "textarea", "math", "svg"])
 16: const inlineElements = new Set(["a", "abbr", "b", "cite", "del", "em", "i", "ins", "mark", "q", "s", "small", "span", "strong", "sub", "sup", "time", "u"])
 17: 
 18: // HTML entities have already been decoded by the time this plugin runs, so
 19: // writing R&#36; does not protect a currency sign from remark-math. Hide dollar
 20: // signs that belong to ISO-style currency prefixes while locating formulas;
 21: // the replacement has the same length, keeping parser offsets aligned with
 22: // the original source used below.
 23: function maskCurrencyDollars(source) {
 24:   return source.replace(/\b([A-Z]{1,3})\$(?=\s*\d)/g, "$1\uFF04")
 25: }
 26: 
 27: /** Recognize LaTeX in HTML text while preserving authored markup and styles. */
 28: export default function rehypeHtmlMath() {
 29:   /** @param {Root} tree */
 30:   return (tree) => {
 31:     /** @type {Map<RootContent, RootContent[]>} */
 32:     const replacements = new Map()
 33: 
 34:     /** @param {Root | Element} parent */
 35:     function process(parent) {
 36:       let source = ""
 37:       /** @type {Segment[]} */
 38:       let segments = []
 39: 
 40:       function flush() {
 41:         if (source.includes("$")) {
 42:           /** @type {Formula[]} */
 43:           const formulas = []
 44:           visit(mathParser.parse(maskCurrencyDollars(source)), (node) => {
 45:             if (node.type !== "math" && node.type !== "inlineMath") return
 46:             const math = /** @type {import('mdast-util-math').Math | import('mdast-util-math').InlineMath} */ (node)
 47:             const start = math.position?.start.offset
 48:             const end = math.position?.end.offset
 49:             if (start === undefined || end === undefined) return
 50:             formulas.push({
 51:               start, end,
 52:               element: {
 53:                 type: "element", tagName: "code",
 54:                 properties: { className: [math.type === "math" ? "math-display" : "math-inline"] },
 55:                 children: [{ type: "text", value: math.value }],
 56:               },
 57:             })
 58:           })
 59: 
 60:           let formulaIndex = 0
 61:           for (const segment of segments) {
 62:             while (formulas[formulaIndex]?.end <= segment.start) formulaIndex++
 63:             /** @type {RootContent[]} */
 64:             const children = []
 65:             let cursor = segment.start
 66:             let changed = false
 67:             for (let i = formulaIndex; i < formulas.length && formulas[i].start < segment.end; i++) {
 68:               const formula = formulas[i]
 69:               if (formula.start > cursor && segment.node.type === "text") {
 70:                 children.push({ type: "text", value: source.slice(cursor, formula.start) })
 71:               }
 72:               if (formula.start >= segment.start) children.push(formula.element)
 73:               cursor = Math.min(segment.end, formula.end)
 74:               changed = true
 75:             }
 76:             if (!changed) continue
 77:             if (cursor < segment.end) children.push({ type: "text", value: source.slice(cursor, segment.end) })
 78:             replacements.set(segment.node, children)
 79:           }
 80:         }
 81:         source = ""
 82:         segments = []
 83:       }
 84: 
 85:       /** @param {RootContent} node */
 86:       function collect(node) {
 87:         if (node.type === "text" || (node.type === "element" && node.tagName === "br")) {
 88:           const value = node.type === "text" ? node.value : "\n"
 89:           segments.push({ node, start: source.length, end: source.length + value.length })
 90:           source += value
 91:         } else if (node.type === "element") {
 92:           if (literalElements.has(node.tagName)) {
 93:             flush()
 94:           } else if (inlineElements.has(node.tagName)) {
 95:             node.children.forEach(collect)
 96:           } else {
 97:             flush()
 98:             process(node)
 99:           }
100:         }
101:       }
102: 
103:       parent.children.forEach(collect)
104:       flush()
105:     }
106: 
107:     /** @param {Root | Element} parent */
108:     function replace(parent) {
109:       parent.children = parent.children.flatMap(node => {
110:         const replacement = replacements.get(node)
111:         if (replacement) return replacement
112:         if (node.type === "element") replace(node)
113:         return [node]
114:       })
115:     }
116: 
117:     // A formula may span several styled spans or soft line breaks, but never
118:     // separate paragraphs, code examples, or non-text content such as images.
119:     process(tree)
120:     replace(tree)
121:   }
122: }
</file>

