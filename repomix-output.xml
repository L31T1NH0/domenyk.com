11: 
12: export function PostSeriesContext({ series, chapters, currentPostId, placement }: Props) {
13:   const currentIndex = chapters.findIndex((chapter) => chapter._id.toString() === currentPostId)
14:   if (currentIndex < 0) return null
15:   const currentPosition = currentIndex + 1
16:   const previous = chapters[currentIndex - 1]
17:   const next = chapters[currentIndex + 1]
18:   const seriesHref = `/series/${encodeURIComponent(series.slug)}`
19: 
20:   if (placement === "before") {
21:     return (
22:       <aside className="post-series-intro" aria-label="Este texto faz parte de uma série">
23:         <div>
24:           <span>Série · capítulo {String(currentPosition).padStart(2, "0")}</span>
25:           <Link href={seriesHref}>{series.title}</Link>
26:         </div>
27:         <span className="post-series-progress" aria-label={`${currentPosition} de ${chapters.length} capítulos`}>
28:           <span style={{ width: `${(currentPosition / chapters.length) * 100}%` }} />
29:         </span>
30:       </aside>
31:     )
32:   }
33: 
34:   return (
35:     <nav className="post-series-navigation" aria-label={`Navegação da série ${series.title}`}>
36:       <div className="post-series-navigation-heading">
37:         <span>Continue na série</span>
38:         <Link href={seriesHref}>Ler obra completa</Link>
39:       </div>
40:       <div className="post-series-navigation-grid">
41:         {previous ? (
42:           <Link href={`/posts/${encodeURIComponent(previous.slug)}`} rel="prev">
43:             <span>Capítulo anterior</span>
44:             <strong>{previous.title}</strong>
45:           </Link>
46:         ) : <span aria-hidden />}
47:         {next ? (
48:           <Link href={`/posts/${encodeURIComponent(next.slug)}`} rel="next">
49:             <span>Próximo capítulo</span>
50:             <strong>{next.title}</strong>
51:           </Link>
52:         ) : (
53:           <Link href={seriesHref}>
54:             <span>Você chegou ao capítulo mais recente</span>
55:             <strong>Rever a série completa</strong>
56:           </Link>
57:         )}
58:       </div>
59:     </nav>
60:   )
61: }
