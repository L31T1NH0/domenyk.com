138:         ? items.length - 1
139:         : event.key === "ArrowDown"
140:           ? (currentIndex + 1 + items.length) % items.length
141:           : (currentIndex - 1 + items.length) % items.length
142:     items[nextIndex]?.focus()
143:   }
