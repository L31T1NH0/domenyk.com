143:         <span className="text-xs font-medium text-zinc-700 dark:text-zinc-300">
144:           {hasCompleteHistory ? `${item.count} ocorrências` : `${occurrenceItems.length} horários registrados`}
145:         </span>
146:         <Link
147:           href={item.href}
148:           onClick={onClose}
149:           className="inline-flex items-center gap-1 text-xs font-medium text-zinc-600 transition-colors hover:text-zinc-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-950 dark:text-zinc-400 dark:hover:text-white dark:focus-visible:outline-white"
150:         >
151:           Abrir conteúdo
152:           <ArrowUpRightIcon className="size-3.5" aria-hidden />
153:         </Link>
154:       </div>
155:       <ol className="px-4 py-1">
156:         {occurrenceItems.map((occurrence, index) => {
157:           const date = new Date(occurrence.occurredAt)
158:           const viewDetails: Array<[string, string | undefined]> = [
159:             ...(item.kind === "view" ? [["Leitura", occurrence.reading ? `Concluída · ${readingDuration(occurrence.reading.activeSeconds)}` : "Não confirmada"] as [string, string]] : []),
160:             ["Página visitada", occurrence.page],
161:             ["Origem", occurrence.source],
162:             ["Dispositivo", occurrence.device],
163:             ["Navegador", occurrence.browser],
164:             ["Sistema", occurrence.os],
165:             ["Localização", occurrence.location],
166:             ["Campanha", occurrence.campaign],
167:             ["Página de entrada", occurrence.landingPage],
168:             ["Idioma", occurrence.language],
169:             ["Visitante", occurrence.visitorType],
170:             ["Tráfego", occurrence.trafficType],
171:           ].filter((detail): detail is [string, string] => Boolean(detail[1]))
172:           const actionCounts = new Map<string, number>()
173:           occurrence.actions?.forEach((action) => {
174:             const label = ACTION_LABELS[action.type]
