137:   const doc = new DOMParser().parseFromString(source, "text/html")
138:   const supported = new Set(["p", "br", "h1", "h2", "h3", "h4", "h5", "h6", "blockquote", "ul", "ol", "li", "pre", "code", "a", "strong", "b", "em", "i", "u", "s", "span", "figure", "img", "figcaption"])
