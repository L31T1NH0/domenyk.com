169: async function getHomeSearchTimelinePage(
170:   page: number,
171:   mode: PublicFeedMode,
172:   limit: number,
173:   normalizedSearch: string
174: ): Promise<HomeTimelinePage> {
175:   let posts: SerializedPostSummary[] = []
176:   let notes: SerializedNote[] = []
177: 
178:   if (mode === "all") {
179:     const entries = await getTimelinePage({ page, limit, search: normalizedSearch })
180:     posts = entries
181:       .filter((entry) => entry.type === "post")
182:       .map((entry) => serializePostSummary(entry.post))
183:     notes = entries
184:       .filter((entry) => entry.type === "note")
185:       .map((entry) => serializeNote(entry.note))
186:   } else if (mode === "posts") {
187:     const result = await getPosts({
188:       page,
189:       limit,
190:       excludeHiddenFromTimeline: true,
191:       search: normalizedSearch,
192:     })
193:     posts = result.posts.map((post) => serializePostSummary(post))
194:   } else {
195:     const result = await getNotes({ page, limit, search: normalizedSearch })
196:     notes = result.notes.map(serializeNote)
197:   }
198: 
199:   const [desktopEntries, desktopPostCount, desktopLooseNoteCount, threadPage] = await Promise.all([
200:     getStandaloneTimelinePage({ page, limit, search: normalizedSearch, mode }),
201:     mode === "notes"
202:       ? Promise.resolve(0)
203:       : countPosts({ excludeHiddenFromTimeline: true, search: normalizedSearch }),
204:     mode === "posts" ? Promise.resolve(0) : countStandaloneNotes(normalizedSearch),
205:     mode === "posts"
206:       ? Promise.resolve({ threads: [], total: 0 })
207:       : getNoteThreadPage({ page, limit, search: normalizedSearch }),
208:   ])
209: 
210:   return {
211:     posts,
212:     notes,
213:     desktopPosts: desktopEntries
214:       .filter((entry) => entry.type === "post")
215:       .map((entry) => serializePostSummary(entry.post)),
216:     desktopNotes: desktopEntries
217:       .filter((entry) => entry.type === "note")
218:       .map((entry) => serializeNote(entry.note)),
219:     desktopThreadNotes: threadPage.threads.flat().map(serializeNote),
220:     desktopPostCount,
221:     desktopLooseNoteCount,
222:     desktopThreadCount: threadPage.total,
223:   }
224: }
225: 
226: const getCachedHomeSearchTimelinePage = unstable_cache(
227:   getHomeSearchTimelinePage,
228:   ["home-search-feed"],
229:   { tags: [PUBLIC_CONTENT_CACHE_TAG], revalidate: PUBLIC_SEARCH_REVALIDATE_SECONDS }
230: )
