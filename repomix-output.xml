 27:   }
 28:   actions?: Array<{
 29:     type: "copied_link" | "commented" | "sent_message"
 30:     occurredAt: Date
 31:   }>
 32: }
 33: 
 34: type NotificationOccurrence = NotificationOccurrenceDetails & {
 35:   occurredAt: Date
 36: }
 37: 
 38: const MAX_NOTIFICATION_OCCURRENCES = 200
 39: const ENGAGEMENT_TOKEN_TTL_MS = 4 * 60 * 60_000
 40: 
 41: export type Notification = {
 42:   _id: ObjectId
 43:   recipientId: string
 44:   kind: NotificationKind
 45:   title: string
 46:   description: string
 47:   href: string
 48:   actorId?: string
