104: function commentMarkdownOptions(content: string): MarkdownRenderOptions {
105:   const allowedUrlPrefixes = new Set<string>()
106:   const urlPattern = /https:\/\/[^\s)"'<>]+/g
107: 
108:   for (const candidate of content.match(urlPattern) ?? []) {
109:     try {
110:       const url = new URL(candidate)
111:       if (
112:         url.protocol === "https:" &&
113:         isProjectBlobHostname(url.hostname) &&
114:         url.pathname.startsWith("/comments/")
115:       ) {
116:         allowedUrlPrefixes.add(`${url.origin}/comments/`)
117:       }
118:     } catch {
119:       // Invalid URLs are removed by the restricted Markdown renderer.
120:     }
121:   }
122: 
123:   return {
124:     externalLinkRel: ["ugc", "nofollow", "noopener", "noreferrer"],
125:     imagePolicy: {
126:       mode: "allowlist",
127:       allowedUrlPrefixes: [...allowedUrlPrefixes],
128:       maxImages: MAX_COMMENT_IMAGES,
129:     },
130:   }
131: }
