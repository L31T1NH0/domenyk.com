 1: import { NextRequest, NextResponse } from "next/server"
 2: import { getHomeTimelinePage, type PublicFeedMode } from "@/lib/public-content-cache"
 3: import { rateLimit } from "@/lib/rate-limit"
 4: import { requestIdentity } from "@/lib/request-identity"
 5: 
 6: const PAGE_SIZE = 10
 7: const MAX_PAGE = 10_000
 8: const FEED_MODES = new Set<PublicFeedMode>(["all", "posts", "notes"])
 9: const PUBLIC_CACHE_HEADERS = {
10:   "Cache-Control": "public, max-age=0, s-maxage=60, stale-while-revalidate=300",
11: }
12: const PRIVATE_CACHE_HEADERS = { "Cache-Control": "private, no-store, max-age=0" }
13: 
14: export async function GET(request: NextRequest) {
15:   const identity = requestIdentity(request)
16:   if (!(await rateLimit(`timeline-read:${identity}`, { limit: 120, windowMs: 60_000 }))) {
17:     return NextResponse.json({ error: "Muitas requisições." }, { status: 429 })
18:   }
19: 
20:   const rawPage = Number(request.nextUrl.searchParams.get("page") ?? 1)
21:   const page = Number.isInteger(rawPage) && rawPage > 0 ? Math.min(rawPage, MAX_PAGE) : 1
22:   const rawMode = request.nextUrl.searchParams.get("mode") ?? "all"
23:   const mode = FEED_MODES.has(rawMode as PublicFeedMode) ? rawMode as PublicFeedMode : "all"
24:   const search = request.nextUrl.searchParams.get("q")?.trim().replace(/\s+/g, " ") ?? ""
25: 
26:   if (search.length > 120) {
27:     return NextResponse.json({ error: "A busca deve ter no máximo 120 caracteres." }, { status: 400 })
28:   }
29:   if (search && !(await rateLimit(`timeline-search:${identity}`, { limit: 30, windowMs: 60_000 }))) {
30:     return NextResponse.json({ error: "Muitas buscas. Tente novamente em instantes." }, { status: 429 })
31:   }
32: 
33:   const result = await getHomeTimelinePage({
34:     page,
35:     mode,
36:     limit: PAGE_SIZE,
37:     search: search || undefined,
38:   })
39: 
40:   return NextResponse.json(result, {
41:     headers: search ? PRIVATE_CACHE_HEADERS : PUBLIC_CACHE_HEADERS,
42:   })
43: }
</file>

