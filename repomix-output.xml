<file path="src/lib/post-engagement.ts">
 1: const LATEST_ENGAGEMENT_KEY = "domenyk:latest-post-engagement"
 2: 
 3: type Engagement = {
 4:   token: string
 5:   publicId: string
 6:   path: string
 7:   at: number
 8: }
 9: 
10: function engagementKey(publicId: string) {
11:   return `domenyk:post-engagement:${publicId}`
12: }
13: 
14: function readEngagement(value: string | null): Engagement | null {
15:   try {
16:     const engagement = JSON.parse(value ?? "null") as Engagement | null
17:     if (!engagement?.token || Date.now() - engagement.at > 4 * 60 * 60_000) return null
18:     return engagement
19:   } catch {
20:     return null
21:   }
22: }
23: 
24: export function setPostEngagement(publicId: string, token: string) {
25:   const engagement: Engagement = { token, publicId, path: window.location.pathname, at: Date.now() }
26:   try {
27:     sessionStorage.setItem(engagementKey(publicId), JSON.stringify(engagement))
28:     sessionStorage.setItem(LATEST_ENGAGEMENT_KEY, JSON.stringify(engagement))
29:   } catch {}
30:   window.dispatchEvent(new CustomEvent("post-engagement-ready", { detail: engagement }))
31: }
32: 
33: export function getPostEngagement(publicId: string) {
34:   try { return readEngagement(sessionStorage.getItem(engagementKey(publicId))) } catch { return null }
35: }
36: 
37: async function sendAction(engagement: Engagement | null, action: "copied_link" | "commented" | "sent_message") {
38:   if (!engagement) return
39:   await fetch("/api/engagement", {
40:     method: "PATCH",
41:     headers: { "Content-Type": "application/json" },
42:     body: JSON.stringify({ token: engagement.token, event: "action", action }),
43:     keepalive: true,
44:   }).catch(() => undefined)
45: }
46: 
47: export function recordCurrentPostAction(action: "copied_link" | "commented") {
48:   let engagement: Engagement | null = null
49:   try { engagement = readEngagement(sessionStorage.getItem(LATEST_ENGAGEMENT_KEY)) } catch {}
50:   if (!engagement || engagement.path !== window.location.pathname) return Promise.resolve()
51:   return sendAction(engagement, action)
52: }
53: 
54: export function recordLatestPostMessage() {
55:   let engagement: Engagement | null = null
56:   try { engagement = readEngagement(sessionStorage.getItem(LATEST_ENGAGEMENT_KEY)) } catch {}
57:   return sendAction(engagement, "sent_message")
58: }
