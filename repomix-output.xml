226:   }
227:   createDOM() {
228:     const figure = document.createElement("figure")
229:     this.applyFigureDOM(figure, true)
230:     return figure
231:   }
232:   updateDOM(_previous: ImageNode, figure: HTMLElement) { this.applyFigureDOM(figure, true); return false }
233: 
234:   exportDOM(): DOMExportOutput {
235:     const figure = document.createElement("figure")
236:     this.applyFigureDOM(figure)
