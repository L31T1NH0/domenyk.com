 28: function getSiteUrl() {
 29:   const rawUrl =
 30:     process.env.NEXT_PUBLIC_SITE_URL ??
 31:     (process.env.NODE_ENV === "development"
 32:       ? process.env.VERCEL_URL ?? "http://localhost:3000"
 33:       : "https://domenyk.com")
 34: 
 35:   const url = rawUrl.startsWith("http") ? rawUrl : `https://${rawUrl}`
 36:   return url.replace(/\/$/, "")
 37: }
