  1: export const READING_PREFERENCES_STORAGE_KEY = "reading-preferences-v3"
  2: export const LEGACY_READING_PREFERENCES_STORAGE_KEY = "reading-preferences-v2"
  3: 
  4: export type ReadingPreferenceKey =
  5:   | "fontSize"
  6:   | "lineHeight"
  7:   | "letterSpacing"
  8:   | "blockSpacing"
  9: 
 10: export type ReadingPreferences = Record<ReadingPreferenceKey, number | null>
 11: 
 12: export type ReadingPreferenceProfile = "home" | "post"
 13: 
 14: export type ReadingPreferenceProfiles = Record<ReadingPreferenceProfile, ReadingPreferences>
 15: 
 16: export type ReadingMetrics = {
 17:   autoFontSize: number
 18:   baseLineHeight: number
 19:   baseBlockSpacing: number
 20: }
 21: 
 22: export type EffectiveReadingMetrics = {
 23:   fontSize: number
 24:   lineHeight: number
 25:   letterSpacing: number
 26:   blockSpacing: number
 27: }
 28: 
 29: type ReadingPreferenceRange = {
 30:   min: number
 31:   max: number
 32:   step: number
 33:   precision: number
 34: }
 35: 
 36: export const DEFAULT_READING_PREFERENCES: ReadingPreferences = {
 37:   fontSize: null,
 38:   lineHeight: null,
 39:   letterSpacing: null,
 40:   blockSpacing: null,
 41: }
 42: 
 43: export const DEFAULT_READING_PREFERENCE_PROFILES: ReadingPreferenceProfiles = {
 44:   home: { ...DEFAULT_READING_PREFERENCES },
 45:   post: { ...DEFAULT_READING_PREFERENCES },
 46: }
 47: 
 48: export const DEFAULT_READING_METRICS: ReadingMetrics = {
 49:   autoFontSize: 18,
 50:   baseLineHeight: 1.65,
 51:   baseBlockSpacing: 0.75,
 52: }
 53: 
 54: export const READING_PREFERENCE_RANGES: Record<ReadingPreferenceKey, ReadingPreferenceRange> = {
 55:   fontSize: { min: 12, max: 24, step: 1, precision: 0 },
 56:   lineHeight: { min: 1.35, max: 2.4, step: 0.05, precision: 3 },
 57:   letterSpacing: { min: 0, max: 0.12, step: 0.005, precision: 3 },
 58:   blockSpacing: { min: 0, max: 2, step: 0.125, precision: 3 },
 59: }
 60: 
 61: function roundTo(value: number, precision: number) {
 62:   const factor = 10 ** precision
 63:   return Math.round((value + Number.EPSILON) * factor) / factor
 64: }
 65: 
 66: function baseMetricForPreference(key: ReadingPreferenceKey, metrics: ReadingMetrics) {
 67:   if (key === "fontSize") return metrics.autoFontSize
 68:   if (key === "lineHeight") return metrics.baseLineHeight
 69:   if (key === "blockSpacing") return metrics.baseBlockSpacing
 70:   return 0.005
 71: }
 72: 
 73: export function clampReadingPreference(key: ReadingPreferenceKey, value: number) {
 74:   const range = READING_PREFERENCE_RANGES[key]
 75:   const finiteValue = Number.isFinite(value) ? value : range.min
 76:   return roundTo(Math.min(range.max, Math.max(range.min, finiteValue)), range.precision)
 77: }
 78: 
 79: export function normalizeReadingPreferences(value: unknown): ReadingPreferences {
 80:   if (!value || typeof value !== "object") return { ...DEFAULT_READING_PREFERENCES }
 81:   const candidate = value as Partial<Record<ReadingPreferenceKey, unknown>>
 82: 
 83:   return {
 84:     fontSize: typeof candidate.fontSize === "number"
 85:       ? clampReadingPreference("fontSize", candidate.fontSize)
 86:       : null,
 87:     lineHeight: typeof candidate.lineHeight === "number"
 88:       ? clampReadingPreference("lineHeight", candidate.lineHeight)
 89:       : null,
 90:     letterSpacing: typeof candidate.letterSpacing === "number"
 91:       ? clampReadingPreference("letterSpacing", candidate.letterSpacing)
 92:       : null,
 93:     blockSpacing: typeof candidate.blockSpacing === "number"
 94:       ? clampReadingPreference("blockSpacing", candidate.blockSpacing)
 95:       : null,
 96:   }
 97: }
 98: 
 99: export function normalizeReadingPreferenceProfiles(value: unknown): ReadingPreferenceProfiles {
100:   if (value && typeof value === "object" && ("home" in value || "post" in value)) {
101:     const candidate = value as Partial<Record<ReadingPreferenceProfile, unknown>>
102:     return {
103:       home: normalizeReadingPreferences(candidate.home),
104:       post: normalizeReadingPreferences(candidate.post),
105:     }
106:   }
107: 
108:   const legacyPreferences = normalizeReadingPreferences(value)
109:   return {
110:     home: { ...legacyPreferences },
111:     post: { ...legacyPreferences },
112:   }
113: }
114: 
115: export function readingPreferenceProfileForPathname(pathname: string): ReadingPreferenceProfile {
116:   return pathname === "/" || pathname === "/notes" ? "home" : "post"
117: }
118: 
119: export function adjustReadingPreference(
120:   preferences: ReadingPreferences,
121:   metrics: ReadingMetrics,
122:   key: ReadingPreferenceKey,
123:   direction: -1 | 1
124: ): ReadingPreferences {
125:   const { step } = READING_PREFERENCE_RANGES[key]
126:   const currentValue = preferences[key] ?? baseMetricForPreference(key, metrics)
127:   return {
128:     ...preferences,
129:     [key]: clampReadingPreference(key, currentValue + step * direction),
130:   }
131: }
132: 
133: export function resetReadingPreference(
134:   preferences: ReadingPreferences,
135:   key: ReadingPreferenceKey
136: ): ReadingPreferences {
137:   return { ...preferences, [key]: null }
138: }
139: 
140: export function hasCustomReadingPreferences(preferences: ReadingPreferences) {
141:   return (Object.keys(DEFAULT_READING_PREFERENCES) as ReadingPreferenceKey[])
142:     .some((key) => preferences[key] !== null)
143: }
144: 
145: export function effectiveReadingMetrics(
146:   preferences: ReadingPreferences,
147:   metrics: ReadingMetrics
148: ): EffectiveReadingMetrics {
149:   return {
150:     fontSize: preferences.fontSize ?? metrics.autoFontSize,
151:     lineHeight: preferences.lineHeight ?? metrics.baseLineHeight,
152:     letterSpacing: preferences.letterSpacing ?? 0.005,
153:     blockSpacing: preferences.blockSpacing ?? metrics.baseBlockSpacing,
154:   }
155: }
