65:   imageHeight: number
66:   imageLeft: number
67:   imageWidth: number
68:   shapeMargin: number
69: }): LineSlot {
70:   const obstacle = alphaIntervalForBand(
71:     geometry,
72:     bandTop,
73:     bandBottom,
74:     imageTop,
75:     imageHeight,
76:     imageLeft,
77:     imageWidth,
78:     shapeMargin
79:   )
80:   if (!obstacle) return { left: 0, width: containerWidth }
81:   if (side === "left") {
82:     const left = Math.min(containerWidth, Math.max(0, obstacle.right))
83:     return { left, width: Math.max(0, containerWidth - left) }
84:   }
85:   return { left: 0, width: Math.max(0, Math.min(containerWidth, obstacle.left)) }
86: }
</file>

<file path="src/components/post/ParagraphCommentsLayer.tsx">
  1: "use client"
  2: 
  3: import { useCallback, useEffect, useRef, useState, type CSSProperties } from "react"
  4: import { createPortal } from "react-dom"
  5: import { ChatBubbleLeftRightIcon } from "@heroicons/react/24/outline"
  6: import { ParagraphThread } from "./ParagraphThread"
  7: import type { PostLocale } from "@/lib/post-locales"
  8: 
  9: type ParagraphPosition = {
 10:   pid: string
 11:   top: number
 12:   left: number
 13: }
 14: 
 15: type Props = {
 16:   postId: string
 17:   isAdmin?: boolean
 18:   containerSelector?: string
 19:   locale?: PostLocale
 20:   variant?: "default" | "editorial"
 21: }
 22: 
 23: export function ParagraphCommentsLayer({ postId, isAdmin = false, containerSelector = "[data-post-content]", locale = "pt", variant = "default" }: Props) {
 24:   const [activePid, setActivePid] = useState<string | null>(null)
 25:   const [hoveredPid, setHoveredPid] = useState<string | null>(null)
 26:   const [counts, setCounts] = useState<Record<string, number>>({})
 27:   const [paragraphIds, setParagraphIds] = useState<string[]>([])
 28:   const [paragraphPositions, setParagraphPositions] = useState<ParagraphPosition[]>([])
 29:   const [isTouch, setIsTouch] = useState(false)
 30:   const [topicsHeight, setTopicsHeight] = useState(128)
 31:   const layerRef = useRef<HTMLDivElement>(null)
 32:   const hoveredPidRef = useRef<string | null>(null)
 33:   const positionFrameRef = useRef<number | null>(null)
 34:   const hideButtonTimerRef = useRef<ReturnType<typeof setTimeout> | null>(null)
 35:   const paragraphIdsKey = paragraphIds.join("\n")
 36: 
 37:   useEffect(() => {
 38:     hoveredPidRef.current = hoveredPid
 39:   }, [hoveredPid])
 40: 
 41:   const clearHideButtonTimer = useCallback(() => {
 42:     if (hideButtonTimerRef.current) {
 43:       clearTimeout(hideButtonTimerRef.current)
 44:       hideButtonTimerRef.current = null
 45:     }
 46:   }, [])
 47: 
 48:   const scheduleHideButton = useCallback((delay = 250) => {
 49:     clearHideButtonTimer()
 50:     hideButtonTimerRef.current = setTimeout(() => setHoveredPid(null), delay)
 51:   }, [clearHideButtonTimer])
 52: 
 53:   useEffect(() => {
 54:     const container = document.querySelector<HTMLElement>(containerSelector)
 55:     const layer = layerRef.current
 56:     if (!container || !layer) return
 57: 
 58:     const measureParagraphs = () => {
 59:       positionFrameRef.current = null
 60:       const containerRect = container.getBoundingClientRect()
 61:       const layerRect = layer.getBoundingClientRect()
 62:       const paragraphs = Array.from(container.querySelectorAll<HTMLElement>("[data-pid]"))
 63:       const next = paragraphs.flatMap((paragraph) => {
 64:         const pid = paragraph.dataset.pid
 65:         if (!pid || paragraph.getClientRects().length === 0) return []
 66:         const rect = paragraph.getBoundingClientRect()
 67:         const lineHeight = parseFloat(getComputedStyle(paragraph).lineHeight) || 24
 68:         return [{
 69:           pid,
 70:           top: rect.top - layerRect.top + Math.max(0, (lineHeight - 32) / 2),
 71:           left: containerRect.right - layerRect.left + 12,
 72:         }]
 73:       })
 74:       setParagraphPositions((current) => current.length === next.length && current.every((entry, index) => (
 75:         entry.pid === next[index].pid && Math.abs(entry.top - next[index].top) < 0.5 &&
 76:         Math.abs(entry.left - next[index].left) < 0.5
 77:       )) ? current : next)
 78:     }
 79:     const scheduleMeasure = () => {
 80:       if (positionFrameRef.current === null) {
 81:         positionFrameRef.current = window.requestAnimationFrame(measureParagraphs)
 82:       }
 83:     }
 84:     const resizeObserver = new ResizeObserver(scheduleMeasure)
 85:     const collectParagraphs = () => {
 86:       const paragraphs = Array.from(container.querySelectorAll<HTMLElement>("[data-pid]"))
 87:       const ids = paragraphs.map((paragraph) => paragraph.dataset.pid).filter((pid): pid is string => Boolean(pid))
 88:       setParagraphIds((current) => current.join("\n") === ids.join("\n") ? current : ids)
 89:       resizeObserver.disconnect()
 90:       resizeObserver.observe(container)
 91:       paragraphs.forEach((paragraph) => resizeObserver.observe(paragraph))
 92:       scheduleMeasure()
 93:     }
 94: 
 95:     collectParagraphs()
 96:     const observer = new MutationObserver(collectParagraphs)
 97:     observer.observe(container, { childList: true, subtree: true, characterData: true })
 98:     window.addEventListener("resize", scheduleMeasure)
 99: 
100:     return () => {
101:       observer.disconnect()
102:       resizeObserver.disconnect()
103:       window.removeEventListener("resize", scheduleMeasure)
104:       if (positionFrameRef.current !== null) {
105:         window.cancelAnimationFrame(positionFrameRef.current)
106:         positionFrameRef.current = null
107:       }
108:     }
109:   }, [containerSelector])
110: 
111:   useEffect(() => {
112:     const pids = paragraphIdsKey ? paragraphIdsKey.split("\n") : []
113:     if (pids.length === 0) return
114: 
115:     const controller = new AbortController()
116: 
117:     fetch(`/api/comments/${postId}/paragraph-counts`, {
118:       method: "POST",
119:       headers: { "Content-Type": "application/json" },
120:       body: JSON.stringify({ paragraphIds: pids, locale }),
121:       signal: controller.signal,
122:     })
123:       .then((r) => r.ok ? r.json() : {})
124:       .then((next: Record<string, number>) => {
125:         setCounts(next)
126:       })
127:       .catch((error: unknown) => {
128:         if (error instanceof DOMException && error.name === "AbortError") return
129:         setCounts({})
130:       })
131: 
132:     return () => {
133:       controller.abort()
134:     }
135:   }, [locale, paragraphIdsKey, postId])
136: 
137:   useEffect(() => {
138:     if (typeof window === "undefined") return
139: 
140:     const media = window.matchMedia("(hover: none), (pointer: coarse), (max-width: 767px)")
141:     const update = () => setIsTouch(media.matches || navigator.maxTouchPoints > 0)
142: 
143:     update()
144:     media.addEventListener("change", update)
145:     return () => media.removeEventListener("change", update)
146:   }, [])
147: 
148:   useEffect(() => {
149:     const onChange = (event: Event) => {
150:       const detail = (event as CustomEvent<{ height?: number }>).detail
151:       setTopicsHeight(typeof detail?.height === "number" && Number.isFinite(detail.height) && detail.height > 0 ? detail.height : 128)
152:     }
153: 
154:     window.addEventListener("paragraph-topics-compact-change", onChange)
155:     return () => window.removeEventListener("paragraph-topics-compact-change", onChange)
156:   }, [])
157: 
158:   useEffect(() => {
159:     const container = document.querySelector(containerSelector)
160:     if (!container) return
161: 
162:     const paragraphs = Array.from(container.querySelectorAll<HTMLElement>("[data-pid]"))
163:     paragraphs.forEach((paragraph) => paragraph.classList.add("paragraph-comments-target"))
164: 
165:     const onMouseMove = (event: Event) => {
166:       if (isTouch) return
167:       const target = event.target as HTMLElement
168:       const paragraph = target.closest<HTMLElement>("[data-pid]")
169:       if (!paragraph || !container.contains(paragraph)) return
170: 
171:       const pid = paragraph.dataset.pid
172:       if (!pid) return
173: 
174:       clearHideButtonTimer()
175:       if (hoveredPidRef.current !== pid) {
176:         hoveredPidRef.current = pid
177:         setHoveredPid(pid)
178:       }
179:     }
180: 
181:     const onMouseLeave = () => {
182:       if (!isTouch) scheduleHideButton()
183:     }
184: 
185:     container.addEventListener("mousemove", onMouseMove)
186:     container.addEventListener("mouseleave", onMouseLeave)
187: 
188:     const cleanups = paragraphs.map((paragraph) => {
189:       const pid = paragraph.dataset.pid
190:       if (!pid) return () => {}
191: 
192:       const onClick = (event: MouseEvent) => {
193:         if (!isTouch) return
194:         const target = event.target as HTMLElement
195:         if (target.closest("a, button, img, textarea, input, select, [contenteditable='true']")) return
196:         if (window.getSelection()?.toString().trim()) return
197:         setActivePid((current) => (current === pid ? null : pid))
198:       }
199: 
200:       paragraph.addEventListener("click", onClick)
201: 
202:       return () => {
203:         paragraph.removeEventListener("click", onClick)
204:       }
205:     })
206: 
207:     return () => {
208:       clearHideButtonTimer()
209:       container.removeEventListener("mousemove", onMouseMove)
210:       container.removeEventListener("mouseleave", onMouseLeave)
211:       paragraphs.forEach((paragraph) => paragraph.classList.remove("paragraph-comments-target"))
212:       cleanups.forEach((cleanup) => cleanup())
213:     }
214:   }, [clearHideButtonTimer, containerSelector, isTouch, paragraphIdsKey, scheduleHideButton])
215: 
216:   const canUseDom = typeof document !== "undefined" && typeof window !== "undefined"
217:   const handleThreadCountChange = useCallback((count: number) => {
218:     if (!activePid) return
219:     setCounts((prev) => ({ ...prev, [activePid]: count }))
220:   }, [activePid])
221: 
222:   useEffect(() => {
223:     window.dispatchEvent(new CustomEvent("paragraph-comments-open-change", {
224:       detail: { open: Boolean(activePid) },
225:     }))
226: 
227:     return () => {
228:       window.dispatchEvent(new CustomEvent("paragraph-comments-open-change", {
229:         detail: { open: false },
230:       }))
231:     }
232:   }, [activePid])
233: 
234:   return (
235:     <div ref={layerRef} className="absolute inset-0 pointer-events-none">
236:       {!isTouch && paragraphPositions.map(({ pid, top, left }) => {
237:         const count = counts[pid] ?? 0
238:         const active = activePid === pid
239:         const visible = hoveredPid === pid || active || count > 0
240:         return (
241:           <div
242:             key={pid}
243:             className="absolute"
244:             style={{ top, left }}
245:           >
246:             <button
247:               type="button"
248:               onPointerEnter={clearHideButtonTimer}
249:               onPointerLeave={() => scheduleHideButton(250)}
250:               onFocus={() => {
251:                 clearHideButtonTimer()
252:                 setHoveredPid(pid)
253:               }}
254:               onBlur={() => scheduleHideButton(250)}
255:               onClick={() => {
256:                 clearHideButtonTimer()
257:                 setHoveredPid(pid)
258:                 setActivePid((current) => current === pid ? null : pid)
259:               }}
260:               className={[
261:                 "group relative flex min-h-8 w-9 items-center justify-center gap-0.5 py-2 text-neutral-500 transition-[opacity,color] duration-150 hover:text-neutral-950 focus-visible:pointer-events-auto focus-visible:opacity-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-400 motion-reduce:transition-none dark:text-[#8f8981] dark:hover:text-[#f1f1f1]",
262:                 visible ? "pointer-events-auto opacity-100" : "pointer-events-none opacity-0",
263:                 active ? "text-neutral-950 dark:text-[#f1f1f1]" : "",
264:               ].join(" ")}
265:               aria-label={count > 0 ? `${count} ${count === 1 ? "comentário neste parágrafo" : "comentários neste parágrafo"}` : "Comentar neste parágrafo"}
266:               aria-expanded={active}
267:               title={active ? "Fechar comentários deste parágrafo" : "Comentar neste parágrafo"}
268:             >
269:               <span aria-hidden className="absolute -left-1 top-1.5 h-5 w-px bg-current opacity-25 group-hover:opacity-50" />
270:               <ChatBubbleLeftRightIcon className="size-3.5 shrink-0" aria-hidden="true" />
271:               {count > 0 && <span className="text-[10px] leading-none tabular-nums" aria-hidden>{count > 99 ? "99+" : count}</span>}
272:             </button>
273:           </div>
274:         )
275:       })}
276: 
277:       {canUseDom && activePid && createPortal(
278:         <div
279:           className={[
280:             "pointer-events-auto fixed right-4 bottom-4 left-4 z-[70] sm:left-auto sm:w-80 xl:bottom-4",
281:             variant === "editorial"
282:               ? "xl:left-auto xl:right-4 xl:top-[8rem] xl:w-72"
283:               : "xl:right-auto xl:left-[var(--post-sidebar-left)] xl:w-[var(--post-sidebar-width)] xl:top-[calc(6rem+var(--post-topics-height))]",
284:           ].join(" ")}
285:           style={{ "--post-topics-height": `${topicsHeight}px` } as CSSProperties}
286:         >
287:           <ParagraphThread
288:             postId={postId}
289:             paragraphId={activePid}
290:             locale={locale}
291:             isAdmin={isAdmin}
292:             autoFocus={isTouch}
293:             onCountChange={handleThreadCountChange}
294:             onClose={() => setActivePid(null)}
295:           />
296:         </div>,
297:         document.body
298:       )}
299:     </div>
300:   )
301: }
