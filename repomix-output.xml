 333: function isInteractiveTarget(target: EventTarget) {
 334:   return target instanceof Element && Boolean(target.closest("input, textarea, select, button, [data-swipe-ignore]"))
 335: }
 336: 
 337: function threadSpanAtScrollPosition(rail: HTMLDivElement, scrollTop = rail.scrollTop) {
 338:   const threads = Array.from(rail.querySelectorAll<HTMLElement>("[data-thread-index]"))
 339:   if (threads.length === 0) return Math.max(1, rail.clientHeight)
 340: 
 341:   const firstOffset = threads[0].offsetTop
 342:   let activeIndex = 0
 343:   for (let index = 1; index < threads.length; index += 1) {
 344:     if (scrollTop < threads[index].offsetTop - firstOffset) break
 345:     activeIndex = index
 346:   }
 347: 
 348:   const current = threads[activeIndex]
 349:   const next = threads[activeIndex + 1]
 350:   return Math.max(1, next ? next.offsetTop - current.offsetTop : current.offsetHeight)
 351: }
 352: 
 353: function captureThreadRailPosition(rail: HTMLDivElement): ThreadRailPosition {
 354:   const threads = Array.from(rail.querySelectorAll<HTMLElement>("[data-thread-index]"))
 355:   if (threads.length === 0) {
 356:     return { threadId: null, offsetWithinThread: 0, fallbackScrollTop: rail.scrollTop }
 357:   }
 358: 
 359:   const firstOffset = threads[0].offsetTop
 360:   let active = threads[0]
 361:   for (let index = 1; index < threads.length; index += 1) {
 362:     if (rail.scrollTop < threads[index].offsetTop - firstOffset) break
 363:     active = threads[index]
 364:   }
 365: 
 366:   const activeStart = active.offsetTop - firstOffset
 367:   return {
 368:     threadId: active.dataset.threadId ?? null,
 369:     offsetWithinThread: Math.max(0, rail.scrollTop - activeStart),
 370:     fallbackScrollTop: rail.scrollTop,
 371:   }
 372: }
 373: 
 374: function resolveThreadRailPosition(rail: HTMLDivElement, position: ThreadRailPosition) {
 375:   const threads = Array.from(rail.querySelectorAll<HTMLElement>("[data-thread-index]"))
 376:   const firstOffset = threads[0]?.offsetTop ?? 0
 377:   const anchorIndex = position.threadId
 378:     ? threads.findIndex((thread) => thread.dataset.threadId === position.threadId)
 379:     : -1
 380:   const anchor = anchorIndex >= 0 ? threads[anchorIndex] : null
 381:   const nextAnchor = anchorIndex >= 0 ? threads[anchorIndex + 1] : null
 382:   const anchorSpan = anchor
 383:     ? Math.max(1, nextAnchor ? nextAnchor.offsetTop - anchor.offsetTop : anchor.offsetHeight)
 384:     : 0
 385:   const requestedTop = anchor
 386:     ? anchor.offsetTop - firstOffset + Math.min(position.offsetWithinThread, anchorSpan - 1)
 387:     : position.fallbackScrollTop
 388:   const maxScrollTop = Math.max(0, rail.scrollHeight - rail.clientHeight)
 389:   return Math.min(maxScrollTop, Math.max(0, requestedTop))
 390: }
