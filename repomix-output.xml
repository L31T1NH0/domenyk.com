 38: export function imageStorageErrorMessage(error: unknown): string {
 39:   if (error instanceof BlobAccessError) {
 40:     return "O armazenamento recusou a credencial configurada. Reconecte o Vercel Blob ao projeto."
 41:   }
 42:   if (error instanceof BlobStoreNotFoundError) {
 43:     return "O armazenamento de imagens configurado não existe mais."
 44:   }
 45:   if (error instanceof BlobStoreSuspendedError) {
 46:     return "O armazenamento de imagens está suspenso. Verifique o limite ou faturamento na Vercel."
 47:   }
 48:   if (error instanceof BlobFileTooLargeError) {
 49:     return "O armazenamento recusou a imagem por exceder o limite de tamanho."
 50:   }
 51:   if (error instanceof BlobContentTypeNotAllowedError) {
 52:     return "O armazenamento recusou o formato desta imagem."
 53:   }
 54:   if (error instanceof BlobServiceRateLimited) {
 55:     return "O armazenamento recebeu muitos envios. Aguarde alguns segundos e tente novamente."
 56:   }
 57:   if (error instanceof BlobServiceNotAvailable) {
 58:     return "O armazenamento de imagens está temporariamente indisponível."
 59:   }
 60:   if (error instanceof BlobRequestAbortedError) {
 61:     return "A conexão com o armazenamento foi interrompida durante o envio."
 62:   }
 63:   if (error instanceof BlobUnknownError) {
 64:     return "O Vercel Blob retornou um erro não identificado (blob_unknown)."
 65:   }
 66:   if (error instanceof Error && /No (?:blob credentials|read-write token) found/i.test(error.message)) {
 67:     return "O armazenamento de imagens não está configurado neste ambiente."
 68:   }
 69:   if (error instanceof BlobError && /OIDC/i.test(error.message)) {
 70:     return "A autorização OIDC deste deploy não corresponde ao armazenamento configurado (blob_oidc)."
 71:   }
 72:   if (error instanceof Error && /fetch failed/i.test(error.message)) {
 73:     const cause = error.cause
 74:     const causeCode = typeof cause === "object" && cause && "code" in cause && typeof cause.code === "string"
 75:       ? cause.code.toLowerCase().replace(/[^a-z0-9_-]/g, "").slice(0, 40)
 76:       : "unknown"
 77:     return `A função não conseguiu se conectar ao Vercel Blob (blob_transport_${causeCode}).`
 78:   }
 79: 
 80:   const errorType = error instanceof Error
 81:     ? error.constructor.name.replace(/[^A-Za-z0-9_-]/g, "").slice(0, 40) || "Error"
 82:     : "Unknown"
 83:   return `Não foi possível armazenar a imagem (blob_unexpected_${errorType}).`
 84: }
