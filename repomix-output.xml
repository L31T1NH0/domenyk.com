  1: import assert from "node:assert/strict"
  2: import test from "node:test"
  3: import { renderMarkdownSync } from "../src/lib/mdx.ts"
  4: import { normalizeEditorialText, editorialTextStyle } from "../src/lib/editorial-text.js"
  5: 
  6: test("editorial text renders formatted content with validated responsive styles", () => {
  7:   const html = renderMarkdownSync(':::editor center 24 1.8 16 sand\n\n**Texto** com [link](https://example.com).\n\n:::')
  8:   assert.match(html, /data-editor-align="center"/)
  9:   assert.match(html, /font-size: min\(24px, 8vw\)/)
 10:   assert.match(html, /line-height: 1.8/)
 11:   assert.match(html, /<strong>Texto<\/strong>/)
 12:   assert.doesNotMatch(html, /:::editor/)
 13: })
 14: 
 15: test("editorial directives stay literal in code and incomplete wrappers", () => {
 16:   assert.match(renderMarkdownSync('```\n:::editor center 24 1.8 16 sand\n\ntexto\n\n:::\n```'), /:::editor/)
 17:   assert.match(renderMarkdownSync(':::editor center 24 1.8 16 sand\n\ntexto'), /:::editor/)
 18: })
