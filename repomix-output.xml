<file path="PRODUCT.md">
 1: # Product
 2: 
 3: <!-- impeccable:product-schema 1 -->
 4: 
 5: ## Platform
 6: 
 7: web
 8: 
 9: ## Users
10: 
11: Readers visiting a personal site to browse essays, posts, notes, and short updates. Admin users also manage notes and visibility from the same surfaces.
12: 
13: ## Product Purpose
14: 
15: The site publishes Domenyk's writing and short-form notes in a compact public feed. Success means readers can quickly move between all content, posts, and notes without the interface getting in the way.
16: 
17: ## Positioning
18: 
19: Domenyk's personal publishing site brings longer writing and short-form notes together. The author's voice and published work are the basis of the site's identity.
20: 
21: ## Operating Context
22: 
23: Readers browse the public home on desktop and mobile, switch between all content, posts, and notes, and search published content. Desktop layouts also support browsing parallel feeds and complementary navigation through archives and categories.
24: 
25: Admin users manage published content and visibility. The public site can also show writing in progress.
26: 
27: ## Capabilities and Constraints
28: 
29: - Publish and browse articles, notes, and note threads.
30: - Find content through feed filters, search, archives, and categories.
31: - Help first-time visitors understand who Domenyk is and find an author-selected starting point. This onboarding addition is approved but not yet implemented; the introduction copy and selected texts remain undecided.
32: - Preserve existing publishing, reading, and admin workflows when extending the home.
33: 
34: ## Brand Commitments
35: 
36: Quiet, direct, text-first.
37: 
38: Preserve the existing monochrome identity and the name Domenyk.
39: 
40: ## Evidence on Hand
41: 
42: - Existing public home and feed: `src/app/(public)/page.tsx` and `src/app/(public)/HomeTimeline.tsx`.
43: - Existing archives, categories, and writing-in-progress navigation: `src/components/timeline/TimelineUtilityRail.tsx`.
44: - Available profile image: `public/images/profile.jpg`.
45: - Published content is loaded through the site's content layer. Use real content and author-selected links; do not invent biographical claims or featured titles.
46: 
47: ## Product Principles
48: 
49: - Keep reading and discovering the author's work central to the experience.
50: - Make longer writing and short updates easy to browse together or separately.
51: - Help newcomers find a starting point while preserving quick access for returning readers.
52: - Keep mobile navigation direct and lightweight.
53: 
54: ## Anti-references
55: 
56: Avoid generic landing-page patterns, oversized decorative UI, heavy card systems, and visual effects that compete with reading.
57: 
58: ## Design Principles
59: 
60: - Keep the timeline compact and readable.
61: - Prefer direct controls over explanatory labels.
62: - Preserve the existing monochrome, text-led identity.
63: - Make mobile navigation fast with minimal chrome.
64: 
65: ## Accessibility & Inclusion
66: 
67: Maintain keyboard-accessible controls, semantic labels, readable contrast, and reduced reliance on motion for navigation.
</file>

<file path="src/app/(public)/notes/NotesTimeline.tsx">
  1: "use client"
  2: 
  3: import { useMemo, useState } from "react"
  4: import { useRouter } from "next/navigation"
  5: import { NoteCard } from "@/components/notes/NoteCard"
  6: import { NoteComposer } from "@/components/notes/NoteComposer"
  7: import type { SerializedNote } from "@/lib/db/notes"
  8: import { groupNotesByThread, mergeNotesById } from "@/lib/note-thread"
  9: import { NoteTimelineGroup } from "@/components/notes/NoteTimelineGroup"
 10: 
 11: type Props = {
 12:   initialNotes: SerializedNote[]
 13:   initialCursor: string | null
 14:   isAdmin: boolean
 15:   showComposer?: boolean
 16:   showAdminHint?: boolean
 17: }
 18: 
 19: export function NotesTimeline({
 20:   initialNotes,
 21:   initialCursor,
 22:   isAdmin,
 23:   showComposer = false,
 24:   showAdminHint = false,
 25: }: Props) {
 26:   const router = useRouter()
 27:   const [notes, setNotes] = useState(initialNotes)
 28:   const [cursor, setCursor] = useState(initialCursor)
 29:   const [loading, setLoading] = useState(false)
 30:   const [deletingId, setDeletingId] = useState<string | null>(null)
 31:   const [error, setError] = useState("")
 32:   const [threadParent, setThreadParent] = useState<SerializedNote | null>(null)
 33:   const [linkingNoteId, setLinkingNoteId] = useState<string | null>(null)
 34:   const noteGroups = useMemo(() => groupNotesByThread(notes), [notes])
 35: 
 36:   function handlePosted(note: SerializedNote) {
 37:     setError("")
 38:     setNotes((prev) => [
 39:       note,
 40:       ...prev.map((existing) => (
 41:         threadParent && existing._id === threadParent._id && !existing.thread && note.thread
 42:           ? { ...existing, thread: { rootId: existing._id, position: 1 } }
 43:           : existing
 44:       )),
 45:     ])
 46:     setThreadParent(null)
 47:   }
 48: 
 49:   function handleContinueThread(note: SerializedNote) {
 50:     setError("")
 51:     setThreadParent(note)
 52:   }
 53: 
 54:   async function handleLinkToThread(note: SerializedNote) {
 55:     if (!threadParent || linkingNoteId) return
 56:     setLinkingNoteId(note._id)
 57:     setError("")
 58: 
 59:     try {
 60:       const response = await fetch(`/api/admin/notes/${note._id}/thread`, {
 61:         method: "POST",
 62:         headers: { "Content-Type": "application/json" },
 63:         body: JSON.stringify({ sourceNoteId: threadParent._id }),
 64:       })
 65:       const data = await response.json().catch(() => null) as { error?: string; thread?: SerializedNote[] } | null
 66:       if (!response.ok || !Array.isArray(data?.thread)) {
 67:         throw new Error(data?.error ?? "Não foi possível linkar a nota à thread.")
 68:       }
 69:       setNotes((current) => mergeNotesById(current, data.thread!))
 70:       setThreadParent(null)
 71:     } catch (caughtError) {
 72:       setError(caughtError instanceof Error ? caughtError.message : "Não foi possível linkar a nota à thread.")
 73:     } finally {
 74:       setLinkingNoteId(null)
 75:     }
 76:   }
 77: 
 78:   async function handleDelete(id: string) {
 79:     if (deletingId) return
 80:     setDeletingId(id)
 81:     setError("")
 82: 
 83:     try {
 84:       const response = await fetch(`/api/admin/notes/${id}`, { method: "DELETE" })
 85:       if (!response.ok) {
 86:         const data = await response.json().catch(() => null)
 87:         throw new Error(data?.error ?? "Não foi possível deletar a nota.")
 88:       }
 89:       const data = await response.json().catch(() => null) as { thread?: SerializedNote[] } | null
 90:       setNotes((prev) => {
 91:         const removed = prev.find((note) => note._id === id)
 92:         const replacements = new Map((data?.thread ?? []).map((note) => [note._id, note]))
 93:         return prev
 94:           .filter((note) => note._id !== id)
 95:           .map((note) => removed?.thread?.rootId === note.thread?.rootId
 96:             ? replacements.get(note._id) ?? note
 97:             : note)
 98:       })
 99:       if (threadParent?._id === id) setThreadParent(null)
100:       router.refresh()
101:     } catch (caughtError) {
102:       const message = caughtError instanceof Error ? caughtError.message : "Não foi possível deletar a nota."
103:       setError(message)
104:       throw new Error(message)
105:     } finally {
106:       setDeletingId(null)
107:     }
108:   }
109: 
110:   function handleUpdate(updatedNote: SerializedNote) {
111:     setError("")
112:     setNotes((prev) => prev.map((note) => note._id === updatedNote._id ? updatedNote : note))
113:   }
114: 
115:   async function loadMore() {
116:     if (!cursor || loading) return
117:     setLoading(true)
118:     setError("")
119: 
120:     try {
121:       const response = await fetch(`/api/notes?cursor=${encodeURIComponent(cursor)}`)
122:       if (!response.ok) {
123:         const data = await response.json().catch(() => null)
124:         throw new Error(data?.error ?? "Não foi possível carregar mais notas.")
125:       }
126: 
127:       const data = await response.json() as { notes?: SerializedNote[]; nextCursor?: string | null }
128:       if (!Array.isArray(data.notes)) throw new Error("A resposta das notas é inválida.")
129: 
130:       const loadedNotes = data.notes
131:       setNotes((prev) => mergeNotesById(prev, loadedNotes))
132:       setCursor(data.nextCursor ?? null)
133:     } catch (caughtError) {
134:       setError(caughtError instanceof Error ? caughtError.message : "Não foi possível carregar mais notas.")
135:     } finally {
136:       setLoading(false)
137:     }
138:   }
139: 
140:   return (
141:     <div className="flex flex-col gap-4">
142:       {(isAdmin || showComposer) && (
143:         <div>
144:           <NoteComposer
145:             onPosted={handlePosted}
146:             threadParent={threadParent}
147:             onCancelThread={() => setThreadParent(null)}
148:           />
149:         </div>
150:       )}
151:       {!isAdmin && !showComposer && showAdminHint && (
152:         <div className="rounded-lg border border-neutral-200 px-3 py-2 text-sm text-neutral-700 dark:border-white/10 dark:text-[#c2bbb1]">
153:           Entre com a conta admin para escrever uma nota.
154:         </div>
155:       )}
156: 
157:       {error && (
158:         <p role="alert" className="text-sm text-red-700 dark:text-red-300">
159:           {error}
160:         </p>
161:       )}
162: 
163:       <div>
164:         {notes.length === 0 ? (
165:           <p className="text-sm text-neutral-600 dark:text-neutral-400">Nenhuma nota publicada ainda.</p>
166:         ) : (
167:           noteGroups.map((group) => (
168:             <NoteTimelineGroup key={group[0].thread?.rootId ?? group[0]._id} notes={group}>
169:               {(note, placement, threadSize) => (
170:                 <NoteCard
171:                   note={note}
172:                   showMetadata
173:                   viewContext="notes"
174:                   isAdmin={isAdmin}
175:                   onDelete={handleDelete}
176:                   onUpdate={handleUpdate}
177:                   onContinueThread={isAdmin ? handleContinueThread : undefined}
178:                   deleting={deletingId === note._id}
179:                   cropTallImages
180:                   timelineThreadPlacement={placement}
181:                   timelineThreadSize={threadSize}
182:                   showThreadLabel={group.length === 1}
183:                   threadLinkSource={threadParent}
184:                   onLinkToThread={handleLinkToThread}
185:                   onCancelThreadLink={() => setThreadParent(null)}
186:                   linkingToThread={linkingNoteId === note._id}
187:                 />
188:               )}
189:             </NoteTimelineGroup>
190:           ))
191:         )}
192:       </div>
193: 
194:       {cursor && (
195:         <button
196:           onClick={loadMore}
197:           disabled={loading}
198:           aria-live="polite"
199:           className="min-h-10 self-center rounded-md px-3 text-sm text-neutral-600 transition-colors hover:bg-neutral-950/5 hover:text-neutral-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-500 disabled:cursor-wait disabled:opacity-50 dark:text-neutral-400 dark:hover:bg-white/10 dark:hover:text-neutral-100 dark:focus-visible:ring-neutral-300"
200:         >
201:           {loading ? "Carregando..." : "Carregar mais"}
202:         </button>
203:       )}
204:     </div>
205:   )
206: }
</file>

<file path="src/app/admin/messages/AdminMessages.tsx">
  1: "use client"
  2: 
  3: import { useEffect, useState } from "react"
  4: import { ArrowDownTrayIcon } from "@heroicons/react/24/outline"
  5: import { DeleteActionMenu } from "@/components/actions/DeleteActionMenu"
  6: import { messageCategoryLabel } from "@/lib/message-categories"
  7: import { formatSiteDate, siteDateKey } from "@/lib/datetime"
  8: 
  9: type Entry = { _id: string; authorName: string; body: string; createdAt: string; readAt?: string; isOwn: boolean }
 10: type Thread = { _id: string; ownerName: string; subject: string; category: string; status: string; entries?: Entry[]; updatedAt: string; lastMessage?: { body: string } | null }
 11: 
 12: export function AdminMessages() {
 13:   const [threads, setThreads] = useState<Thread[] | null>(null)
 14:   const [selected, setSelected] = useState<string | null>(null)
 15:   const [reply, setReply] = useState("")
 16:   const [busy, setBusy] = useState(false)
 17:   const [exporting, setExporting] = useState(false)
 18:   const [actionError, setActionError] = useState("")
 19:   const [cursor, setCursor] = useState<string | null>(null)
 20:   const [hasMore, setHasMore] = useState(false)
 21:   const [archived, setArchived] = useState(false)
 22:   const thread = threads?.find((item) => item._id === selected)
 23: 
 24:   async function selectThread(id: string) {
 25:     setSelected(id)
 26:     setActionError("")
 27:     const response = await fetch(`/api/messages/${id}/read`, { method: "POST" })
 28:     if (!response.ok) return
 29:     const detail = await response.json()
 30:     setThreads((current) => current?.map((item) => item._id === id ? detail : item) ?? [])
 31:   }
 32: 
 33:   useEffect(() => {
 34:     fetch(`/api/admin/messages${archived ? "?archived=1" : ""}`, { cache: "no-store" })
 35:       .then((response) => response.json())
 36:       .then((data) => {
 37:         setThreads(data.items); setCursor(data.nextCursor); setHasMore(data.hasMore)
 38:         const fromHash = window.location.hash.slice(1)
 39:         const initial = data.items.some((item: Thread) => item._id === fromHash) ? fromHash : data.items[0]?._id ?? null
 40:         setSelected(initial)
 41:         if (initial) void selectThread(initial)
 42:       })
 43:   }, [archived])
 44: 
 45:   async function answer() {
 46:     if (!thread || !reply.trim()) return
 47:     setBusy(true)
 48:     const response = await fetch(`/api/messages/${thread._id}`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ body: reply }) })
 49:     const updated = await response.json(); setBusy(false)
 50:     if (response.ok) { setThreads((current) => current?.map((item) => item._id === updated._id ? updated : item) ?? []); setReply("") }
 51:   }
 52: 
 53:   async function patchThread(payload: object) {
 54:     if (!thread) return null
 55:     setBusy(true)
 56:     const response = await fetch(`/api/messages/${thread._id}`, { method: "PATCH", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) })
 57:     const updated = await response.json(); setBusy(false)
 58:     return response.ok ? updated : null
 59:   }
 60: 
 61:   async function changeStatus(status: "open" | "accepted" | "declined" | "closed") {
 62:     const updated = await patchThread({ status })
 63:     if (updated) setThreads((current) => current?.map((item) => item._id === updated._id ? updated : item) ?? [])
 64:   }
 65: 
 66:   async function archiveThread() {
 67:     const updated = await patchThread({ archived: !archived })
 68:     if (updated) { setThreads((current) => current?.filter((item) => item._id !== updated._id) ?? []); setSelected(null) }
 69:   }
 70: 
 71:   async function deleteThread() {
 72:     if (!thread) return
 73:     setBusy(true)
 74:     const response = await fetch(`/api/messages/${thread._id}`, { method: "DELETE" })
 75:     setBusy(false)
 76:     if (!response.ok) throw new Error("Não foi possível excluir o assunto.")
 77:     setThreads((current) => current?.filter((item) => item._id !== thread._id) ?? [])
 78:     setSelected(null)
 79:   }
 80: 
 81:   async function downloadThread() {
 82:     if (!thread) return
 83:     setExporting(true)
 84:     setActionError("")
 85:     try {
 86:       const response = await fetch("/api/admin/messages/download", {
 87:         method: "POST",
 88:         headers: { "Content-Type": "application/json" },
 89:         body: JSON.stringify({ ids: [thread._id] }),
 90:       })
 91:       if (!response.ok) {
 92:         const data = await response.json().catch(() => null) as { error?: string } | null
 93:         throw new Error(data?.error ?? "Não foi possível exportar a conversa.")
 94:       }
 95: 
 96:       const url = URL.createObjectURL(await response.blob())
 97:       const anchor = document.createElement("a")
 98:       anchor.href = url
 99:       anchor.download = `conversa-${siteDateKey()}.md`
100:       document.body.append(anchor)
101:       anchor.click()
102:       anchor.remove()
103:       URL.revokeObjectURL(url)
104:     } catch (error) {
105:       setActionError(error instanceof Error ? error.message : "Não foi possível exportar a conversa.")
106:     } finally {
107:       setExporting(false)
108:     }
109:   }
110: 
111:   async function loadMore() {
112:     if (!cursor) return
113:     const params = new URLSearchParams({ cursor, ...(archived ? { archived: "1" } : {}) })
114:     const response = await fetch(`/api/admin/messages?${params}`, { cache: "no-store" })
115:     if (!response.ok) return
116:     const data = await response.json()
117:     setThreads((current) => [...(current ?? []), ...data.items]); setCursor(data.nextCursor); setHasMore(data.hasMore)
118:   }
119: 
120:   if (!threads) return <p className="text-sm text-neutral-500">Carregando mensagens…</p>
121: 
122:   return <div className="grid min-h-[32rem] overflow-hidden rounded-xl border border-neutral-200 bg-white lg:grid-cols-[18rem_1fr] dark:border-neutral-800 dark:bg-neutral-950">
