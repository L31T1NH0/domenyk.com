<file path="src/components/timeline/PersonalTimeline.tsx">
  1: "use client"
  2: 
  3: import { useCallback, useEffect, useRef, useState } from "react"
  4: import dynamic from "next/dynamic"
  5: import { ArrowDownIcon, ArrowUpIcon } from "@heroicons/react/24/outline"
  6: import { DeleteActionMenu } from "@/components/actions/DeleteActionMenu"
  7: import type { PersonalTimelinePage, PersonalUpdate, PersonalUpdateOrderDirection } from "@/lib/personal-timeline"
  8: import { formatSiteDate } from "@/lib/datetime"
  9: 
 10: const Composer = dynamic(() => import("./PersonalUpdateComposer"), {
 11:   loading: () => <p role="status" className="text-sm text-neutral-600 dark:text-neutral-400">Carregando editor…</p>,
 12: })
 13: 
 14: async function fetchPage(signal: AbortSignal, cursor?: string): Promise<PersonalTimelinePage> {
 15:   const response = await fetch(`/api/mural${cursor ? `?cursor=${cursor}` : ""}`, { signal, cache: "no-store" })
 16:   if (!response.ok) throw new Error("Não foi possível carregar o mural.")
 17:   return response.json()
 18: }
 19: 
 20: export function PersonalTimeline({ isAdmin, compact = false }: { isAdmin: boolean; compact?: boolean }) {
 21:   const [items, setItems] = useState<PersonalUpdate[]>([])
 22:   const [cursor, setCursor] = useState<string | null>(null)
 23:   const [loading, setLoading] = useState(true)
 24:   const [error, setError] = useState("")
 25:   const [editing, setEditing] = useState<string | null>(null)
 26:   const [ordering, setOrdering] = useState<string | null>(null)
 27:   const [status, setStatus] = useState("")
 28:   const [actionError, setActionError] = useState("")
 29:   const requestRef = useRef<AbortController | null>(null)
 30:   const moreRef = useRef<HTMLDivElement | null>(null)
 31: 
 32:   const load = useCallback(async (nextCursor?: string) => {
 33:     requestRef.current?.abort()
 34:     const controller = new AbortController()
 35:     requestRef.current = controller
 36:     setLoading(true)
 37:     setError("")
 38:     try {
 39:       const data = await fetchPage(controller.signal, nextCursor)
 40:       if (controller.signal.aborted) return
 41:       setItems(previous => nextCursor
 42:         ? [...previous, ...data.items.filter(item => !previous.some(existing => existing._id === item._id))]
 43:         : data.items)
 44:       setCursor(data.nextCursor)
 45:     } catch {
 46:       if (!controller.signal.aborted) setError("Não foi possível carregar o mural.")
 47:     } finally {
 48:       if (!controller.signal.aborted) setLoading(false)
 49:     }
 50:   }, [])
 51: 
 52:   useEffect(() => {
 53:     const controller = new AbortController()
 54:     requestRef.current = controller
 55:     void fetchPage(controller.signal).then(data => {
 56:       if (controller.signal.aborted) return
 57:       setItems(data.items)
 58:       setCursor(data.nextCursor)
 59:     }).catch(() => {
 60:       if (!controller.signal.aborted) setError("Não foi possível carregar o mural.")
 61:     }).finally(() => {
 62:       if (!controller.signal.aborted) setLoading(false)
 63:     })
 64:     return () => requestRef.current?.abort()
 65:   }, [])
 66: 
 67:   useEffect(() => {
 68:     const target = moreRef.current
 69:     if (!compact || !cursor || loading || error || !target) return
 70:     const observer = new IntersectionObserver(entries => {
 71:       if (entries.some(entry => entry.isIntersecting)) void load(cursor)
 72:     }, { rootMargin: "120px" })
 73:     observer.observe(target)
 74:     return () => observer.disconnect()
 75:   }, [compact, cursor, loading, error, load])
 76: 
 77:   function saved(item: PersonalUpdate) {
 78:     setItems(previous => previous.some(existing => existing._id === item._id)
 79:       ? previous.map(existing => existing._id === item._id ? item : existing)
 80:       : [item, ...previous])
 81:     setEditing(null)
 82:     setActionError("")
 83:     setStatus("Publicação salva.")
 84:   }
 85: 
 86:   async function remove(id: string) {
 87:     setActionError("")
 88:     const response = await fetch(`/api/mural/${id}`, { method: "DELETE" })
 89:     if (!response.ok) throw new Error("Não foi possível excluir a publicação.")
 90:     setItems(previous => previous.filter(item => item._id !== id))
 91:     setStatus("Publicação excluída.")
 92:   }
 93: 
 94:   async function reorder(id: string, direction: PersonalUpdateOrderDirection) {
 95:     if (ordering) return
 96:     setOrdering(id)
 97:     setStatus("")
 98:     setActionError("")
 99:     try {
100:       const response = await fetch(`/api/mural/${id}/order`, {
101:         method: "PATCH",
102:         headers: { "Content-Type": "application/json" },
103:         body: JSON.stringify({ direction }),
104:       })
105:       const data = await response.json().catch(() => null)
106:       if (!response.ok) throw new Error(data?.error ?? "Não foi possível alterar a ordem.")
107:       const page = data as PersonalTimelinePage
108:       setItems(page.items)
109:       setCursor(page.nextCursor)
110:       setStatus("Ordem do mural atualizada.")
111:     } catch (caughtError) {
112:       setActionError(caughtError instanceof Error ? caughtError.message : "Não foi possível alterar a ordem.")
113:     } finally {
114:       setOrdering(null)
115:     }
116:   }
117: 
118:   return (
119:     <div className={`personal-timeline w-full min-w-0 ${compact ? "personal-timeline-compact" : ""}`}>
120:       {!compact && isAdmin && !loading && <div id="publicar" className="mb-6"><Composer onSaved={saved} /></div>}
121:       <p className="sr-only" role="status">{status}</p>
122:       {actionError && <p role="alert" className="personal-timeline-order-error">{actionError}</p>}
123:       {!compact && loading && items.length === 0 && <p role="status" className="personal-timeline-muted py-4">Carregando…</p>}
124:       {!compact && !loading && !error && items.length === 0 && <p className="personal-timeline-muted py-4">{isAdmin ? "Seu mural está pronto para a primeira publicação." : "Ainda não há publicações."}</p>}
125:       <div aria-busy={loading} className="personal-timeline-items w-full min-w-0">
126:         {items.map((item, index) => (
127:           <article key={item._id} id={`publicacao-${item._id}`} className="personal-timeline-item w-full min-w-0">
128:             {!compact && <div className="mb-3 flex flex-wrap items-center justify-between gap-1">
129:               <span className="personal-timeline-date">
130:                 <time dateTime={item.createdAt}>{formatSiteDate(item.createdAt, { day: "numeric", month: "short", year: "numeric" })}</time>
131:               </span>
132:               {!compact && isAdmin && <div className="flex items-center gap-1">
133:                 <div className="flex items-center" role="group" aria-label="Ordenar publicação" aria-busy={ordering === item._id}>
134:                   <button type="button" className="personal-timeline-order-control" disabled={Boolean(ordering) || Boolean(editing) || index === 0} aria-label="Mover publicação para cima" title="Mover para cima" onClick={() => void reorder(item._id, "up")}>
135:                     <ArrowUpIcon aria-hidden className="size-4" />
136:                   </button>
137:                   <button type="button" className="personal-timeline-order-control" disabled={Boolean(ordering) || Boolean(editing) || (index === items.length - 1 && !cursor)} aria-label="Mover publicação para baixo" title="Mover para baixo" onClick={() => void reorder(item._id, "down")}>
138:                     <ArrowDownIcon aria-hidden className="size-4" />
139:                   </button>
140:                 </div>
141:                 <button type="button" disabled={Boolean(ordering)} className="personal-timeline-action" onClick={() => setEditing(item._id)}>Editar</button>
142:                 <DeleteActionMenu disabled={Boolean(ordering) || Boolean(editing)} title="Excluir publicação do mural?" triggerAriaLabel="Excluir publicação do mural" onDelete={() => remove(item._id)} />
143:               </div>}
144:             </div>}
145:             {editing === item._id && !compact
146:               ? <Composer item={item} onSaved={saved} onCancel={() => setEditing(null)} />
147:               : <div className="personal-timeline-content w-full min-w-0" dangerouslySetInnerHTML={{ __html: item.contentHtml }} />}
148:           </article>
149:         ))}
150:       </div>
151:       {!compact && error && <div role="alert" className="py-3 text-sm"><p>{error}</p><button type="button" className="personal-timeline-action" onClick={() => void load(items.length ? cursor ?? undefined : undefined)}>Tentar novamente</button></div>}
152:       {!compact && cursor && !error && <button type="button" disabled={loading} className="personal-timeline-action mt-3" onClick={() => void load(cursor)}>{loading ? "Carregando…" : "Mais publicações"}</button>}
153:       {compact && cursor && <div ref={moreRef} aria-hidden="true" className="h-px" />}
154:     </div>
155:   )
156: }
</file>

