780: export function extractParagraphIds(content: string, options: MarkdownRenderOptions = {}): string[] {
781:   const paragraphIds: string[] = []
782:   createProcessor(options, (paragraphId) => paragraphIds.push(paragraphId), isHtmlContent(content)).processSync(content)
783:   return paragraphIds
