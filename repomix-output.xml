 96:   paragraph.dataset.pretextFlowRendered = "true"
 97:   paragraph.style.height = `${Math.max(0, lineCount * lineHeight).toFixed(2)}px`
 98:   for (let itemIndex = 0; itemIndex < sources.length; itemIndex += 1) {
 99:     const source = sources[itemIndex]
100:     if (!source) continue
101:     const replacement = document.createDocumentFragment()
102:     const appendSpace = (text: string) => {
103:       if (!text) return
104:       const space = document.createElement("span")
105:       space.className = "pretext-flow-preserved-space"
106:       space.textContent = text
107:       replacement.append(space)
108:     }
109:     if (!source.text.trim()) {
110:       appendSpace(source.text)
111:       source.node.replaceWith(replacement)
112:       continue
113:     }
114:     appendSpace(edgeWhitespace(source.text, "start"))
115:     for (const fragment of positioned[itemIndex] ?? []) {
116:       const span = document.createElement("span")
117:       span.className = "pretext-flow-fragment"
118:       span.dataset.pretextGapBefore = fragment.gapBefore.toFixed(2)
119:       span.dataset.pretextLine = String(fragment.lineIndex)
120:       span.style.setProperty("--pretext-fragment-left", `${fragment.left.toFixed(2)}px`)
121:       span.style.setProperty("--pretext-fragment-top", `${fragment.top.toFixed(2)}px`)
122:       span.textContent = fragment.text
123:       replacement.append(span)
124:     }
125:     appendSpace(edgeWhitespace(source.text, "end"))
126:     source.node.replaceWith(replacement)
127:   }
128: 
129:   const lines = new Map<number, HTMLElement[]>()
130:   for (const fragment of paragraph.querySelectorAll<HTMLElement>(".pretext-flow-fragment")) {
131:     const lineIndex = Number.parseInt(fragment.dataset.pretextLine ?? "", 10)
132:     if (!Number.isFinite(lineIndex)) continue
133:     const line = lines.get(lineIndex) ?? []
134:     line.push(fragment)
135:     lines.set(lineIndex, line)
136:   }
137:   for (const line of lines.values()) {
138:     line.sort((a, b) => parsePixelValue(a.style.getPropertyValue("--pretext-fragment-left")) - parsePixelValue(b.style.getPropertyValue("--pretext-fragment-left")))
139:     const corrected = stabilizePaintedLine(line.map(fragment => ({
140:       gapBefore: parsePixelValue(fragment.dataset.pretextGapBefore ?? "0"),
141:       left: parsePixelValue(fragment.style.getPropertyValue("--pretext-fragment-left")),
142:       width: fragment.getBoundingClientRect().width,
143:     })))
144:     line.forEach((fragment, index) => fragment.style.setProperty("--pretext-fragment-left", `${corrected[index]?.toFixed(2) ?? "0"}px`))
145:   }
146: }
