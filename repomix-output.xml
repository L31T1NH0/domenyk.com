 90: function safeFilename(filename: string): string {
 91:   const normalized = filename
 92:     .normalize("NFKD")
 93:     .replace(/[^\w.\-]+/g, "-")
 94:     .replace(/^-+|-+$/g, "")
 95:     .slice(0, 120)
 96: 
 97:   return normalized || "image"
 98: }
