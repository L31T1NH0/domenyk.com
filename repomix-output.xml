 53: export const getCachedTimelineUtilityRail = unstable_cache(
 54:   async (search = "", mode: PublicFeedMode = "all"): Promise<TimelineUtilityRailData> => {
 55:     const [archiveMonths, themes, writingProgress] = await Promise.all([
 56:       getTimelineArchiveMonths({ search: search || undefined, mode }),
 57:       getThemes({ activeOnly: true }),
 58:       getWritingProgress(),
 59:     ])
 60:     const archiveByYear = new Map<number, TimelineUtilityRailData["archives"][number]>()
 61: 
 62:     for (const archiveMonth of archiveMonths) {
 63:       const existing = archiveByYear.get(archiveMonth.year)
 64:       if (existing) {
 65:         existing.count += archiveMonth.count
 66:         existing.months.push({ month: archiveMonth.month, count: archiveMonth.count })
 67:       } else {
 68:         archiveByYear.set(archiveMonth.year, {
 69:           year: archiveMonth.year,
 70:           count: archiveMonth.count,
 71:           months: [{ month: archiveMonth.month, count: archiveMonth.count }],
 72:         })
 73:       }
 74:     }
 75: 
 76:     return {
 77:       writingProgress,
 78:       archives: [...archiveByYear.values()],
 79:       categories: themes
 80:         .filter((theme) => theme.postIds.length > 0)
 81:         .map((theme) => ({ name: theme.name, slug: theme.slug, count: theme.postIds.length })),
 82:     }
 83:   },
 84:   ["timeline-utility-rail-v3"],
 85:   { tags: [PUBLIC_CONTENT_CACHE_TAG], revalidate: PUBLIC_CONTENT_REVALIDATE_SECONDS }
 86: )
