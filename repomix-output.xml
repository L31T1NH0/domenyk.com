746: function withPublicationCss(renderedHtml: string, source: string, html: boolean): string {
747:   if (!html) return renderedHtml
748: 
749:   const css = extractPublicationCss(source)
750:   if (!css.trim()) return renderedHtml
751: 
752:   const id = createHash("sha256")
753:     .update(source)
754:     .digest("hex")
755:     .slice(0, 16)
756:   const surface = `[data-publication-surface="${id}"]`
757: 
758:   try {
759:     const stylesheet = compilePublicationCss(css, surface)
760:     return `<div data-publication-surface="${id}">${renderedHtml}</div><style data-publication-css="${id}">${stylesheet}</style>`
761:   } catch {
762:     // Keep an unfinished stylesheet in the editor draft without allowing it to
763:     // break public rendering. It becomes active as soon as it parses cleanly.
764:     return renderedHtml
765:   }
766: }
