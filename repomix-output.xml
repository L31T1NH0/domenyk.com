1099:   async function handleDelete(id: string) {
1100:     if (deletingNoteId) return
1101:     setDeletingNoteId(id)
1102:     setNoteError("")
1103: 
1104:     try {
1105:       const response = await fetch(`/api/admin/notes/${id}`, { method: "DELETE" })
1106:       if (!response.ok) {
1107:         const data = await response.json().catch(() => null)
1108:         throw new Error(data?.error ?? "Não foi possível deletar a nota.")
1109:       }
1110:       const data = await response.json().catch(() => null) as { thread?: SerializedNote[] } | null
1111:       setNotes((prev) => {
1112:         const removed = prev.find((note) => note._id === id)
1113:         const replacements = new Map((data?.thread ?? []).map((note) => [note._id, note]))
1114:         return prev
1115:           .filter((note) => note._id !== id)
1116:           .map((note) => removed?.thread?.rootId === note.thread?.rootId
1117:             ? replacements.get(note._id) ?? note
1118:             : note)
1119:       })
1120:       setDesktopTimelineNotes((current) => current
1121:         .filter((note) => note._id !== id)
1122:         .map((note) => data?.thread?.find((replacement) => replacement._id === note._id) ?? note))
1123:       setDesktopRailNotes((current) => current
1124:         .filter((note) => note._id !== id)
1125:         .map((note) => data?.thread?.find((replacement) => replacement._id === note._id) ?? note))
1126:       if (threadParent?._id === id) setThreadParent(null)
1127:       setNoteCount((prev) => Math.max(0, prev - 1))
1128:       router.refresh()
1129:     } catch (caughtError) {
1130:       const message = caughtError instanceof Error ? caughtError.message : "Não foi possível deletar a nota."
1131:       setNoteError(message)
1132:       throw new Error(message)
1133:     } finally {
1134:       setDeletingNoteId(null)
1135:     }
1136:   }
1137: 
