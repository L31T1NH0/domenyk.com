 48:   </>
 49: }
 50: export function PoliticalQuiz() {
 51:   const [answers,setAnswers]=useState<(Answer|null)[]>(Array(60).fill(null))
 52:   const [index,setIndex]=useState(0)
 53:   const [started,setStarted]=useState(false)
 54:   const [ready,setReady]=useState(false)
 55:   const [result,setResult]=useState<QuizResult|null>(null)
 56:   const [busy,setBusy]=useState(false)
 57:   const [error,setError]=useState("")
 58:   const [storageError,setStorageError]=useState(false)
 59:   const questionRef=useRef<HTMLFieldSetElement>(null)
 60:   useEffect(()=>{
 61:     startTransition(() => {
 62:     try {
 63:       const raw=localStorage.getItem(STORAGE_KEY)
 64:       if(raw){
 65:         const saved=JSON.parse(raw)
 66:         if(saved && saved.quiz_version===QUIZ_VERSION&&Array.isArray(saved.answers)&&saved.answers.length===60&&saved.answers.every((a:unknown)=>a===null||isAnswer(a))){
 67:           setAnswers(saved.answers)
 68:           setIndex(Math.max(0,saved.answers.findIndex((a:unknown)=>a===null)))
 69:           const snapshot = saved.result
 70:           if (snapshot && snapshot.quiz_version === QUIZ_VERSION && JSON.stringify(snapshot.answers) === JSON.stringify(saved.answers)
 71:             && typeof snapshot.description === "string" && typeof snapshot.quadrant === "string" && typeof snapshot.closest_profile === "string"
 72:             && typeof snapshot.created_at === "string" && !Number.isNaN(Date.parse(snapshot.created_at))
 73:             && [snapshot.x,snapshot.y,...Object.keys(DIMENSIONS).map(key=>snapshot.dimensions?.[key])].every(value=>value===null||(typeof value === "number"&&Number.isFinite(value)&&Math.abs(value)<=10))
 74:             && [snapshot.consistency,snapshot.symmetry].every(value=>value===null||(typeof value === "number"&&value>=0&&value<=100))
 75:             && [snapshot.coverage,snapshot.conditional,snapshot.diagnosticCoverage,snapshot.axisCoverage?.x,snapshot.axisCoverage?.y].every(value=>typeof value === "number"&&value>=0&&value<=100)
 76:             && Array.isArray(snapshot.nearby_profiles) && snapshot.nearby_profiles.every((value:unknown)=>typeof value === "string")
 77:             && Array.isArray(snapshot.comparisons) && snapshot.comparisons.every((pair: {label?:unknown;relationship?:unknown;gap?:unknown})=>pair&&typeof pair.label === "string"&&typeof pair.relationship === "string"&&(pair.gap===null||typeof pair.gap === "number"))) setResult(snapshot)
 78:         }
 79:       }
 80:     } catch {setStorageError(true)}
 81:     setReady(true)
 82:     })
 83:   },[])
 84:   useEffect(()=>{
 85:     if(!ready)return
 86:     try {localStorage.setItem(STORAGE_KEY,JSON.stringify({quiz_version:QUIZ_VERSION,answers,result}))} catch {startTransition(()=>setStorageError(true))}
 87:   },[answers,result,ready])
 88:   useEffect(()=>{if(started&&!result)questionRef.current?.focus()},[index,started,result])
 89:   const count=answers.filter(a=>a!==null).length
 90:   const question=QUESTIONS[index]
 91:   async function finish() {
 92:     const missing=answers.findIndex(a=>a===null)
 93:     if(missing!==-1){setIndex(missing);setError("Responda esta pergunta antes de calcular o resultado.");return}
 94:     setBusy(true);setError("")
 95:     try {
 96:       const response=await fetch("/api/quiz",{signal:AbortSignal.timeout(20000),method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({quiz_version:QUIZ_VERSION,answers})})
 97:       const payload=await response.json()
 98:       if(!response.ok)throw new Error(payload.error??"Não foi possível calcular o resultado.")
 99:       setResult(payload);window.scrollTo({top:0,behavior:"instant"})
100:     }catch(err){setError(err instanceof Error && err.name === "Error"?err.message:"Falha de conexão. Tente novamente; suas respostas estão preservadas.")}
101:     finally{setBusy(false)}
102:   }
103:   function reset(){setAnswers(Array(60).fill(null));setIndex(0);setResult(null);setStarted(false);setError("")}
104:   return <div className={styles.quiz}>
105:     {storageError&&<p role="status" className={styles.notice}>O navegador não permitiu salvar o progresso. Mantenha esta página aberta até concluir e baixe seu resultado.</p>}
106:     {result?<Result result={result} onReview={()=>{setResult(null);setStarted(true);setIndex(0)}} onReset={reset}/>:!started?<>
107:       <h1>Teste de posicionamento político</h1>
108:       <p className={styles.intro}>Entenda sua posição entre esquerda e direita econômica, liberdade e autoridade.</p>
109: 
110:       <p>60 perguntas, uma por vez. No final, veja seu mapa político e as dimensões que formam seu resultado. Sem precisar criar uma conta.</p>
111:       <p className={styles.muted}>Você pode voltar e revisar qualquer resposta. O progresso fica salvo neste navegador.</p>
112:       <p className={styles.muted}>Modelo experimental v0.1. O resultado é uma aproximação, não uma definição da sua identidade política.</p>
113:       <button className={styles.primary} disabled={!ready} onClick={()=>setStarted(true)}>{count?`Continuar teste · ${count}/60` : "Começar o teste"}</button>
114:       {count>0&&<button className={styles.textButton} onClick={reset}>Descartar progresso e começar de novo</button>}
115:       <details className={styles.details}><summary>Como responder e como calculamos</summary><p>Use sete níveis de discordância e concordância. “Neutro” representa uma posição intermediária; “Depende” registra uma condição ausente; “Não sei” indica falta de informação.</p><p>Perguntas posicionais recebem pesos nos eixos e dimensões. Cada média é normalizada pela soma dos pesos absolutos das respostas numéricas. Os oito diagnósticos não movem o ponto no mapa. Moralidade, coerção, propriedade e responsabilidade por dano são tratados separadamente.</p><p>O cálculo acontece no servidor. As respostas não são gravadas no banco; o progresso e o último resultado ficam neste navegador, com sua versão. Para guardar uma cópia durável, baixe o resultado ao concluir.</p></details>
116:     </>:<>
117:       <h1>Teste de posicionamento político</h1>
118:       <div className={styles.progressHeading}><span>Pergunta {index+1} de 60</span><span>{count} respondidas</span></div>
119:       <progress value={count} max={60} aria-label="Perguntas respondidas" />
120:       <fieldset ref={questionRef} tabIndex={-1} className={styles.question} disabled={busy}>
121:         <legend>{question.text}</legend>
122:         <div className={styles.options}>{OPTIONS.map(option=><label key={String(option.value)} className={answers[index]===option.value?styles.selected:undefined}><input type="radio" name={`question-${question.id}`} value={option.value} checked={answers[index]===option.value} onChange={()=>{setAnswers(previous=>previous.map((a,i)=>i===index?option.value:a));setError("")}}/><span>{option.label}</span></label>)}</div>
123:       </fieldset>
124:       <p className={styles.hint}>Neutro: posição intermediária. Depende: faltam condições. Não sei: faltam informações.</p>
125:       {error&&<p role="alert" className={styles.notice}>{error}</p>}
126:       <div className={styles.navigation}><button disabled={index===0||busy} onClick={()=>setIndex(index-1)}>Anterior</button>{index<59?<button className={styles.primary} disabled={answers[index]===null||busy} onClick={()=>setIndex(index+1)}>Próxima pergunta</button>:<button className={styles.primary} disabled={answers[index]===null||busy} onClick={finish}>{busy?"Calculando…":"Ver meu resultado"}</button>}</div>
127:       <details className={styles.details}><summary>Ir para uma pergunta</summary><div className={styles.questionLinks}>{QUESTIONS.map((q,i)=><button key={q.id} disabled={busy} aria-label={`Pergunta ${q.id}${answers[i]!==null?", respondida":""}`} aria-current={index===i?"step":undefined} className={answers[i]!==null?styles.answered:undefined} onClick={()=>setIndex(i)}>{q.id}</button>)}</div></details>
128:       <p className={styles.muted}>Progresso salvo neste navegador · {QUIZ_VERSION}</p>
129:     </>}
130:   </div>
131: }
</file>

