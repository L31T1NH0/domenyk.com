 58: export type NotificationInput = Omit<Notification, "_id" | "count" | "occurrences" | "createdAt" | "updatedAt">
 59: export type AggregateNotificationInput = Omit<Notification, "_id" | "count" | "occurrences" | "readAt" | "createdAt" | "updatedAt"> & { aggregateKey: string }
 60: 
 61: let indexesPromise: Promise<unknown> | undefined
 62: 
 63: async function collection() {
 64:   const col = (await getDb()).collection<Notification>("notifications")
 65:   indexesPromise ??= Promise.all([
 66:     col.createIndex({ recipientId: 1, updatedAt: -1 }),
 67:     col.createIndex({ recipientId: 1, readAt: 1 }),
 68:     col.createIndex({ recipientId: 1, aggregateKey: 1 }, { unique: true, sparse: true }),
 69:   ])
 70:   await indexesPromise
 71:   return col
 72: }
 73: 
 74: export async function createNotification(
 75:   data: NotificationInput,
 76:   occurrenceDetails: NotificationOccurrenceDetails = {}
 77: ) {
 78:   if (data.actorId && data.actorId === data.recipientId) return null
 79:   const now = new Date()
 80:   const result = await (await collection()).insertOne({
 81:     ...data,
 82:     count: 1,
 83:     occurrences: [{ occurredAt: now, ...occurrenceDetails }],
 84:     createdAt: now,
 85:     updatedAt: now,
 86:   } as Notification)
 87:   return result.insertedId
 88: }
 89: 
 90: export async function createNotificationOnce(
 91:   data: NotificationInput & { aggregateKey: string },
 92:   occurrenceDetails: NotificationOccurrenceDetails = {}
 93: ) {
 94:   if (data.actorId && data.actorId === data.recipientId) return null
 95:   const now = new Date()
 96:   let result
 97:   try {
 98:     result = await (await collection()).updateOne(
 99:       { recipientId: data.recipientId, aggregateKey: data.aggregateKey },
100:       {
101:         $setOnInsert: {
102:           ...data,
103:           count: 1,
104:           occurrences: [{ occurredAt: now, ...occurrenceDetails }],
105:           createdAt: now,
106:           updatedAt: now,
107:         },
108:       },
109:       { upsert: true }
110:     )
111:   } catch (error) {
112:     if (typeof error === "object" && error && "code" in error && error.code === 11000) return null
113:     throw error
114:   }
115:   if (!result.upsertedId) return null
116: 
117:   return result.upsertedId
118: }
119: 
120: export async function aggregateNotification(
121:   data: AggregateNotificationInput,
122:   occurrenceDetails: NotificationOccurrenceDetails = {}
123: ) {
124:   const now = new Date()
125:   const aggregateKey = dailyNotificationAggregateKey(data.aggregateKey, now)
126:   const occurrence: NotificationOccurrence = { occurredAt: now, ...occurrenceDetails }
127:   await (await collection()).updateOne(
128:     { recipientId: data.recipientId, aggregateKey },
129:     [
130:       {
131:         $set: {
132:           kind: data.kind,
133:           title: data.title,
134:           description: data.description,
135:           href: data.href,
136:           recipientId: data.recipientId,
137:           aggregateKey,
138:           createdAt: { $ifNull: ["$createdAt", now] },
139:           updatedAt: now,
140:           count: { $add: [{ $ifNull: ["$count", 0] }, 1] },
141:           occurrences: {
142:             $slice: [
143:               {
144:                 $concatArrays: [
145:                   {
146:                     $ifNull: [
147:                       "$occurrences",
148:                       { $cond: [{ $ne: [{ $type: "$createdAt" }, "missing"] }, ["$createdAt"], []] },
149:                     ],
150:                   },
151:                   [occurrence],
152:                 ],
153:               },
154:               -MAX_NOTIFICATION_OCCURRENCES,
155:             ],
156:           },
157:           readAt: "$$REMOVE",
158:         },
159:       },
160:     ],
161:     { upsert: true }
162:   )
163:   return aggregateKey
164: }
