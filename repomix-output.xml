 3: const notificationDayFormatter = new Intl.DateTimeFormat("en-US", {
 4:   day: "2-digit",
 5:   month: "2-digit",
 6:   year: "numeric",
 7:   timeZone: NOTIFICATION_TIME_ZONE,
 8: })
 9: 
10: export function notificationDay(date: Date) {
11:   const parts = Object.fromEntries(
12:     notificationDayFormatter
13:       .formatToParts(date)
14:       .filter((part) => part.type !== "literal")
15:       .map((part) => [part.type, part.value])
16:   )
17: 
18:   return `${parts.year}-${parts.month}-${parts.day}`
19: }
20: 
21: export function dailyNotificationAggregateKey(aggregateKey: string, date: Date) {
22:   return `${aggregateKey}:day:${notificationDay(date)}`
23: }
