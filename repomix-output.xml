154:         .filter((entry) => entry.type === "post")
155:         .map((entry) => serializePostSummary(entry.post)),
156:       notes: entries
157:         .filter((entry) => entry.type === "note")
158:         .map((entry) => serializeNote(entry.note)),
159:       threadNotes: threadPage.threads.flat().map(serializeNote),
160:       postCount,
161:       looseNoteCount,
162:       threadCount: threadPage.total,
