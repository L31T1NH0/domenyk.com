435: function isAllowedImageSource(source: string, prefixes: readonly AllowedImagePrefix[]): boolean {
436:   try {
437:     const url = new URL(source)
438:     if (
439:       (url.protocol !== "https:" && url.protocol !== "http:") ||
440:       url.username ||
441:       url.password
442:     ) {
443:       return false
444:     }
445: 
446:     return prefixes.some(
447:       (prefix) => url.origin === prefix.origin && pathMatchesPrefix(url.pathname, prefix.pathname)
448:     )
449:   } catch {
450:     // Relative URLs are intentionally rejected in restricted content. Besides
451:     // tracking pixels, an image request can otherwise trigger same-origin GETs.
452:     return false
453:   }
