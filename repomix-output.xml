184: function databaseValueToJson(value: unknown): unknown {
185:   if (value instanceof ObjectId) return value.toHexString()
186:   if (value instanceof Date) return value.toISOString()
187:   if (Array.isArray(value)) return value.map(databaseValueToJson)
188:   if (value && typeof value === "object") {
189:     return Object.fromEntries(Object.entries(value).map(([key, child]) => [key, databaseValueToJson(child)]))
190:   }
191:   return value
192: }
