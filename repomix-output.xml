<file path="src/app/sitemap/notes.xml/route.ts">
 1: import { getIndexableNotes } from "@/lib/db/notes"
 2: import { absoluteUrl, preferredContentImages } from "@/lib/seo"
 3: 
 4: export const runtime = "nodejs"
 5: 
 6: function escapeXml(value: string) {
 7:   return value.replace(/[<>&'\"]/g, (character) => ({
 8:     "<": "&lt;",
 9:     ">": "&gt;",
10:     "&": "&amp;",
11:     "'": "&apos;",
12:     '"': "&quot;",
13:   })[character] ?? character)
14: }
15: 
16: export async function GET() {
17:   const notes = await getIndexableNotes({ limit: 50_000 })
18:   const urls = notes.map((note) => {
19:     const images = preferredContentImages({ images: note.images, markdown: note.content })
20:       .map((image) => `<image:image><image:loc>${escapeXml(absoluteUrl(image))}</image:loc></image:image>`)
21:       .join("")
22:     const lastModified = (note.updatedAt ?? note.createdAt).toISOString()
23:     return `<url><loc>${escapeXml(absoluteUrl(`/notes/${note._id.toString()}`))}</loc><lastmod>${lastModified}</lastmod><changefreq>monthly</changefreq><priority>0.5</priority>${images}</url>`
24:   }).join("")
25: 
26:   const xml = `<?xml version="1.0" encoding="UTF-8"?>\n<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">${urls}</urlset>`
27:   return new Response(xml, {
28:     headers: {
29:       "Content-Type": "application/xml; charset=utf-8",
30:       "Cache-Control": "public, s-maxage=300, stale-while-revalidate=3600",
31:     },
32:   })
33: }
</file>

