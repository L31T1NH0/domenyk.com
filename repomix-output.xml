198: export async function createNote(data: { title?: string; seoTitle?: string; seoDescription?: string; content: string; images?: string[]; continueFromNoteId?: string }): Promise<Note> {
199:   const col = await collection()
200:   const now = new Date()
201:   let threadFields: Pick<Note, "threadRootId" | "previousNoteId" | "threadPosition"> = {}
202:   let initializedRoot: ObjectId | null = null
203: 
204:   if (data.continueFromNoteId) {
205:     const sourceId = toObjectId(data.continueFromNoteId)
206:     if (!sourceId) throw new NoteThreadError("Nota de origem inválida.")
207: 
208:     const source = await col.findOne({ _id: sourceId, deleting: { $ne: true } })
209:     if (!source) throw new NoteThreadError("A nota usada para continuar a thread não existe.")
210: 
211:     if (source.threadRootId) {
212:       const lastNote = await col.find({
213:         threadRootId: source.threadRootId,
214:         deleting: { $ne: true },
215:       }).sort({ threadPosition: -1, _id: -1 }).limit(1).next()
216:       if (!lastNote?.threadPosition) throw new NoteThreadError("A thread está inconsistente.")
217:       threadFields = {
218:         threadRootId: source.threadRootId,
219:         previousNoteId: lastNote._id,
220:         threadPosition: lastNote.threadPosition + 1,
221:       }
222:     } else {
223:       const initialized = await col.updateOne(
224:         { _id: source._id, deleting: { $ne: true }, threadRootId: { $exists: false } },
225:         { $set: { threadRootId: source._id, threadPosition: 1, updatedAt: now } }
226:       )
227:       if (initialized.matchedCount !== 1) {
228:         throw new NoteThreadError("A thread mudou enquanto a nota era criada. Tente novamente.")
229:       }
230:       initializedRoot = source._id
231:       threadFields = {
232:         threadRootId: source._id,
233:         previousNoteId: source._id,
234:         threadPosition: 2,
235:       }
236:     }
237:   }
238: 
239:   const note: Omit<Note, "_id"> = {
240:     ...(data.title ? { title: data.title } : {}),
241:     ...(data.seoTitle ? { seoTitle: data.seoTitle } : {}),
242:     ...(data.seoDescription ? { seoDescription: data.seoDescription } : {}),
243:     content: normalizeNoteContent(data.content), images: data.images, publishedAt: now, createdAt: now, updatedAt: now,
244:     ...threadFields,
245:   }
246:   try {
247:     const result = await col.insertOne(note as Note)
248:     return { ...note, _id: result.insertedId }
249:   } catch (error) {
250:     if (initializedRoot) {
251:       const members = await col.countDocuments({ threadRootId: initializedRoot })
252:       if (members === 1) {
253:         await col.updateOne(
254:           { _id: initializedRoot },
255:           { $unset: { threadRootId: "", threadPosition: "" } }
256:         )
257:       }
258:     }
259:     throw error
260:   }
261: }
