118:       gainNodeRef.current.gain.value = volume * (isBoosted ? BOOST_MULTIPLIER : 1)
119:     } else if (audioRef.current) {
120:       audioRef.current.volume = volume
121:     }
122:   }, [volume, isBoosted])
123: 
124:   useEffect(() => {
125:     return () => {
126:       sourceRef.current?.disconnect()
127:       gainNodeRef.current?.disconnect()
128:       void audioContextRef.current?.close().catch(() => undefined)
129:     }
130:   }, [])
