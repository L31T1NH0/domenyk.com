18: function alphaIntervalForBand(
19:   geometry: FlowImageAlphaGeometry,
20:   bandTop: number,
21:   bandBottom: number,
22:   imageTop: number,
23:   imageHeight: number,
24:   imageLeft: number,
25:   imageWidth: number,
26:   shapeMargin: number
27: ) {
28:   if (imageHeight <= 0 || geometry.rows.length === 0) return null
29:   const start = Math.max(0, Math.floor(((bandTop - shapeMargin - imageTop) / imageHeight) * geometry.rows.length))
30:   const end = Math.min(
31:     geometry.rows.length - 1,
32:     Math.ceil(((bandBottom + shapeMargin - imageTop) / imageHeight) * geometry.rows.length)
33:   )
34:   if (end < 0 || start >= geometry.rows.length || start > end) return null
35:   let left = Infinity
36:   let right = -Infinity
37:   for (let row = start; row <= end; row += 1) {
38:     const bounds = geometry.rows[row]
39:     if (!bounds) continue
40:     left = Math.min(left, imageLeft + bounds.left * imageWidth)
41:     right = Math.max(right, imageLeft + bounds.right * imageWidth)
42:   }
43:   if (!Number.isFinite(left) || !Number.isFinite(right)) return null
44:   return { left: left - shapeMargin, right: right + shapeMargin }
