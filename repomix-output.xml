<file path="src/lib/svg-sanitizer.ts">
  1: import "server-only"
  2: 
  3: import { SaxesParser } from "saxes"
  4: 
  5: const SVG_NAMESPACE = "http://www.w3.org/2000/svg"
  6: const MAX_ELEMENTS = 5_000
  7: const MAX_DEPTH = 64
  8: const MAX_ATTRIBUTES_PER_ELEMENT = 64
  9: const MAX_SANITIZED_SVG_BYTES = 1024 * 1024
 10: 
 11: const ALLOWED_ELEMENTS = new Set([
 12:   "svg",
 13:   "g",
 14:   "path",
 15:   "rect",
 16:   "circle",
 17:   "ellipse",
 18:   "line",
 19:   "polyline",
 20:   "polygon",
 21:   "defs",
 22:   "clipPath",
 23:   "mask",
 24:   "linearGradient",
 25:   "radialGradient",
 26:   "stop",
 27:   "title",
 28:   "desc",
 29: ])
 30: 
 31: const ALLOWED_ATTRIBUTES = new Set([
 32:   "xmlns",
 33:   "viewBox",
 34:   "width",
 35:   "height",
 36:   "preserveAspectRatio",
 37:   "id",
 38:   "class",
 39:   "transform",
 40:   "transform-origin",
 41:   "d",
 42:   "x",
 43:   "y",
 44:   "x1",
 45:   "x2",
 46:   "y1",
 47:   "y2",
 48:   "cx",
 49:   "cy",
 50:   "r",
 51:   "rx",
 52:   "ry",
 53:   "points",
 54:   "pathLength",
 55:   "fill",
 56:   "fill-opacity",
 57:   "fill-rule",
 58:   "stroke",
 59:   "stroke-width",
 60:   "stroke-opacity",
 61:   "stroke-linecap",
 62:   "stroke-linejoin",
 63:   "stroke-miterlimit",
 64:   "stroke-dasharray",
 65:   "stroke-dashoffset",
 66:   "opacity",
 67:   "clip-path",
 68:   "clip-rule",
 69:   "mask",
 70:   "gradientUnits",
 71:   "gradientTransform",
 72:   "offset",
 73:   "stop-color",
 74:   "stop-opacity",
 75:   "vector-effect",
 76:   "color",
 77:   "color-interpolation",
 78: ])
 79: 
 80: function escapeAttribute(value: string) {
 81:   return value
 82:     .replace(/&/g, "&amp;")
 83:     .replace(/"/g, "&quot;")
 84:     .replace(/</g, "&lt;")
 85:     .replace(/>/g, "&gt;")
 86: }
 87: 
 88: function escapeText(value: string) {
 89:   return value
 90:     .replace(/&/g, "&amp;")
 91:     .replace(/</g, "&lt;")
 92:     .replace(/>/g, "&gt;")
 93: }
 94: 
 95: function safeAttributeValue(name: string, value: string) {
 96:   if (/[^\t\n\r\x20-\uFFFF]/u.test(value)) return false
 97:   if (/javascript:|data:|https?:|\/\//i.test(value)) return false
 98:   if (/url\s*\(/i.test(value) && !/^url\(#[A-Za-z_][\w:.-]*\)$/i.test(value.trim())) return false
 99:   if (name === "xmlns" && value !== SVG_NAMESPACE) return false
100:   if (name === "id" && !/^[A-Za-z_][\w:.-]*$/.test(value)) return false
101:   return true
102: }
103: 
104: export function sanitizeSvg(data: Buffer): Buffer {
105:   if (data.length === 0 || data.length > MAX_SANITIZED_SVG_BYTES * 4) {
106:     throw new Error("Invalid SVG size")
107:   }
108: 
109:   const source = data.toString("utf8")
110:   if (source.includes("\uFFFD")) throw new Error("Invalid SVG encoding")
111: 
112:   const parser = new SaxesParser({ xmlns: false })
113:   const output: string[] = ['<?xml version="1.0" encoding="UTF-8"?>']
114:   const stack: string[] = []
115:   let failed: Error | null = null
116:   let elementCount = 0
117:   let sawRoot = false
118: 
119:   const reject = (message: string) => {
120:     if (!failed) failed = new Error(message)
121:   }
122: 
123:   parser.on("doctype", () => reject("SVG doctypes are not allowed"))
124:   parser.on("processinginstruction", () => reject("SVG processing instructions are not allowed"))
125:   parser.on("cdata", () => reject("SVG CDATA is not allowed"))
126:   parser.on("error", (error) => reject(error.message))
127:   parser.on("opentag", (tag) => {
128:     if (failed) return
129:     const name = tag.name
130:     elementCount += 1
131:     if (elementCount > MAX_ELEMENTS || stack.length >= MAX_DEPTH) {
132:       reject("SVG is too complex")
133:       return
134:     }
135:     if (!ALLOWED_ELEMENTS.has(name)) {
136:       reject(`SVG element ${name} is not allowed`)
137:       return
138:     }
139:     if (!sawRoot) {
140:       if (name !== "svg") {
141:         reject("SVG root element is required")
142:         return
143:       }
144:       sawRoot = true
145:     } else if (stack.length === 0 || name === "svg") {
146:       reject("Nested or multiple SVG roots are not allowed")
147:       return
148:     }
149: 
150:     const entries = Object.entries(tag.attributes)
151:     if (entries.length > MAX_ATTRIBUTES_PER_ELEMENT) {
152:       reject("SVG element has too many attributes")
153:       return
154:     }
155: 
156:     const attributes: string[] = []
157:     for (const [attributeName, value] of entries) {
158:       if (
159:         !ALLOWED_ATTRIBUTES.has(attributeName) ||
160:         /^on/i.test(attributeName) ||
161:         attributeName.includes(":") ||
162:         !safeAttributeValue(attributeName, value)
163:       ) {
164:         reject(`SVG attribute ${attributeName} is not allowed`)
165:         return
166:       }
167:       attributes.push(`${attributeName}="${escapeAttribute(value)}"`)
168:     }
169:     if (name === "svg" && !entries.some(([attributeName]) => attributeName === "xmlns")) {
170:       attributes.unshift(`xmlns="${SVG_NAMESPACE}"`)
171:     }
172: 
173:     output.push(`<${name}${attributes.length > 0 ? ` ${attributes.join(" ")}` : ""}>`)
174:     stack.push(name)
175:   })
176:   parser.on("text", (value) => {
177:     if (failed || value.length === 0) return
178:     const parent = stack.at(-1)
179:     if (parent === "title" || parent === "desc") output.push(escapeText(value))
180:     else if (value.trim().length > 0) reject("Text is only allowed in SVG title and description")
181:   })
182:   parser.on("closetag", (tag) => {
183:     if (failed) return
184:     const expected = stack.pop()
185:     if (expected !== tag.name) {
186:       reject("Malformed SVG nesting")
187:       return
188:     }
189:     output.push(`</${tag.name}>`)
190:   })
191: 
192:   parser.write(source).close()
193:   if (failed) throw failed
194:   if (!sawRoot || stack.length !== 0) throw new Error("Malformed SVG")
195: 
196:   const sanitized = Buffer.from(output.join(""), "utf8")
197:   if (sanitized.length > MAX_SANITIZED_SVG_BYTES) throw new Error("Sanitized SVG is too large")
198:   return sanitized
199: }
</file>

<file path="src/lib/view-referrer.ts">
 1: const INTERNAL_REFERRER_KEY = "domenyk:internal-referrer"
 2: const ENTRY_PAGE_KEY = "domenyk:entry-page"
 3: const KNOWN_VISITOR_KEY = "domenyk:known-visitor"
 4: const VISITOR_TYPE_KEY = "domenyk:visitor-type"
 5: const VISITOR_ID_KEY = "domenyk:visitor-id"
 6: 
 7: type StoredReferrer = {
 8:   from: string
 9:   to: string
10:   at: number
11: }
12: 
13: export function rememberInternalReferrer(from: string, to: string) {
14:   try {
15:     sessionStorage.setItem(INTERNAL_REFERRER_KEY, JSON.stringify({ from, to, at: Date.now() }))
16:   } catch {}
17: }
18: 
19: export function initializeVisitorContext() {
20:   try {
21:     if (!sessionStorage.getItem(ENTRY_PAGE_KEY)) {
22:       sessionStorage.setItem(ENTRY_PAGE_KEY, `${window.location.pathname}${window.location.search}`.slice(0, 500))
23:     }
24:     if (!sessionStorage.getItem(VISITOR_TYPE_KEY)) {
25:       const visitorType = localStorage.getItem(KNOWN_VISITOR_KEY) ? "Visitante recorrente" : "Novo visitante"
26:       sessionStorage.setItem(VISITOR_TYPE_KEY, visitorType)
27:       localStorage.setItem(KNOWN_VISITOR_KEY, new Date().toISOString())
28:     }
29:   } catch {}
30: }
31: 
32: function visitorId() {
33:   try {
34:     const stored = localStorage.getItem(VISITOR_ID_KEY)
35:     if (stored) return stored.slice(0, 64)
36: 
37:     const id = crypto.randomUUID()
38:     localStorage.setItem(VISITOR_ID_KEY, id)
39:     return id
40:   } catch {
41:     return ""
42:   }
43: }
44: 
45: function viewReferrer() {
46:   try {
47:     const stored = JSON.parse(sessionStorage.getItem(INTERNAL_REFERRER_KEY) ?? "null") as StoredReferrer | null
48:     if (stored && Date.now() - stored.at < 60_000) {
49:       const target = new URL(stored.to)
50:       if (target.pathname === window.location.pathname) {
51:         sessionStorage.removeItem(INTERNAL_REFERRER_KEY)
52:         return stored.from.slice(0, 2048)
53:       }
54:     }
55:   } catch {}
56:   return document.referrer.slice(0, 2048)
57: }
58: 
59: export function viewClientContext() {
60:   initializeVisitorContext()
61:   let visitorType = "Recorrência desconhecida"
62:   let landingPage = `${window.location.pathname}${window.location.search}`.slice(0, 500)
63: 
64:   try {
65:     landingPage = sessionStorage.getItem(ENTRY_PAGE_KEY) ?? landingPage
66:     visitorType = sessionStorage.getItem(VISITOR_TYPE_KEY) ?? visitorType
67:   } catch {}
68: 
69:   const entryUrl = new URL(landingPage, window.location.origin)
70:   return {
71:     visitorId: visitorId(),
72:     referrer: viewReferrer(),
73:     landingPage: entryUrl.pathname.slice(0, 500),
74:     language: navigator.language.slice(0, 35),
75:     visitorType,
76:     utmSource: entryUrl.searchParams.get("utm_source")?.slice(0, 100) ?? "",
77:     utmMedium: entryUrl.searchParams.get("utm_medium")?.slice(0, 100) ?? "",
78:     utmCampaign: entryUrl.searchParams.get("utm_campaign")?.slice(0, 150) ?? "",
79:   }
80: }
</file>

