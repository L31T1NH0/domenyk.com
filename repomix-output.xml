<file path="src/components/post/PostTopics.tsx">
  1: "use client"
  2: 
  3: import { useEffect, useRef, useState } from "react"
  4: const TOPIC_LINK_CLASS_NAME = "flex min-h-6 shrink-0 items-start py-0.5 pr-3 leading-5"
  5: 
  6: function topicIndent(level: number) {
  7:   return `${1.5 + Math.max(0, level - 2)}rem`
  8: }
  9: 
 10: function fitTopicWindow(heights: number[], active: number, budget: number, gap: number) {
 11:   let start = active
 12:   let end = active + 1
 13:   let used = heights[active] ?? 0
 14:   let before = 0
 15:   let after = 0
 16: 
 17:   while (start > 0 || end < heights.length) {
 18:     const previous = start > 0 ? heights[start - 1] + gap : Infinity
 19:     const next = end < heights.length ? heights[end] + gap : Infinity
 20:     const fitsBefore = used + previous <= budget
 21:     const fitsAfter = used + next <= budget
 22:     if (!fitsBefore && !fitsAfter) break
 23: 
 24:     if (fitsBefore && (!fitsAfter || before < after)) {
 25:       start -= 1
 26:       used += previous
 27:       before += previous
 28:     } else {
 29:       end += 1
 30:       used += next
 31:       after += next
 32:     }
 33:   }
 34: 
 35:   return { start, end }
 36: }
 37: 
 38: type HeadingEntry = {
 39:   id: string
 40:   text: string
 41:   level: number
 42:   element: HTMLElement
 43: }
 44: 
 45: function slugify(text: string) {
 46:   const normalized = text
 47:     .normalize("NFKD")
 48:     .replace(/[\u0300-\u036f]/g, "")
 49:     .toLowerCase()
 50: 
 51:   const slug = normalized
 52:     .replace(/[^a-z0-9\s-]/g, " ")
 53:     .trim()
 54:     .replace(/\s+/g, "-")
 55: 
 56:   return slug || "topico"
 57: }
 58: 
 59: function collectHeadings(containerSelector: string): HeadingEntry[] {
 60:   const container = document.querySelector<HTMLElement>(containerSelector)
 61:   if (!container) return []
 62: 
 63:   const usedIds = new Set(Array.from(document.querySelectorAll("[id]"), (element) => element.id))
 64:   const headings = Array.from(container.querySelectorAll<HTMLElement>("h1, h2, h3, h4, h5, h6"))
 65: 
 66:   const entries = headings
 67:     .map((element) => {
 68:       const text = element.textContent?.trim().replace(/^#+\s*/, "") ?? ""
 69:       if (!text) return null
 70: 
 71:       let id = element.id.trim()
 72:       if (!id) {
 73:         const base = slugify(text)
 74:         id = base
 75:         let suffix = 1
 76:         while (usedIds.has(id)) id = `${base}-${suffix++}`
 77:         usedIds.add(id)
 78:         element.id = id
 79:       }
 80: 
 81:       return {
 82:         id,
 83:         text,
 84:         level: Number(element.tagName.slice(1)),
 85:         element,
 86:       }
 87:     })
 88:     .filter((heading): heading is HeadingEntry => heading !== null)
 89: 
 90:   const comments = document.querySelector<HTMLElement>("[data-post-comments]")
 91:   if (entries.length > 0 && comments?.id) {
 92:     entries.push({ id: comments.id, text: "Comentários", level: 2, element: comments })
 93:   }
 94:   return entries
 95: }
 96: 
 97: type Props = {
 98:   containerSelector?: string
 99: }
100: 
101: export function PostTopics({ containerSelector = "[data-post-content]" }: Props) {
102:   const [headings, setHeadings] = useState<HeadingEntry[]>([])
103:   const [activeId, setActiveId] = useState<string | null>(null)
104:   const [prefersReducedMotion, setPrefersReducedMotion] = useState(false)
105:   const [paragraphCommentsOpen, setParagraphCommentsOpen] = useState(false)
106:   const [topicWindow, setTopicWindow] = useState({ start: 0, end: 1 })
107:   const panelRef = useRef<HTMLDivElement>(null)
108:   const titleRef = useRef<HTMLParagraphElement>(null)
109:   const measurementRef = useRef<HTMLDivElement>(null)
110:   const markerRef = useRef<HTMLParagraphElement>(null)
111:   const navRef = useRef<HTMLElement>(null)
112:   const listRef = useRef<HTMLDivElement>(null)
113:   const indicatorRef = useRef<HTMLSpanElement>(null)
114: 
115:   useEffect(() => {
116:     const container = document.querySelector<HTMLElement>(containerSelector)
117:     if (!container) return
118: 
119:     const update = () => {
120:       const next = collectHeadings(containerSelector)
121:       setHeadings((current) => current.length === next.length && current.every((entry, index) => (
122:         entry.id === next[index].id && entry.text === next[index].text &&
123:         entry.level === next[index].level && entry.element === next[index].element
124:       )) ? current : next)
125:     }
126:     const frame = window.requestAnimationFrame(update)
127:     const observer = new MutationObserver(update)
128:     observer.observe(container, { childList: true, subtree: true, characterData: true })
129: 
130:     return () => {
131:       window.cancelAnimationFrame(frame)
132:       observer.disconnect()
133:     }
134:   }, [containerSelector])
135: 
136:   useEffect(() => {
137:     const media = window.matchMedia("(prefers-reduced-motion: reduce)")
138:     const update = () => setPrefersReducedMotion(media.matches)
139: 
140:     const frame = window.requestAnimationFrame(update)
141:     media.addEventListener("change", update)
142:     return () => {
143:       window.cancelAnimationFrame(frame)
144:       media.removeEventListener("change", update)
145:     }
146:   }, [])
147: 
148:   useEffect(() => {
149:     const onChange = (event: Event) => {
150:       const detail = (event as CustomEvent<{ open?: boolean }>).detail
151:       const open = Boolean(detail?.open)
152:       setParagraphCommentsOpen(open)
153:     }
154: 
155:     window.addEventListener("paragraph-comments-open-change", onChange)
156:     return () => window.removeEventListener("paragraph-comments-open-change", onChange)
157:   }, [])
158: 
159:   useEffect(() => {
160:     if (headings.length === 0) {
161:       return
162:     }
163: 
164:     let frame: number | null = null
165: 
166:     const updateActiveHeading = () => {
167:       frame = null
168:       const focusLine = window.scrollY + window.innerHeight * 0.5
169:       let nextActiveId: string | null = null
170: 
171:       for (const heading of headings) {
172:         const top = heading.element.getBoundingClientRect().top + window.scrollY
173:         if (top <= focusLine) nextActiveId = heading.id
174:         else break
175:       }
176: 
177:       setActiveId((current) => (current === nextActiveId ? current : nextActiveId))
178:     }
179: 
180:     const requestUpdate = () => {
181:       if (frame !== null) return
182:       frame = window.requestAnimationFrame(updateActiveHeading)
183:     }
184: 
185:     requestUpdate()
186:     window.addEventListener("scroll", requestUpdate, { passive: true })
187:     window.addEventListener("resize", requestUpdate)
188:     window.addEventListener("hashchange", requestUpdate)
189:     const resizeObserver = new ResizeObserver(requestUpdate)
190:     const container = document.querySelector(containerSelector)
191:     if (container) resizeObserver.observe(container)
192: 
193:     return () => {
194:       if (frame !== null) window.cancelAnimationFrame(frame)
195:       window.removeEventListener("scroll", requestUpdate)
196:       window.removeEventListener("resize", requestUpdate)
197:       window.removeEventListener("hashchange", requestUpdate)
198:       resizeObserver.disconnect()
199:     }
200:   }, [headings, containerSelector])
201: 
202:   const activeIndex = headings.findIndex((heading) => heading.id === activeId)
203:   const displayedHeadings = headings.slice(topicWindow.start, topicWindow.end)
204:   const hasEarlierTopics = topicWindow.start > 0
205:   const hasLaterTopics = topicWindow.end < headings.length
206: 
207:   useEffect(() => {
208:     const panel = panelRef.current
209:     const title = titleRef.current
210:     const measurement = measurementRef.current
211:     const marker = markerRef.current
212:     if (!panel || !title || !measurement || !marker || headings.length === 0) return
213: 
214:     let frame = 0
215:     const update = () => {
216:       frame = 0
217:       if (panel.getBoundingClientRect().width === 0) return
218: 
219:       const heights = Array.from(measurement.children, (item) => item.getBoundingClientRect().height)
220:       const gap = parseFloat(getComputedStyle(measurement).rowGap) || 0
221:       const headerHeight = title.getBoundingClientRect().height + (parseFloat(getComputedStyle(panel).rowGap) || 0)
222:       const markersHeight = marker.getBoundingClientRect().height * 2 + gap * 2
223:       const anchor = Math.max(0, activeIndex)
224:       const panelTop = Math.max(24, panel.getBoundingClientRect().top)
225:       const availableHeight = Math.max(0, window.innerHeight - panelTop - 24)
226:       const panelHeight = paragraphCommentsOpen
227:         ? Math.min(availableHeight, Math.max(128, headerHeight + markersHeight + heights[anchor]))
228:         : availableHeight
229:       const contentHeight = Math.max(0, panelHeight - headerHeight)
230:       const totalHeight = heights.reduce((sum, height) => sum + height, 0) + gap * Math.max(0, heights.length - 1)
231:       const next = totalHeight <= contentHeight
232:         ? { start: 0, end: headings.length }
233:         : fitTopicWindow(heights, anchor, Math.max(0, contentHeight - markersHeight), gap)
234: 
235:       setTopicWindow((current) => current.start === next.start && current.end === next.end ? current : next)
236:     }
237:     const requestUpdate = () => {
238:       if (!frame) frame = window.requestAnimationFrame(update)
239:     }
240: 
241:     requestUpdate()
242:     const observer = new ResizeObserver(requestUpdate)
243:     observer.observe(measurement)
244:     observer.observe(title)
245:     window.addEventListener("resize", requestUpdate)
246:     window.visualViewport?.addEventListener("resize", requestUpdate)
247: 
248:     return () => {
249:       if (frame) window.cancelAnimationFrame(frame)
