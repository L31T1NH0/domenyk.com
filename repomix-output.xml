 41: ]
 42: 
 43: export function AdminMenu() {
 44:   const pathname = usePathname()
 45:   const clerk = useClerk()
 46:   const { isLoaded, isSignedIn, user } = useUser()
 47:   const { darkMode, toggleTheme } = useThemeSwitcher()
 48:   const [open, setOpen] = useState(false)
 49:   const menuId = useId()
 50:   const rootRef = useRef<HTMLDivElement>(null)
 51:   const triggerRef = useRef<HTMLButtonElement>(null)
 52: 
 53:   function closeMenu(restoreFocus = false) {
 54:     setOpen(false)
 55:     if (restoreFocus) requestAnimationFrame(() => triggerRef.current?.focus())
 56:   }
 57: 
 58:   function menuItems() {
 59:     return Array.from(rootRef.current?.querySelectorAll<HTMLElement>("[role='menuitem']") ?? [])
 60:   }
 61: 
 62:   useEffect(() => {
 63:     if (!open) return
 64:     const onPointerDown = (event: PointerEvent) => {
 65:       if (!rootRef.current?.contains(event.target as Node)) closeMenu()
 66:     }
 67:     const onKeyDown = (event: globalThis.KeyboardEvent) => {
 68:       if (event.key !== "Escape") return
 69:       event.preventDefault()
 70:       closeMenu(true)
 71:     }
 72:     document.addEventListener("pointerdown", onPointerDown)
 73:     document.addEventListener("keydown", onKeyDown)
 74:     return () => {
 75:       document.removeEventListener("pointerdown", onPointerDown)
 76:       document.removeEventListener("keydown", onKeyDown)
 77:     }
 78:   }, [open])
 79: 
 80:   function handleMenuKeyDown(event: KeyboardEvent<HTMLDivElement>) {
 81:     if (!["ArrowDown", "ArrowUp", "Home", "End"].includes(event.key)) return
 82:     const items = menuItems()
 83:     if (items.length === 0) return
 84:     event.preventDefault()
 85:     const currentIndex = items.indexOf(document.activeElement as HTMLElement)
 86:     const nextIndex = event.key === "Home"
