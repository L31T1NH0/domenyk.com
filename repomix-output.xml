173: export async function DELETE(_req: NextRequest, { params }: Params) {
174:   const unauthorized = await adminOnly()
175:   if (unauthorized) return unauthorized
176: 
177:   const { id } = await params
178:   if (!toObjectId(id)) return NextResponse.json({ error: "ID inválido" }, { status: 400 })
179: 
180:   const existingPost = await getPostById(id)
181:   if (!existingPost) return NextResponse.json({ error: "Post não encontrado" }, { status: 404 })
182:   const indexedPaths = getPublishedPostLocales(existingPost).map((locale) => localizedPostPath(existingPost, locale))
183: 
184:   const marked = await markPostDeleting(id)
185:   if (!marked) return NextResponse.json({ error: "Post não encontrado" }, { status: 404 })
186:   const comments = await getCommentsForParent(id)
187:   const contents = comments.map((comment) => comment.content)
188:   await queueCommentImagesForCleanup(contents)
189:   await deleteCommentsForParent(id)
190:   await removePostFromSeries(existingPost._id)
191:   await deletePost(id)
192:   await deleteCommentImagesFromContents(contents)
193:   invalidatePublicContentCache()
194:   if (indexedPaths.length > 0) after(() => notifyIndexNow(indexedPaths))
195:   return NextResponse.json({ ok: true })
196: }
