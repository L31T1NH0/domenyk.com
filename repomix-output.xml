 44:     updatedAt: device.updatedAt.toISOString(),
 45:     topics: adminPushTopicsFor(device),
 46:     ...(device.lastSuccessAt ? { lastSuccessAt: device.lastSuccessAt.toISOString() } : {}),
 47:   }))
 48:   const content: PushContentOption[] = [
 49:     ...posts.map((post) => ({
 50:       id: post._id.toString(),
 51:       type: "post" as const,
 52:       title: post.title,
 53:       description: post.excerpt?.trim() || `Leia “${post.title}” no domenyk.com.`,
 54:       href: `/posts/${post.slug}`,
 55:     })),
 56:     ...notes.map((note) => ({
 57:       id: note._id.toString(),
