  6: 
  7: type Props = {
  8:   boundaryId?: string
  9:   label?: string
 10:   href?: string
 11:   variant?: "default" | "editorial"
 12: }
 13: 
 14: export function BackHome({ boundaryId = "post-content-boundary", label = "Voltar", href = "/" }: Props) {
 15:   const linkRef = useRef<HTMLAnchorElement>(null)
 16:   const [position, setPosition] = useState<{ left: number; top: number } | null>(null)
 17: 
 18:   useEffect(() => {
 19:     let frame = 0
 20: 
 21:     function measure() {
 22:       frame = 0
 23:       const boundary = document.getElementById(boundaryId)
 24:       const link = linkRef.current
 25:       const content = link?.closest<HTMLElement>(".post-reading-page, .post-style-editorial")
 26:         ?? boundary?.parentElement
 27:       if (!content || !link) return
 28: 
 29:       const rem = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16
 30:       const buttonWidth = link.getBoundingClientRect().width
 31:       const left = content.getBoundingClientRect().left - buttonWidth - 2.5 * rem
 32:       if (!window.matchMedia("(min-width: 48rem)").matches || left < 0.5 * rem) {
 33:         setPosition(null)
 34:         return
 35:       }
 36: 
 37:       const viewportCenter = window.innerHeight / 2
 38:       const buttonHeight = link.getBoundingClientRect().height
 39:       const buttonTop = viewportCenter - buttonHeight / 2
 40:       const buttonBottom = viewportCenter + buttonHeight / 2
 41:       const boundaryTop = boundary?.getBoundingClientRect().top ?? Infinity
 42:       const gap = 12
 43:       const top = boundaryTop >= buttonTop - gap && boundaryTop <= buttonBottom
 44:         ? boundaryTop + gap + buttonHeight / 2
 45:         : viewportCenter
 46:       setPosition((current) => current?.left === left && current.top === top ? current : { left, top })
 47:     }
 48: 
 49:     function scheduleMeasure() {
 50:       if (frame) return
 51:       frame = window.requestAnimationFrame(measure)
 52:     }
 53: 
 54:     scheduleMeasure()
 55:     window.addEventListener("scroll", scheduleMeasure, { passive: true })
 56:     window.addEventListener("resize", scheduleMeasure)
 57:     const observer = new ResizeObserver(scheduleMeasure)
 58:     const link = linkRef.current
 59:     const content = link?.closest<HTMLElement>(".post-reading-page, .post-style-editorial")
 60:       ?? document.getElementById(boundaryId)?.parentElement
 61:     if (content) observer.observe(content)
 62:     if (link) observer.observe(link)
 63: 
 64:     return () => {
 65:       if (frame) window.cancelAnimationFrame(frame)
 66:       window.removeEventListener("scroll", scheduleMeasure)
 67:       window.removeEventListener("resize", scheduleMeasure)
 68:       observer.disconnect()
 69:     }
 70:   }, [boundaryId])
 71: 
 72:   return (
 73:     <>
 74:       <div className={position ? "hidden" : "mt-4 mx-0"}>
 75:         <Link
 76:           href={href}
 77:           className="inline-flex w-fit h-fit items-center gap-2 py-1 text-zinc-600 hover:text-zinc-900 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-400 dark:text-zinc-300 dark:hover:text-zinc-100 mx-0"
 78:           aria-label={label}
 79:           title={label}
 80:         >
 81:           <ChevronLeftIcon className="size-5" aria-hidden="true" />
 82:           <span className="text-sm">{label}</span>
 83:         </Link>
 84:       </div>
 85: 
 86:       <Link
 87:         ref={linkRef}
 88:         href={href}
 89:         className="fixed z-40 flex size-10 items-center justify-center rounded-full text-zinc-700 transition-[top] duration-150 hover:text-zinc-900 motion-reduce:transition-none dark:text-zinc-300 dark:hover:text-zinc-100"
 90:         style={{
 91:           top: position?.top ?? 0,
 92:           left: position?.left ?? 0,
 93:           transform: "translateY(-50%)",
 94:           visibility: position ? "visible" : "hidden",
 95:         }}
 96:         aria-hidden={!position}
 97:         tabIndex={position ? undefined : -1}
 98:         aria-label={label}
 99:         title={label}
100:       >
101:         <ChevronLeftIcon className="size-7" aria-hidden="true" />
102:       </Link>
