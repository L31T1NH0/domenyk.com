262:     ),
263:     col.updateOne(
264:       { endpoint, messageUserId: userId },
265:       { $set: { messageEvents: false, updatedAt: new Date() }, $unset: { messageUserId: "", messageVerifiedAt: "" } }
266:     ),
267:   ])
268: }
