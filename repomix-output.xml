117: export async function deleteNoteMetrics(noteId: string): Promise<void> {
118:   const objectId = toObjectId(noteId)
119:   if (!objectId) return
120:   // Deleting auxiliary data must not depend on index creation. In a fresh
121:   // serverless instance, collections() also reconciles indexes; an index
122:   // conflict there used to make the API return 500 after the note itself had
123:   // already been deleted.
124:   const db = await getDb()
