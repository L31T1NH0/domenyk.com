251:     return {
252:       ...feed,
253:       desktopPosts: desktop.posts,
254:       desktopNotes: desktop.notes,
255:       desktopThreadNotes: desktop.threadNotes,
256:       desktopPostCount: desktop.postCount,
257:       desktopLooseNoteCount: desktop.looseNoteCount,
258:       desktopThreadCount: desktop.threadCount,
259:     }
260:   }
261: 
262:   return getCachedHomeSearchTimelinePage(page, mode, limit, normalizedSearch)
263: }
