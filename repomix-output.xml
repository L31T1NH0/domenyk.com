<file path="src/app/api/push/subscriptions/route.ts">
  1: import { NextRequest, NextResponse } from "next/server"
  2: import { getAuthUserId, isAdmin } from "@/lib/auth"
  3: import {
  4:   deletePushSubscription,
  5:   getPushSubscription,
  6:   PUSH_TOPICS,
  7:   adminPushTopicsFor,
  8:   pushCapabilityMatches,
  9:   revokePrivatePushSubscription,
 10:   upsertPushSubscription,
 11:   verifyAdminPushSubscription,
 12:   verifyMessagePushSubscription,
 13:   type PushTopic,
 14: } from "@/lib/db/push-subscriptions"
 15: import { normalizeAdminPushTopics } from "@/lib/notification-events"
 16: import { rateLimit } from "@/lib/rate-limit"
 17: import { requestIdentity } from "@/lib/request-identity"
 18: import { isSameOriginRequest } from "@/lib/csrf"
 19: import { sendPushSubscriptionChallenge } from "@/lib/push"
 20: 
 21: const ALLOWED_PUSH_HOSTS = [
 22:   "fcm.googleapis.com",
 23:   "push.services.mozilla.com",
 24:   "updates.push.services.mozilla.com",
 25:   "notify.windows.com",
 26:   "web.push.apple.com",
 27:   "push.apple.com",
 28: ]
 29: 
 30: function validEndpoint(value: unknown): value is string {
 31:   if (typeof value !== "string" || value.length > 2048) return false
 32:   try {
 33:     const url = new URL(value)
 34:     return url.protocol === "https:" && ALLOWED_PUSH_HOSTS.some((host) => (
 35:       url.hostname === host || url.hostname.endsWith(`.${host}`)
 36:     ))
 37:   } catch {
 38:     return false
 39:   }
 40: }
 41: 
 42: function validKey(value: unknown, bytes: number, firstByte?: number): value is string {
 43:   if (typeof value !== "string" || !/^[A-Za-z0-9_-]+$/.test(value)) return false
 44:   const decoded = Buffer.from(value, "base64url")
 45:   return decoded.length === bytes && (firstByte === undefined || decoded[0] === firstByte)
 46: }
 47: 
 48: function topicsFrom(value: unknown): PushTopic[] {
 49:   if (!Array.isArray(value)) return []
 50:   return Array.from(new Set(value.filter((topic): topic is PushTopic => (
 51:     typeof topic === "string" && PUSH_TOPICS.includes(topic as PushTopic)
 52:   ))))
 53: }
 54: 
 55: function authFromBody(body: { keys?: { auth?: unknown } } | null): string | null {
 56:   return validKey(body?.keys?.auth, 16) ? body.keys.auth : null
 57: }
 58: 
 59: export async function PUT(req: NextRequest) {
 60:   if (!isSameOriginRequest(req)) return NextResponse.json({ error: "Origem não permitida." }, { status: 403 })
 61:   if (!(await rateLimit(`push-status:${requestIdentity(req)}`, { limit: 60, windowMs: 60 * 60_000 }))) {
 62:     return NextResponse.json({ error: "Muitas tentativas. Tente novamente mais tarde." }, { status: 429 })
 63:   }
 64:   const body = await req.json().catch(() => null) as { endpoint?: unknown; keys?: { auth?: unknown } } | null
 65:   const auth = authFromBody(body)
 66:   if (!validEndpoint(body?.endpoint) || !auth) return NextResponse.json({ error: "Inscrição inválida." }, { status: 400 })
 67:   const subscription = await getPushSubscription(body.endpoint)
 68:   if (!subscription || !pushCapabilityMatches(subscription, auth)) {
 69:     return NextResponse.json({ error: "Inscrição não encontrada." }, { status: 404 })
 70:   }
 71:   const admin = await isAdmin()
 72:   const userId = await getAuthUserId()
 73:   if (admin && subscription.adminEvents && userId && subscription.adminUserId === userId) {
 74:     await verifyAdminPushSubscription(body.endpoint, userId)
 75:   }
 76:   if (subscription?.messageEvents && userId && subscription.messageUserId === userId) {
 77:     await verifyMessagePushSubscription(body.endpoint, userId)
 78:   }
 79:   return NextResponse.json({
 80:     subscribed: subscription.status === "active",
 81:     pending: subscription.status === "pending",
 82:     topics: subscription.status === "active" ? subscription.topics : [],
 83:     adminEvents: subscription.status === "active" && admin ? subscription.adminEvents === true : false,
 84:     adminTopics: subscription.status === "active" && admin ? adminPushTopicsFor(subscription) : [],
 85:     messageEvents: Boolean(subscription.status === "active" && userId && subscription.messageEvents && subscription.messageUserId === userId),
 86:   })
 87: }
 88: 
 89: export async function POST(req: NextRequest) {
 90:   if (!isSameOriginRequest(req)) return NextResponse.json({ error: "Origem não permitida." }, { status: 403 })
 91:   if (!(await rateLimit(`push-subscribe:${requestIdentity(req)}`, { limit: 20, windowMs: 60 * 60_000 }))) {
 92:     return NextResponse.json({ error: "Muitas tentativas. Tente novamente mais tarde." }, { status: 429 })
 93:   }
 94: 
 95:   const body = await req.json().catch(() => null) as {
 96:     endpoint?: unknown
 97:     expirationTime?: unknown
 98:     keys?: { p256dh?: unknown; auth?: unknown }
 99:     topics?: unknown
100:     adminEvents?: unknown
101:     adminTopics?: unknown
102:     messageEvents?: unknown
103:   } | null
104:   if (
105:     !validEndpoint(body?.endpoint) ||
106:     !validKey(body?.keys?.p256dh, 65, 0x04) ||
107:     !validKey(body?.keys?.auth, 16)
108:   ) {
109:     return NextResponse.json({ error: "Inscrição inválida." }, { status: 400 })
110:   }
111: 
112:   const userId = await getAuthUserId()
113:   const admin = userId ? await isAdmin() : false
114:   const existing = await getPushSubscription(body.endpoint)
115:   if (existing && !pushCapabilityMatches(existing, body.keys.auth)) {
116:     return NextResponse.json({ error: "A inscrição não pertence a este dispositivo." }, { status: 403 })
117:   }
118:   if (!existing) {
119:     const identity = requestIdentity(req)
120:     const [withinIpLimit, withinGlobalLimit] = await Promise.all([
121:       rateLimit(`push-subscribe-new:${identity}`, { limit: 5, windowMs: 24 * 60 * 60_000 }),
122:       rateLimit("push-subscribe-new:global", { limit: 200, windowMs: 24 * 60 * 60_000 }),
123:     ])
124:     if (!withinIpLimit || !withinGlobalLimit) {
125:       return NextResponse.json({ error: "Limite de novos dispositivos atingido." }, { status: 429 })
126:     }
127:   }
128: 
129:   const saved = await upsertPushSubscription({
130:     endpoint: body.endpoint,
131:     expirationTime: typeof body.expirationTime === "number" ? body.expirationTime : null,
132:     keys: { p256dh: body.keys.p256dh, auth: body.keys.auth },
133:     topics: topicsFrom(body.topics),
134:     userAgent: req.headers.get("user-agent")?.slice(0, 300),
135:     ...(admin && userId ? {
136:       admin: {
137:         topics: normalizeAdminPushTopics(body.adminTopics, body.adminEvents === true),
138:         userId,
139:       },
140:     } : {}),
141:     ...(userId ? { messages: { enabled: body.messageEvents === true, userId } } : {}),
142:   })
143: 
144:   if (saved.challengeToken) {
145:     const delivered = await sendPushSubscriptionChallenge(saved.subscription, saved.challengeToken)
146:     if (!delivered) {
147:       await deletePushSubscription(body.endpoint)
148:       return NextResponse.json({ error: "Não foi possível confirmar este dispositivo." }, { status: 502 })
149:     }
150:     return NextResponse.json({ ok: true, pending: true }, { status: 202 })
151:   }
152: 
153:   return NextResponse.json({ ok: true, pending: false })
154: }
155: 
156: export async function PATCH(req: NextRequest) {
157:   if (!isSameOriginRequest(req)) return NextResponse.json({ error: "Origem não permitida." }, { status: 403 })
158:   if (!(await rateLimit(`push-private-revoke:${requestIdentity(req)}`, { limit: 10, windowMs: 60 * 60_000 }))) {
159:     return NextResponse.json({ error: "Muitas tentativas. Tente novamente mais tarde." }, { status: 429 })
160:   }
161:   const userId = await getAuthUserId()
162:   if (!userId) return NextResponse.json({ error: "Unauthorized" }, { status: 401 })
163:   const body = await req.json().catch(() => null) as { endpoint?: unknown; keys?: { auth?: unknown } } | null
164:   const auth = authFromBody(body)
165:   if (!validEndpoint(body?.endpoint) || !auth) return NextResponse.json({ error: "Inscrição inválida." }, { status: 400 })
166:   const subscription = await getPushSubscription(body.endpoint)
167:   if (!subscription || !pushCapabilityMatches(subscription, auth)) {
168:     return NextResponse.json({ error: "Inscrição não encontrada." }, { status: 404 })
169:   }
170:   await revokePrivatePushSubscription(body.endpoint, userId)
171:   return NextResponse.json({ ok: true })
172: }
173: 
174: export async function DELETE(req: NextRequest) {
175:   if (!isSameOriginRequest(req)) return NextResponse.json({ error: "Origem não permitida." }, { status: 403 })
176:   if (!(await rateLimit(`push-delete:${requestIdentity(req)}`, { limit: 20, windowMs: 60 * 60_000 }))) {
177:     return NextResponse.json({ error: "Muitas tentativas. Tente novamente mais tarde." }, { status: 429 })
178:   }
179:   const body = await req.json().catch(() => null) as { endpoint?: unknown; keys?: { auth?: unknown } } | null
180:   const auth = authFromBody(body)
181:   if (!validEndpoint(body?.endpoint) || !auth) return NextResponse.json({ error: "Inscrição inválida." }, { status: 400 })
182:   const subscription = await getPushSubscription(body.endpoint)
183:   if (!subscription || !pushCapabilityMatches(subscription, auth)) {
184:     return NextResponse.json({ error: "Inscrição não encontrada." }, { status: 404 })
185:   }
186:   await deletePushSubscription(body.endpoint)
187:   return NextResponse.json({ ok: true })
188: }
