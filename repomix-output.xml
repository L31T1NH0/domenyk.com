 65: export async function listMessageThreadsPage(opts: { ownerId?: string; archived?: boolean; cursor?: string; limit?: number } = {}) {
 66:   const decoded = decodeCursor(opts.cursor)
 67:   const filter: Record<string, unknown> = {
 68:     ...(opts.ownerId ? { ownerId: opts.ownerId } : {}),
 69:     ...(opts.archived ? { archivedAt: { $exists: true } } : { archivedAt: { $exists: false } }),
 70:   }
 71:   if (decoded) filter.$or = [{ updatedAt: { $lt: decoded.updatedAt } }, { updatedAt: decoded.updatedAt, _id: { $lt: decoded._id } }]
 72:   const limit = Math.max(1, Math.min(opts.limit ?? MESSAGE_PAGE_SIZE, 50))
 73:   const threads = await (await collection())
 74:     .find(filter, { projection: { entries: { $slice: -1 } } })
 75:     .sort({ updatedAt: -1, _id: -1 }).limit(limit + 1).toArray()
 76:   const hasMore = threads.length > limit
 77:   if (hasMore) threads.pop()
 78:   const last = threads.at(-1)
 79:   return { threads, hasMore, nextCursor: hasMore && last ? `${last.updatedAt.toISOString()}_${last._id}` : null }
 80: }
