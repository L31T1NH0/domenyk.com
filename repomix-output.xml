 265: const feedModeOrder: FeedMode[] = ["all", "posts", "notes"]
 266: const SWIPE_THRESHOLD = 46
 267: const SWIPE_MAX_OFFSET = 72
 268: 
 269: function useTimelineFeed({
 270:   notes,
 271:   posts,
 272:   postCount,
 273:   noteCount,
 274:   mode,
 275: }: {
 276:   notes: SerializedNote[]
 277:   posts: SerializedPostSummary[]
 278:   postCount: number
 279:   noteCount: number
 280:   mode: FeedMode
 281: }) {
 282:   const timelineCount = postCount + noteCount
 283: 
 284:   const allItems = useMemo<TimelineItem[]>(() => {
 285:     return [
 286:       ...notes.map((note) => ({ type: "note" as const, id: `note:${note._id}`, date: note.publishedAt, note })),
 287:       ...posts.map((post) => ({ type: "post" as const, id: `post:${post.publicId}`, date: postDate(post), post })),
 288:     ].sort((a, b) => {
 289:       const aPinned = a.type === "post" && a.post.pinned
 290:       const bPinned = b.type === "post" && b.post.pinned
 291: 
 292:       if (aPinned !== bPinned) return aPinned ? -1 : 1
 293:       return new Date(b.date).getTime() - new Date(a.date).getTime()
 294:     })
 295:   }, [notes, posts])
 296: 
 297:   const visibleItems = useMemo<TimelineDisplayItem[]>(() => {
 298:     const filteredItems = mode === "posts"
 299:       ? allItems.filter((item) => item.type === "post")
 300:       : mode === "notes"
 301:         ? allItems.filter((item) => item.type === "note")
 302:         : allItems
 303:     const noteGroups = groupNotesByThread(
 304:       filteredItems
 305:         .filter((item): item is Extract<TimelineItem, { type: "note" }> => item.type === "note")
 306:         .map((item) => item.note)
 307:     )
 308:     const groupByNoteId = new Map<string, SerializedNote[]>()
 309:     for (const group of noteGroups) {
 310:       for (const note of group) groupByNoteId.set(note._id, group)
 311:     }
 312:     const emittedGroups = new Set<string>()
 313: 
 314:     return filteredItems.flatMap((item): TimelineDisplayItem[] => {
 315:       if (item.type === "post") return [item]
 316:       const group = groupByNoteId.get(item.note._id) ?? [item.note]
 317:       const groupId = group[0].thread?.rootId ?? group[0]._id
 318:       if (emittedGroups.has(groupId)) return []
 319:       emittedGroups.add(groupId)
 320:       return [{ type: "note-group", id: `note-group:${groupId}`, date: item.date, notes: group }]
 321:     })
 322:   }, [allItems, mode])
 323: 
 324:   return { timelineCount, visibleItems }
 325: }
