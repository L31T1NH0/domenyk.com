 16: export function MediaLibrary({ initialMedia }: Props) {
 17:   const [media, setMedia] = useState(initialMedia)
 18:   const [uploading, setUploading] = useState(false)
 19:   const [deletingUrl, setDeletingUrl] = useState<string | null>(null)
 20:   const [copied, setCopied] = useState<string | null>(null)
 21:   const [error, setError] = useState("")
 22:   const fileRef = useRef<HTMLInputElement>(null)
 23: 
 24:   async function upload(file: File) {
 25:     setUploading(true)
 26:     setError("")
 27:     try {
 28:       const form = new FormData()
 29:       form.append("file", file)
 30:       const res = await fetch("/api/admin/media", { method: "POST", body: form })
 31:       const data = await res.json().catch(() => ({}))
 32:       if (!res.ok || !data.url) throw new Error(data.error ?? "Erro ao enviar imagem.")
 33:       setMedia((prev) => [
 34:         {
 35:           url: data.url,
 36:           pathname: file.name,
 37:           size: file.size,
 38:           uploadedAt: new Date().toISOString(),
 39:           contentType: data.contentType ?? file.type,
 40:         },
 41:         ...prev,
 42:       ])
 43:       if (fileRef.current) fileRef.current.value = ""
 44:     } catch (err) {
 45:       setError(err instanceof Error ? err.message : "Erro ao enviar imagem.")
 46:     } finally {
 47:       setUploading(false)
 48:     }
 49:   }
 50: 
 51:   async function copyUrl(url: string) {
 52:     await navigator.clipboard.writeText(url)
 53:     setCopied(url)
 54:     setTimeout(() => setCopied(null), 2000)
 55:   }
 56: 
 57:   async function remove(item: SerializedMediaItem) {
 58:     setDeletingUrl(item.url)
 59:     setError("")
 60:     try {
 61:       const res = await fetch("/api/admin/media", {
 62:         method: "DELETE",
 63:         headers: { "Content-Type": "application/json" },
 64:         body: JSON.stringify({ url: item.url }),
 65:       })
 66:       const data = await res.json().catch(() => ({}))
 67:       if (!res.ok) throw new Error(data.error ?? "Erro ao deletar imagem.")
 68:       setMedia((prev) => prev.filter((asset) => asset.url !== item.url))
 69:     } catch (err) {
 70:       const message = err instanceof Error ? err.message : "Erro ao deletar imagem."
 71:       setError(message)
 72:       throw new Error(message)
 73:     } finally {
 74:       setDeletingUrl(null)
 75:     }
 76:   }
 77: 
 78:   return (
 79:     <div className="admin-media-library">
 80:       <div
 81:         className="admin-media-dropzone"
 82:         onDragOver={(e) => e.preventDefault()}
 83:         onDrop={(e) => {
 84:           e.preventDefault()
 85:           const file = e.dataTransfer.files[0]
 86:           if (file) upload(file)
 87:         }}
 88:       >
 89:         <input
 90:           ref={fileRef}
 91:           type="file"
 92:           accept="image/png,image/jpeg,image/webp,image/svg+xml,.svg"
 93:           className="hidden"
 94:           onChange={(e) => { if (e.target.files?.[0]) upload(e.target.files[0]) }}
 95:         />
 96:         {uploading ? (
 97:           <div className="admin-media-upload-state" role="status">
 98:             <span className="admin-media-upload-icon"><ArrowUpTrayIcon aria-hidden /></span>
 99:             <span><strong>Enviando imagem</strong><small>O arquivo aparecerá na biblioteca assim que terminar.</small></span>
100:           </div>
101:         ) : (
102:           <div className="admin-media-upload-state">
103:             <span className="admin-media-upload-icon"><ArrowUpTrayIcon aria-hidden /></span>
104:             <span><strong>Envie uma imagem</strong><small>Arraste um arquivo para esta área ou escolha no dispositivo. SVG, PNG, JPG e WebP.</small></span>
105:             <button type="button" className="admin-button-secondary" onClick={() => fileRef.current?.click()}>Escolher arquivo</button>
106:           </div>
107:         )}
108:       </div>
109:       {error && <p className="admin-form-error" role="alert">{error}</p>}
110: 
111:       <section className="admin-media-section">
112:         <header><div><h2>Biblioteca</h2><p>{media.length} {media.length === 1 ? "arquivo disponível" : "arquivos disponíveis"}</p></div></header>
113:         <div className="admin-media-grid">
114:         {media.map((item) => (
115:           <figure
116:             key={item.url}
117:             className="admin-media-item"
118:             title={item.pathname}
119:           >
120:             <div className="admin-media-preview"><img src={item.url} alt="" /></div>
121:             <figcaption>
122:               <span className="admin-media-meta"><strong>{item.pathname}</strong><small>{formatBytes(item.size)}</small></span>
123:               <span className="admin-media-actions">
124:               <button
125:                 type="button"
126:                 onClick={() => copyUrl(item.url)}
127:                 className="admin-icon-button"
128:                 aria-label={copied === item.url ? "URL copiada" : "Copiar URL"}
129:                 title={copied === item.url ? "URL copiada" : "Copiar URL"}
130:               >
131:                 {copied === item.url ? <CheckIcon aria-hidden /> : <ClipboardDocumentIcon aria-hidden />}
132:               </button>
133:               <DeleteActionMenu
134:                 title="Excluir esta imagem?"
135:                 description="O arquivo será apagado permanentemente dos assets e poderá deixar referências quebradas no site."
136:                 onDelete={() => remove(item)}
137:                 disabled={deletingUrl === item.url}
138:                 triggerAriaLabel={`Opções da imagem ${item.pathname}`}
139:                 triggerClassName="admin-icon-button"
140:               />
141:               </span>
142:             </figcaption>
143:           </figure>
144:         ))}
145:         {media.length === 0 && <p className="admin-empty admin-media-empty">Nenhuma imagem enviada. Use a área acima para começar.</p>}
146:         </div>
147:       </section>
148:     </div>
149:   )
150: }
