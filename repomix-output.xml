 98:     document.addEventListener("keydown", closeFromKeyboard)
 99:     return () => {
100:       cancelAnimationFrame(frame)
101:       document.removeEventListener("pointerdown", closeFromOutside)
102:       document.removeEventListener("keydown", closeFromKeyboard)
103:     }
104:   }, [open])
105: 
106:   async function confirmDelete() {
107:     setPending(true)
108:     setError("")
109:     try {
110:       await onDelete()
111:       setOpen(false)
112:     } catch (caughtError) {
113:       setError(caughtError instanceof Error ? caughtError.message : "Não foi possível excluir. Tente novamente.")
114:     } finally {
115:       setPending(false)
