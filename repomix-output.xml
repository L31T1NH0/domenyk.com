  1: import { normalizeAdminPushTopics, type AdminPushTopic } from "@/lib/notification-events"
  2: 
  3: type PushStatus = {
  4:   topics: Array<"posts" | "notes">
  5:   adminEvents: boolean
  6:   adminTopics: AdminPushTopic[]
  7:   messageEvents: boolean
  8:   subscribed: boolean
  9:   pending: boolean
 10: }
 11: 
 12: export function applicationServerKey(value: string) {
 13:   const padding = "=".repeat((4 - value.length % 4) % 4)
 14:   const base64 = (value + padding).replace(/-/g, "+").replace(/_/g, "/")
 15:   const raw = window.atob(base64)
 16:   return Uint8Array.from(raw, (character) => character.charCodeAt(0))
 17: }
 18: 
 19: function supported() {
 20:   return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
 21: }
 22: 
 23: export async function pushStatusFor(subscription: PushSubscription): Promise<PushStatus> {
 24:   const response = await fetch("/api/push/subscriptions", {
 25:     method: "PUT",
 26:     headers: { "Content-Type": "application/json" },
 27:     body: JSON.stringify(subscription.toJSON()),
 28:   })
 29:   if (!response.ok) return { topics: [], adminEvents: false, adminTopics: [], messageEvents: false, subscribed: false, pending: false }
 30:   const status = await response.json() as Partial<PushStatus>
 31:   return {
 32:     topics: Array.isArray(status.topics) ? status.topics : [],
 33:     adminEvents: status.adminEvents === true,
 34:     adminTopics: normalizeAdminPushTopics(status.adminTopics, status.adminEvents === true),
 35:     messageEvents: status.messageEvents === true,
 36:     subscribed: status.subscribed === true,
 37:     pending: status.pending === true,
 38:   }
 39: }
 40: 
 41: export async function waitForPushVerification(subscription: PushSubscription): Promise<void> {
 42:   for (let attempt = 0; attempt < 10; attempt += 1) {
 43:     const status = await pushStatusFor(subscription)
 44:     if (status.subscribed) return
 45:     if (!status.pending) break
 46:     await new Promise((resolve) => window.setTimeout(resolve, 400))
 47:   }
 48:   throw new Error("Não foi possível confirmar o recebimento neste dispositivo.")
 49: }
 50: 
 51: export async function revokePrivatePushForCurrentDevice(): Promise<void> {
 52:   if (!("serviceWorker" in navigator)) return
 53:   const registration = await navigator.serviceWorker.getRegistration("/")
 54:   const subscription = await registration?.pushManager.getSubscription()
 55:   if (!subscription) return
 56: 
 57:   const response = await fetch("/api/push/subscriptions", {
 58:     method: "PATCH",
 59:     headers: { "Content-Type": "application/json" },
 60:     body: JSON.stringify(subscription.toJSON()),
 61:     keepalive: true,
 62:   })
 63:   if (response.ok) return
 64:   await subscription.unsubscribe().catch(() => false)
 65:   throw new Error("Não foi possível revogar os alertas privados.")
 66: }
 67: 
 68: export async function messagePushPreference() {
 69:   if (!supported() || Notification.permission !== "granted") return false
 70:   const registration = await navigator.serviceWorker.getRegistration("/")
 71:   const subscription = await registration?.pushManager.getSubscription()
 72:   if (!subscription) return false
 73:   return (await pushStatusFor(subscription)).messageEvents
 74: }
 75: 
 76: export async function setMessagePushPreference(enabled: boolean) {
 77:   if (!supported()) throw new Error("Este navegador não oferece notificações para sites.")
 78: 
 79:   const permissionPromise = enabled && Notification.permission === "default"
 80:     ? Notification.requestPermission()
 81:     : Promise.resolve(Notification.permission)
 82:   const permission = await permissionPromise
 83:   if (enabled && permission !== "granted") {
 84:     throw new Error("A permissão de notificações não foi concedida.")
 85:   }
 86: 
 87:   let registration = await navigator.serviceWorker.getRegistration("/")
 88:   let subscription = await registration?.pushManager.getSubscription() ?? null
 89:   if (!enabled && !subscription) return
 90: 
 91:   const configResponse = await fetch("/api/push/config", { cache: "no-store" })
 92:   const config = await configResponse.json() as { configured?: boolean; publicKey?: string | null }
 93:   if (!config.configured || !config.publicKey) throw new Error("As notificações ainda não foram configuradas pelo site.")
 94: 
 95:   if (!registration) {
 96:     registration = await navigator.serviceWorker.register("/push-service-worker.js", { scope: "/" })
 97:   }
 98:   if (!subscription) {
 99:     subscription = await registration.pushManager.subscribe({
100:       userVisibleOnly: true,
101:       applicationServerKey: applicationServerKey(config.publicKey),
102:     })
103:   }
104: 
105:   const status = await pushStatusFor(subscription)
106:   const response = await fetch("/api/push/subscriptions", {
107:     method: "POST",
108:     headers: { "Content-Type": "application/json" },
109:     body: JSON.stringify({
110:       ...subscription.toJSON(),
111:       topics: status.topics,
112:       adminEvents: status.adminEvents,
113:       adminTopics: status.adminTopics,
114:       messageEvents: enabled,
115:     }),
116:   })
117:   if (!response.ok) {
118:     const data = await response.json().catch(() => null) as { error?: string } | null
119:     throw new Error(data?.error || "Não foi possível salvar a preferência de mensagens.")
120:   }
121:   const result = await response.json().catch(() => null) as { pending?: boolean } | null
122:   if (result?.pending) await waitForPushVerification(subscription)
123:   window.dispatchEvent(new Event("push:preferences-changed"))
124: }
</file>

