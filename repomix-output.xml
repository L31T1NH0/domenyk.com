198: export async function completeNotificationReading(id: string, activeSeconds: number, progress: number) {
199:   const validSince = new Date(Date.now() - ENGAGEMENT_TOKEN_TTL_MS)
200:   const result = await (await getDb()).collection("notifications").updateOne(
201:     {
202:       occurrences: {
203:         $elemMatch: {
204:           id,
205:           occurredAt: { $gte: validSince },
206:           reading: { $exists: false },
207:         },
208:       },
209:     },
210:     { $set: {
211:       "occurrences.$.reading": {
212:         completedAt: new Date(),
213:         activeSeconds,
214:         progress,
215:       },
216:     } }
217:   )
218:   return result.modifiedCount > 0
219: }
