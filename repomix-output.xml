148: function layoutParagraph({
149:   paragraph,
150:   geometry,
151:   side,
152:   containerWidth,
153:   imageTop,
154:   imageHeight,
155:   imageLeft,
156:   imageWidth,
157:   shapeMargin,
158: }: {
159:   paragraph: HTMLParagraphElement
160:   geometry: FlowImageAlphaGeometry
161:   side: FlowSide
162:   containerWidth: number
163:   imageTop: number
164:   imageHeight: number
165:   imageLeft: number
166:   imageWidth: number
167:   shapeMargin: number
168: }) {
169:   const source = collectInlineSources(paragraph)
170:   if (!source) return false
171:   const prepared = prepareRichInline(source.items)
172:   const paragraphTop = paragraph.offsetTop
173:   const paragraphLeft = paragraph.offsetLeft
174:   const style = window.getComputedStyle(paragraph)
175:   const fontSize = parsePixelValue(style.fontSize, 16)
176:   const lineHeight = parsePixelValue(style.lineHeight, fontSize * 1.5)
177:   const positioned: PositionedFragment[][] = source.sources.map(() => [])
178:   let cursor: RichInlineCursor = { itemIndex: 0, segmentIndex: 0, graphemeIndex: 0 }
179:   let lineIndex = 0
180:   while (lineIndex < MAX_GENERATED_LINES) {
181:     const bandTop = paragraphTop + lineIndex * lineHeight
182:     const slot = lineSlotForAlphaBand({
183:       geometry, side, containerWidth, bandTop, bandBottom: bandTop + lineHeight,
184:       imageTop, imageHeight, imageLeft, imageWidth, shapeMargin,
185:     })
186:     if (slot.width < MIN_LINE_WIDTH) {
187:       lineIndex += 1
188:       continue
189:     }
190:     const range = layoutNextRichInlineLineRange(prepared, Math.max(1, slot.width - LINE_WIDTH_GUARD), cursor)
191:     if (!range) break
192:     const line = materializeRichInlineLineRange(prepared, range)
193:     let inlineOffset = 0
194:     for (const fragment of line.fragments) {
195:       inlineOffset += fragment.gapBefore
196:       positioned[fragment.itemIndex]?.push({
197:         gapBefore: fragment.gapBefore,
198:         left: slot.left - paragraphLeft + inlineOffset,
199:         lineIndex,
200:         text: fragment.text,
201:         top: lineIndex * lineHeight,
202:       })
203:       inlineOffset += fragment.occupiedWidth
204:     }
205:     cursor = range.end
206:     lineIndex += 1
207:   }
208:   if (lineIndex >= MAX_GENERATED_LINES) return false
209:   projectFragments(paragraph, source.sources, positioned, lineIndex, lineHeight)
210:   return true
211: }
