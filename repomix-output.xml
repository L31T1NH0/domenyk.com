130: export function PostsTable({ posts: initial }: Props) {
131:   const [posts, setPosts] = useState(initial)
132:   const [selected, setSelected] = useState<Record<string, boolean>>({})
133:   const [query, setQuery] = useState("")
134:   const [status, setStatus] = useState<StatusFilter>("all")
135:   const [visibility, setVisibility] = useState<VisibilityFilter>("all")
136:   const [showConfig, setShowConfig] = useState(false)
137:   const [busyAction, setBusyAction] = useState<string | null>(null)
138:   const [actionError, setActionError] = useState("")
139:   const [visibleColumns, setVisibleColumns] = useState<Record<ColumnKey, boolean>>({
140:     status: true,
141:     date: true,
142:     views: true,
143:     reading: true,
144:     style: false,
145:   })
146: 
147:   const filteredPosts = useMemo(() => {
148:     return posts.filter((post) => {
149:       if (!postMatchesQuery(post, query)) return false
150:       if (status === "published" && !post.published) return false
151:       if (status === "draft" && post.published) return false
152:       if (visibility === "timeline" && post.hiddenFromTimeline === true) return false
153:       if (visibility === "hidden" && post.hiddenFromTimeline !== true) return false
154:       return true
155:     })
156:   }, [posts, query, status, visibility])
157: 
158:   const selectedIds = useMemo(() => Object.keys(selected).filter((id) => selected[id]), [selected])
159:   const allFilteredSelected = filteredPosts.length > 0 && filteredPosts.every((post) => selected[post._id])
160: 
161:   function setPostSelected(id: string, checked: boolean) {
162:     setSelected((prev) => ({ ...prev, [id]: checked }))
163:   }
164: 
165:   function toggleFilteredSelection() {
166:     setSelected((prev) => {
167:       const next = { ...prev }
168:       for (const post of filteredPosts) next[post._id] = !allFilteredSelected
169:       return next
170:     })
171:   }
172: 
173:   async function patchPost(id: string, body: Record<string, unknown>) {
174:     const res = await fetch(`/api/admin/posts/${id}`, {
175:       method: "PATCH",
176:       headers: { "Content-Type": "application/json" },
177:       body: JSON.stringify(body),
178:     })
179:     if (!res.ok) throw new Error("Não foi possível atualizar o post.")
180:   }
181: 
182:   async function togglePostBoolean(id: string, key: "published" | "pinned", current: boolean) {
183:     setActionError("")
184:     try {
185:       await patchPost(id, { [key]: !current })
186:       setPosts((prev) => prev.map((post) => (post._id === id ? { ...post, [key]: !current } : post)))
187:     } catch (err) {
188:       setActionError(err instanceof Error ? err.message : "Não foi possível atualizar o post.")
189:     }
190:   }
191: 
192:   function togglePublish(post: SerializedPostSummary) {
193:     void togglePostBoolean(post._id, "published", post.published)
194:   }
195: 
196:   function togglePin(post: SerializedPostSummary) {
197:     void togglePostBoolean(post._id, "pinned", post.pinned)
198:   }
199: 
200:   async function hideFromTimeline(ids: string[]) {
201:     setBusyAction("hide")
202:     setActionError("")
203:     try {
204:       await Promise.all(ids.map((id) => patchPost(id, { hiddenFromTimeline: true })))
205:       setPosts((prev) => prev.map((post) => (ids.includes(post._id) ? { ...post, hiddenFromTimeline: true } : post)))
206:       setSelected({})
207:     } catch (err) {
208:       setActionError(err instanceof Error ? err.message : "Não foi possível ocultar os posts.")
209:     } finally {
210:       setBusyAction(null)
211:     }
212:   }
213: 
214:   async function remove(ids: string[]) {
215:     setBusyAction("delete")
216:     setActionError("")
217:     try {
218:       const responses = await Promise.all(ids.map((id) => fetch(`/api/admin/posts/${id}`, { method: "DELETE" })))
219:       if (responses.some((res) => !res.ok)) throw new Error("Não foi possível deletar todos os posts.")
220:       setPosts((prev) => prev.filter((post) => !ids.includes(post._id)))
221:       setSelected({})
222:     } catch (err) {
223:       const message = err instanceof Error ? err.message : "Não foi possível deletar os posts."
224:       setActionError(message)
225:       throw new Error(message)
226:     } finally {
227:       setBusyAction(null)
228:     }
229:   }
230: 
231:   async function download(ids: string[]) {
232:     setBusyAction("download")
233:     setActionError("")
234:     try {
235:       const res = await fetch("/api/admin/posts/download", {
236:         method: "POST",
237:         headers: { "Content-Type": "application/json" },
238:         body: JSON.stringify({ ids }),
239:       })
240:       if (!res.ok) throw new Error("Não foi possível exportar os posts.")
241: 
242:       const blob = await res.blob()
243:       const url = URL.createObjectURL(blob)
244:       const anchor = document.createElement("a")
245:       anchor.href = url
246:       anchor.download = `posts-${siteDateKey()}.md`
247:       anchor.click()
248:       URL.revokeObjectURL(url)
249:     } catch (err) {
250:       setActionError(err instanceof Error ? err.message : "Não foi possível exportar os posts.")
251:     } finally {
252:       setBusyAction(null)
253:     }
254:   }
255: 
256:   const actionIds = selectedIds.length > 0 ? selectedIds : filteredPosts.map((post) => post._id)
257: 
258:   return (
259:     <section className="admin-records admin-post-records">
260:       <div className="admin-records-toolbar">
261:         <div className="admin-records-toolbar-row">
262:           <div><strong>Todos os posts</strong><small>{filteredPosts.length} de {posts.length} registros{selectedIds.length > 0 ? ` · ${selectedIds.length} selecionados` : ""}</small></div>
263:           <div className="admin-record-controls">
264:             <label className="admin-control-search"><MagnifyingGlassIcon aria-hidden /><input value={query} onChange={(event) => setQuery(event.target.value)} placeholder="Buscar posts" /></label>
265:             <select value={status} onChange={(event) => setStatus(event.target.value as StatusFilter)} className="admin-control" aria-label="Filtrar por publicação"><option value="all">Todos</option><option value="published">Publicados</option><option value="draft">Rascunhos</option></select>
266:             <select value={visibility} onChange={(event) => setVisibility(event.target.value as VisibilityFilter)} className="admin-control" aria-label="Filtrar por visibilidade"><option value="all">Toda timeline</option><option value="timeline">Visíveis</option><option value="hidden">Ocultos</option></select>
267:             <button type="button" onClick={() => download(actionIds)} disabled={actionIds.length === 0 || busyAction === "download"} className="admin-control-button"><ArrowDownTrayIcon aria-hidden />Exportar</button>
268:             <div className="admin-record-config">
269:               <button type="button" onClick={() => setShowConfig((value) => !value)} className="admin-icon-control" aria-label="Configurar tabela" aria-expanded={showConfig}><Cog6ToothIcon aria-hidden /></button>
270:               {showConfig && <div className="admin-posts-columns-panel"><strong>Colunas visíveis</strong>{columns.map((column) => <label key={column.key}><input type="checkbox" checked={visibleColumns[column.key]} onChange={(event) => setVisibleColumns((prev) => ({ ...prev, [column.key]: event.target.checked }))} className="admin-check" />{column.label}</label>)}</div>}
271:             </div>
272:           </div>
273:         </div>
274: 
275:         {actionError && <p className="admin-form-error admin-records-error" role="alert">{actionError}</p>}
276:         {selectedIds.length > 0 && <div className="admin-record-selection"><strong>{selectedIds.length} selecionados</strong><button type="button" onClick={() => hideFromTimeline(selectedIds)} disabled={busyAction === "hide"}><EyeSlashIcon aria-hidden />Ocultar da timeline</button><button type="button" onClick={() => download(selectedIds)} disabled={busyAction === "download"}><ArrowDownTrayIcon aria-hidden />Baixar textos</button><DeleteActionMenu title={selectedIds.length === 1 ? "Excluir o post selecionado?" : `Excluir ${selectedIds.length} posts?`} description={selectedIds.length === 1 ? "O post e seus comentários serão apagados permanentemente." : "Os posts selecionados e seus comentários serão apagados permanentemente."} onDelete={() => remove(selectedIds)} disabled={busyAction === "delete"} triggerLabel="Deletar" triggerVariant="text" triggerClassName="admin-record-delete" /></div>}
277:       </div>
278: 
279:       {filteredPosts.length === 0 ? <div className="admin-empty">Nenhum post encontrado.</div> : <>
280:         <div className="admin-post-cards">
281:           {filteredPosts.map((post) => <article key={post._id} className="admin-post-card">
282:             <input type="checkbox" checked={selected[post._id] === true} onChange={(event) => setPostSelected(post._id, event.target.checked)} aria-label={`Selecionar ${post.title}`} className="admin-check" />
283:             <div className="admin-post-card-body"><header><div><h2>{post.title}</h2><span><PostFlags post={post} /></span></div><p>{post.slug}</p></header><TranslationBadges post={post} /><dl><div><dt>Status</dt><dd><StatusBadge published={post.published} /></dd></div><div><dt>Publicado</dt><dd>{formatDate(post.publishedAt ?? post.createdAt)}</dd></div><div><dt>Views</dt><dd>{post.views ?? 0}</dd></div><div><dt>Leitura</dt><dd>{post.readingTimeMinutes} min</dd></div></dl><PostRowActions post={post} onTogglePublish={togglePublish} onTogglePin={togglePin} onRemove={(id) => remove([id])} /></div>
284:           </article>)}
285:         </div>
286: 
287:         <div className="admin-record-table-wrap admin-post-table-wrap">
288:           <table className="admin-record-table admin-post-table">
289:             <thead><tr><th scope="col"><input type="checkbox" checked={allFilteredSelected} onChange={toggleFilteredSelection} aria-label="Selecionar posts filtrados" className="admin-check" /></th><th scope="col">Post</th>{visibleColumns.status && <th scope="col">Status</th>}{visibleColumns.date && <th scope="col">Publicado</th>}{visibleColumns.views && <th scope="col">Views</th>}{visibleColumns.reading && <th scope="col">Leitura</th>}{visibleColumns.style && <th scope="col">Estilo</th>}<th scope="col">Ações</th></tr></thead>
290:             <tbody>{filteredPosts.map((post) => <tr key={post._id}><td><input type="checkbox" checked={selected[post._id] === true} onChange={(event) => setPostSelected(post._id, event.target.checked)} aria-label={`Selecionar ${post.title}`} className="admin-check" /></td><td><div className="admin-post-cell"><div><Link href={`/admin/posts/${post._id}`}>{post.title}</Link><span><PostFlags post={post} /></span></div><p>{post.slug}</p><TranslationBadges post={post} /></div></td>{visibleColumns.status && <td><StatusBadge published={post.published} /></td>}{visibleColumns.date && <td><time>{formatDate(post.publishedAt ?? post.createdAt)}</time></td>}{visibleColumns.views && <td className="admin-record-number">{post.views ?? 0}</td>}{visibleColumns.reading && <td className="admin-record-number">{post.readingTimeMinutes} min</td>}{visibleColumns.style && <td>{post.style}</td>}<td><PostRowActions post={post} compact onTogglePublish={togglePublish} onTogglePin={togglePin} onRemove={(id) => remove([id])} /></td></tr>)}</tbody>
291:           </table>
292:         </div>
293:       </>}
294:     </section>
295:   )
296: }
