786: export function hasParagraphId(
787:   content: string,
788:   paragraphId: string,
789:   options: MarkdownRenderOptions = {}
790: ): boolean {
791:   if (!paragraphId || paragraphId.length > 120) return false
792:   const optionsKey = JSON.stringify({
793:     authorImageUrl: options.authorImageUrl ?? null,
794:     coAuthorImageUrl: options.coAuthorImageUrl ?? null,
795:     defaultImageAlt: options.defaultImageAlt ?? null,
796:     imagePolicy: options.imagePolicy ?? null,
797:     externalLinkRel: options.externalLinkRel ?? null,
798:   })
799:   const cacheKey = createHash("sha256")
800:     .update(optionsKey)
801:     .update("\0")
802:     .update(content)
803:     .digest("hex")
804:   let ids = paragraphIdCache.get(cacheKey)
805: 
806:   if (!ids) {
807:     ids = new Set(extractParagraphIds(content, options))
808:     paragraphIdCache.set(cacheKey, ids)
809:     if (paragraphIdCache.size > MAX_PARAGRAPH_ID_CACHE_ENTRIES) {
810:       const oldestKey = paragraphIdCache.keys().next().value
811:       if (oldestKey) paragraphIdCache.delete(oldestKey)
812:     }
813:   }
814: 
815:   return ids.has(paragraphId)
816: }
