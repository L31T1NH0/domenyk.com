28:   const continueFromNoteId = body?.continueFromNoteId === undefined
29:     ? undefined
30:     : asString(body.continueFromNoteId, 24)
31:   if (body?.continueFromNoteId !== undefined && (!continueFromNoteId || !toObjectId(continueFromNoteId))) {
32:     throw new NoteInputError("Nota de origem inválida.")
33:   }
34: 
35:   const note = await createNote({
36:     title,
37:     content: normalizedContent,
38:     images,
39:     continueFromNoteId,
40:   })
