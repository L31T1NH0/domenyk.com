 3: import { createHash, randomUUID } from "node:crypto"
 4: import {
 5:   aggregateNotification as storeAggregateNotification,
 6:   createNotification as storeNotification,
 7:   createNotificationOnce as storeNotificationOnce,
 8:   type AggregateNotificationInput,
 9:   type NotificationInput,
10:   type NotificationOccurrenceDetails,
11: } from "@/lib/db/notifications"
12: import type { AdminPushTopic } from "@/lib/notification-events"
13: import { sendAdminPush } from "@/lib/push"
14: import { rateLimit } from "@/lib/rate-limit"
15: 
16: const AGGREGATE_PUSH_WINDOW_MS = 10 * 60_000
17: 
18: function pushPayload(data: Pick<NotificationInput, "title" | "description" | "href">) {
19:   return {
20:     title: data.title,
21:     body: data.description,
22:     url: data.href,
23:   }
