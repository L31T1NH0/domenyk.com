<file path="src/components/post/flow-image-alpha.ts">
 1: export type FlowImageAlphaRow = { left: number; right: number }
 2: 
 3: export type FlowImageAlphaGeometry = {
 4:   height: number
 5:   left: number
 6:   right: number
 7:   rows: Array<FlowImageAlphaRow | null>
 8:   width: number
 9: }
10: 
11: export const MAX_FLOW_ALPHA_SAMPLE_DIMENSION = 512
12: export const FLOW_ALPHA_THRESHOLD = Math.ceil(255 * 0.12)
13: 
14: export function geometryFromAlphaPixels(
15:   pixels: Uint8ClampedArray,
16:   width: number,
17:   height: number,
18:   naturalWidth: number,
19:   naturalHeight: number,
20:   threshold = FLOW_ALPHA_THRESHOLD
21: ): FlowImageAlphaGeometry {
22:   if (width < 1 || height < 1 || pixels.length < width * height * 4) {
23:     throw new Error("Invalid alpha pixel buffer")
24:   }
25:   let firstVisibleColumn = width
26:   let lastVisibleColumn = -1
27:   const rows: Array<FlowImageAlphaRow | null> = new Array(height).fill(null)
28:   for (let y = 0; y < height; y += 1) {
29:     let rowLeft = width
30:     let rowRight = -1
31:     for (let x = 0; x < width; x += 1) {
32:       const alpha = pixels[(y * width + x) * 4 + 3]
33:       if (alpha < threshold) continue
34:       rowLeft = Math.min(rowLeft, x)
35:       rowRight = Math.max(rowRight, x)
36:       firstVisibleColumn = Math.min(firstVisibleColumn, x)
37:       lastVisibleColumn = Math.max(lastVisibleColumn, x)
38:     }
39:     if (rowRight >= rowLeft) rows[y] = { left: rowLeft / width, right: (rowRight + 1) / width }
40:   }
41:   if (lastVisibleColumn < firstVisibleColumn) {
42:     return { height: naturalHeight, left: 0, right: 0, rows, width: naturalWidth }
43:   }
44:   return {
45:     height: naturalHeight,
46:     left: firstVisibleColumn / width,
47:     right: (width - 1 - lastVisibleColumn) / width,
48:     rows,
49:     width: naturalWidth,
50:   }
51: }
</file>

<file path="src/components/post/flow-image-alpha.worker.ts">
 1: /// <reference lib="webworker" />
 2: 
 3: import { geometryFromAlphaPixels } from "./flow-image-alpha"
 4: 
 5: type Request = {
 6:   bitmap: ImageBitmap
 7:   naturalHeight: number
 8:   naturalWidth: number
 9:   sampleHeight: number
10:   sampleWidth: number
11: }
12: 
13: self.addEventListener("message", (event: MessageEvent<Request>) => {
14:   const { bitmap, naturalHeight, naturalWidth, sampleHeight, sampleWidth } = event.data
15:   try {
16:     const canvas = new OffscreenCanvas(sampleWidth, sampleHeight)
17:     const context = canvas.getContext("2d", { willReadFrequently: true })
18:     if (!context) throw new Error("Canvas 2D is unavailable")
19:     context.drawImage(bitmap, 0, 0, sampleWidth, sampleHeight)
20:     bitmap.close()
21:     const pixels = context.getImageData(0, 0, sampleWidth, sampleHeight).data
22:     self.postMessage({
23:       geometry: geometryFromAlphaPixels(
24:         pixels,
25:         sampleWidth,
26:         sampleHeight,
27:         naturalWidth,
28:         naturalHeight
29:       ),
30:     })
31:   } catch (error) {
32:     bitmap.close()
33:     self.postMessage({ error: error instanceof Error ? error.message : "Alpha measurement failed" })
34:   }
35: })
36: 
37: export {}
</file>

