  9: } from "@/lib/blob"
 10: 
 11: const MAX_MULTIPART_SIZE_BYTES = MAX_IMAGE_UPLOAD_BYTES + 256 * 1024
 12: 
 13: export type ImageUploadFolder = "posts" | "notes" | "comments" | "media"
 14: 
 15: async function readBoundedBody(
 16:   req: NextRequest
 17: ): Promise<{ body: ArrayBuffer | null; tooLarge: boolean }> {
 18:   if (!req.body) return { body: null, tooLarge: false }
 19: 
 20:   const reader = req.body.getReader()
 21:   const chunks: Uint8Array[] = []
 22:   let total = 0
 23: 
 24:   try {
 25:     while (true) {
 26:       const { done, value } = await reader.read()
 27:       if (done) break
 28:       if (!value) continue
 29: 
 30:       total += value.byteLength
 31:       if (total > MAX_MULTIPART_SIZE_BYTES) {
 32:         await reader.cancel().catch(() => undefined)
 33:         return { body: null, tooLarge: true }
 34:       }
 35:       chunks.push(value)
 36:     }
 37:   } finally {
 38:     reader.releaseLock()
 39:   }
 40: 
 41:   const body = new Uint8Array(total)
 42:   let offset = 0
 43:   for (const chunk of chunks) {
 44:     body.set(chunk, offset)
 45:     offset += chunk.byteLength
 46:   }
 47: 
 48:   return { body: body.buffer, tooLarge: false }
 49: }
 50: 
 51: export async function uploadImageFromRequest(
 52:   req: NextRequest,
 53:   folder: ImageUploadFolder,
 54:   onUploaded?: (url: string) => Promise<void>
 55: ) {
 56:   const contentType = req.headers.get("content-type") ?? ""
 57:   if (!/^multipart\/form-data(?:;|$)/i.test(contentType)) {
 58:     return NextResponse.json({ error: "O conteúdo deve ser multipart/form-data." }, { status: 400 })
 59:   }
 60: 
 61:   const contentLengthHeader = req.headers.get("content-length")
 62:   const contentLength = contentLengthHeader === null ? null : Number(contentLengthHeader)
 63:   if (contentLength !== null && (!Number.isSafeInteger(contentLength) || contentLength < 0)) {
 64:     return NextResponse.json({ error: "Content-Length inválido." }, { status: 400 })
 65:   }
 66:   if (contentLength !== null && contentLength > MAX_MULTIPART_SIZE_BYTES) {
 67:     return NextResponse.json({ error: "A requisição deve ter no máximo 4,25MB." }, { status: 413 })
 68:   }
 69: 
 70:   const requestBody = await readBoundedBody(req).catch(() => null)
 71:   if (!requestBody) {
 72:     return NextResponse.json({ error: "Não foi possível ler o formulário." }, { status: 400 })
 73:   }
 74:   if (requestBody.tooLarge) {
 75:     return NextResponse.json({ error: "A requisição deve ter no máximo 4,25MB." }, { status: 413 })
 76:   }
 77:   if (!requestBody.body) {
 78:     return NextResponse.json({ error: "Formulário inválido." }, { status: 400 })
 79:   }
 80: 
 81:   const formData = await new Response(requestBody.body, {
 82:     headers: { "content-type": contentType },
 83:   }).formData().catch(() => null)
 84:   if (!formData) {
 85:     return NextResponse.json({ error: "Formulário inválido." }, { status: 400 })
 86:   }
 87: 
 88:   return uploadImageFromFormData(formData, folder, onUploaded)
 89: }
 90: 
 91: async function uploadImageFromFormData(
 92:   formData: FormData,
 93:   folder: ImageUploadFolder,
 94:   onUploaded?: (url: string) => Promise<void>
 95: ) {
 96:   const file = formData.get("file")
 97: 
 98:   if (!(file instanceof File)) {
 99:     return NextResponse.json({ error: "Nenhum arquivo enviado" }, { status: 400 })
100:   }
101: 
102:   if (!isAllowedImageType(file.type)) {
103:     return NextResponse.json({ error: "Arquivo inválido. Envie SVG, PNG, JPG ou WebP." }, { status: 400 })
104:   }
105: 
106:   if (file.size > MAX_IMAGE_UPLOAD_BYTES) {
107:     return NextResponse.json({ error: "A imagem deve ter no máximo 4MB." }, { status: 400 })
108:   }
109: 
110:   const buffer = await file.arrayBuffer()
111:   const image = await sanitizeImageUpload(file.name, buffer, file.type).catch(() => null)
112:   if (!image) {
113:     return NextResponse.json({ error: "Imagem inválida ou corrompida." }, { status: 400 })
114:   }
115: 
116:   let uploadedUrl: string | undefined
117:   try {
118:     uploadedUrl = await uploadImage(image.filename, image.data, folder, image.contentType)
119:     if (onUploaded) {
120:       try {
121:         await onUploaded(uploadedUrl)
122:       } catch (error) {
123:         await deleteImage(uploadedUrl).catch(() => undefined)
124:         throw error
125:       }
126:     }
127:     return NextResponse.json({ url: uploadedUrl, contentType: image.contentType }, { status: 201 })
128:   } catch (error) {
129:     console.error("[image-upload] failed to store image", error)
130:     return NextResponse.json(
131:       { error: imageStorageErrorMessage(error) },
132:       { status: 502 }
133:     )
134:   }
135: }
</file>

