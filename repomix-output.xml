  4: import { recordActivityEvent } from "@/lib/db/activity"
  5: import { aggregateNotification, createNotification } from "@/lib/admin-notifications"
  6: import { getPostByPublicId, incrementPostViewsOnce } from "@/lib/db/posts"
  7: import { isPostLocale } from "@/lib/post-locales"
  8: import { getPostVersion } from "@/lib/post-versions"
  9: import { qualifiesPostView } from "@/lib/post-view-qualification"
 10: import { rateLimit } from "@/lib/rate-limit"
 11: import { requestIdentity } from "@/lib/request-identity"
 12: import { viewRequestDetails, type ViewClientContext } from "@/lib/view-request-details"
 13: import { siteDateKey } from "@/lib/datetime"
 14: 
 15: const VIEW_COOKIE_MAX_AGE = 60 * 60 * 24
 16: 
 17: function viewCookieName(publicId: string) {
 18:   const hash = createHash("sha256").update(publicId).digest("hex").slice(0, 16)
 19:   return `post_viewed_${hash}`
 20: }
 21: 
 22: function viewVisitorKey(req: NextRequest, publicId: string): string {
 23:   const day = siteDateKey()
 24:   return createHash("sha256")
 25:     .update(`${day}\n${publicId}\n${requestIdentity(req)}`)
 26:     .digest("hex")
 27: }
 28: 
 29: export async function POST(
 30:   req: NextRequest,
 31:   { params }: { params: Promise<{ slug: string }> }
 32: ) {
 33:   const { slug: publicId } = await params
 34:   if (!publicId || publicId.length > 180) {
 35:     return NextResponse.json({ error: "Not found" }, { status: 404 })
 36:   }
 37: 
 38:   const body = await req.json().catch(() => null) as ({
 39:     locale?: unknown
 40:     activeSeconds?: unknown
 41:     progress?: unknown
 42:     interacted?: unknown
 43:   } & ViewClientContext) | null
 44:   const locale = typeof body?.locale === "string" ? body.locale : "pt"
 45:   if (!isPostLocale(locale)) {
 46:     return NextResponse.json({ error: "Invalid locale" }, { status: 400 })
 47:   }
 48:   const qualification = {
 49:     activeSeconds: Number(body?.activeSeconds),
 50:     progress: Number(body?.progress),
 51:     interacted: body?.interacted === true,
 52:   }
 53:   if (!qualifiesPostView(qualification)) {
 54:     return NextResponse.json({ error: "Visualização ainda não qualificada." }, { status: 400 })
 55:   }
 56: 
 57:   const post = await getPostByPublicId(publicId)
 58:   const version = post ? getPostVersion(post, locale) : null
 59:   if (!post || !version?.published) {
 60:     return NextResponse.json({ error: "Not found" }, { status: 404 })
 61:   }
 62: 
 63:   const cookieName = viewCookieName(publicId)
 64:   if (await isAdmin() || req.cookies.has(cookieName)) {
 65:     return NextResponse.json({ views: post.views ?? 0, viewCounted: false })
 66:   }
 67:   if (!(await rateLimit(`post-view:${requestIdentity(req)}`, { limit: 120, windowMs: 24 * 60 * 60_000 }))) {
 68:     return NextResponse.json({ views: post.views ?? 0, viewCounted: false }, { status: 429 })
 69:   }
 70: 
 71:   const result = await incrementPostViewsOnce(publicId, viewVisitorKey(req, publicId))
 72:   const viewer = result.counted ? await getAuthUser() : null
 73:   if (result.counted) {
 74:     await recordActivityEvent({
 75:       type: "post_view", visitorKey: requestIdentity(req), isAuthenticated: Boolean(viewer),
 76:       ...(viewer ? { userId: viewer.id, userName: viewer.name } : {}), postId: post._id, postPublicId: post.publicId,
 77:       postSlug: post.slug, postTitle: version.title, locale,
 78:     }).catch(() => undefined)
 79:   }
 80: 
 81:   const adminId = getAdminUserId()
 82:   let readingToken: string | undefined
 83:   if (result.counted && adminId) {
 84:     readingToken = randomUUID()
 85:     const details = { ...viewRequestDetails(req, body ?? {}), id: readingToken }
 86:     if (viewer) {
 87:       await createNotification({
 88:         recipientId: adminId, actorId: viewer.id, actorImageUrl: viewer.imageUrl, kind: "view",
 89:         title: `${viewer.name} visitou ${version.title}`,
 90:         description: `Visita de usuário autenticado · ${result.views} visualizações no total.`,
 91:         href: `/posts/${post.slug}`,
 92:       }, "identified_post_views", details).catch(() => undefined)
 93:     } else {
 94:       await aggregateNotification({
 95:         recipientId: adminId, kind: "view", aggregateKey: `view:${publicId}`,
 96:         title: `Novas visualizações em ${version.title}`,
 97:         description: `O post chegou a ${result.views} visualizações.`, href: `/posts/${post.slug}`,
 98:       }, "anonymous_post_views", details).catch(() => undefined)
 99:     }
100:   }
101: 
102:   const response = NextResponse.json({ views: result.views, viewCounted: result.counted, readingToken })
103:   response.cookies.set(cookieName, "1", {
104:     httpOnly: true,
105:     maxAge: VIEW_COOKIE_MAX_AGE,
106:     path: "/",
107:     sameSite: "lax",
108:     secure: process.env.NODE_ENV === "production",
109:   })
110:   return response
111: }
</file>

