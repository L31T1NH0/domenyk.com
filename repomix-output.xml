<file path="scripts/migrate-post-seo.mjs">
 1: import { MongoClient } from "mongodb"
 2: import { backupDatabase, backupPassphrase } from "./secure-mongo-backup.mjs"
 3: 
 4: const apply = process.argv.includes("--apply")
 5: const backupArg = process.argv.find((argument) => argument.startsWith("--backup-dir="))?.slice("--backup-dir=".length)
 6: const uri = process.env.MONGODB_URI
 7: if (!uri) throw new Error("MONGODB_URI is not set")
 8: if (apply && !backupArg) throw new Error("Use --backup-dir=/caminho/novo ao executar com --apply.")
 9: const passphrase = apply ? backupPassphrase() : null
10: 
11: function plainDescription(markdown = "", maxLength = 155) {
12:   const text = markdown
13:     .replace(/```[\s\S]*?```/g, " ")
14:     .replace(/`[^`]*`/g, " ")
15:     .replace(/!\[[^\]]*]\([^)]*\)/g, " ")
16:     .replace(/\[([^\]]+)]\([^)]*\)/g, "$1")
17:     .replace(/<[^>]+>/g, " ")
18:     .replace(/[#>*_~\-]+/g, " ")
19:     .replace(/\s+/g, " ")
20:     .trim()
21:   if (text.length <= maxLength) return text
22:   const candidate = text.slice(0, maxLength + 1)
23:   return `${candidate.slice(0, candidate.lastIndexOf(" ") || maxLength).trim()}...`
24: }
25: 
26: function migrationSet(post) {
27:   const set = {}
28:   if (!("seoTitle" in post) && post.title) set.seoTitle = post.title
29:   if (!("seoDescription" in post)) {
30:     const value = post.excerpt ?? post.subtitle ?? plainDescription(post.content)
31:     if (value) set.seoDescription = value
32:   }
33: 
34:   for (const [locale, translation] of Object.entries(post.translations ?? {})) {
35:     if (!("seoTitle" in translation) && translation.title) set[`translations.${locale}.seoTitle`] = translation.title
36:     if (!("seoDescription" in translation)) {
37:       const value = translation.excerpt ?? translation.subtitle ?? plainDescription(translation.content)
38:       if (value) set[`translations.${locale}.seoDescription`] = value
39:     }
40:   }
41:   return set
42: }
43: 
44: const client = new MongoClient(uri)
45: try {
46:   await client.connect()
47:   const db = client.db("blog")
48:   const posts = await db.collection("posts").find({}).toArray()
49:   const operations = posts.flatMap((post) => {
50:     const $set = migrationSet(post)
51:     return Object.keys($set).length > 0 ? [{ updateOne: { filter: { _id: post._id }, update: { $set } } }] : []
52:   })
53: 
54:   const report = {
55:     mode: apply ? "apply" : "dry-run",
56:     posts: posts.length,
57:     postsToUpdate: operations.length,
58:     fieldsToAdd: operations.reduce((total, operation) => total + Object.keys(operation.updateOne.update.$set).length, 0),
59:   }
60: 
61:   if (!apply) {
62:     console.log(JSON.stringify(report, null, 2))
63:   } else {
64:     const beforeCounts = Object.fromEntries(await Promise.all(
65:       (await db.listCollections({}, { nameOnly: true }).toArray()).map(async ({ name }) => [name, await db.collection(name).countDocuments({})])
66:     ))
67:     const backup = await backupDatabase(db, backupArg, passphrase)
68:     const result = operations.length > 0 ? await db.collection("posts").bulkWrite(operations, { ordered: true }) : null
69:     const afterCounts = Object.fromEntries(await Promise.all(
70:       Object.keys(beforeCounts).map(async (name) => [name, await db.collection(name).countDocuments({})])
71:     ))
72:     if (JSON.stringify(beforeCounts) !== JSON.stringify(afterCounts)) {
73:       throw new Error("As contagens do banco mudaram durante a migração.")
74:     }
75: 
76:     const remaining = await db.collection("posts").find({}).toArray()
77:     const remainingChanges = remaining.filter((post) => Object.keys(migrationSet(post)).length > 0)
78:     if (remainingChanges.length > 0) throw new Error(`${remainingChanges.length} post(s) ainda exigem migração.`)
79: 
80:     console.log(JSON.stringify({
81:       ...report,
82:       backup: backup.target,
83:       backupCollections: backup.manifest.collections.length,
84:       matched: result?.matchedCount ?? 0,
85:       modified: result?.modifiedCount ?? 0,
86:       countsPreserved: true,
87:       idempotent: true,
88:     }, null, 2))
89:   }
90: } finally {
91:   await client.close()
92: }
</file>

<file path="scripts/secure-mongo-backup.mjs">
 1: import { createCipheriv, createDecipheriv, createHash, randomBytes, scryptSync } from "node:crypto"
 2: import { chmod, mkdir, readFile, readdir, realpath, writeFile } from "node:fs/promises"
 3: import { dirname, isAbsolute, relative, resolve } from "node:path"
 4: import { fileURLToPath } from "node:url"
 5: import { EJSON } from "bson"
 6: 
 7: const MAGIC = Buffer.from("DOMENYKB1", "ascii")
 8: const SALT_BYTES = 16
 9: const IV_BYTES = 12
10: const AUTH_TAG_BYTES = 16
11: const repositoryRoot = resolve(dirname(fileURLToPath(import.meta.url)), "..")
12: 
13: function isInsideRepository(path) {
14:   const relation = relative(repositoryRoot, path)
15:   return relation === "" || (!relation.startsWith("..") && !isAbsolute(relation))
16: }
17: 
18: export function backupPassphrase() {
19:   const passphrase = process.env.MIGRATION_BACKUP_PASSPHRASE?.trim() ?? ""
20:   if (passphrase.length < 16) {
21:     throw new Error("Defina MIGRATION_BACKUP_PASSPHRASE com pelo menos 16 caracteres.")
22:   }
23:   return passphrase
24: }
25: 
26: export function encryptBackup(contents, passphrase) {
27:   const salt = randomBytes(SALT_BYTES)
28:   const iv = randomBytes(IV_BYTES)
29:   const key = scryptSync(passphrase, salt, 32)
30:   const cipher = createCipheriv("aes-256-gcm", key, iv)
31:   const ciphertext = Buffer.concat([cipher.update(contents, "utf8"), cipher.final()])
32:   return Buffer.concat([MAGIC, salt, iv, cipher.getAuthTag(), ciphertext])
33: }
34: 
35: export function decryptBackup(contents, passphrase) {
36:   const buffer = Buffer.isBuffer(contents) ? contents : Buffer.from(contents)
37:   if (!buffer.subarray(0, MAGIC.length).equals(MAGIC)) throw new Error("Formato de backup inválido.")
38:   const saltStart = MAGIC.length
39:   const ivStart = saltStart + SALT_BYTES
40:   const tagStart = ivStart + IV_BYTES
41:   const dataStart = tagStart + AUTH_TAG_BYTES
42:   const key = scryptSync(passphrase, buffer.subarray(saltStart, ivStart), 32)
43:   const decipher = createDecipheriv("aes-256-gcm", key, buffer.subarray(ivStart, tagStart))
44:   decipher.setAuthTag(buffer.subarray(tagStart, dataStart))
45:   return Buffer.concat([decipher.update(buffer.subarray(dataStart)), decipher.final()]).toString("utf8")
46: }
47: 
48: export async function readEncryptedBackup(path, passphrase) {
49:   return decryptBackup(await readFile(path), passphrase)
50: }
51: 
52: export async function backupDatabase(db, directory, passphrase) {
53:   const requestedTarget = resolve(directory)
54:   if (isInsideRepository(requestedTarget)) {
55:     throw new Error(`O backup deve ficar fora do repositório: ${requestedTarget}`)
56:   }
57: 
58:   await mkdir(requestedTarget, { recursive: true, mode: 0o700 })
59:   const target = await realpath(requestedTarget)
60:   if (isInsideRepository(target)) {
61:     throw new Error(`O destino real do backup fica dentro do repositório: ${target}`)
62:   }
63:   await chmod(target, 0o700)
64:   if ((await readdir(target)).length > 0) {
65:     throw new Error(`O diretório de backup precisa estar vazio: ${target}`)
66:   }
67: 
68:   const collections = await db.listCollections().toArray()
69:   const manifest = { database: db.databaseName, createdAt: new Date().toISOString(), encrypted: true, collections: [] }
70:   for (const collectionInfo of collections) {
71:     const { name } = collectionInfo
72:     const documents = await db.collection(name).find({}).toArray()
73:     const contents = EJSON.stringify(documents, null, 2, { relaxed: false })
74:     const indexes = await db.collection(name).listIndexes().toArray().catch(() => [])
75:     const file = `${name}.ejson.enc`
76:     await writeFile(resolve(target, file), encryptBackup(contents, passphrase), { flag: "wx", mode: 0o600 })
77:     manifest.collections.push({
78:       name,
79:       file,
80:       documents: documents.length,
81:       sha256: createHash("sha256").update(contents).digest("hex"),
82:       options: collectionInfo.options ?? {},
83:       indexes,
84:     })
85:   }
86: 
87:   const manifestContents = EJSON.stringify(manifest, null, 2, { relaxed: false })
88:   await writeFile(
89:     resolve(target, "manifest.ejson.enc"),
90:     encryptBackup(manifestContents, passphrase),
91:     { flag: "wx", mode: 0o600 }
92:   )
93:   return { target, manifest }
94: }
</file>

