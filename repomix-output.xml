<file path="src/app/api/notes/[noteId]/view/route.ts">
 1: import { createHash } from "crypto"
 2: import { NextRequest, NextResponse } from "next/server"
 3: import { getAdminUserId, getAuthUser, isAdmin } from "@/lib/auth"
 4: import { getNote } from "@/lib/db/notes"
 5: import { recordNoteView } from "@/lib/db/note-metrics"
 6: import { aggregateNotification, createNotification } from "@/lib/admin-notifications"
 7: import { isNoteViewSource, NOTE_VIEW_TTL_MS } from "@/lib/note-views"
 8: import { noteDisplayTitle } from "@/lib/seo"
 9: import { rateLimit } from "@/lib/rate-limit"
10: import { requestIdentity } from "@/lib/request-identity"
11: import { viewRequestDetails } from "@/lib/view-request-details"
12: import type { ViewClientContext } from "@/lib/view-request-details"
13: import { isSameOriginRequest } from "@/lib/csrf"
14: import { siteDateKey } from "@/lib/datetime"
15: 
16: function visitorKey(req: NextRequest, noteId: string, source: string) {
17:   const day = siteDateKey()
18:   return createHash("sha256").update(`${day}\n${noteId}\n${source}\n${requestIdentity(req)}`).digest("hex")
19: }
20: 
21: function directCookieName(noteId: string) {
22:   return `note_viewed_${createHash("sha256").update(noteId).digest("hex").slice(0, 16)}`
23: }
24: 
25: export async function POST(req: NextRequest, { params }: { params: Promise<{ noteId: string }> }) {
26:   if (!isSameOriginRequest(req)) {
27:     return NextResponse.json({ counted: false }, { status: 403 })
28:   }
29:   const { noteId } = await params
30:   const body = await req.json().catch(() => null) as ({ source?: unknown } & ViewClientContext) | null
31:   if (!isNoteViewSource(body?.source)) return NextResponse.json({ error: "Origem inválida." }, { status: 400 })
32:   const source = body.source
33:   const note = await getNote(noteId)
34:   if (!note) return NextResponse.json({ error: "Nota não encontrada." }, { status: 404 })
35:   if (await isAdmin()) return NextResponse.json({ counted: false })
36: 
37:   const cookieName = directCookieName(noteId)
38:   if (source === "direct" && req.cookies.has(cookieName)) return NextResponse.json({ counted: false })
39:   const withinLimit = await rateLimit(
40:     `note-view:${source}:${requestIdentity(req)}`,
41:     { limit: source === "direct" ? 60 : 600, windowMs: 24 * 60 * 60_000 }
42:   )
43:   if (!withinLimit) return NextResponse.json({ counted: false }, { status: 429 })
44: 
45:   const result = await recordNoteView(noteId, visitorKey(req, noteId, source), source)
46:   if (source === "direct" && result.counted) {
47:     const [viewer, adminId] = await Promise.all([getAuthUser(), Promise.resolve(getAdminUserId())])
48:     if (adminId) {
49:       const title = note.title?.trim() || noteDisplayTitle(note)
50:       const details = viewRequestDetails(req, body ?? {})
51:       if (viewer) {
52:         await createNotification({
53:           recipientId: adminId,
54:           actorId: viewer.id,
55:           actorImageUrl: viewer.imageUrl,
56:           kind: "view",
57:           title: `${viewer.name} abriu uma nota`,
58:           description: `“${title}” recebeu uma view real · ${result.metrics.directViews} no total.`,
59:           href: `/notes/${noteId}`,
60:         }, "identified_note_views", details).catch(() => undefined)
61:       } else {
62:         await aggregateNotification({
63:           recipientId: adminId,
64:           kind: "view",
65:           aggregateKey: `note-view:${noteId}`,
66:           title: `Novas views reais em uma nota`,
67:           description: `“${title}” chegou a ${result.metrics.directViews} views reais.`,
68:           href: `/notes/${noteId}`,
69:         }, "anonymous_note_views", details).catch(() => undefined)
70:       }
71:     }
72:   }
73: 
74:   const response = NextResponse.json({ counted: result.counted })
75:   if (source === "direct") {
76:     response.cookies.set(cookieName, "1", {
77:       httpOnly: true,
78:       maxAge: NOTE_VIEW_TTL_MS / 1000,
79:       path: "/",
80:       sameSite: "lax",
81:       secure: process.env.NODE_ENV === "production",
82:     })
83:   }
84:   return response
85: }
</file>

<file path="src/app/api/site-visits/route.ts">
 1: import { createHash } from "node:crypto"
 2: import { after, NextRequest, NextResponse } from "next/server"
 3: import { getAdminUserId, getAuthUser, getAuthUserId } from "@/lib/auth"
 4: import { notifySiteVisit } from "@/lib/admin-notifications"
 5: import { getSiteVisitNotificationSettings } from "@/lib/db/notification-settings"
 6: import { claimOncePerWindow, rateLimit } from "@/lib/rate-limit"
 7: import { requestIdentity } from "@/lib/request-identity"
 8: import { viewRequestDetails, type ViewClientContext } from "@/lib/view-request-details"
 9: 
10: const VISIT_DEDUPLICATION_WINDOW_MS = 60 * 60_000
11: 
12: function validPublicPath(value: unknown): value is string {
13:   return typeof value === "string" && value.startsWith("/") && !value.startsWith("//") &&
14:     value.length <= 500 && value !== "/admin" && !value.startsWith("/admin/") &&
15:     value !== "/api" && !value.startsWith("/api/") && !value.startsWith("/_next/")
16: }
17: 
18: export async function POST(req: NextRequest) {
19:   const settings = await getSiteVisitNotificationSettings()
20:   if (!settings.pushEnabled && !settings.storeInHistory) return new Response(null, { status: 204 })
21:   const adminId = getAdminUserId()
22:   if (!adminId) return NextResponse.json({ error: "Admin user is not configured" }, { status: 503 })
23: 
24:   const body = await req.json().catch(() => null) as ({ path?: unknown } & ViewClientContext) | null
25:   const path = body?.path
26:   if (!validPublicPath(path)) {
27:     return NextResponse.json({ error: "Página inválida." }, { status: 400 })
28:   }
29: 
30:   const details = { ...viewRequestDetails(req, body ?? {}), page: path }
31:   if (details.trafficType === "Bot") return new Response(null, { status: 204 })
32: 
33:   const identity = requestIdentity(req)
34:   const [withinVisitorLimit, withinGlobalLimit, userId] = await Promise.all([
35:     rateLimit(`site-visit:${identity}`, { limit: 120, windowMs: 60 * 60_000 }),
36:     rateLimit("site-visit:global", { limit: 1_500, windowMs: 60 * 60_000 }),
37:     getAuthUserId(),
38:   ])
39:   if (!withinVisitorLimit || !withinGlobalLimit) {
40:     return NextResponse.json({ error: "Limite de visitas atingido." }, { status: 429 })
41:   }
42:   if (userId && userId === adminId) return new Response(null, { status: 204 })
43: 
44:   const pathHash = createHash("sha256").update(path).digest("hex").slice(0, 24)
45:   const clientVisitorId = typeof body?.visitorId === "string" && /^[a-f\d-]{36}$/i.test(body.visitorId)
46:     ? body.visitorId
47:     : null
48:   const visitor = userId
49:     ? `account:${userId}`
50:     : clientVisitorId
51:       ? `browser:${clientVisitorId}`
52:       : `network:${identity}`
53:   const visitHash = createHash("sha256").update(`${visitor}\n${path}`).digest("hex")
54:   const firstVisitInWindow = await claimOncePerWindow(
55:     `site-visit-page:${visitHash}`,
56:     VISIT_DEDUPLICATION_WINDOW_MS
57:   )
58:   if (!firstVisitInWindow) {
59:     return NextResponse.json({ received: true, deduplicated: true }, { status: 202 })
60:   }
61: 
62:   const viewer = userId ? await getAuthUser() : null
63:   const description = viewer
64:     ? `${viewer.name} abriu ${path}.`
65:     : `Uma pessoa abriu ${path}.`
66: 
67:   after(() => notifySiteVisit({
68:     data: {
69:       recipientId: adminId,
70:       kind: "site_visit",
71:       aggregateKey: `site-visit:${pathHash}`,
72:       title: viewer ? `${viewer.name} visitou o site` : "Nova visita no site",
73:       description,
74:       href: path,
75:     },
76:     occurrenceDetails: details,
77:     storeInHistory: settings.storeInHistory,
78:     sendPush: settings.pushEnabled,
79:   }).catch(() => undefined))
80: 
81:   return NextResponse.json({ received: true }, { status: 202 })
82: }
</file>

