11: 
12: export async function POST(req: NextRequest) {
13:   const unauthorized = await adminOnly()
14:   if (unauthorized) return unauthorized
15: 
16:   const body = await req.json().catch(() => null) as Record<string, unknown> | null
17:   if (!body) return NextResponse.json({ error: "JSON inválido" }, { status: 400 })
18:   if ("locale" in body && body.locale !== "pt") {
19:     return NextResponse.json({ error: "Salve primeiro a versão original em português." }, { status: 400 })
20:   }
21: 
22:   const title = asString(body.title, 180)
23:   const content = asString(body.content, 300_000)
24:   const slug = asSlug(body.slug)
25: 
26:   if (!title || !content || !slug) {
27:     return NextResponse.json({ error: "title, content e slug são obrigatórios" }, { status: 400 })
28:   }
29: 
30:   try {
31:     const seriesPublicId = asOptionalString(body.seriesPublicId, 80) ?? null
32:     if (seriesPublicId && !(await getSeriesByPublicId(seriesPublicId))) {
33:       return NextResponse.json({ error: "Série inválida." }, { status: 400 })
34:     }
35:     const cover = parsePostCover(body.cover)
36:     const post = await createPost({
37:       title,
38:       seoTitle: asOptionalString(body.seoTitle, 180),
39:       seoDescription: asOptionalString(body.seoDescription, 500),
40:       content,
41:       slug,
42:       excerpt: asOptionalString(body.excerpt, 500),
43:       subtitle: asOptionalString(body.subtitle, 500),
44:       cover,
45:       showCoverInTimeline: Boolean(cover) && body.showCoverInTimeline !== false,
46:       friendImage: asTrustedImageUrl(body.friendImage),
47:       coAuthorUserId: asOptionalString(body.coAuthorUserId, 120) ?? null,
48:       audioUrl: asHttpsUrl(body.audioUrl),
49:       background: parsePostBackground(body.background),
50:       tags: asStringArray(body.tags, 20, 40),
51:       sources: parsePostSources(body.sources),
52:       style: parsePostStyle(body.style, "standard"),
53:       hiddenFromTimeline: body.hiddenFromTimeline === true,
54:       published: body.published === true,
55:     })
56:     post.series = (await setSeriesForPost(post._id, seriesPublicId)) ?? undefined
57:     invalidatePublicContentCache()
58: 
59:     if (post.published) {
60:       if (!post.hiddenFromTimeline) after(() => notifyIndexNow([`/posts/${post.slug}`]))
61:       after(() => sendReaderPush({
62:         dedupeKey: `post:published:${post._id.toString()}:pt`,
63:         source: "automatic",
64:         topic: "posts",
65:         contentType: "post",
66:         contentId: post._id.toString(),
67:         title: post.series?.published ? `Novo capítulo de ${post.series.title}: ${post.title}` : `Novo post: ${post.title}`,
68:         body: post.excerpt?.trim() || descriptionFromMarkdown(post.content, 180),
69:         url: `/posts/${post.slug}`,
70:       }).catch(() => undefined))
71:     }
72: 
73:     return NextResponse.json(serializePost(post, { includeUnpublishedTranslations: true }), { status: 201 })
74:   } catch (err) {
75:     if (err instanceof Error && err.message.includes("duplicate key")) {
76:       return NextResponse.json({ error: "Slug ou publicId já existe." }, { status: 409 })
77:     }
78:     throw err
79:   }
80: }
