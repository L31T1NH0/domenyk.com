 7: const backupDirectory = process.argv.find((argument) => argument.startsWith("--backup-dir="))?.slice("--backup-dir=".length)
 8: const uri = process.env.MONGODB_URI
 9: if (!backupDirectory) throw new Error("Use --backup-dir=/caminho/do/backup.")
10: if (!uri) throw new Error("MONGODB_URI is not set")
11: const passphrase = backupPassphrase()
12: 
13: const originalPosts = EJSON.parse(
14:   await readEncryptedBackup(resolve(backupDirectory, "posts.ejson.enc"), passphrase),
15:   { relaxed: false }
16: )
17: const client = new MongoClient(uri)
18: try {
19:   await client.connect()
20:   const currentPosts = await client.db("blog").collection("posts").find({}).toArray()
21:   const currentById = new Map(currentPosts.map((post) => [post._id.toString(), post]))
22:   const differences = []
23: 
24:   for (const original of originalPosts) {
25:     const current = currentById.get(original._id.toString())
26:     if (!current) {
27:       differences.push({ id: original._id.toString(), reason: "ausente" })
28:       continue
29:     }
30:     const comparable = EJSON.parse(EJSON.stringify(current, null, 0, { relaxed: false }), { relaxed: false })
31:     if (!Object.hasOwn(original, "seoTitle")) delete comparable.seoTitle
32:     if (!Object.hasOwn(original, "seoDescription")) delete comparable.seoDescription
33:     for (const [locale, translation] of Object.entries(original.translations ?? {})) {
34:       const comparableTranslation = comparable.translations?.[locale]
35:       if (!comparableTranslation) continue
36:       if (!Object.hasOwn(translation, "seoTitle")) delete comparableTranslation.seoTitle
37:       if (!Object.hasOwn(translation, "seoDescription")) delete comparableTranslation.seoDescription
38:     }
39:     if (!isDeepStrictEqual(original, comparable)) {
40:       differences.push({ id: original._id.toString(), reason: "conteúdo divergente fora dos novos campos" })
41:     }
42:   }
43: 
44:   console.log(JSON.stringify({
45:     backupPosts: originalPosts.length,
46:     currentPosts: currentPosts.length,
47:     postsUnchangedOutsideAddedFields: differences.length === 0,
48:     differences,
49:   }, null, 2))
50:   if (differences.length > 0 || originalPosts.length !== currentPosts.length) process.exitCode = 1
51: } finally {
52:   await client.close()
53: }
