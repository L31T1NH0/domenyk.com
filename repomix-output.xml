<file path="src/lib/api/comment-abuse.ts">
 1: import "server-only"
 2: 
 3: import { NextRequest, NextResponse } from "next/server"
 4: import { commentAccountPolicy } from "@/lib/comment-policy"
 5: import { rateLimit } from "@/lib/rate-limit"
 6: import { requestIdentity } from "@/lib/request-identity"
 7: 
 8: type CommentUser = {
 9:   id: string
10:   emailVerified: boolean
11:   createdAt: Date
12: }
13: 
14: export async function enforceCommentPolicy(
15:   req: NextRequest,
16:   user: CommentUser,
17:   admin: boolean
18: ): Promise<NextResponse<{ error: string }> | null> {
19:   const policy = commentAccountPolicy({
20:     admin,
21:     emailVerified: user.emailVerified,
22:     createdAt: user.createdAt,
23:   })
24: 
25:   if (!policy.allowed) {
26:     const error = policy.reason === "email_unverified"
27:       ? "Confirme seu endereço de email antes de comentar."
28:       : "Contas novas podem comentar uma hora após o cadastro."
29:     return NextResponse.json({ error }, { status: 403 })
30:   }
31: 
32:   if (admin) return null
33: 
34:   const identity = requestIdentity(req)
35:   const minuteLimit = policy.newAccount ? 4 : 8
36:   const dailyLimit = policy.newAccount ? 10 : 30
37:   const checks = await Promise.all([
38:     rateLimit(`comment-global:user:${user.id}`, { limit: minuteLimit, windowMs: 60_000 }),
39:     rateLimit(`comment-global:ip:${identity}`, { limit: 20, windowMs: 60_000 }),
40:     rateLimit(`comment-daily:user:${user.id}`, { limit: dailyLimit, windowMs: 24 * 60 * 60_000 }),
41:     rateLimit(`comment-daily:ip:${identity}`, { limit: 80, windowMs: 24 * 60 * 60_000 }),
42:   ])
43: 
44:   if (checks.every(Boolean)) return null
45:   return NextResponse.json(
46:     { error: "Limite de comentários atingido. Tente novamente mais tarde." },
47:     { status: 429 }
48:   )
49: }
</file>

