 10: 
 11: const FALLBACK_DATE = new Date("2026-07-12T00:00:00.000Z")
 12: 
 13: export async function generateSitemaps() {
 14:   return getSitemapDescriptors()
 15: }
 16: 
 17: async function indexSitemap(): Promise<MetadataRoute.Sitemap> {
 18:   const [latestPostDate, notes] = await Promise.all([
 19:     getLatestPublishedPostUpdate(),
 20:     getIndexableNotes({ limit: 1 }),
 21:   ])
 22:   const latestNoteDate = notes[0] ? (notes[0].updatedAt ?? notes[0].createdAt) : undefined
 23:   const homeLastModified = [latestPostDate, latestNoteDate]
 24:     .filter((date): date is Date => Boolean(date))
 25:     .sort((a, b) => b.getTime() - a.getTime())[0] ?? FALLBACK_DATE
 26: 
 27:   return [
 28:     {
 29:       url: absoluteUrl("/"),
 30:       lastModified: homeLastModified,
 31:       changeFrequency: "daily",
 32:       priority: 1,
 33:     },
 34:     {
 35:       url: absoluteUrl(ARTICLE_COLLECTION_PATH),
 36:       lastModified: latestPostDate ?? FALLBACK_DATE,
 37:       changeFrequency: "weekly",
 38:       priority: 0.9,
 39:     },
 40:     {
