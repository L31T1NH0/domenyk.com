272: function remarkAuthorReferences(options: MarkdownRenderOptions = {}) {
273:   return (tree: MdastNode) => {
274:     visit(tree, "paragraph", (paragraph: MdastNode, _index, parent: MdastNode | undefined) => {
275:       if (parent?.type === "blockquote") return
276: 
277:       const children = paragraph.children ?? []
278:       const nextChildren: MdastNode[] = []
279:       let changed = false
280: 
281:       for (const child of children) {
282:         if (child.type !== "text" || typeof child.value !== "string") {
283:           nextChildren.push(child)
284:           continue
285:         }
286: 
287:         const segments: MdastNode[] = []
288:         let lastIndex = 0
289:         const matcher = new RegExp(AUTHOR_TOKEN_PATTERN.source, AUTHOR_TOKEN_PATTERN.flags)
290:         let match: RegExpExecArray | null
291: 
292:         while ((match = matcher.exec(child.value)) !== null) {
293:           const [token] = match
294:           const matchIndex = match.index
295: 
296:           if (matchIndex > lastIndex) {
297:             segments.push({ type: "text", value: child.value.slice(lastIndex, matchIndex) })
298:           }
299: 
300:           if (token === "@co-autor") {
301:             segments.push({
302:               type: "html",
303:               value: authorReferenceHtml("co-author", options.coAuthorImageUrl),
304:             })
305:           } else {
306:             segments.push({
307:               type: "html",
308:               value: authorReferenceHtml("author", options.authorImageUrl ?? DEFAULT_AUTHOR_IMAGE),
309:             })
310:           }
311: 
312:           lastIndex = matchIndex + token.length
313:           changed = true
314:         }
315: 
316:         if (lastIndex === 0) {
317:           nextChildren.push(child)
318:           continue
319:         }
320: 
321:         if (lastIndex < child.value.length) {
322:           segments.push({ type: "text", value: child.value.slice(lastIndex) })
323:         }
324: 
325:         nextChildren.push(...segments)
326:       }
327: 
328:       if (changed) paragraph.children = nextChildren
329:     })
330:   }
