105:   const sourceNoteId = stringValue(value.sourceNoteId, 100)
106:   const sourceRootId = stringValue(value.sourceRootId, 100)
107:   const originalContent = stringValue(value.originalContent)
108:   const originalFingerprint = stringValue(value.originalFingerprint, 100)
109:   const proposedContent = stringValue(value.proposedContent)
110:   const proposedFingerprint = stringValue(value.proposedFingerprint, 100)
111:   if (!sourceNoteId || !sourceRootId || originalContent === null || !originalFingerprint || proposedContent === null || !proposedFingerprint) return null
112:   if (typeof value.position !== "number" || !Number.isInteger(value.position) || value.position < 1) return null
113:   if (typeof value.changed !== "boolean") return null
114:   return {
115:     sourceNoteId,
116:     sourceRootId,
117:     position: value.position,
118:     originalContent,
119:     originalFingerprint,
120:     proposedContent,
121:     proposedFingerprint,
122:     changed: value.changed,
123:   }
124: }
125: 
126: export function validateEditorialImportBundle(value: unknown): EditorialImportBundle {
127:   if (!isRecord(value) || value.version !== 1 || value.kind !== "domenyk_editorial_import") {
128:     throw new Error("Pacote editorial inválido.")
129:   }
130:   if (value.safety && isRecord(value.safety) && value.safety.match !== "sha256(normalize(content))") {
131:     throw new Error("O pacote usa um método de correspondência incompatível.")
132:   }
133:   if (!Array.isArray(value.actions) || value.actions.length > 500) throw new Error("O pacote não contém uma lista de ações válida.")
134:   const actions: EditorialImportAction[] = []
135:   const actionIds = new Set<string>()
136:   for (const rawAction of value.actions) {
137:     if (!isRecord(rawAction)) throw new Error("Uma ação do pacote é inválida.")
138:     const editorialId = stringValue(rawAction.editorialId, 100)
139:     const title = stringValue(rawAction.title, 500)
140:     const decision = rawAction.decision
141:     const action = rawAction.action
142:     if (!editorialId || title === null || !["keep", "revise", "archive"].includes(String(decision)) || !["keep", "update", "archive"].includes(String(action))) {
143:       throw new Error("Uma ação do pacote contém campos inválidos.")
144:     }
145:     if (actionIds.has(editorialId)) throw new Error(`A unidade ${editorialId} aparece mais de uma vez.`)
146:     actionIds.add(editorialId)
147:     if (!Array.isArray(rawAction.parts) || rawAction.parts.length > 100) throw new Error(`A unidade ${editorialId} não contém partes válidas.`)
148:     const parts = rawAction.parts.map(parsePart)
149:     if (parts.some((part): part is null => part === null)) throw new Error(`A unidade ${editorialId} contém uma parte inválida.`)
150:     actions.push({
151:       editorialId,
152:       title,
153:       decision: decision as EditorialImportAction["decision"],
154:       action: action as EditorialImportAction["action"],
155:       parts: parts as EditorialImportPart[],
156:     })
157:   }
158:   return {
159:     version: 1,
160:     kind: "domenyk_editorial_import",
161:     generatedAt: stringValue(value.generatedAt, 100) ?? "",
162:     sourceRequest: stringValue(value.sourceRequest, 500) ?? "",
163:     source: stringValue(value.source, 500) ?? "",
164:     safety: {
165:       match: "sha256(normalize(content))",
166:       applyRequiresUniqueMatch: true,
167:       archiveDeletesMatchedNotes: true,
168:     },
169:     counts: isRecord(value.counts) ? {
170:       units: Number(value.counts.units) || 0,
171:       archive: Number(value.counts.archive) || 0,
172:       update: Number(value.counts.update) || 0,
173:       keep: Number(value.counts.keep) || 0,
174:     } : undefined,
175:     actions,
176:   }
177: }
178: 
179: async function getNoteCandidates(bundle: EditorialImportBundle) {
180:   const fingerprints = new Set(bundle.actions.flatMap((action) => action.parts.map((part) => part.originalFingerprint)))
181:   const notes = await (await getDb()).collection<Note>("notes").find({ deleting: { $ne: true } }).toArray()
182:   const byFingerprint = new Map<string, Note[]>()
183:   for (const note of notes) {
184:     const fingerprint = editorialImportFingerprint(normalizeNoteContent(note.content))
185:     if (!fingerprints.has(fingerprint)) continue
186:     const candidates = byFingerprint.get(fingerprint) ?? []
187:     candidates.push(note)
188:     byFingerprint.set(fingerprint, candidates)
189:   }
190:   return byFingerprint
191: }
192: 
193: async function buildPlan(bundle: EditorialImportBundle) {
194:   const byFingerprint = await getNoteCandidates(bundle)
195:   const claimed = new Set<string>()
196:   const items: PlanItem[] = []
197:   const operations: Array<{ action: EditorialImportAction; part: EditorialImportPart; note: Note }> = []
198:   for (const action of bundle.actions) {
199:     for (const part of action.parts) {
200:       if (action.action === "keep" || (action.action === "update" && !part.changed)) continue
201:       const candidates = byFingerprint.get(part.originalFingerprint) ?? []
202:       if (candidates.length === 0) {
203:         items.push({ editorialId: action.editorialId, title: action.title, action: action.action, position: part.position, sourceNoteId: part.sourceNoteId, status: "missing", detail: "Nenhuma nota do site possui esta impressão digital." })
204:         continue
205:       }
206:       if (candidates.length > 1) {
207:         items.push({ editorialId: action.editorialId, title: action.title, action: action.action, position: part.position, sourceNoteId: part.sourceNoteId, status: "ambiguous", detail: `${candidates.length} notas possuem o mesmo conteúdo.` })
208:         continue
209:       }
210:       const note = candidates[0]
211:       const noteId = note._id.toString()
212:       if (claimed.has(noteId)) {
213:         items.push({ editorialId: action.editorialId, title: action.title, action: action.action, position: part.position, sourceNoteId: part.sourceNoteId, status: "duplicate", noteId, detail: "A mesma nota foi apontada por mais de uma ação." })
214:         continue
215:       }
216:       claimed.add(noteId)
217:       const unchanged = action.action === "update" && editorialImportFingerprint(part.proposedContent) === part.originalFingerprint
218:       items.push({ editorialId: action.editorialId, title: action.title, action: action.action, position: part.position, sourceNoteId: part.sourceNoteId, status: unchanged ? "unchanged" : "matched", noteId, changed: !unchanged })
219:       operations.push({ action, part, note })
220:     }
221:   }
222:   return { items, operations }
223: }
224: 
225: export async function previewEditorialImport(bundle: EditorialImportBundle): Promise<EditorialImportPreview> {
226:   const { items } = await buildPlan(bundle)
227:   const counts = {
228:     units: bundle.actions.length,
229:     archive: items.filter((item) => item.action === "archive" && item.status === "matched").length,
230:     update: items.filter((item) => item.action === "update" && item.status === "matched").length,
231:     unchanged: items.filter((item) => item.status === "unchanged").length,
232:     missing: items.filter((item) => item.status === "missing").length,
233:     ambiguous: items.filter((item) => item.status === "ambiguous").length,
234:     duplicate: items.filter((item) => item.status === "duplicate").length,
235:   }
236:   return { ok: true, canApply: counts.missing === 0 && counts.ambiguous === 0 && counts.duplicate === 0, counts, items }
237: }
238: 
239: async function removeNoteAndChildren(noteId: string) {
240:   const marked = await markNoteDeleting(noteId)
241:   if (!marked) throw new Error("Uma nota do pacote não existe mais.")
242:   const comments = await getCommentsForParent(noteId)
243:   const contents = comments.map((comment) => comment.content)
244:   await queueCommentImagesForCleanup(contents)
245:   await deleteCommentsForParent(noteId)
246:   const result = await deleteNote(noteId)
247:   await deleteCommentImagesFromContents(contents)
248:   if (!result.deleted) throw new Error("Uma nota do pacote não pôde ser excluída.")
249: }
250: 
251: export async function applyEditorialImport(bundle: EditorialImportBundle) {
252:   const plan = await buildPlan(bundle)
253:   const blocked = plan.items.filter((item) => ["missing", "ambiguous", "duplicate"].includes(item.status))
254:   if (blocked.length) {
255:     const error = new Error("A importação foi bloqueada porque existem correspondências inseguras.")
256:     Object.assign(error, { code: "EDITORIAL_IMPORT_CONFLICT", blocked })
257:     throw error
258:   }
259:   const changedNoteIds: string[] = []
260:   for (const { action, part, note } of plan.operations) {
261:     const noteId = note._id.toString()
262:     if (action.action === "archive") {
263:       await removeNoteAndChildren(noteId)
264:       changedNoteIds.push(noteId)
265:       continue
266:     }
267:     const updated = await updateNote(noteId, { content: part.proposedContent })
268:     if (!updated) throw new Error("Uma nota do pacote não pôde ser atualizada.")
269:     changedNoteIds.push(noteId)
270:   }
271:   return { changedNoteIds }
272: }
</file>

<file path="src/lib/editorial-text.js">
 1: export const TEXT_SIZES = ["auto", "14", "16", "18", "20", "24", "28", "32", "40"]
 2: export const TEXT_LEADING = ["auto", "1.2", "1.4", "1.6", "1.8", "2"]
 3: export const TEXT_SPACING = ["auto", "0", "8", "16", "24", "32"]
 4: export const TEXT_TONES = ["none", "neutral", "sand", "rose", "blue"]
 5: export const TEXT_ALIGN = ["left", "center", "right", "justify"]
 6: 
 7: /** @typedef {{ align: string, size: string, leading: string, spacing: string, tone: string }} EditorialText */
 8: /** @type {EditorialText} */
 9: export const DEFAULT_EDITORIAL_TEXT = { align: "left", size: "auto", leading: "auto", spacing: "auto", tone: "none" }
10: 
11: /** @param {Partial<EditorialText>} value @returns {EditorialText} */
12: export function normalizeEditorialText(value) {
13:   /** @param {readonly string[]} options @param {string | undefined} candidate @param {string} fallback */
14:   const allowed = (options, candidate, fallback) => candidate && options.includes(candidate) ? candidate : fallback
15:   return {
16:     align: allowed(TEXT_ALIGN, value.align, "left"),
17:     size: allowed(TEXT_SIZES, value.size, "auto"),
18:     leading: allowed(TEXT_LEADING, value.leading, "auto"),
19:     spacing: allowed(TEXT_SPACING, value.spacing, "auto"),
20:     tone: allowed(TEXT_TONES, value.tone, "none"),
21:   }
22: }
23: 
24: /** @param {Partial<EditorialText>} value */
25: export function editorialTextStyle(value) {
26:   const p = normalizeEditorialText(value)
27:   return [
28:     p.size !== "auto" && `font-size: min(${p.size}px, 8vw)`,
29:     p.leading !== "auto" && `line-height: ${p.leading}`,
30:     p.spacing !== "auto" && `margin-bottom: ${p.spacing}px`,
31:     p.tone !== "none" && `background-color: var(--editorial-tone-${p.tone})`,
32:     p.tone !== "none" && "padding: 1em",
33:   ].filter(Boolean).join("; ")
34: }
35: 
36: /** @param {string} style @param {string} align @returns {EditorialText} */
37: export function editorialTextFromStyle(style, align) {
38:   return normalizeEditorialText({
39:     align,
40:     size: style.match(/font-size:\s*min\((\d+)px/)?.[1],
41:     leading: style.match(/line-height:\s*([\d.]+)/)?.[1],
42:     spacing: style.match(/margin-bottom:\s*(\d+)px/)?.[1],
43:     tone: style.match(/--editorial-tone-(\w+)/)?.[1],
44:   })
45: }
