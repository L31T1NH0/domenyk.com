246: export type SerializedMediaItem = Omit<MediaItem, "uploadedAt"> & { uploadedAt: string }
247: 
248: export function serializeMediaItem(item: MediaItem): SerializedMediaItem {
249:   return { ...item, uploadedAt: item.uploadedAt.toISOString() }
250: }
251: 
252: export async function listMedia(): Promise<MediaItem[]> {
253:   const media: MediaItem[] = []
254:   let cursor: string | undefined
255: 
256:   do {
257:     const page = await list({ ...blobAuthOptions(), prefix: "media/", cursor, limit: 1_000 })
258:     media.push(...page.blobs.map((blob) => ({
259:       url: blob.url,
260:       pathname: blob.pathname,
261:       size: blob.size,
262:       uploadedAt: blob.uploadedAt,
263:       contentType: blob.pathname.toLocaleLowerCase("en-US").endsWith(".svg")
264:         ? "image/svg+xml"
265:         : "image/webp",
266:     })))
267: 
268:     if (!page.hasMore) break
269:     if (!page.cursor || page.cursor === cursor) {
270:       throw new Error("Invalid cursor returned while listing media")
271:     }
272:     cursor = page.cursor
273:   } while (true)
274: 
275:   return media
276: }
