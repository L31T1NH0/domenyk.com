 33:   const tag = node.tagName.toLowerCase()
 34:   if (tag === "strong" || tag === "b") return content.trim() ? `**${content.trim()}**` : ""
 35:   if (tag === "em" || tag === "i") return content.trim() ? `*${content.trim()}*` : ""
 36:   if (tag === "code") return content.trim() ? `\`${content.trim().replace(/`/g, "\\`")}\`` : ""
 37:   if (tag === "a") {
 38:     const href = node.getAttribute("href")
 39:     return href && content.trim() ? `[${content.trim()}](${href})` : content
 40:   }
 41:   if (tag === "br") return "\n"
 42:   return content
 43: }
 44: 
 45: function prefixLines(value: string, prefix: string) {
 46:   return value.split("\n").map((line) => `${prefix}${line}`).join("\n")
 47: }
 48: 
 49: function serializeBlockNode(node: Node, listIndex?: number): string {
 50:   if (node.nodeType === Node.TEXT_NODE) return escapeMarkdownText(node.textContent ?? "")
 51:   if (!(node instanceof HTMLElement)) return ""
 52: 
 53:   const tag = node.tagName.toLowerCase()
 54:   if (tag === "ul" || tag === "ol") {
 55:     return Array.from(node.children)
 56:       .filter((child) => child.tagName.toLowerCase() === "li")
 57:       .map((child, index) => serializeBlockNode(child, tag === "ol" ? index + 1 : undefined))
 58:       .filter(Boolean)
 59:       .join("\n")
 60:   }
 61:   if (tag === "li") {
 62:     const content = Array.from(node.childNodes).map(serializeInlineNode).join("").trim()
 63:     return content ? `${listIndex ? `${listIndex}.` : "-"} ${content}` : ""
 64:   }
 65: 
 66:   const content = Array.from(node.childNodes).map(serializeInlineNode).join("").trim()
 67:   if (!content) return ""
 68:   if (/^h[1-6]$/.test(tag)) return `${"#".repeat(Number(tag[1]))} ${content}`
 69:   if (tag === "blockquote") return prefixLines(content, "> ")
 70:   return content
 71: }
 72: 
 73: function selectionAsMarkdown(range: Range) {
 74:   const fragment = range.cloneContents()
 75:   const container = document.createElement("div")
 76:   container.append(fragment)
 77:   const blockSelector = "p,h1,h2,h3,h4,h5,h6,blockquote,ul,ol,pre"
 78:   const topLevelBlocks = Array.from(container.querySelectorAll<HTMLElement>(blockSelector))
 79:     .filter((element) => !element.parentElement?.closest(blockSelector))
 80: 
 81:   const markdown = topLevelBlocks.length > 0
 82:     ? topLevelBlocks.map((element) => serializeBlockNode(element)).filter(Boolean).join("\n\n")
 83:     : Array.from(container.childNodes).map(serializeBlockNode).join("")
 84: 
 85:   return markdown.replace(/[ \t]+\n/g, "\n").replace(/\n{3,}/g, "\n\n").trim()
 86: }
 87: 
 88: export function PostSelectionNoteGenerator({
 89:   postPath,
 90:   postTitle,
 91: }: {
 92:   postPath: string
 93:   postTitle: string
 94: }) {
 95:   const router = useRouter()
 96:   const dropdownRef = useRef<HTMLDivElement>(null)
 97:   const actionRef = useRef<HTMLButtonElement>(null)
 98:   const selectionTimerRef = useRef<ReturnType<typeof setTimeout> | null>(null)
 99:   const [excerpt, setExcerpt] = useState("")
100:   const [selectedContent, setSelectedContent] = useState("")
101:   const [position, setPosition] = useState<DropdownPosition | null>(null)
102:   const [submitting, setSubmitting] = useState(false)
103:   const [error, setError] = useState("")
104: 
105:   const close = useCallback(() => {
106:     if (submitting) return
107:     setPosition(null)
108:     setExcerpt("")
109:     setSelectedContent("")
110:     setError("")
111:     window.getSelection()?.removeAllRanges()
112:   }, [submitting])
113: 
114:   const readSelection = useCallback((focusAction = false) => {
115:     const selection = window.getSelection()
116:     if (!selection || selection.isCollapsed || selection.rangeCount === 0) return
117: 
118:     const range = selection.getRangeAt(0)
119:     const start = range.startContainer.nodeType === Node.ELEMENT_NODE
120:       ? range.startContainer as Element
121:       : range.startContainer.parentElement
122:     const end = range.endContainer.nodeType === Node.ELEMENT_NODE
123:       ? range.endContainer as Element
124:       : range.endContainer.parentElement
125:     const content = start?.closest("[data-post-content]")
126: 
127:     if (!content || !end || !content.contains(end)) return
128: 
129:     const selectedText = selection.toString().replace(/\s+/g, " ").trim()
130:     const markdown = selectionAsMarkdown(range)
131:     const selectionRect = range.getBoundingClientRect()
132:     if (!selectedText || !markdown || (selectionRect.width === 0 && selectionRect.height === 0)) return
133: 
134:     const availableWidth = Math.min(DROPDOWN_WIDTH, window.innerWidth - VIEWPORT_MARGIN * 2)
135:     const centeredLeft = selectionRect.left + selectionRect.width / 2 - availableWidth / 2
136:     const left = Math.min(
137:       window.innerWidth - availableWidth - VIEWPORT_MARGIN,
138:       Math.max(VIEWPORT_MARGIN, centeredLeft)
139:     )
140:     const above = selectionRect.bottom + DROPDOWN_ESTIMATED_HEIGHT + VIEWPORT_MARGIN > window.innerHeight
141: 
142:     setExcerpt(selectedText)
143:     setSelectedContent(markdown)
144:     setError(markdown.length > MAX_GENERATED_NOTE_LENGTH ? "Selecione um trecho menor para gerar a nota." : "")
145:     setPosition({
146:       left,
147:       top: above ? Math.max(VIEWPORT_MARGIN, selectionRect.top - 8) : selectionRect.bottom + 8,
148:       above,
149:     })
150: 
151:     if (focusAction) requestAnimationFrame(() => actionRef.current?.focus())
152:   }, [])
153: 
154:   useEffect(() => {
155:     const handlePointerUp = () => window.setTimeout(() => readSelection(), 0)
156:     const handleKeyUp = (event: globalThis.KeyboardEvent) => {
157:       if (event.key === "Shift" || event.shiftKey) readSelection(true)
158:     }
159:     const handleSelectionChange = () => {
160:       if (selectionTimerRef.current) clearTimeout(selectionTimerRef.current)
161:       selectionTimerRef.current = setTimeout(() => readSelection(), 500)
162:     }
163: 
164:     document.addEventListener("pointerup", handlePointerUp)
165:     document.addEventListener("keyup", handleKeyUp)
166:     document.addEventListener("selectionchange", handleSelectionChange)
167:     return () => {
168:       document.removeEventListener("pointerup", handlePointerUp)
169:       document.removeEventListener("keyup", handleKeyUp)
170:       document.removeEventListener("selectionchange", handleSelectionChange)
171:       if (selectionTimerRef.current) clearTimeout(selectionTimerRef.current)
172:     }
173:   }, [readSelection])
174: 
175:   useEffect(() => {
176:     if (!position) return
177: 
178:     const handlePointerDown = (event: PointerEvent) => {
179:       if (!dropdownRef.current?.contains(event.target as Node)) close()
180:     }
181:     const handleKeyDown = (event: globalThis.KeyboardEvent) => {
182:       if (event.key !== "Escape") return
183:       event.preventDefault()
184:       close()
185:     }
186:     const handleViewportChange = () => close()
187: 
188:     document.addEventListener("pointerdown", handlePointerDown)
189:     document.addEventListener("keydown", handleKeyDown)
190:     window.addEventListener("scroll", handleViewportChange, true)
191:     window.addEventListener("resize", handleViewportChange)
192:     return () => {
193:       document.removeEventListener("pointerdown", handlePointerDown)
194:       document.removeEventListener("keydown", handleKeyDown)
195:       window.removeEventListener("scroll", handleViewportChange, true)
196:       window.removeEventListener("resize", handleViewportChange)
197:     }
198:   }, [close, position])
199: 
200:   async function publish() {
201:     if (!selectedContent || selectedContent.length > MAX_GENERATED_NOTE_LENGTH || submitting) return
202:     setSubmitting(true)
203:     setError("")
204: 
205:     try {
206:       const sourceLabel = `Continuar lendo: ${escapeMarkdownText(postTitle)}`
207:       const content = `${selectedContent}\n\n[${sourceLabel}](${postPath})`
208:       const response = await fetch("/api/admin/notes", {
209:         method: "POST",
210:         headers: { "Content-Type": "application/json" },
211:         body: JSON.stringify({ content }),
212:       })
213:       const data = await response.json().catch(() => null) as (CreatedNote & { error?: string }) | null
214:       if (!response.ok || !data?._id) {
215:         throw new Error(data?.error ?? "Não foi possível publicar a nota.")
216:       }
217: 
218:       setPosition(null)
219:       router.push(`/notes/${data._id}`)
220:     } catch (caughtError) {
221:       setError(caughtError instanceof Error ? caughtError.message : "Não foi possível publicar a nota.")
222:       setSubmitting(false)
223:     }
224:   }
225: 
226:   if (!position) return null
227: 
228:   return (
229:     <div
230:       ref={dropdownRef}
231:       role="dialog"
232:       aria-label="Gerar nota a partir do trecho selecionado"
233:       className="fixed z-[70] w-[min(18rem,calc(100vw-1.5rem))] rounded-[10px] border border-neutral-200 bg-white p-1.5 text-neutral-950 shadow-[0_4px_8px_rgb(0_0_0_/_0.12)] dark:border-white/10 dark:bg-[#0b0b0b] dark:text-[#f1f1f1] dark:shadow-[0_4px_8px_rgb(0_0_0_/_0.45)]"
234:       style={{
235:         left: position.left,
236:         top: position.top,
237:         transform: position.above ? "translateY(-100%)" : undefined,
238:       }}
239:     >
240:       <blockquote className="line-clamp-3 border-l border-[#E00070] px-2.5 py-1.5 text-xs leading-[1.5] text-neutral-600 dark:text-[#A8A095]">
241:         {excerpt}
242:       </blockquote>
243:       {error && <p role="alert" className="px-2.5 py-1.5 text-xs leading-5 text-red-700 dark:text-red-400">{error}</p>}
244:       <button
245:         ref={actionRef}
246:         type="button"
247:         onClick={() => void publish()}
248:         disabled={submitting || selectedContent.length > MAX_GENERATED_NOTE_LENGTH}
249:         className="mt-1 flex min-h-10 w-full items-center gap-2.5 rounded-md px-2.5 text-left text-[13px] font-medium text-neutral-700 outline-none transition-colors hover:bg-neutral-100 hover:text-neutral-950 focus-visible:bg-neutral-100 focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-neutral-500 disabled:cursor-wait disabled:opacity-50 dark:text-[#d8d4ce] dark:hover:bg-white/[0.07] dark:hover:text-[#f1f1f1] dark:focus-visible:bg-white/[0.07] dark:focus-visible:ring-neutral-300"
250:       >
251:         <DocumentPlusIcon className="size-4 shrink-0" aria-hidden />
252:         {submitting ? "Gerando nota…" : "Gerar nota"}
253:       </button>
254:     </div>
255:   )
256: }
</file>

