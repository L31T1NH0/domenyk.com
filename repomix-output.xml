  3: import { ArrowUpIcon, XMarkIcon } from "@heroicons/react/24/solid"
  4: import { useCallback, useEffect, useRef, useState } from "react"
  5: import {
  6:   getMinimumRestorableOffset,
  7:   isRestorableReadingPosition,
  8:   POST_READING_POSITION_SKIP_RESTORE_KEY,
  9:   POST_READING_POSITION_STORAGE_PREFIX,
 10:   READING_COMPLETION_THRESHOLD,
 11: } from "@/lib/post-reading-position"
 12: 
 13: type Props = {
 14:   postId: string
 15:   updatedAt: string
 16: }
 17: 
 18: type SavedPosition = {
 19:   contentOffset: number
 20:   progress: number
 21:   updatedAt: string
 22:   savedAt: number
 23: }
 24: 
 25: const maxAgeMs = 1000 * 60 * 60 * 24 * 90
 26: const skipRestoreMaxAgeMs = 15_000
 27: 
 28: function getStorageKey(postId: string) {
 29:   return `${POST_READING_POSITION_STORAGE_PREFIX}${postId}`
 30: }
 31: 
 32: function getContentMetrics(content: HTMLElement) {
 33:   const contentTop = content.getBoundingClientRect().top + window.scrollY
 34:   const totalScrollable = Math.max(content.scrollHeight - window.innerHeight, 1)
 35:   const contentOffset = Math.max(0, window.scrollY - contentTop)
 36:   const progress = Math.min(1, Math.max(0, contentOffset / totalScrollable))
 37: 
 38:   return { contentTop, contentOffset, progress, totalScrollable }
 39: }
 40: 
 41: function readSavedPosition(key: string, updatedAt: string): SavedPosition | null {
 42:   try {
 43:     const raw = window.localStorage.getItem(key)
 44:     if (!raw) return null
 45: 
 46:     const saved = JSON.parse(raw) as Partial<SavedPosition>
 47:     if (
 48:       typeof saved.contentOffset !== "number" ||
 49:       typeof saved.progress !== "number" ||
 50:       typeof saved.savedAt !== "number" ||
 51:       saved.updatedAt !== updatedAt ||
 52:       Date.now() - saved.savedAt > maxAgeMs
 53:     ) {
 54:       window.localStorage.removeItem(key)
 55:       return null
 56:     }
 57: 
 58:     return saved as SavedPosition
 59:   } catch {
 60:     window.localStorage.removeItem(key)
 61:     return null
 62:   }
 63: }
 64: 
 65: function consumeSkipRestoreMarker() {
 66:   try {
 67:     const raw = window.sessionStorage.getItem(POST_READING_POSITION_SKIP_RESTORE_KEY)
 68:     if (!raw) return false
 69: 
 70:     window.sessionStorage.removeItem(POST_READING_POSITION_SKIP_RESTORE_KEY)
 71:     const marker = JSON.parse(raw) as { destination?: unknown; markedAt?: unknown }
 72:     const destination = `${window.location.pathname}${window.location.search}`
 73: 
 74:     return marker.destination === destination
 75:       && typeof marker.markedAt === "number"
 76:       && Date.now() - marker.markedAt <= skipRestoreMaxAgeMs
 77:   } catch {
 78:     try {
 79:       window.sessionStorage.removeItem(POST_READING_POSITION_SKIP_RESTORE_KEY)
 80:     } catch {
 81:       // Session storage is unavailable; there is no marker to consume.
 82:     }
 83:     return false
 84:   }
 85: }
 86: 
 87: export function PostReadingPosition({ postId, updatedAt }: Props) {
 88:   const [restored, setRestored] = useState(false)
 89:   const noticeTimerRef = useRef<number | null>(null)
 90:   const lastPositionRef = useRef<SavedPosition | null>(null)
 91:   const suppressSavesRef = useRef(false)
 92:   const suppressSavesTimerRef = useRef<number | null>(null)
 93: 
 94:   const clearNoticeTimer = useCallback(() => {
 95:     if (!noticeTimerRef.current) return
 96:     window.clearTimeout(noticeTimerRef.current)
 97:     noticeTimerRef.current = null
 98:   }, [])
 99: 
100:   const startNoticeTimer = useCallback(() => {
101:     clearNoticeTimer()
102:     noticeTimerRef.current = window.setTimeout(() => {
103:       setRestored(false)
104:       noticeTimerRef.current = null
105:     }, 8000)
106:   }, [clearNoticeTimer])
107: 
108:   useEffect(() => {
109:     const content = document.querySelector<HTMLElement>("[data-post-content]")
110:     if (!content) return
111: 
112:     const key = getStorageKey(postId)
113:     const clearSavedPosition = () => {
114:       lastPositionRef.current = null
115:       try {
116:         window.localStorage.removeItem(key)
117:       } catch {
118:         // Storage can be unavailable in private contexts; reading should continue normally.
119:       }
120:     }
121: 
122:     const skipRestore = consumeSkipRestoreMarker()
123:     if (skipRestore) clearSavedPosition()
124:     const saved = window.location.hash || skipRestore ? null : readSavedPosition(key, updatedAt)
125:     lastPositionRef.current = saved
126:     let saveFrame = 0
127:     let restoreFrame = 0
128:     let restoreTimer: number | null = null
129: 
130:     const restore = () => {
131:       if (!saved) return
132:       if (!isRestorableReadingPosition(saved, window.innerHeight)) {
133:         clearSavedPosition()
134:         return
135:       }
136: 
137:       const { contentTop, totalScrollable } = getContentMetrics(content)
138:       const offset = Math.min(saved.contentOffset, totalScrollable)
139:       window.scrollTo({ top: Math.max(0, contentTop + offset), behavior: "auto" })
140:       setRestored(true)
141:       startNoticeTimer()
142:     }
143: 
144:     const scheduleRestore = () => {
145:       restoreFrame = window.requestAnimationFrame(() => {
146:         restoreFrame = window.requestAnimationFrame(() => {
147:           restoreFrame = 0
148:           restore()
149:         })
150:       })
151:     }
152: 
153:     const writePosition = (value: SavedPosition) => {
154:       try {
155:         window.localStorage.setItem(key, JSON.stringify(value))
156:       } catch {
157:         // Storage can be unavailable in private contexts; reading should continue normally.
158:       }
159:     }
160: 
161:     const save = () => {
162:       saveFrame = 0
163:       if (suppressSavesRef.current) return
164: 
165:       const { contentOffset, progress } = getContentMetrics(content)
166:       const minimumOffset = getMinimumRestorableOffset(window.innerHeight)
167: 
168:       if (contentOffset < minimumOffset || progress >= READING_COMPLETION_THRESHOLD) {
169:         clearSavedPosition()
170:         return
171:       }
172: 
173:       if (isRestorableReadingPosition({ contentOffset, progress }, window.innerHeight)) {
174:         const value: SavedPosition = {
175:           contentOffset,
176:           progress,
177:           updatedAt,
178:           savedAt: Date.now(),
179:         }
180: 
181:         lastPositionRef.current = value
182:         writePosition(value)
183:       }
184:     }
185: 
186:     const requestSave = () => {
187:       if (saveFrame) return
188:       saveFrame = window.requestAnimationFrame(save)
189:     }
190: 
191:     const saveBeforeNavigation = (event: MouseEvent) => {
192:       const target = event.target instanceof Element ? event.target.closest("a") : null
193:       if (target) save()
194:     }
195: 
196:     scheduleRestore()
197:     restoreTimer = window.setTimeout(restore, 700)
198:     window.addEventListener("scroll", requestSave, { passive: true })
199:     window.addEventListener("resize", requestSave)
200:     window.addEventListener("pagehide", save)
201:     document.addEventListener("click", saveBeforeNavigation, { capture: true })
202: 
203:     return () => {
204:       window.removeEventListener("scroll", requestSave)
205:       window.removeEventListener("resize", requestSave)
206:       window.removeEventListener("pagehide", save)
207:       document.removeEventListener("click", saveBeforeNavigation, { capture: true })
208:       if (saveFrame) window.cancelAnimationFrame(saveFrame)
209:       if (restoreFrame) window.cancelAnimationFrame(restoreFrame)
210:       if (restoreTimer) window.clearTimeout(restoreTimer)
211:       if (suppressSavesTimerRef.current) window.clearTimeout(suppressSavesTimerRef.current)
212:       clearNoticeTimer()
213:       save()
214:     }
215:   }, [clearNoticeTimer, postId, startNoticeTimer, updatedAt])
216: 
217:   const returnToStart = () => {
218:     suppressSavesRef.current = true
219:     lastPositionRef.current = null
220:     if (suppressSavesTimerRef.current) window.clearTimeout(suppressSavesTimerRef.current)
221:     suppressSavesTimerRef.current = window.setTimeout(() => {
222:       suppressSavesRef.current = false
223:       suppressSavesTimerRef.current = null
224:     }, 1000)
225: 
226:     try {
227:       window.localStorage.removeItem(getStorageKey(postId))
228:     } catch {
229:       // Ignore unavailable local storage; the scroll action is the important part.
230:     }
231:     setRestored(false)
232:     window.scrollTo({ top: 0, behavior: "smooth" })
233:   }
234: 
235:   if (!restored) return null
236: 
237:   return (
238:     <div
239:       aria-live="polite"
240:       className="fixed inset-x-0 bottom-4 z-[60] flex justify-center px-4 sm:bottom-5"
241:     >
242:       <div
243:         onMouseEnter={clearNoticeTimer}
244:         onMouseLeave={startNoticeTimer}
245:         onFocus={clearNoticeTimer}
246:         onBlur={startNoticeTimer}
247:         className="flex max-w-[calc(100vw-2rem)] items-center gap-2 rounded-md border border-zinc-200 bg-white px-3 py-2 text-sm text-zinc-800 shadow-sm dark:border-zinc-800 dark:bg-zinc-950 dark:text-zinc-200 sm:max-w-sm"
248:       >
249:         <span className="min-w-0 truncate">Você voltou de onde parou</span>
250:         <button
251:           type="button"
252:           onClick={returnToStart}
253:           className="inline-flex h-7 shrink-0 items-center gap-1 rounded-md px-2 text-xs font-semibold text-[#C00060] transition hover:bg-zinc-100 hover:text-[#E00070] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#E00070] dark:text-[#ff4aa3] dark:hover:bg-white/10 dark:hover:text-[#ff7abd]"
254:         >
255:           <ArrowUpIcon className="h-3.5 w-3.5" aria-hidden />
256:           Topo
257:         </button>
258:         <button
259:           type="button"
260:           aria-label="Fechar aviso"
261:           onClick={() => setRestored(false)}
262:           className="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md text-zinc-500 transition hover:bg-zinc-100 hover:text-zinc-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#E00070] dark:text-zinc-500 dark:hover:bg-white/10 dark:hover:text-white"
263:         >
264:           <XMarkIcon className="h-4 w-4" aria-hidden />
265:         </button>
266:       </div>
267:     </div>
268:   )
269: }
