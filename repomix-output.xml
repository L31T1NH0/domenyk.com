<file path="src/lib/quiz/calculate.server.ts">
 1: import "server-only"
 2: import { DIMENSIONS, QUIZ_VERSION, type Answer, type Dimension, type QuizResult } from "./types"
 3: import { QUESTIONS, isAnswer } from "./questions"
 4: import { WEIGHTS } from "./weights.server"
 5: import { IDEOLOGIES } from "./ideologies"
 6: import { compareAnswers } from "./consistency"
 7: const round = (n: number) => Math.round(n * 10) / 10
 8: export function validateAnswers(input: unknown): input is Answer[] {
 9:   return Array.isArray(input) && input.length === QUESTIONS.length && input.every(isAnswer)
10: }
11: export function calculate(answers: Answer[]): QuizResult {
12:   if (!validateAnswers(answers)) throw new Error("Responda às 60 perguntas com uma resposta válida.")
13:   const dimensionKeys = Object.keys(DIMENSIONS) as Dimension[]
14:   function score(key: Dimension | "x" | "y") {
15:     let numerator = 0, used = 0, total = 0
16:     WEIGHTS.forEach((weights,i) => {
17:       const weight = weights[key] ?? 0
18:       total += Math.abs(weight)
19:       if (typeof answers[i] === "number") {
20:         numerator += (answers[i] as number) / 3 * weight
21:         used += Math.abs(weight)
22:       }
23:     })
24:     return {value:used ? round(10 * numerator / used) : null,coverage:total ? Math.round(100 * used / total) : 0}
25:   }
26:   const sx = score("x"), sy = score("y")
27:   const dimensions = Object.fromEntries(dimensionKeys.map(key => [key,score(key).value])) as QuizResult["dimensions"]
28:   const coverage = Math.round(100 * answers.slice(0,52).filter(a => typeof a === "number").length / 52)
29:   const enough = sx.coverage >= 50 && sy.coverage >= 50 && coverage >= 60
30:   const distances = IDEOLOGIES.map(profile => {
31:     const diffs = dimensionKeys.filter(key => dimensions[key] !== null).map(key => (dimensions[key]! - profile.dimensions[key]) ** 2)
32:     if (sx.value !== null) diffs.push((sx.value-profile.x)**2)
33:     if (sy.value !== null) diffs.push((sy.value-profile.y)**2)
34:     return { name:profile.name,distance:Math.sqrt(diffs.reduce((s,d)=>s+d,0)/Math.max(1,diffs.length)) }
35:   }).sort((a,b)=>a.distance-b.distance)
36:   const symmetryAnswers = [answers[56], answers[57], answers[58]]
37:   const symmetryMeasured = symmetryAnswers.flatMap((a,i) => typeof a === "number" ? [(a * (i === 1 ? -1 : 1) + 3) / 6 * 100] : [])
38:   const {consistency,comparisons} = compareAnswers(answers)
39:   const x = sx.value, y = sy.value
40:   const quadrant = x === null || y === null ? "Dados insuficientes" : Math.abs(x)<1 && Math.abs(y)<1 ? "Região central" : `${Math.abs(x)<1 ? "Economia mista" : x>0 ? "Direita econômica" : "Esquerda econômica"} · ${Math.abs(y)<1 ? "posição intermediária em autoridade" : y>0 ? "inclinação à autoridade" : "inclinação à liberdade"}`
41:   const statements = [
42:     !enough ? "Há poucas respostas posicionais para uma comparação confiável com os perfis de referência." : "Seu resultado combina preferências econômicas, liberdades civis e escolhas institucionais; o quadrante não determina uma ideologia.",
43:     x === null ? "O eixo econômico não pôde ser calculado." : x>3 ? "Você tende a preferir autonomia privada e coordenação por mercado." : x< -3 ? "Você tende a preferir coordenação política da economia e redistribuição." : "Suas posições econômicas são intermediárias ou combinam os dois polos.",
44:     y === null ? "O eixo de autoridade não pôde ser calculado." : y< -3 ? "Você tende a limitar a coerção e preservar a autonomia individual." : y>3 ? "Você aceita mais instrumentos de coerção e concentração de poder." : "Suas respostas sobre autoridade variam entre autonomia e controle.",
45:     dimensions.PU !== null && dimensions.PU > 3 && y !== null && y < -2 ? "Na segurança, suas respostas são mais punitivas que sua preferência geral por liberdade." : "",
46:     "Os pesos e perfis da v0.1 são hipóteses editoriais, ainda sem validação empírica. Os indicadores não medem inteligência, mérito ou correção política.",
47:   ].filter(Boolean)
48:   return {quiz_version:QUIZ_VERSION,answers:[...answers],x,y,dimensions,consistency,symmetry:symmetryMeasured.length < 2 ? null : Math.round(symmetryMeasured.reduce((s,n)=>s+n,0)/symmetryMeasured.length),coverage,conditional:answers.filter(a=>a==="depends").length,diagnosticCoverage:Math.round(100*answers.slice(52).filter(a=>typeof a==="number").length/8),axisCoverage:{x:sx.coverage,y:sy.coverage},comparisons,closest_profile:!enough ? "Dados insuficientes" : distances[0].distance>4 ? "Híbrido" : distances[0].name,nearby_profiles:enough ? distances.slice(0,3).map(p=>p.name) : [],quadrant,description:statements.join(" "),created_at:new Date().toISOString()}
49: }
</file>

<file path="src/lib/quiz/consistency.ts">
 1: import type { Answer } from "./types"
 2: export const COMPARISONS = [
 3:   {a:3,b:4,sign:-1,label:"Expressão e criminalização",relationship:"negativa",tolerance:2},
 4:   {a:5,b:39,sign:-1,label:"Tarifas e importações",relationship:"negativa",tolerance:1},
 5:   {a:2,b:1,sign:1,label:"Contratos: princípio e salário mínimo",relationship:"parcial / abstrato × concreto",tolerance:3},
 6:   {a:49,b:50,sign:1,label:"Preços: princípio e desastre",relationship:"condicional / abstrato × concreto",tolerance:3},
 7:   {a:57,b:58,sign:-1,label:"Limites para aliados e adversários",relationship:"negativa",tolerance:1},
 8:   {a:57,b:59,sign:1,label:"Simetria de poderes",relationship:"positiva",tolerance:1},
 9: ] as const
10: export function compareAnswers(answers: Answer[]) {
11:   const comparisons = COMPARISONS.map(pair => {
12:     const a = answers[pair.a - 1], b = answers[pair.b - 1]
13:     const gap = typeof a === "number" && typeof b === "number" ? Math.abs(a - b * pair.sign) : null
14:     return {label:pair.label,relationship:pair.relationship,gap,penalty:gap === null ? null : Math.max(0,gap-pair.tolerance)/(6-pair.tolerance)}
15:   })
16:   const measured = comparisons.filter(p => p.penalty !== null)
17:   return { comparisons: comparisons.map(({label,relationship,gap}) => ({label,relationship,gap})), consistency: measured.length < 2 ? null : Math.round(100 * (1 - measured.reduce((sum,p) => sum + p.penalty!,0) / measured.length)) }
18: }
</file>

