33:     margin, 'margin-inline': margin, 'margin-block': margin,
34:     'margin-left': dimension, 'margin-right': dimension, 'margin-top': dimension, 'margin-bottom': dimension,
35:     float: /^(none|left|right|inline-start|inline-end)$/,
36:     clear: /^(none|left|right|both|inline-start|inline-end)$/,
37:     'object-fit': /^(fill|contain|cover|none|scale-down)$/,
38:     'object-position': /^(?:(?:left|center|right|top|bottom|\d{1,3}(?:\.\d+)?%)(?:\s+|$)){1,2}$/,
39:     'aspect-ratio': /^(?:auto|\d{1,4}(?:\.\d+)?\s*\/\s*\d{1,4}(?:\.\d+)?)$/,
40:     'shape-margin': dimension,
41:     'shape-outside': /^(?:none|margin-box|border-box|padding-box|content-box|(?:inset|circle|ellipse|polygon)\([\d\s.,%pxemratoflighnbd-]+\))$/,
42:     'shape-image-threshold': /^(?:0(?:\.\d+)?|1(?:\.0+)?)$/,
43:     'border-radius': margin,
44:   }
45:   const image = style.split(';').flatMap(declaration => {
46:     const separator = declaration.indexOf(':')
47:     const key = declaration.slice(0, separator).trim().toLowerCase()
48:     const value = declaration.slice(separator + 1).trim()
49:     const rule = Object.hasOwn(rules, key) ? rules[/** @type {keyof typeof rules} */ (key)] : null
50:     return separator > 0 && rule?.test(value) ? [`${key}: ${value}`] : []
51:   })
52:   return [safeEditorialStyle(style), ...image].filter(Boolean).join('; ')
53: }
54: 
55: /** @param {string} value */
56: export function imageClasses(value) {
57:   return value.split(/\s+/).filter(token => /^[a-zA-Z_][a-zA-Z0-9_-]*$/.test(token)).join(' ')
58: }
