  2: import test from "node:test"
  3: 
  4: import {
  5:   $convertFromMarkdownString,
  6:   $convertToMarkdownString,
  7:   TRANSFORMERS,
  8: } from "@lexical/markdown"
  9: import { CodeHighlightNode, CodeNode } from "@lexical/code"
 10: import { LinkNode } from "@lexical/link"
 11: import { ListItemNode, ListNode } from "@lexical/list"
 12: import { HeadingNode, QuoteNode } from "@lexical/rich-text"
 13: import { createEditor } from "lexical"
 14: import {
 15:   prepareLatexForLexicalImport,
 16:   restoreLatexAfterLexicalExport,
 17: } from "../src/components/editor/latex-markdown.ts"
 18: import { renderMarkdownSync } from "../src/lib/mdx.ts"
 19: import { asString } from "../src/lib/validation.ts"
 20: 
 21: const COMPLETE_LATEX_MARKDOWN = String.raw`# Teste de LaTeX
 22: 
 23: Fórmula inline:
 24: 
 25: $P \rightarrow Q$
 26: 
 27: Negação:
 28: 
 29: $\neg Q$
 30: 
 31: Conjunção:
 32: 
 33: $P \land Q$
 34: 
 35: Disjunção:
 36: 
 37: $P \lor Q$
 38: 
 39: Não implicação:
 40: 
 41: $P \not\Rightarrow Q$
 42: 
 43: Quantificador universal:
 44: 
 45: $\forall x \in A$
 46: 
 47: Quantificador existencial:
 48: 
 49: $\exists x \in A$
 50: 
 51: Pertencimento:
 52: 
 53: $x \in A$
 54: 
 55: Não pertencimento:
 56: 
 57: $x \notin A$
 58: 
 59: Delta:
 60: 
 61: $\Delta R = 0$
 62: 
 63: Letra grega:
 64: 
 65: $\pi = R - C$
 66: 
 67: Fração:
 68: 
 69: $\frac{a}{b}$
 70: 
 71: Potência:
 72: 
 73: $x^2$
 74: 
 75: Subscrito:
 76: 
 77: $x_1$
 78: 
 79: Expressão em bloco:
 80: 
 81: $$
 82: \Delta R = 0 \land \Delta C > 0
 83: \Rightarrow
 84: \Delta \pi < 0
 85: $$
 86: 
 87: Lógica:
 88: 
 89: $$
 90: P \rightarrow Q
 91: $$
 92: 
 93: $$
 94: \neg Q
 95: $$
 96: 
 97: $$
 98: \therefore \neg P
 99: $$
100: 
101: Quantificação:
102: 
103: $$
104: \forall x \in A,\; P(x) \rightarrow Q(x)
105: $$`
106: 
107: function lexicalRoundTrip(markdown) {
108:   const editor = createEditor({
109:     namespace: "latex-markdown-round-trip",
110:     nodes: [HeadingNode, QuoteNode, ListNode, ListItemNode, CodeNode, CodeHighlightNode, LinkNode],
111:     onError: (error) => { throw error },
112:   })
113:   let exported = ""
114: 
115:   editor.update(() => {
116:     $convertFromMarkdownString(prepareLatexForLexicalImport(markdown), TRANSFORMERS)
117:     exported = restoreLatexAfterLexicalExport(
118:       $convertToMarkdownString(TRANSFORMERS)
119:     )
120:   }, { discrete: true })
121: 
122:   return exported
123: }
124: 
125: test("preserves generic LaTeX commands through the Lexical round trip", () => {
126:   const markdown = lexicalRoundTrip(COMPLETE_LATEX_MARKDOWN)
127: 
128:   for (const command of [
129:     String.raw`\rightarrow`,
130:     String.raw`\Rightarrow`,
131:     String.raw`\neg`,
132:     String.raw`\land`,
133:     String.raw`\lor`,
134:     String.raw`\therefore`,
135:     String.raw`\forall`,
136:     String.raw`\exists`,
137:     String.raw`\in`,
138:     String.raw`\notin`,
139:     String.raw`\Delta`,
140:     String.raw`\pi`,
141:     String.raw`\frac`,
142:   ]) {
143:     assert.ok(markdown.includes(command), `missing ${command}`)
144:     assert.ok(!markdown.includes(`\\${command}`), `duplicated ${command}`)
145:   }
146: 
147:   const html = renderMarkdownSync(markdown)
148:   for (const symbol of ["→", "⇒", "¬", "∧", "∨", "∴", "∀", "∃", "∈", "∉", "Δ", "π"]) {
149:     assert.ok(html.includes(symbol), `missing rendered symbol ${symbol}`)
150:   }
151:   assert.match(html, /<mfrac>/)
152:   assert.match(html, /class="katex-display"/)
153: })
154: 
155: test("preserves LaTeX through JSON and API validation", () => {
156:   const input = String.raw`Uma proposição: $P \rightarrow Q$ e $\neg Q$.`
157:   const afterEditor = lexicalRoundTrip(input)
158:   const afterJson = JSON.parse(JSON.stringify({ content: afterEditor })).content
159:   const afterValidation = asString(afterJson, 20_000)
160: 
161:   assert.equal(afterEditor, input)
162:   assert.equal(afterJson, input)
163:   assert.equal(afterValidation, input)
164: })
165: 
166: test("preserves intentional double backslashes used by LaTeX environments", () => {
167:   const input = String.raw`$$
168: \begin{aligned}x&=1\\y&=2\end{aligned}
169: $$`
170: 
171:   assert.equal(lexicalRoundTrip(input), input)
172:   assert.match(renderMarkdownSync(lexicalRoundTrip(input)), /class="katex-display"/)
173: })
174: 
175: test("does not rewrite backslashes outside math or inside code", () => {
176:   const exported = [
177:     String.raw`Texto \\ fora de matemática.`,
178:     String.raw`Código: \`$P \\rightarrow Q$\`.`,
179:     "```text",
180:     String.raw`$P \\rightarrow Q$`,
181:     "```",
182:     String.raw`Fórmula: $P \\rightarrow Q$.`,
183:   ].join("\n")
184: 
185:   const restored = restoreLatexAfterLexicalExport(exported)
186: 
187:   assert.ok(restored.includes(String.raw`Texto \\ fora de matemática.`))
188:   assert.ok(restored.includes(String.raw`\`$P \\rightarrow Q$\``))
189:   assert.ok(restored.includes(["```text", String.raw`$P \\rightarrow Q$`, "```"].join("\n")))
190:   assert.ok(restored.includes(String.raw`Fórmula: $P \rightarrow Q$.`))
191: })
</file>

