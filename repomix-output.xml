 48: function toDate(value: unknown, fallback = new Date()): Date {
 49:   if (value instanceof Date) return value
 50:   if (typeof value === "string" || typeof value === "number") {
 51:     const date = new Date(value)
 52:     if (!Number.isNaN(date.getTime())) return date
 53:   }
 54:   return fallback
 55: }
