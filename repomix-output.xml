292: export async function ensurePostPublicIds(posts: PostSummary[]): Promise<PostSummary[]> {
293:   const missingPublicIds = posts.filter((post) => !post.publicId)
294:   if (missingPublicIds.length === 0) return posts
295: 
296:   const col = await collection()
297:   await Promise.all(missingPublicIds.map(async (post) => {
298:     const publicId = randomUUID()
299:     const result = await col.updateOne(
300:       { _id: post._id, publicId: { $exists: false } },
301:       { $set: { publicId, updatedAt: new Date() } }
302:     )
303: 
304:     if (result.modifiedCount === 1) {
305:       post.publicId = publicId
306:       return
307:     }
308: 
309:     const freshPost = await col.findOne({ _id: post._id }, { projection: { publicId: 1 } })
310:     post.publicId = freshPost?.publicId ?? publicId
311:   }))
312: 
313:   return posts
314: }
