  3: import { useEffect, useId, useRef, useState } from "react"
  4: import { useLexicalComposerContext } from "@lexical/react/LexicalComposerContext"
  5: import { $getRoot, $getState, $setState, type LexicalEditor } from "lexical"
  6: import { ToolbarButton } from "./ToolbarButton"
  7: import { publicationCssState, readHtmlFromEditor } from "./html-content"
  8: import { compilePublicationCss } from "@/lib/publication-css"
  9: import { PublicationPreview } from "./PublicationPreview"
 10: import { splitInlineCssHooks } from "@/lib/inline-css-hooks"
 11: import { SAFE_PUBLICATION_HTML_TAGS } from "@/lib/content-format"
 12: 
 13: type AvailableSelector = {
 14:   selector: string
 15:   label: string
 16:   count: number
 17:   kind: "root" | "tag" | "class" | "hook"
 18: }
 19: 
 20: const SAFE_HTML_TAGS = new Set<string>(SAFE_PUBLICATION_HTML_TAGS)
 21: const CSS_CLASS_PATTERN = /^[a-zA-Z_][a-zA-Z0-9_-]*$/
 22: 
 23: function selectorsFromEditor(editor: LexicalEditor): AvailableSelector[] {
 24:   const html = readHtmlFromEditor(editor)
 25:   if (!html) return [{ selector: ":scope", label: ":scope", count: 1, kind: "root" }]
 26: 
 27:   const document = new DOMParser().parseFromString(html, "text/html")
 28:   const root = document.querySelector<HTMLElement>('[data-editor-document="html"]')
 29:   if (!root) return []
 30:   const counts = new Map<string, AvailableSelector>()
 31:   const add = (selector: string, label: string, kind: AvailableSelector["kind"]) => {
 32:     const current = counts.get(selector)
 33:     if (current) {
 34:       current.count += 1
 35:       return
 36:     }
 37:     counts.set(selector, { selector, label, count: 1, kind })
 38:   }
 39: 
 40:   root.querySelectorAll("*").forEach(element => {
 41:     const tag = element.tagName.toLowerCase()
 42:     if (!SAFE_HTML_TAGS.has(tag)) return
 43:     add(tag, tag, "tag")
 44:     element.classList.forEach(className => {
 45:       if (CSS_CLASS_PATTERN.test(className)) add(`.${className}`, `.${className}`, "class")
 46:     })
 47:   })
 48: 
 49:   const selectors: AvailableSelector[] = [
 50:     { selector: ":scope", label: ":scope", count: 1, kind: "root" },
 51:     ...counts.values(),
 52:   ]
 53:   const knownHooks = new Set<string>()
 54:   root.querySelectorAll<HTMLElement>("[data-css-hook]").forEach(element => {
 55:     const hook = element.dataset.cssHook
 56:     if (!hook || knownHooks.has(hook)) return
 57:     knownHooks.add(hook)
 58:     selectors.push({ selector: `[data-css-hook="${hook}"]`, label: `::${hook}::`, count: 1, kind: "hook" })
 59:   })
 60: 
 61:   const occurrences = new Map<string, number>()
 62:   for (const node of cssHookTextNodes(root)) {
 63:     for (const part of splitInlineCssHooks(node.data, occurrences)) {
 64:       if (part.type !== "hook" || knownHooks.has(part.id)) continue
 65:       knownHooks.add(part.id)
 66:       selectors.push({ selector: `[data-css-hook="${part.id}"]`, label: part.source, count: 1, kind: "hook" })
 67:     }
 68:   }
 69:   return selectors
 70: }
 71: 
 72: function cssHookTextNodes(root: HTMLElement) {
 73:   const walker = root.ownerDocument.createTreeWalker(root, NodeFilter.SHOW_TEXT)
 74:   const textNodes: Text[] = []
 75:   let current = walker.nextNode()
 76:   while (current) {
 77:     if (!current.parentElement?.closest("code, pre, style")) textNodes.push(current as Text)
 78:     current = walker.nextNode()
 79:   }
 80:   return textNodes
 81: }
 82: 
 83: export function PublicationCssControls({ variant }: { variant?: "default" | "compact" | "comment" }) {
 84:   const [editor] = useLexicalComposerContext()
 85:   const [open, setOpen] = useState(false)
 86:   const [css, setCss] = useState("")
 87:   const [error, setError] = useState("")
 88:   const [preview, setPreview] = useState("")
 89:   const [selectors, setSelectors] = useState<AvailableSelector[]>([])
 90:   const id = useId()
 91:   const textareaRef = useRef<HTMLTextAreaElement>(null)
 92: 
 93:   useEffect(() => {
 94:     let active = true
 95:     let timer: ReturnType<typeof setTimeout> | null = null
 96:     const refresh = () => {
 97:       if (!active) return
 98:       setSelectors(selectorsFromEditor(editor))
 99:     }
100:     refresh()
101:     const unregister = editor.registerUpdateListener(({ editorState }) => {
102:       editorState.read(() => setCss($getState($getRoot(), publicationCssState)))
103:       if (timer) clearTimeout(timer)
104:       timer = setTimeout(refresh, 120)
105:     })
106:     return () => {
107:       active = false
108:       if (timer) clearTimeout(timer)
109:       unregister()
110:     }
111:   }, [editor])
112: 
113:   function toggle() {
114:     editor.getEditorState().read(() => {
115:       const value = $getState($getRoot(), publicationCssState)
116:       setCss(value)
117:     })
118:     setOpen(value => !value)
119:   }
120: 
121:   function change(value: string) {
122:     setCss(value)
123:     setPreview("")
124:     setError("")
125:     // CSS incompleto faz parte do rascunho e só é validado ao publicar.
126:     editor.update(() => $setState($getRoot(), publicationCssState, value))
127:   }
128: 
129:   function showPreview() {
130:     try {
131:       compilePublicationCss(css, "[data-publication-preview]")
132:       setPreview(readHtmlFromEditor(editor))
133:       setError("")
134:     } catch (error) {
135:       setError(error instanceof Error ? error.message : "Confira o CSS.")
136:     }
137:   }
138: 
139:   function insertSelector(selector: string) {
140:     const existing = css.indexOf(`${selector} {`)
141:     if (existing >= 0) {
142:       textareaRef.current?.focus()
143:       textareaRef.current?.setSelectionRange(existing, existing + selector.length)
144:       return
145:     }
146: 
147:     const rule = `${selector} {\n  \n}`
148:     const next = css.trim() ? `${css.trimEnd()}\n\n${rule}` : rule
149:     change(next)
150:     requestAnimationFrame(() => {
151:       const cursor = next.length - 2
152:       textareaRef.current?.focus()
153:       textareaRef.current?.setSelectionRange(cursor, cursor)
154:     })
155:   }
156: 
157:   return <>
158:     <ToolbarButton variant={variant} title="CSS desta publicação" expanded={open} onClick={toggle}><span className="text-[10px] font-bold tracking-tight">CSS</span></ToolbarButton>
159:     {open && <div className="publication-css-panel" role="group" aria-label="CSS da publicação">
160:       <label htmlFor={id}>CSS desta publicação</label>
161:       <p id={`${id}-help`} className="publication-css-help">Use uma tag, classe ou seletor mais específico. <code>:scope</code> representa a área inteira desta publicação.</p>
162:       <div className="publication-css-selectors" aria-label="Seletores disponíveis no texto">
163:         <span>Disponíveis neste texto</span>
164:         <div>{selectors.map(item => <button key={item.selector} type="button" data-css-selector-kind={item.kind} title={`Inserir ${item.selector}`} onClick={() => insertSelector(item.selector)}><code>{item.label}</code>{item.kind !== "hook" && item.kind !== "root" && <small>{item.count}</small>}</button>)}</div>
165:       </div>
166:       <p className="publication-css-help">Para um trecho individual, escreva <code>::trecho::</code> ou selecione palavras e use o botão <code>::</code>; use o mesmo botão para remover a marca. Para um nome explícito: <code>::nome|trecho::</code>.</p>
167:       <textarea ref={textareaRef} id={id} aria-describedby={`${id}-help`} aria-invalid={Boolean(error)} value={css} onChange={event => change(event.target.value)} spellCheck={false} rows={9} placeholder={"p { line-height: 1.8; }\n\n[data-css-hook=\"destaque\"] {\n  color: #e00070;\n}\n\n@media (max-width: 600px) {\n  p { font-size: 16px; }\n}"} />
168:       <div className="flex flex-wrap items-center gap-2">
169:         <button type="button" onClick={showPreview} className="editorial-control-trigger">Pré-visualizar</button>
170:         <button type="button" onClick={() => change("")} className="editorial-control-trigger">Limpar CSS</button>
171:         <span className="ml-auto text-xs text-neutral-500 dark:text-neutral-400">{css.length.toLocaleString("pt-BR")} caracteres</span>
172:       </div>
173:       {error && <p role="alert" className="publication-css-error">{error}</p>}
174:       {preview && <PublicationPreview content={preview} />}
175:     </div>}
176:   </>
177: }
