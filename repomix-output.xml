648: export async function updatePostTranslation(
649:   id: string,
650:   locale: TranslationLocale,
651:   data: {
652:     title: string
653:     slug?: string
654:     seoTitle?: string
655:     seoDescription?: string
656:     content: string
657:     excerpt?: string
658:     subtitle?: string
659:     coverAlt?: string
660:     tags?: string[]
661:     sources?: PostSource[]
662:     published?: boolean
663:   },
664:   sourceUpdatedAt: Date,
665:   existing?: PostTranslation
666: ): Promise<PostTranslation> {
667:   const objectId = toObjectId(id)
668:   if (!objectId) throw new Error("Invalid post id")
669: 
670:   const now = new Date()
671:   const slug = data.slug ?? existing?.slug ?? slugifyPostTitle(data.seoTitle || data.title)
672:   if (!slug) throw new Error("Título traduzido inválido para gerar a URL.")
673:   const published = data.published ?? existing?.published ?? false
674:   const slugAliases = preservedSlugAliases(existing?.slug, existing?.slugAliases, slug)
675:   const translation: PostTranslation = {
676:     slug,
677:     ...(slugAliases.length > 0 ? { slugAliases } : {}),
678:     title: data.title,
679:     seoTitle: data.seoTitle,
680:     seoDescription: data.seoDescription,
681:     content: data.content,
682:     excerpt: data.excerpt,
683:     subtitle: data.subtitle,
684:     coverAlt: data.coverAlt,
685:     tags: data.tags ?? existing?.tags ?? [],
686:     sources: data.sources ?? existing?.sources,
687:     published,
688:     publishedAt: published ? existing?.publishedAt ?? now : undefined,
689:     readingTimeMinutes: calcReadingTime(data.content),
690:     sourceUpdatedAt,
691:     createdAt: existing?.createdAt ?? now,
692:     updatedAt: now,
693:   }
694: 
695:   const col = await collection()
696:   await col.updateOne(
697:     { _id: objectId, originalContentUpdatedAt: { $exists: false } },
698:     { $set: { originalContentUpdatedAt: sourceUpdatedAt } }
699:   )
700: 
701:   const result = await col.updateOne(
702:     { _id: objectId, deleting: { $ne: true } },
703:     { $set: { [`translations.${locale}`]: translation } }
704:   )
705:   if (result.matchedCount !== 1) throw new Error("Post not found")
706: 
707:   return translation
708: }
