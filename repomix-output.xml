  1: import { NextRequest, NextResponse } from "next/server"
  2: import { getAdminUserId, getAuthUser, getAuthUserId, isAdmin } from "@/lib/auth"
  3: import { createNotification } from "@/lib/admin-notifications"
  4: import { createComment, deleteComment, getCommentsPage, serializeComment, MAX_COMMENTS_PER_RESPONSE } from "@/lib/db/comments"
  5: import { getNote } from "@/lib/db/notes"
  6: import { rateLimit } from "@/lib/rate-limit"
  7: import { requestIdentity } from "@/lib/request-identity"
  8: import { toObjectId } from "@/lib/validation"
  9: import { MAX_COMMENT_IMAGES, parseCommentContent } from "@/lib/api/comment-input"
 10: import {
 11:   claimCommentUploads,
 12:   commentUploadClaimMatches,
 13:   commitCommentUploadClaim,
 14:   extractCommentBlobUrls,
 15:   releaseCommentUploadClaim,
 16: } from "@/lib/db/comment-uploads"
 17: import { enforceCommentPolicy } from "@/lib/api/comment-abuse"
 18: 
 19: type Params = { params: Promise<{ noteId: string }> }
 20: 
 21: export async function GET(req: NextRequest, { params }: Params) {
 22:   const { noteId } = await params
 23:   if (!toObjectId(noteId)) return NextResponse.json({ error: "ID inválido" }, { status: 400 })
 24:   if (!(await rateLimit(`comment-read:${requestIdentity(req)}`, { limit: 120, windowMs: 60_000 }))) {
 25:     return NextResponse.json({ error: "Muitas requisições." }, { status: 429 })
 26:   }
 27: 
 28:   const [note, userId, admin] = await Promise.all([getNote(noteId), getAuthUserId(), isAdmin()])
 29:   if (!note) return NextResponse.json({ error: "Not found" }, { status: 404 })
 30: 
 31:   const cursor = req.nextUrl.searchParams.get("cursor") ?? undefined
 32:   if (cursor && !toObjectId(cursor)) return NextResponse.json({ error: "Cursor inválido" }, { status: 400 })
 33:   const { comments, hasMore, nextCursor, total } = await getCommentsPage(noteId, { cursor })
 34:   return NextResponse.json(comments.map((comment) =>
 35:     serializeComment(comment, admin || userId === comment.authorId)
 36:   ), {
 37:     headers: {
 38:       "X-Comments-Limit": String(MAX_COMMENTS_PER_RESPONSE),
 39:       "X-Comments-Total": String(total),
 40:       "X-Comments-Truncated": String(hasMore),
 41:       ...(nextCursor ? { "X-Comments-Next-Cursor": nextCursor } : {}),
 42:     },
 43:   })
 44: }
 45: 
 46: export async function POST(req: NextRequest, { params }: Params) {
 47:   const userId = await getAuthUserId()
 48:   if (!userId) return NextResponse.json({ error: "Unauthorized" }, { status: 401 })
 49:   if (!(await rateLimit(`note-comment:${userId}`, { limit: 12, windowMs: 60_000 }))) {
 50:     return NextResponse.json({ error: "Muitas tentativas. Tente novamente em instantes." }, { status: 429 })
 51:   }
 52:   const user = await getAuthUser()
 53:   if (!user || user.id !== userId) return NextResponse.json({ error: "Unauthorized" }, { status: 401 })
 54: 
 55:   const { noteId } = await params
 56:   if (!toObjectId(noteId)) return NextResponse.json({ error: "ID inválido" }, { status: 400 })
 57: 
 58:   const [note, admin] = await Promise.all([getNote(noteId), isAdmin()])
 59:   if (!note) return NextResponse.json({ error: "Not found" }, { status: 404 })
 60: 
 61:   const body = await req.json().catch(() => null) as { content?: unknown } | null
 62:   const content = parseCommentContent(body?.content, { allowImages: admin })
 63: 
 64:   if (!content) {
 65:     return NextResponse.json({ error: "Invalid content" }, { status: 400 })
 66:   }
 67: 
 68:   const policyError = await enforceCommentPolicy(req, user, admin)
 69:   if (policyError) return policyError
 70: 
 71:   const expectedImageUrls = extractCommentBlobUrls([content]).slice(0, MAX_COMMENT_IMAGES)
 72:   const uploadClaim = await claimCommentUploads(content, user.id)
 73:   if (!commentUploadClaimMatches(expectedImageUrls, uploadClaim)) {
 74:     await releaseCommentUploadClaim(uploadClaim)
 75:     return NextResponse.json({ error: "Uma ou mais imagens são inválidas ou expiraram." }, { status: 400 })
 76:   }
 77: 
 78:   let comment
 79:   try {
 80:     comment = await createComment({
 81:       postId: noteId,
 82:       authorId: user.id,
 83:       authorName: user.name,
 84:       authorImageUrl: user.imageUrl,
 85:       content,
 86:     })
 87:   } catch (error) {
 88:     await releaseCommentUploadClaim(uploadClaim).catch(() => undefined)
 89:     throw error
 90:   }
 91:   if (!(await getNote(noteId))) {
 92:     await deleteComment(comment._id.toString()).catch(() => undefined)
 93:     await releaseCommentUploadClaim(uploadClaim).catch(() => undefined)
 94:     return NextResponse.json({ error: "A nota foi removida durante o envio." }, { status: 409 })
 95:   }
 96:   await commitCommentUploadClaim(uploadClaim).catch(() => undefined)
 97: 
 98:   const adminId = getAdminUserId()
 99:   if (adminId) await createNotification({
100:     recipientId: adminId, actorId: user.id, actorImageUrl: user.imageUrl, kind: "comment",
101:     title: "Novo comentário em uma nota", description: `${user.name} comentou em uma nota.`, href: `/notes/${noteId}`,
102:   }, "note_comments").catch(() => null)
103: 
104:   return NextResponse.json(serializeComment(comment, true), { status: 201 })
105: }
</file>

