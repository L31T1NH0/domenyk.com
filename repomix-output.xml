161:               <span className="mt-0.5 grid size-7 shrink-0 place-items-center rounded-md bg-red-50 text-red-700 dark:bg-red-500/10 dark:text-red-400">
162:                 <TrashIcon className="size-4" aria-hidden />
163:               </span>
