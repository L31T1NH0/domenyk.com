  1: import { MongoClient } from "mongodb"
  2: 
  3: const uri = process.env.MONGODB_URI
  4: if (!uri) throw new Error("MONGODB_URI is not set")
  5: 
  6: function plainText(markdown = "") {
  7:   return markdown
  8:     .replace(/```[\s\S]*?```/g, " ")
  9:     .replace(/`[^`]*`/g, " ")
 10:     .replace(/!\[[^\]]*]\([^)]*\)/g, " ")
 11:     .replace(/\[([^\]]+)]\([^)]*\)/g, "$1")
 12:     .replace(/<[^>]+>/g, " ")
 13:     .replace(/[#>*_~\-]+/g, " ")
 14:     .replace(/\s+/g, " ")
 15:     .trim()
 16: }
 17: 
 18: function description(markdown = "") {
 19:   const text = plainText(markdown)
 20:   if (text.length <= 155) return text
 21:   const candidate = text.slice(0, 156)
 22:   return `${candidate.slice(0, candidate.lastIndexOf(" ") || 155).trim()}...`
 23: }
 24: 
 25: function markdownImages(markdown = "") {
 26:   return [...markdown.matchAll(/!\[([^\]]*)]\(([^)\s]+)(?:\s+"[^"]*")?\)/g)]
 27:     .map((match) => ({ alt: match[1].trim(), url: match[2] }))
 28: }
 29: 
 30: function markdownLinks(markdown = "") {
 31:   return [...markdown.matchAll(/(?<!!)\[[^\]]+]\(([^)\s]+)(?:\s+"[^"]*")?\)/g)]
 32:     .map((match) => match[1])
 33: }
 34: 
 35: function normalizedPath(value) {
 36:   try {
 37:     const url = new URL(value, "https://domenyk.com")
 38:     return url.origin === "https://domenyk.com" ? decodeURIComponent(url.pathname) : null
 39:   } catch {
 40:     return null
 41:   }
 42: }
 43: 
 44: const issues = []
 45: function report(level, scope, message) {
 46:   issues.push({ level, scope, message })
 47: }
 48: 
 49: const client = new MongoClient(uri)
 50: try {
 51:   await client.connect()
 52:   const db = client.db("blog")
 53:   const [posts, notes] = await Promise.all([
 54:     db.collection("posts").find({ deleting: { $ne: true } }).toArray(),
 55:     db.collection("notes").find({ deleting: { $ne: true } }).toArray(),
 56:   ])
 57:   const publishedPosts = posts.filter((post) => post.published && post.hiddenFromTimeline !== true)
 58:   const publishedTranslations = posts.flatMap((post) =>
 59:     Object.entries(post.translations ?? {})
 60:       .filter(([, translation]) => translation?.published && post.hiddenFromTimeline !== true)
 61:       .map(([locale, translation]) => ({ post, locale, translation })))
 62:   const knownPaths = new Set([
 63:     "/", "/notes", "/sobre", "/fale-comigo",
 64:     ...publishedPosts.map((post) => `/posts/${post.slug}`),
 65:     ...notes.map((note) => `/notes/${note._id.toString()}`),
 66:     ...publishedTranslations.map(({ post, locale, translation }) => `/${locale}/posts/${translation.slug ?? post.slug}`),
 67:   ])
 68: 
 69:   const slugCounts = new Map()
 70:   for (const post of posts) slugCounts.set(post.slug, (slugCounts.get(post.slug) ?? 0) + 1)
 71:   for (const [slug, count] of slugCounts) {
 72:     if (count > 1) report("error", `post:${slug}`, `slug duplicado em ${count} documentos`)
 73:   }
 74: 
 75:   function auditArticle({ scope, title, seoTitle, seoDescription, content, excerpt, subtitle, cover, tags, sources, publishedAt, updatedAt }) {
 76:     const searchTitle = seoTitle?.trim() || title?.trim()
 77:     const sourceDescription = seoDescription?.trim() || excerpt?.trim() || subtitle?.trim() || description(content)
 78:     const searchDescription = description(sourceDescription)
 79:     if (!title?.trim()) report("error", scope, "título editorial ausente")
 80:     if (!searchTitle) report("error", scope, "título SEO vazio")
 81:     if (!content?.trim()) report("error", scope, "conteúdo vazio")
 82:     if (!searchDescription) report("error", scope, "descrição SEO vazia")
 83:     else if (searchDescription.length < 50) report("warning", scope, `descrição curta (${searchDescription.length} caracteres)`)
 84:     if (!publishedAt) report("error", scope, "data de publicação ausente")
 85:     if (!updatedAt) report("error", scope, "data de modificação ausente")
 86:     if (cover?.url && !cover.alt?.trim()) report("warning", scope, "capa depende do fallback de texto alternativo; descreva o que aparece na imagem")
 87:     if (cover?.url && cover.alt?.trim() === title?.trim()) {
 88:       report("warning", scope, "texto alternativo da capa repete o título; descreva o que aparece na imagem")
 89:     }
 90:     if (!Array.isArray(tags) || tags.length === 0) report("warning", scope, "sem tags para descoberta e conteúdos relacionados")
 91:     for (const source of sources ?? []) {
 92:       try {
 93:         if (new URL(source.url).protocol !== "https:") throw new Error()
 94:       } catch {
 95:         report("error", scope, `fonte inválida: ${source?.url ?? "sem URL"}`)
 96:       }
 97:     }
 98:     for (const image of markdownImages(content)) {
 99:       if (!image.alt) report("warning", scope, `imagem no corpo depende do fallback contextual de texto alternativo: ${image.url}`)
100:     }
101:     for (const href of markdownLinks(content)) {
102:       const path = normalizedPath(href)
103:       if (path && !knownPaths.has(path) && !path.startsWith("/temas/")) {
