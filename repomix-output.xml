 12: import { DeleteActionMenu } from "@/components/actions/DeleteActionMenu"
 13: import type { SerializedPostSummary } from "@/lib/db/posts"
 14: import { isTranslationRevisionStale, POST_LOCALE_DETAILS, TRANSLATION_LOCALES } from "@/lib/post-locales"
 15: import { formatSiteDate, siteDateKey } from "@/lib/datetime"
 16: 
 17: type Props = { posts: SerializedPostSummary[] }
 18: type StatusFilter = "all" | "published" | "draft"
 19: type VisibilityFilter = "all" | "timeline" | "hidden"
 20: type ColumnKey = "status" | "date" | "views" | "reading" | "style"
 21: 
 22: const columns: Array<{ key: ColumnKey; label: string }> = [
 23:   { key: "status", label: "Status" },
 24:   { key: "date", label: "Publicado" },
 25:   { key: "views", label: "Views" },
 26:   { key: "reading", label: "Leitura" },
 27:   { key: "style", label: "Estilo" },
 28: ]
 29: 
 30: function formatDate(value?: string) {
 31:   if (!value) return "Sem data"
 32:   return formatSiteDate(value, { day: "2-digit", month: "short", year: "numeric" })
 33: }
 34: 
 35: function postMatchesQuery(post: SerializedPostSummary, query: string) {
 36:   const normalized = query.trim().toLowerCase()
 37:   if (!normalized) return true
 38: 
 39:   return [
 40:     post.title,
 41:     post.slug,
 42:     post.publicId,
 43:     post.excerpt,
 44:     ...TRANSLATION_LOCALES.flatMap((locale) => {
 45:       const translation = post.translations?.[locale]
 46:       return translation ? [translation.title, translation.excerpt, translation.subtitle, ...(translation.tags ?? [])] : []
 47:     }),
 48:     ...post.tags,
 49:   ]
 50:     .filter(Boolean)
 51:     .some((value) => value!.toLowerCase().includes(normalized))
 52: }
 53: 
 54: function TranslationBadges({ post }: { post: SerializedPostSummary }) {
 55:   const originalUpdatedAt = post.originalContentUpdatedAt ?? post.updatedAt
 56: 
 57:   return (
 58:     <div className="admin-locale-list" aria-label="Estado das traduções">
 59:       {TRANSLATION_LOCALES.map((locale) => {
 60:         const translation = post.translations?.[locale]
 61:         const stale = translation
 62:           ? isTranslationRevisionStale(translation.sourceUpdatedAt, originalUpdatedAt)
 63:           : false
 64:         const label = !translation
 65:           ? "sem tradução"
 66:           : stale
 67:             ? `${translation.published ? "publicado" : "rascunho"}, revisão pendente`
 68:             : translation.published ? "publicado" : "rascunho"
 69:         const state = !translation ? "is-missing" : stale ? "is-stale" : translation.published ? "is-live" : "is-draft"
 70: 
 71:         return (
 72:           <span key={locale} title={`${POST_LOCALE_DETAILS[locale].adminLabel}: ${label}`} className={`admin-locale-state ${state}`}>
 73:             {POST_LOCALE_DETAILS[locale].shortLabel} · {label}
 74:           </span>
 75:         )
 76:       })}
 77:     </div>
 78:   )
 79: }
 80: 
 81: function StatusBadge({ published }: { published: boolean }) {
 82:   return (
 83:     <span className={`admin-record-status ${published ? "is-live" : "is-review"}`}>
 84:       {published ? "Publicado" : "Rascunho"}
 85:     </span>
 86:   )
 87: }
 88: 
 89: function PostFlags({ post }: { post: SerializedPostSummary }) {
 90:   return (
 91:     <>
 92:       {post.pinned && <span className="admin-record-flag is-pinned">Fixado</span>}
 93:       {post.hiddenFromTimeline && <span className="admin-record-flag">Oculto</span>}
 94:       {post.series && <span className="admin-record-flag">Série · cap. {post.series.position}</span>}
 95:     </>
 96:   )
