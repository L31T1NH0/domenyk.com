 327: function mergePostsById(current: SerializedPostSummary[], incoming: SerializedPostSummary[]) {
 328:   const postsById = new Map(current.map((post) => [post._id, post]))
 329:   for (const post of incoming) postsById.set(post._id, post)
 330:   return Array.from(postsById.values())
 331: }
