158:           const nextOpen = !isOpen
159:           setIsOpen(nextOpen)
160:           if (nextOpen && status === "idle") void loadMore()
161:         }}
162:         className="flex min-h-7 w-full cursor-pointer items-center gap-1.5 rounded-sm text-[10px] leading-4 text-neutral-500 outline-none hover:text-neutral-950 focus-visible:ring-2 focus-visible:ring-neutral-500 dark:text-[#8f8981] dark:hover:text-[#f1f1f1] dark:focus-visible:ring-neutral-300"
163:       >
164:         <ChevronDownIcon
165:           aria-hidden
166:           className={`size-2.5 shrink-0 text-neutral-400 transition-transform duration-150 motion-reduce:transition-none dark:text-[#77716a] ${isOpen ? "rotate-0" : "-rotate-90"}`}
167:         />
168:         <span className="min-w-0 flex-1 truncate text-left">{monthNames[month - 1]}</span>
169:         <span className="shrink-0 font-editorial-mono text-[9px] tabular-nums" title={itemCountLabel(count)}>
170:           {count}
171:         </span>
172:       </button>
173: 
174:       <div id={contentId} hidden={!isOpen} className="ml-4 mt-1.5 min-w-0">
175:         <ArchiveItemResults
176:           items={items}
177:           status={status}
178:           hasMore={hasMore}
179:           searchQuery={searchQuery}
180:           loadMore={loadMore}
181:         />
182:       </div>
183:     </div>
184:   )
185: }
