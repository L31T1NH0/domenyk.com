202:   }
203: 
204:   isInline() { return false }
205: 
206:   applyFigureDOM(figure: HTMLElement, editing = false) {
207:     for (const name of ["data-flow-image", "data-flow-width", "data-editor-image", "data-editor-width", "data-image-theme"]) figure.removeAttribute(name)
208:     if (this.__layout === "block") {
209:       figure.dataset.editorImage = this.__alignment
210:       figure.dataset.editorWidth = String(this.__blockWidth)
211:     } else {
212:       figure.dataset.flowImage = this.__layout === "flow-left" ? "left" : "right"
213:       figure.dataset.flowWidth = String(this.__flowWidth)
214:     }
215:     if (this.__themeMode === "adaptive-monochrome") figure.dataset.imageTheme = "adaptive"
216:     const f = this.__formatting
217:     const width = f.width ?? (this.__layout === "block" ? this.__blockWidth : this.__flowWidth)
218:     figure.dataset.imageWidth = String(width)
219:     figure.dataset.imageUnit = f.unit ?? "%"
220:     figure.dataset.imageGap = String(f.gap ?? 16)
221:     figure.className = f.figureClass ?? ""
222:     figure.setAttribute("style", `${editing ? imageDefaults(this.__src, width, f.unit, f.gap) + ";" : ""}${f.figureStyle ?? ""}`)
223:     figure.removeAttribute("tabindex")
224:     figure.removeAttribute("aria-label")
