<file path="src/components/noise/NoisePreferenceContext.tsx">
  1: "use client"
  2: 
  3: import {
  4:   createContext,
  5:   useCallback,
  6:   useContext,
  7:   useMemo,
  8:   useSyncExternalStore,
  9:   type ReactNode,
 10: } from "react"
 11: 
 12: export type NoisePreference = "animated" | "static" | "off"
 13: 
 14: const DEFAULT_NOISE_PREFERENCE: NoisePreference = "off"
 15: const NOISE_PREFERENCE_STORAGE_KEY = "noise"
 16: const NOISE_PREFERENCE_CHANGE_EVENT = "noisepreferencechange"
 17: 
 18: let volatileNoisePreference: NoisePreference | null = null
 19: 
 20: type NoisePreferenceContextValue = {
 21:   preference: NoisePreference
 22:   setPreference: (preference: NoisePreference) => void
 23: }
 24: 
 25: const NoisePreferenceContext = createContext<NoisePreferenceContextValue | null>(null)
 26: 
 27: function normalizeNoisePreference(value: string | null): NoisePreference {
 28:   if (value === "animated" || value === "static" || value === "off") return value
 29:   return DEFAULT_NOISE_PREFERENCE
 30: }
 31: 
 32: function getNoisePreferenceSnapshot() {
 33:   if (volatileNoisePreference) return volatileNoisePreference
 34: 
 35:   try {
 36:     return normalizeNoisePreference(window.localStorage.getItem(NOISE_PREFERENCE_STORAGE_KEY))
 37:   } catch {
 38:     return DEFAULT_NOISE_PREFERENCE
 39:   }
 40: }
 41: 
 42: function getServerNoisePreferenceSnapshot() {
 43:   return DEFAULT_NOISE_PREFERENCE
 44: }
 45: 
 46: function subscribeToNoisePreference(onStoreChange: () => void) {
 47:   const handleStorage = (event: StorageEvent) => {
 48:     if (event.key !== NOISE_PREFERENCE_STORAGE_KEY) return
 49:     volatileNoisePreference = normalizeNoisePreference(event.newValue)
 50:     onStoreChange()
 51:   }
 52: 
 53:   window.addEventListener("storage", handleStorage)
 54:   window.addEventListener(NOISE_PREFERENCE_CHANGE_EVENT, onStoreChange)
 55: 
 56:   return () => {
 57:     window.removeEventListener("storage", handleStorage)
 58:     window.removeEventListener(NOISE_PREFERENCE_CHANGE_EVENT, onStoreChange)
 59:   }
 60: }
 61: 
 62: function storeNoisePreference(preference: NoisePreference) {
 63:   volatileNoisePreference = preference
 64: 
 65:   try {
 66:     window.localStorage.setItem(NOISE_PREFERENCE_STORAGE_KEY, preference)
 67:   } catch {
 68:     // The in-memory preference still works when storage is unavailable.
 69:   }
 70: 
 71:   window.dispatchEvent(new Event(NOISE_PREFERENCE_CHANGE_EVENT))
 72: }
 73: 
 74: export function NoisePreferenceProvider({ children }: { children: ReactNode }) {
 75:   const preference = useSyncExternalStore(
 76:     subscribeToNoisePreference,
 77:     getNoisePreferenceSnapshot,
 78:     getServerNoisePreferenceSnapshot,
 79:   )
 80: 
 81:   const setPreference = useCallback((nextPreference: NoisePreference) => {
 82:     storeNoisePreference(nextPreference)
 83:   }, [])
 84: 
 85:   const value = useMemo(
 86:     () => ({ preference, setPreference }),
 87:     [preference, setPreference],
 88:   )
 89: 
 90:   return (
 91:     <NoisePreferenceContext.Provider value={value}>
 92:       {children}
 93:     </NoisePreferenceContext.Provider>
 94:   )
 95: }
 96: 
 97: export function useNoisePreference() {
 98:   const context = useContext(NoisePreferenceContext)
 99: 
100:   if (!context) {
101:     throw new Error("useNoisePreference must be used within NoisePreferenceProvider")
102:   }
103: 
104:   return context
105: }
</file>

