<file path="src/lib/db/client.ts">
 1: import "server-only"
 2: 
 3: import { MongoClient } from "mongodb"
 4: import { resetOnRejection } from "../retryable-promise"
 5: 
 6: declare global {
 7:   var _mongoClient: MongoClient | undefined
 8:   var _mongoClientPromise: Promise<MongoClient> | undefined
 9: }
10: 
11: function getClientPromise(): Promise<MongoClient> {
12:   const uri = process.env.MONGODB_URI
13:   if (!uri) throw new Error("MONGODB_URI is not set")
14: 
15:   if (!global._mongoClientPromise) {
16:     const client = new MongoClient(uri, {
17:       // Keep serverless instances from exhausting the Atlas M0 connection limit.
18:       // The pool still reuses connections, but releases idle ones after traffic subsides.
19:       maxPoolSize: 10,
20:       minPoolSize: 0,
21:       maxIdleTimeMS: 30_000,
22:     })
23:     const retryableConnection = resetOnRejection(client.connect(), async () => {
24:       if (global._mongoClientPromise === retryableConnection) {
25:         global._mongoClient = undefined
26:         global._mongoClientPromise = undefined
27:       }
28:       await client.close()
29:     })
30: 
31:     global._mongoClient = client
32:     global._mongoClientPromise = retryableConnection
33:   }
34: 
35:   return global._mongoClientPromise
36: }
37: 
38: export async function getDb() {
39:   const client = await getClientPromise()
40:   return client.db("blog")
41: }
</file>

<file path="src/lib/db/note-metrics.ts">
  1: import "server-only"
  2: 
  3: import { ObjectId } from "mongodb"
  4: import { getDb } from "./client"
  5: import { toObjectId } from "../validation"
  6: import type { NoteViewSource } from "../note-views"
  7: import { siteDateKey } from "../datetime"
  8: 
  9: export type NoteMetrics = {
 10:   directViews: number
 11:   homeImpressions: number
 12:   notesImpressions: number
 13:   updatedAt?: Date
 14: }
 15: 
 16: type StoredNoteMetrics = NoteMetrics & { _id: ObjectId; noteId: ObjectId }
 17: type NoteViewEvent = {
 18:   _id: ObjectId
 19:   noteId: ObjectId
 20:   visitorKey: string
 21:   source: NoteViewSource
 22:   day: string
 23:   createdAt: Date
 24: }
 25: 
 26: const EMPTY_METRICS: NoteMetrics = { directViews: 0, homeImpressions: 0, notesImpressions: 0 }
 27: let indexesPromise: Promise<void> | undefined
 28: 
 29: async function collections() {
 30:   const db = await getDb()
 31:   const metrics = db.collection<StoredNoteMetrics>("note_metrics")
 32:   const events = db.collection<NoteViewEvent>("note_view_events")
 33:   indexesPromise ??= Promise.all([
 34:     metrics.createIndex({ noteId: 1 }, { unique: true }),
 35:     events.createIndex({ noteId: 1, visitorKey: 1, source: 1, day: 1 }, { unique: true }),
 36:     events.createIndex({ createdAt: 1 }, { expireAfterSeconds: 60 * 60 * 24 * 90 }),
 37:   ]).then(() => undefined)
 38:   await indexesPromise
 39:   return { metrics, events }
 40: }
 41: 
 42: function counterForSource(source: NoteViewSource): keyof Pick<NoteMetrics, "directViews" | "homeImpressions" | "notesImpressions"> {
 43:   if (source === "direct") return "directViews"
 44:   if (source === "home") return "homeImpressions"
 45:   return "notesImpressions"
 46: }
 47: 
 48: export async function recordNoteView(
 49:   noteId: string,
 50:   visitorKey: string,
 51:   source: NoteViewSource
 52: ): Promise<{ counted: boolean; metrics: NoteMetrics }> {
 53:   const objectId = toObjectId(noteId)
 54:   if (!objectId) return { counted: false, metrics: EMPTY_METRICS }
 55:   const { metrics, events } = await collections()
 56:   const now = new Date()
 57:   const day = siteDateKey(now)
 58: 
 59:   try {
 60:     await events.insertOne({ _id: new ObjectId(), noteId: objectId, visitorKey, source, day, createdAt: now })
 61:   } catch (error) {
 62:     if (!(typeof error === "object" && error && "code" in error && error.code === 11000)) throw error
 63:     return { counted: false, metrics: await getNoteMetrics(noteId) }
 64:   }
 65: 
 66:   const counter = counterForSource(source)
 67:   const result = await metrics.findOneAndUpdate(
 68:     { noteId: objectId },
 69:     {
 70:       $inc: { [counter]: 1 },
 71:       $set: { updatedAt: now },
 72:       $setOnInsert: {
 73:         _id: new ObjectId(),
 74:         noteId: objectId,
 75:         ...(counter === "directViews" ? { homeImpressions: 0, notesImpressions: 0 } : {}),
 76:         ...(counter === "homeImpressions" ? { directViews: 0, notesImpressions: 0 } : {}),
 77:         ...(counter === "notesImpressions" ? { directViews: 0, homeImpressions: 0 } : {}),
 78:       },
 79:     },
 80:     { upsert: true, returnDocument: "after" }
 81:   )
 82: 
 83:   return {
 84:     counted: true,
 85:     metrics: {
 86:       directViews: result?.directViews ?? 0,
 87:       homeImpressions: result?.homeImpressions ?? 0,
 88:       notesImpressions: result?.notesImpressions ?? 0,
 89:       updatedAt: result?.updatedAt,
 90:     },
 91:   }
 92: }
 93: 
 94: export async function getNoteMetrics(noteId: string): Promise<NoteMetrics> {
 95:   const objectId = toObjectId(noteId)
 96:   if (!objectId) return { ...EMPTY_METRICS }
 97:   const row = await (await collections()).metrics.findOne({ noteId: objectId })
 98:   return row ? {
 99:     directViews: row.directViews ?? 0,
100:     homeImpressions: row.homeImpressions ?? 0,
101:     notesImpressions: row.notesImpressions ?? 0,
102:     updatedAt: row.updatedAt,
103:   } : { ...EMPTY_METRICS }
104: }
105: 
