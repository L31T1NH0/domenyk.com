  1: "use client"
  2: import { startTransition, useEffect, useRef, useState } from "react"
  3: import { QUESTIONS, isAnswer } from "@/lib/quiz/questions"
  4: import { DIMENSIONS, QUIZ_VERSION, type Answer, type Dimension, type QuizResult } from "@/lib/quiz/types"
  5: import styles from "./quiz.module.css"
  6: const STORAGE_KEY = `political-quiz:${QUIZ_VERSION}`
  7: const OPTIONS: {value:Answer;label:string}[] = [
  8:   {value:-3,label:"Discordo totalmente"},{value:-2,label:"Discordo"},{value:-1,label:"Discordo um pouco"},
  9:   {value:0,label:"Neutro"},{value:1,label:"Concordo um pouco"},{value:2,label:"Concordo"},{value:3,label:"Concordo totalmente"},
 10:   {value:"depends",label:"Depende"},{value:"unknown",label:"Não sei"},
 11: ]
 12: const format = (value:number|null) => value === null ? "Sem dados" : `${value>0?"+":""}${value.toFixed(1).replace(".",",")}`
 13: function Compass({x,y}:{x:number|null;y:number|null}) {
 14:   return <svg className={styles.compass} viewBox="0 0 360 330" role="img" aria-label={x === null || y === null ? "Mapa sem posição: faltam respostas." : `Mapa político: economia ${format(x)}, autoridade ${format(y)}.`}>
 15:     <title>Posição econômica e relação com a autoridade</title>
 16:     <rect x="65" y="35" width="230" height="230" fill="none" stroke="currentColor" opacity=".18" />
 17:     {[-5,5].map(t=><g key={t} stroke="currentColor" opacity=".1"><path d={`M${180+t*11.5} 35V265`} /><path d={`M65 ${150+t*11.5}H295`} /></g>)}
 18:     <g stroke="currentColor" opacity=".65"><path d="M65 150H295M180 35V265" /></g>
 19:     <g fill="currentColor" fontSize="11" textAnchor="middle"><text x="180" y="20">Mais autoridade</text><text x="180" y="292">Mais liberdade</text><text x="33" y="144">Esquerda</text><text x="33" y="160">econômica</text><text x="327" y="144">Direita</text><text x="327" y="160">econômica</text><text x="75" y="166">−10</text><text x="285" y="166">+10</text><text x="193" y="49">+10</text><text x="194" y="258">−10</text><text x="190" y="166">0</text></g>
 20:     {x!==null&&y!==null&&<g><circle cx={180+x*11.5} cy={150-y*11.5} r="8" fill="var(--quiz-accent)" stroke="var(--quiz-surface)" strokeWidth="3" /><text x="180" y="319" fill="currentColor" textAnchor="middle" fontSize="12">X {format(x)} · Y {format(y)}</text></g>}
 21:   </svg>
