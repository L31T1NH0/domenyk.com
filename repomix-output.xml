104: function sourcesToText(sources?: Array<{ label?: string; url: string }>): string {
105:   return sources?.map((source) => source.label ? `${source.label} | ${source.url}` : source.url).join("\n") ?? ""
106: }
107: 
108: function sourcesFromText(value: string): Array<{ label?: string; url: string }> {
109:   return value.split("\n").flatMap((line) => {
110:     const trimmed = line.trim()
111:     if (!trimmed) return []
112:     const separator = trimmed.lastIndexOf("|")
113:     if (separator === -1) return [{ url: trimmed }]
114:     const label = trimmed.slice(0, separator).trim()
115:     const url = trimmed.slice(separator + 1).trim()
116:     return [{ url, ...(label ? { label } : {}) }]
117:   })
118: }
