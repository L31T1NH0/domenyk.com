 1: import { NextRequest, NextResponse } from "next/server"
 2: import { verifyPushSubscriptionChallenge } from "@/lib/db/push-subscriptions"
 3: import { rateLimit } from "@/lib/rate-limit"
 4: import { requestIdentity } from "@/lib/request-identity"
 5: import { isSameOriginRequest } from "@/lib/csrf"
 6: 
 7: const ALLOWED_PUSH_HOSTS = [
 8:   "fcm.googleapis.com",
 9:   "push.services.mozilla.com",
10:   "updates.push.services.mozilla.com",
11:   "notify.windows.com",
12:   "web.push.apple.com",
13:   "push.apple.com",
14: ]
15: 
16: function validEndpoint(value: unknown): value is string {
17:   if (typeof value !== "string" || value.length > 2048) return false
18:   try {
19:     const url = new URL(value)
20:     return url.protocol === "https:" && ALLOWED_PUSH_HOSTS.some((host) => (
21:       url.hostname === host || url.hostname.endsWith(`.${host}`)
22:     ))
23:   } catch {
24:     return false
25:   }
26: }
27: 
28: function validAuth(value: unknown): value is string {
29:   if (typeof value !== "string" || !/^[A-Za-z0-9_-]+$/.test(value)) return false
30:   return Buffer.from(value, "base64url").length === 16
31: }
32: 
33: export async function POST(req: NextRequest) {
34:   if (!isSameOriginRequest(req)) return NextResponse.json({ error: "Origem não permitida." }, { status: 403 })
35:   if (!(await rateLimit(`push-verify:${requestIdentity(req)}`, { limit: 10, windowMs: 60 * 60_000 }))) {
36:     return NextResponse.json({ error: "Muitas tentativas." }, { status: 429 })
37:   }
38: 
39:   const body = await req.json().catch(() => null) as {
40:     endpoint?: unknown
41:     keys?: { auth?: unknown }
42:     challengeToken?: unknown
43:   } | null
44:   if (
45:     !validEndpoint(body?.endpoint) ||
46:     !validAuth(body?.keys?.auth) ||
47:     typeof body?.challengeToken !== "string" ||
48:     !/^[A-Za-z0-9_-]{43}$/.test(body.challengeToken)
49:   ) {
50:     return NextResponse.json({ error: "Confirmação inválida." }, { status: 400 })
51:   }
52: 
53:   const verified = await verifyPushSubscriptionChallenge(
54:     body.endpoint,
55:     body.keys.auth,
56:     body.challengeToken
57:   )
58:   if (!verified) return NextResponse.json({ error: "Confirmação expirada ou inválida." }, { status: 410 })
59:   return NextResponse.json({ ok: true })
60: }
</file>

