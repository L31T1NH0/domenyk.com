<file path="src/lib/db/comment-uploads.ts">
  1: import "server-only"
  2: 
  3: import { randomUUID } from "node:crypto"
  4: import type { Filter, ObjectId } from "mongodb"
  5: import { deleteImage } from "@/lib/blob"
  6: import { getDb } from "@/lib/db/client"
  7: import { BLOB_PUBLIC_HOSTNAME } from "@/lib/blob-host"
  8: 
  9: type CommentUploadState = "pending" | "reserved" | "deleting"
 10: 
 11: type CommentUpload = {
 12:   url: string
 13:   ownerId: string
 14:   createdAt: Date
 15:   expiresAt: Date
 16:   state?: CommentUploadState
 17:   reservationId?: string
 18:   reservationExpiresAt?: Date
 19:   cleanupId?: string
 20:   cleanupLeaseExpiresAt?: Date
 21:   usedAt?: Date
 22: }
 23: 
 24: type StoredCommentReference = {
 25:   _id: ObjectId
 26:   content?: string
 27: }
 28: 
 29: export type CommentUploadClaim = Readonly<{
 30:   id: string
 31:   ownerId: string
 32:   urls: readonly string[]
 33: }>
 34: 
 35: export function commentUploadClaimMatches(
 36:   expectedUrls: readonly string[],
 37:   claim: CommentUploadClaim | null
 38: ): boolean {
 39:   const claimedUrls = claim?.urls ?? []
 40:   if (expectedUrls.length !== claimedUrls.length) return false
 41:   const claimed = new Set(claimedUrls)
 42:   return expectedUrls.every((url) => claimed.has(url))
 43: }
 44: 
 45: export type CommentUploadCleanupResult = {
 46:   deleted: number
 47:   preserved: number
 48:   failed: number
 49:   hasMore: boolean
 50: }
 51: 
 52: export type CommentImageCleanupResult = Omit<CommentUploadCleanupResult, "hasMore">
 53: 
 54: const PENDING_UPLOAD_TTL_MS = 60 * 60 * 1000
 55: const RESERVATION_TTL_MS = 10 * 60 * 1000
 56: const CLEANUP_LEASE_MS = 2 * 60 * 1000
 57: const CLEANUP_RETRY_DELAY_MS = 60 * 1000
 58: const DELETION_OUTBOX_DELAY_MS = 5 * 60 * 1000
 59: const DEFAULT_CLEANUP_BUDGET_MS = 1_500
 60: const MAX_CLEANUP_BUDGET_MS = 30_000
 61: const MAX_CLEANUP_CONCURRENCY = 4
 62: const COMMENT_BLOB_URL_PATTERN = new RegExp(
 63:   `https:\\/\\/${BLOB_PUBLIC_HOSTNAME.replace(/\./g, "\\.")}\\/comments\\/[a-z0-9._~!$&*+,;=:@%/-]+`,
 64:   "gi"
 65: )
 66: 
 67: let indexesPromise: Promise<void> | undefined
 68: 
 69: function pendingStateFilter(): Filter<CommentUpload> {
 70:   return {
 71:     $or: [
 72:       { state: "pending" },
 73:       { state: { $exists: false }, usedAt: { $exists: false } },
 74:     ],
 75:   }
 76: }
 77: 
 78: async function collection() {
 79:   const db = await getDb()
 80:   const col = db.collection<CommentUpload>("comment_uploads")
 81:   indexesPromise ??= (async () => {
 82:     await Promise.all([
 83:       col.createIndex({ url: 1 }, { unique: true }),
 84:       col.createIndex({ ownerId: 1, state: 1, expiresAt: 1 }),
 85:       col.createIndex({ state: 1, reservationExpiresAt: 1 }),
 86:       col.createIndex({ state: 1, cleanupLeaseExpiresAt: 1 }),
 87:     ])
 88: 
 89:     // Older versions retained one document for every used image forever. Once an
 90:     // upload is committed, the comment content itself is the source of truth.
 91:     await col.deleteMany({ usedAt: { $exists: true } })
 92:   })()
 93:   await indexesPromise
 94:   return col
 95: }
 96: 
 97: function escapeRegExp(value: string): string {
 98:   return value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")
 99: }
100: 
101: async function isReferencedByComment(url: string): Promise<boolean> {
102:   const db = await getDb()
103:   const comments = db.collection<StoredCommentReference>("comments")
104:   const match = await comments.findOne(
105:     { content: { $regex: escapeRegExp(url) } },
106:     { projection: { _id: 1 } }
107:   )
108:   return match !== null
109: }
110: 
111: async function queueCommentImageCleanup(
112:   url: string,
113:   delayMs = CLEANUP_RETRY_DELAY_MS
114: ): Promise<void> {
115:   const now = new Date()
116:   await (await collection()).updateOne(
117:     { url },
118:     {
119:       $set: {
120:         ownerId: "__cleanup__",
121:         expiresAt: new Date(now.getTime() + Math.max(0, delayMs)),
122:         state: "pending",
123:       },
124:       $setOnInsert: { createdAt: now },
125:       $unset: {
126:         reservationId: "",
127:         reservationExpiresAt: "",
128:         cleanupId: "",
129:         cleanupLeaseExpiresAt: "",
130:         usedAt: "",
131:       },
132:     },
133:     { upsert: true }
134:   )
135: }
136: 
137: export async function queueCommentImagesForCleanup(contents: Iterable<string>): Promise<void> {
138:   const urls = extractCommentBlobUrls(contents)
139:   if (urls.length === 0) return
140: 
141:   const col = await collection()
142:   for (let offset = 0; offset < urls.length; offset += 500) {
143:     const now = new Date()
144:     const expiresAt = new Date(now.getTime() + DELETION_OUTBOX_DELAY_MS)
145:     await col.bulkWrite(
146:       urls.slice(offset, offset + 500).map((url) => ({
147:         updateOne: {
148:           filter: { url },
149:           update: {
150:             $set: { ownerId: "__cleanup__", expiresAt, state: "pending" as const },
151:             $setOnInsert: { createdAt: now },
152:             $unset: {
153:               reservationId: "",
154:               reservationExpiresAt: "",
155:               cleanupId: "",
156:               cleanupLeaseExpiresAt: "",
157:               usedAt: "",
158:             },
159:           },
160:           upsert: true,
161:         },
162:       })),
163:       { ordered: false }
164:     )
165:   }
166: }
167: 
168: export function extractCommentBlobUrls(contents: Iterable<string>): string[] {
169:   const urls = new Set<string>()
170:   for (const content of contents) {
171:     for (const match of content.matchAll(COMMENT_BLOB_URL_PATTERN)) {
172:       urls.add(match[0])
173:     }
174:   }
175:   return [...urls]
176: }
177: 
178: export async function recordCommentUpload(url: string, ownerId: string): Promise<void> {
179:   const now = new Date()
180:   await (await collection()).insertOne({
181:     url,
182:     ownerId,
183:     createdAt: now,
184:     expiresAt: new Date(now.getTime() + PENDING_UPLOAD_TTL_MS),
185:     state: "pending",
186:   })
187: }
188: 
189: /**
190:  * Reserves the caller's pending uploads before a comment is created. The
191:  * reservation prevents cleanup from racing the database write.
192:  */
193: export async function claimCommentUploads(
194:   content: string,
195:   ownerId: string
196: ): Promise<CommentUploadClaim | null> {
197:   const col = await collection()
198:   const now = new Date()
199:   const requestedUrls = extractCommentBlobUrls([content]).slice(0, 4)
200:   if (requestedUrls.length === 0) return null
201: 
202:   const candidates = await col.find({
203:     $and: [
204:       { ownerId, url: { $in: requestedUrls }, expiresAt: { $gt: now } },
205:       pendingStateFilter(),
206:     ],
207:   }, { projection: { url: 1 } }).toArray()
208:   const availableUrls = new Set(candidates.map((upload) => upload.url))
209:   const candidateUrls = requestedUrls.filter((url) => availableUrls.has(url))
210: 
211:   if (candidateUrls.length === 0) return null
212: 
213:   const reservationId = randomUUID()
214:   await col.updateMany(
215:     {
216:       $and: [
217:         { ownerId, url: { $in: candidateUrls }, expiresAt: { $gt: now } },
218:         pendingStateFilter(),
219:       ],
220:     },
221:     {
222:       $set: {
223:         state: "reserved",
224:         reservationId,
225:         reservationExpiresAt: new Date(now.getTime() + RESERVATION_TTL_MS),
226:       },
227:     }
228:   )
229: 
230:   const reserved = await col.find(
231:     { ownerId, state: "reserved", reservationId },
232:     { projection: { url: 1 } }
233:   ).toArray()
234:   if (reserved.length === 0) return null
235: 
236:   return {
237:     id: reservationId,
238:     ownerId,
239:     urls: reserved.map((upload) => upload.url),
240:   }
241: }
242: 
243: /** Removes transient tracking after the comment has been stored successfully. */
244: export async function commitCommentUploadClaim(
245:   claim: CommentUploadClaim | null
246: ): Promise<void> {
247:   if (!claim || claim.urls.length === 0) return
248: 
249:   const col = await collection()
250:   await col.deleteMany({
251:     ownerId: claim.ownerId,
252:     state: "reserved",
253:     reservationId: claim.id,
254:     url: { $in: [...claim.urls] },
255:   })
256: 
257:   const unresolved = await col.countDocuments({
258:     ownerId: claim.ownerId,
259:     url: { $in: [...claim.urls] },
260:   }, { limit: 1 })
261:   if (unresolved > 0) {
262:     throw new Error("Unable to commit all comment uploads")
263:   }
264: }
265: 
266: /** Restores a reservation after the comment write fails. */
267: export async function releaseCommentUploadClaim(
268:   claim: CommentUploadClaim | null
269: ): Promise<void> {
270:   if (!claim || claim.urls.length === 0) return
271: 
272:   await (await collection()).updateMany(
273:     {
274:       ownerId: claim.ownerId,
275:       state: "reserved",
276:       reservationId: claim.id,
277:       url: { $in: [...claim.urls] },
278:     },
279:     {
280:       $set: { state: "pending" },
281:       $unset: { reservationId: "", reservationExpiresAt: "" },
282:     }
283:   )
284: }
285: 
286: async function releaseExpiredReservations(now: Date): Promise<void> {
287:   await (await collection()).updateMany(
288:     { state: "reserved", reservationExpiresAt: { $lte: now } },
289:     {
290:       $set: { state: "pending" },
291:       $unset: { reservationId: "", reservationExpiresAt: "" },
292:     }
293:   )
294: }
295: 
296: async function acquireExpiredUpload(): Promise<CommentUpload | null> {
297:   const col = await collection()
298:   const now = new Date()
299:   const cleanupId = randomUUID()
300:   return col.findOneAndUpdate(
301:     {
302:       $or: [
303:         {
304:           $and: [
305:             pendingStateFilter(),
306:             { expiresAt: { $lte: now } },
307:           ],
308:         },
309:         {
310:           $and: [
311:             { state: "deleting" },
312:             {
313:               $or: [
314:                 { cleanupLeaseExpiresAt: { $lte: now } },
315:                 { cleanupLeaseExpiresAt: { $exists: false } },
316:               ],
317:             },
318:           ],
319:         },
320:       ],
321:     },
322:     {
323:       $set: {
324:         state: "deleting",
325:         cleanupId,
326:         cleanupLeaseExpiresAt: new Date(now.getTime() + CLEANUP_LEASE_MS),
327:       },
328:       $unset: { reservationId: "", reservationExpiresAt: "" },
329:     },
330:     { returnDocument: "after", sort: { expiresAt: 1 } }
331:   )
332: }
333: 
334: async function cleanupLeasedUpload(
335:   upload: CommentUpload
336: ): Promise<"deleted" | "preserved" | "failed"> {
337:   const col = await collection()
338:   const leaseFilter = {
339:     url: upload.url,
340:     state: "deleting" as const,
341:     cleanupId: upload.cleanupId,
342:   }
343: 
344:   try {
345:     if (await isReferencedByComment(upload.url)) {
346:       await col.deleteOne(leaseFilter)
347:       return "preserved"
348:     }
349: 
350:     await deleteImage(upload.url)
351:     await col.deleteOne(leaseFilter)
352:     return "deleted"
353:   } catch {
354:     await col.updateOne(
355:       leaseFilter,
356:       {
357:         $set: {
358:           cleanupLeaseExpiresAt: new Date(Date.now() + CLEANUP_RETRY_DELAY_MS),
359:         },
360:         $unset: { cleanupId: "" },
361:       }
362:     ).catch(() => undefined)
363:     return "failed"
364:   }
365: }
366: 
367: /**
368:  * Cleans expired uploads using short atomic leases. Work is time-bounded rather
369:  * than item-bounded, so a large backlog keeps making progress without allowing
370:  * one request to run indefinitely. A cron route can pass a larger budget.
371:  */
372: export async function cleanupExpiredCommentUploads(
373:   options: { maxDurationMs?: number; concurrency?: number } = {}
374: ): Promise<CommentUploadCleanupResult> {
375:   const maxDurationMs = Math.max(
376:     100,
377:     Math.min(options.maxDurationMs ?? DEFAULT_CLEANUP_BUDGET_MS, MAX_CLEANUP_BUDGET_MS)
378:   )
379:   const concurrency = Math.max(
380:     1,
381:     Math.min(Math.floor(options.concurrency ?? 2), MAX_CLEANUP_CONCURRENCY)
382:   )
383:   const deadline = Date.now() + maxDurationMs
384:   const result = { deleted: 0, preserved: 0, failed: 0 }
385: 
386:   await releaseExpiredReservations(new Date())
387: 
388:   const worker = async () => {
389:     while (Date.now() < deadline) {
390:       const upload = await acquireExpiredUpload()
391:       if (!upload) return
392: 
393:       const outcome = await cleanupLeasedUpload(upload)
394:       result[outcome] += 1
395:     }
396:   }
397:   await Promise.all(Array.from({ length: concurrency }, () => worker()))
398: 
399:   const col = await collection()
400:   const now = new Date()
401:   const hasMore = (await col.countDocuments({
402:     $or: [
403:       {
404:         $and: [
405:           pendingStateFilter(),
406:           { expiresAt: { $lte: now } },
407:         ],
408:       },
409:       { state: "deleting" },
410:     ],
411:   }, { limit: 1 })) > 0
412: 
413:   return { ...result, hasMore }
414: }
415: 
416: /**
417:  * Deletes comment Blobs no longer referenced after one comment was removed.
418:  * Call this only after the corresponding comment database write succeeds.
419:  */
420: export async function deleteCommentImagesFromContent(
421:   content: string
422: ): Promise<CommentImageCleanupResult> {
423:   return deleteCommentImagesFromContents([content])
424: }
425: 
426: /**
427:  * Cascade helper for deleting a post/note and its comments. Pass the deleted
428:  * comments' raw Markdown after the database deletion has succeeded.
429:  */
430: export async function deleteCommentImagesFromContents(
431:   contents: Iterable<string>
432: ): Promise<CommentImageCleanupResult> {
433:   const urls = extractCommentBlobUrls(contents)
434:   const result = { deleted: 0, preserved: 0, failed: 0 }
435:   let nextIndex = 0
436: 
437:   const worker = async () => {
438:     while (nextIndex < urls.length) {
439:       const index = nextIndex
440:       nextIndex += 1
441:       const url = urls[index]
442: 
443:       try {
444:         if (await isReferencedByComment(url)) {
445:           result.preserved += 1
446:           continue
447:         }
448: 
449:         await deleteImage(url)
450:         await (await collection()).deleteOne({ url })
451:         result.deleted += 1
452:       } catch {
453:         await queueCommentImageCleanup(url).catch(() => undefined)
454:         result.failed += 1
455:       }
456:     }
457:   }
458: 
459:   await Promise.all(Array.from(
460:     { length: Math.min(MAX_CLEANUP_CONCURRENCY, urls.length) },
461:     () => worker()
462:   ))
463:   return result
464: }
</file>

