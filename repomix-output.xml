472: /** Full-fidelity Markdown representation for the v5 image model. */
473: export const HTML_IMAGE_TRANSFORMER: ElementTransformer = {
474:   type: "element",
475:   dependencies: [ImageNode],
476:   regExp: /^<figure\b.*<\/figure>$/,
477:   export(node) {
478:     const image = imageNodeFromTransformerTarget(node)
479:     if (!image) return null
480:     const d = image.exportJSON()
481:     const f = d.formatting ?? {}
482:     if (!Object.keys(f).length && !(d.layout !== "block" && d.caption)) return null
483:     const attr = (name: string, value: string | number | undefined) => value === undefined || value === "" ? "" : ` ${name}="${escapeHtmlAttribute(String(value))}"`
484:     const width = f.width ?? (d.layout === "block" ? d.blockWidth : d.flowWidth)
485:     const layout = d.layout === "block" ? attr("data-editor-image", d.alignment) : attr("data-flow-image", d.layout === "flow-left" ? "left" : "right")
486:     return `<figure${layout}${attr("data-image-width", width)}${attr("data-image-unit", f.unit ?? "%")}${attr("data-image-gap", f.gap ?? 16)}${attr("data-image-theme", d.themeMode === "adaptive-monochrome" ? "adaptive" : undefined)}${attr("class", f.figureClass)}${attr("style", f.figureStyle)}><img${attr("src", d.src)} alt="${escapeHtmlAttribute(d.alt ?? "")}"${attr("class", f.imageClass)}${attr("style", f.imageStyle)}>${d.caption ? `<figcaption${attr("class", f.captionClass)}${attr("style", f.captionStyle)}>${escapeHtmlAttribute(d.caption)}</figcaption>` : ""}</figure>`
487:   },
488:   replace(parent, _children, match) {
489:     const tree = fromHtml(match[0], { fragment: true })
490:     const figure = tree.children.find((node): node is Element => node.type === "element" && node.tagName === "figure")
491:     const img = figure?.children.find((node): node is Element => node.type === "element" && node.tagName === "img")
492:     if (!figure || !img) return false
493:     const caption = figure.children.find((node): node is Element => node.type === "element" && node.tagName === "figcaption")
494:     const p = figure.properties
495:     const side = p.dataFlowImage
496:     const node = $createImageNode(String(img.properties.src ?? ""), String(img.properties.alt ?? ""), side === "left" ? "flow-left" : side === "right" ? "flow-right" : "block", normalizeFlowWidth(p.dataFlowWidth), p.dataImageTheme === "adaptive" ? "adaptive-monochrome" : "original")
497:     node.setBlockWidth(imageNumber(p.dataEditorWidth, 100, 100))
498:     node.setAlignment(p.dataEditorImage as "left" | "center" | "right")
499:     node.setCaption(caption?.children.map(child => child.type === "text" ? child.value : "").join("") ?? "")
500:     const classes = (element?: Element) => Array.isArray(element?.properties.className) ? element.properties.className.join(" ") : String(element?.properties.className ?? "")
501:     node.setFormatting({
502:       width: imageNumber(p.dataImageWidth ?? (side ? p.dataFlowWidth : p.dataEditorWidth), side ? 42 : 100),
503:       unit: p.dataImageUnit === "px" ? "px" : "%", gap: imageNumber(p.dataImageGap, 16, 256),
504:       figureClass: classes(figure), figureStyle: String(p.style ?? ""),
505:       imageClass: classes(img), imageStyle: String(img.properties.style ?? ""),
506:       captionClass: classes(caption), captionStyle: String(caption?.properties.style ?? ""),
507:     })
508:     parent.replace(node)
509:   },
510: }
