<file path="src/components/post/PostMetaBar.tsx">
  1: "use client"
  2: 
  3: import { useEffect, useMemo, useState } from "react"
  4: import { ClockIcon, EyeIcon, ShareIcon } from "@heroicons/react/24/solid"
  5: import type { PostLocale } from "@/lib/post-locales"
  6: import { viewClientContext } from "@/lib/view-referrer"
  7: import { recordCurrentPostAction, setPostEngagement } from "@/lib/post-engagement"
  8: import { qualifiesPostView } from "@/lib/post-view-qualification"
  9: 
 10: type Props = {
 11:   publicId: string
 12:   dateLabel?: string
 13:   readingTime: string
 14:   initialViews?: number
 15:   locale?: PostLocale
 16:   variant?: "default" | "editorial"
 17: }
 18: 
 19: const VIEW_TTL_MS = 24 * 60 * 60 * 1000
 20: const pendingViewPublicIds = new Set<string>()
 21: 
 22: const labels: Record<PostLocale, { readingTime: string; views: string; share: string; copied: string }> = {
 23:   pt: { readingTime: "Tempo de leitura", views: "views", share: "Compartilhar", copied: "Copiado" },
 24:   en: { readingTime: "Reading time", views: "views", share: "Share", copied: "Copied" },
 25:   de: { readingTime: "Lesezeit", views: "Aufrufe", share: "Teilen", copied: "Kopiert" },
 26:   id: { readingTime: "Waktu baca", views: "tayangan", share: "Bagikan", copied: "Tersalin" },
 27: }
 28: 
 29: export function PostMetaBar({ publicId, dateLabel, readingTime, initialViews = 0, locale = "pt", variant = "default" }: Props) {
 30:   const [views, setViews] = useState(initialViews)
 31:   const [copied, setCopied] = useState(false)
 32:   const copy = labels[locale]
 33: 
 34:   useEffect(() => {
 35:     const storageKey = `post-viewed:${publicId}`
 36:     const previousView = Number(localStorage.getItem(storageKey) ?? 0)
 37: 
 38:     if (pendingViewPublicIds.has(publicId) || (previousView && Date.now() - previousView < VIEW_TTL_MS)) {
 39:       return
 40:     }
 41: 
 42:     let cancelled = false
 43:     let activeSeconds = 0
 44:     let baselineProgress: number | null = null
 45:     let progress = 0
 46:     let interacted = false
 47:     let requestStarted = false
 48: 
 49:     function currentProgress() {
 50:       const content = document.querySelector<HTMLElement>("[data-post-content]")
 51:       if (!content) return null
 52:       const contentTop = content.getBoundingClientRect().top + window.scrollY
 53:       const totalScrollable = Math.max(content.scrollHeight - window.innerHeight, 1)
 54:       return Math.min(1, Math.max(0, (window.scrollY - contentTop) / totalScrollable))
 55:     }
 56: 
 57:     function measureProgress() {
 58:       const current = currentProgress()
 59:       if (current === null) return
 60:       baselineProgress ??= current
 61:       progress = Math.max(progress, Math.abs(current - baselineProgress))
 62:     }
 63: 
 64:     function countQualifiedView() {
 65:       if (requestStarted) return
 66:       measureProgress()
 67:       if (!qualifiesPostView({ activeSeconds, progress, interacted })) return
 68:       requestStarted = true
 69: 
 70:       if (pendingViewPublicIds.has(publicId)) return
 71:       pendingViewPublicIds.add(publicId)
 72: 
 73:       fetch(`/api/posts/${encodeURIComponent(publicId)}/view`, {
 74:         method: "POST",
 75:         cache: "no-store",
 76:         headers: { "Content-Type": "application/json" },
 77:         body: JSON.stringify({
 78:           locale,
 79:           ...viewClientContext(),
 80:           activeSeconds,
 81:           progress,
 82:           interacted,
 83:         }),
 84:       })
 85:         .then((res) => (res.ok ? res.json() : null))
 86:         .then((post) => {
 87:           if (!cancelled && typeof post?.views === "number") {
 88:             setViews(post.views)
 89:             localStorage.setItem(storageKey, String(Date.now()))
 90:             if (typeof post.readingToken === "string") setPostEngagement(publicId, post.readingToken)
 91:           }
 92:         })
 93:         .finally(() => {
 94:           pendingViewPublicIds.delete(publicId)
 95:         })
 96:         .catch(() => {})
 97:     }
 98: 
 99:     function onProgress() {
100:       measureProgress()
101:       countQualifiedView()
102:     }
103: 
104:     function onInteraction() {
105:       interacted = true
106:       countQualifiedView()
107:     }
108: 
109:     measureProgress()
110:     const timer = window.setInterval(() => {
111:       if (document.visibilityState === "visible" && document.hasFocus()) activeSeconds += 1
112:       countQualifiedView()
113:     }, 1000)
114: 
115:     window.addEventListener("scroll", onProgress, { passive: true })
116:     window.addEventListener("pointerdown", onInteraction, { passive: true })
117:     window.addEventListener("keydown", onInteraction)
118: 
119:     return () => {
120:       cancelled = true
121:       window.clearInterval(timer)
122:       window.removeEventListener("scroll", onProgress)
123:       window.removeEventListener("pointerdown", onInteraction)
124:       window.removeEventListener("keydown", onInteraction)
125:     }
126:   }, [locale, publicId])
