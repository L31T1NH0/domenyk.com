157:           className="fixed z-[120] w-[min(18rem,calc(100vw-1.5rem))] rounded-[10px] border border-zinc-200 bg-white p-1.5 text-zinc-950 shadow-[0_4px_8px_rgb(0_0_0_/_0.12)] dark:border-zinc-800 dark:bg-zinc-950 dark:text-zinc-100 dark:shadow-[0_4px_8px_rgb(0_0_0_/_0.45)]"
158:         >
