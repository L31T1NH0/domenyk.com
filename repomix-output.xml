 99: function ArchiveMonth({
100:   year,
101:   month,
102:   count,
103:   searchQuery,
104:   feedMode,
105: }: {
106:   year: number
107:   month: number
108:   count: number
109:   searchQuery: string
110:   feedMode: "all" | "posts" | "notes"
111: }) {
112:   const contentId = useId()
113:   const [isOpen, setIsOpen] = useState(false)
114:   const [items, setItems] = useState<TimelineArchiveItem[]>([])
115:   const [status, setStatus] = useState<ArchiveLoadStatus>("idle")
116:   const [hasMore, setHasMore] = useState(count > 0)
117: 
118:   async function loadMore() {
119:     if (status === "loading" || !hasMore) return
120:     setStatus("loading")
121: 
122:     try {
123:       const params = new URLSearchParams({
124:         year: String(year),
125:         month: String(month),
126:         offset: String(items.length),
127:         mode: feedMode,
128:       })
129:       if (searchQuery) params.set("q", searchQuery)
130:       const response = await fetch(`/api/archive?${params.toString()}`)
131:       const data = await response.json().catch(() => null) as {
132:         items?: TimelineArchiveItem[]
133:         hasMore?: boolean
134:         error?: string
135:       } | null
136:       if (!response.ok || !Array.isArray(data?.items)) {
137:         throw new Error(data?.error ?? "Não foi possível carregar o arquivo.")
138:       }
139: 
140:       setItems((current) => [
141:         ...current,
142:         ...data.items!.filter((item) => !current.some((existing) => existing.id === item.id && existing.type === item.type)),
143:       ])
144:       setHasMore(data.hasMore === true)
145:       setStatus("ready")
146:     } catch {
147:       setStatus("error")
148:     }
149:   }
150: 
151:   return (
152:     <div>
153:       <button
154:         type="button"
155:         aria-expanded={isOpen}
156:         aria-controls={contentId}
