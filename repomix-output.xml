110: function detectImageType(data: Buffer): string | null {
111:   if (data.subarray(0, 3).equals(Buffer.from([0xff, 0xd8, 0xff]))) return "image/jpeg"
112:   if (data.subarray(0, 8).equals(Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]))) {
113:     return "image/png"
114:   }
115:   if (
116:     data.subarray(0, 4).toString("ascii") === "RIFF" &&
117:     data.subarray(8, 12).toString("ascii") === "WEBP"
118:   ) {
119:     return "image/webp"
120:   }
121:   const start = data.subarray(0, Math.min(data.length, 512)).toString("utf8").replace(/^\uFEFF/, "").trimStart()
122:   if (/^(?:<\?xml[\s\S]*?\?>\s*)?<svg(?:\s|>)/i.test(start)) return "image/svg+xml"
123:   return null
124: }
