429: function pathMatchesPrefix(pathname: string, prefix: string): boolean {
430:   if (prefix === "/") return true
431:   if (prefix.endsWith("/")) return pathname.startsWith(prefix)
432:   return pathname === prefix || pathname.startsWith(`${prefix}/`)
433: }
