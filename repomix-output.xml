<file path="src/app/api/quiz/route.ts">
 1: import { calculate, validateAnswers } from "@/lib/quiz/calculate.server"
 2: import { QUIZ_VERSION } from "@/lib/quiz/types"
 3: import { isSameOriginRequest } from "@/lib/csrf"
 4: export async function POST(request: Request) {
 5:   if (!isSameOriginRequest(request)) return Response.json({error:"Origem inválida."},{status:403})
 6:   // O cálculo é puro e não grava respostas políticas em logs ou no banco.
 7:   const reader = request.body?.getReader()
 8:   let body = "", size = 0
 9:   const decoder = new TextDecoder()
10:   if (reader) {
11:     try {
12:       while (true) {
13:         const {value,done} = await reader.read()
14:         if (done) break
15:         size += value.byteLength
16:         if (size > 4096) {
17:           await reader.cancel()
18:           return Response.json({error:"Envio muito grande."},{status:413})
19:         }
20:         body += decoder.decode(value,{stream:true})
21:       }
22:       body += decoder.decode()
23:     } catch { return Response.json({error:"Não foi possível ler o envio."},{status:400}) }
24:     finally { reader.releaseLock() }
25:   }
26:   let payload
27:   try { payload = JSON.parse(body) } catch { return Response.json({error:"Envio inválido."},{status:400}) }
28:   if (!payload || payload.quiz_version !== QUIZ_VERSION || !validateAnswers(payload.answers)) {
29:     return Response.json({error:"Confira a versão e responda às 60 perguntas."},{status:400})
30:   }
31:   return Response.json(calculate(payload.answers),{headers:{"Cache-Control":"no-store"}})
32: }
</file>

