768: export async function renderMarkdown(content: string, options: MarkdownRenderOptions = {}): Promise<string> {
769:   const html = isHtmlContent(content)
770:   const result = await createProcessor(options, undefined, html).process(content)
771:   return withPublicationCss(String(result), content, html)
772: }
