 73:           ["Seus dispositivos", counts.adminDevices],
 74:         ].map(([label, value]) => <div key={label}><span>{label}</span><strong>{value}</strong></div>)}
 75:       </section>
 76: 
 77:       <AdminNotificationSettings
 78:         initialPushSiteVisits={visitSettings.pushEnabled}
 79:         initialStoreSiteVisits={visitSettings.storeInHistory}
 80:         webhookConfigured={Boolean(process.env.CLERK_WEBHOOK_SIGNING_SECRET?.trim())}
 81:       />
 82: 
 83:       <ManualPushComposer content={content} />
 84: 
 85:       <div className="admin-notification-grid">
 86:         <div className="admin-notification-devices">
 87:           <section className="admin-workspace-panel">
 88:             <header className="admin-workspace-header"><div><h2>Este dispositivo</h2><p>Alertas administrativos e publicações</p></div></header>
 89:             <div className="admin-block-body"><PushSubscriptionManager showAdminEvents /></div>
 90:           </section>
 91: 
 92:           <section className="admin-workspace-panel">
 93:             <header className="admin-workspace-header"><div><h2>Dispositivos administrativos</h2><p>Revogue o acesso privado de aparelhos que você não usa mais</p></div></header>
 94:             <AdminPushDevices devices={devices} />
 95:           </section>
 96:         </div>
 97: 
 98:         <section className="admin-workspace-panel admin-notification-history">
 99:           <header className="admin-workspace-header"><div><h2>Disparos recentes</h2><p>{campaigns.length} registros</p></div></header>
100:           {campaigns.length === 0 ? <p className="admin-empty">Nenhuma notificação enviada ainda.</p> : campaigns.map((campaign) => (
101:             <div key={campaign._id.toString()} className="admin-push-campaign">
102:               <div><strong>{campaign.title}</strong><span>{campaign.source === "manual" ? "Manual" : "Automático"} · {campaign.topic === "posts" ? "Posts" : "Notas"}</span></div>
103:               <div><span>{campaign.sentCount} enviados · {campaign.failedCount} falhas</span><time>{campaign.createdAt.toLocaleString("pt-BR", { dateStyle: "short", timeStyle: "short", timeZone: "America/Fortaleza" })}</time></div>
104:             </div>
105:           ))}
106:         </section>
107:       </div>
108:     </>
