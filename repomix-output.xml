<file path="src/lib/comment-policy.ts">
 1: export const MIN_COMMENT_ACCOUNT_AGE_MS = 60 * 60 * 1000
 2: 
 3: export type CommentAccountPolicyInput = {
 4:   admin: boolean
 5:   emailVerified: boolean
 6:   createdAt: Date
 7: }
 8: 
 9: export type CommentAccountPolicyResult =
10:   | { allowed: true; newAccount: boolean }
11:   | { allowed: false; reason: "email_unverified" | "account_too_new" }
12: 
13: export function commentAccountPolicy(
14:   input: CommentAccountPolicyInput,
15:   now = Date.now()
16: ): CommentAccountPolicyResult {
17:   if (input.admin) return { allowed: true, newAccount: false }
18:   if (!input.emailVerified) return { allowed: false, reason: "email_unverified" }
19: 
20:   const ageMs = Math.max(0, now - input.createdAt.getTime())
21:   if (ageMs < MIN_COMMENT_ACCOUNT_AGE_MS) {
22:     return { allowed: false, reason: "account_too_new" }
23:   }
24: 
25:   return { allowed: true, newAccount: ageMs < 24 * 60 * 60 * 1000 }
26: }
</file>

<file path="src/lib/csrf.ts">
 1: type RequestMetadata = {
 2:   method: string
 3:   url: string
 4:   headers: Pick<Headers, "get">
 5: }
 6: 
 7: const SAFE_METHODS = new Set(["GET", "HEAD", "OPTIONS"])
 8: 
 9: function headerOrigin(value: string | null): string | null {
10:   if (!value) return null
11:   try {
12:     return new URL(value).origin
13:   } catch {
14:     return null
15:   }
16: }
17: 
18: export function isMutationMethod(method: string): boolean {
19:   return !SAFE_METHODS.has(method.toUpperCase())
20: }
21: 
22: export function isSameOriginRequest(
23:   request: RequestMetadata,
24:   enforce = process.env.NODE_ENV === "production"
25: ): boolean {
26:   if (!enforce) return true
27: 
28:   const targetOrigin = new URL(request.url).origin
29:   const fetchSite = request.headers.get("sec-fetch-site")
30:   const origin = headerOrigin(request.headers.get("origin"))
31: 
32:   if (fetchSite && fetchSite !== "same-origin") return false
33:   if (origin) return origin === targetOrigin
34:   if (request.headers.get("origin")) return false
35:   if (fetchSite === "same-origin") return true
36: 
37:   const referer = headerOrigin(request.headers.get("referer"))
38:   return referer === targetOrigin
39: }
40: 
41: export function shouldBlockApiMutation(
42:   request: RequestMetadata,
43:   enforce = process.env.NODE_ENV === "production"
44: ): boolean {
45:   return isMutationMethod(request.method) && !isSameOriginRequest(request, enforce)
46: }
</file>

