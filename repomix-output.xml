<file path="src/lib/db/activity.ts">
  1: import "server-only"
  2: 
  3: import { ObjectId } from "mongodb"
  4: import { getDb } from "./client"
  5: import { shiftSiteDateKey, siteDateKey, startOfSiteDay } from "../datetime"
  6: 
  7: type ActivityEventType = "post_view" | "comment_created"
  8: 
  9: export type ActivityEvent = {
 10:   _id: ObjectId
 11:   type: ActivityEventType
 12:   occurredAt: Date
 13:   visitorKey: string
 14:   isAuthenticated: boolean
 15:   userId?: string
 16:   userName?: string
 17:   postId?: ObjectId
 18:   postPublicId?: string
 19:   postSlug?: string
 20:   postTitle?: string
 21:   locale?: string
 22:   retentionUntil: Date
 23: }
 24: 
 25: const ACTIVITY_RETENTION_MS = 90 * 24 * 60 * 60_000
 26: 
 27: let indexesPromise: Promise<void> | undefined
 28: 
 29: async function collection() {
 30:   const db = await getDb()
 31:   const col = db.collection<ActivityEvent>("activity_events")
 32:   indexesPromise ??= Promise.all([
 33:     col.createIndex({ occurredAt: -1 }),
 34:     col.createIndex({ type: 1, occurredAt: -1 }),
 35:     col.createIndex({ postPublicId: 1, occurredAt: -1 }),
 36:     col.createIndex({ visitorKey: 1, occurredAt: -1 }),
 37:     col.createIndex(
 38:       { retentionUntil: 1 },
 39:       { expireAfterSeconds: 0, name: "activity_events_retention" }
 40:     ),
 41:     col.updateMany(
 42:       { retentionUntil: { $exists: false } },
 43:       { $set: { retentionUntil: new Date(Date.now() + ACTIVITY_RETENTION_MS) } }
 44:     ),
 45:   ]).then(() => undefined)
 46:   await indexesPromise
 47:   return col
 48: }
 49: 
 50: export async function recordActivityEvent(event: Omit<ActivityEvent, "_id" | "occurredAt" | "retentionUntil">) {
 51:   const now = new Date()
 52:   await (await collection()).insertOne({
 53:     ...event,
 54:     occurredAt: now,
 55:     retentionUntil: new Date(now.getTime() + ACTIVITY_RETENTION_MS),
 56:   } as ActivityEvent)
 57: }
 58: 
 59: export type ActivityDashboard = {
 60:   totals: { views: number; comments: number; visitors: number; authenticated: number }
 61:   days: Array<{ date: string; views: number; comments: number }>
 62:   topPosts: Array<{ publicId: string; slug: string; title: string; views: number; comments: number }>
 63:   recent: Array<{
 64:     id: string
 65:     type: ActivityEventType
 66:     occurredAt: string
 67:     isAuthenticated: boolean
 68:     userName?: string
 69:     postSlug?: string
 70:     postTitle?: string
 71:     locale?: string
 72:   }>
 73: }
 74: 
 75: export async function getActivityDashboard(days = 14): Promise<ActivityDashboard> {
 76:   const col = await collection()
 77:   const currentDateKey = siteDateKey()
 78:   const firstDateKey = shiftSiteDateKey(currentDateKey, -(days - 1))
 79:   const since = startOfSiteDay(new Date(), -(days - 1))
 80: 
 81:   const [byDay, totalsRow, topPosts, recent] = await Promise.all([
 82:     col.aggregate<{ _id: { date: string; type: ActivityEventType }; count: number }>([
 83:       { $match: { occurredAt: { $gte: since } } },
 84:       { $group: { _id: { date: { $dateToString: { format: "%Y-%m-%d", date: "$occurredAt", timezone: "America/Fortaleza" } }, type: "$type" }, count: { $sum: 1 } } },
 85:     ]).toArray(),
 86:     col.aggregate<{ views: number; comments: number; visitors: string[]; authenticated: number }>([
 87:       { $match: { occurredAt: { $gte: since } } },
 88:       { $group: {
 89:         _id: null,
 90:         views: { $sum: { $cond: [{ $eq: ["$type", "post_view"] }, 1, 0] } },
 91:         comments: { $sum: { $cond: [{ $eq: ["$type", "comment_created"] }, 1, 0] } },
 92:         visitors: { $addToSet: "$visitorKey" },
 93:         authenticated: { $sum: { $cond: ["$isAuthenticated", 1, 0] } },
 94:       } },
 95:     ]).next(),
 96:     col.aggregate<{ _id: string; slug: string; title: string; views: number; comments: number }>([
 97:       { $match: { occurredAt: { $gte: since }, postPublicId: { $type: "string" } } },
 98:       { $group: {
 99:         _id: "$postPublicId", slug: { $last: "$postSlug" }, title: { $last: "$postTitle" },
100:         views: { $sum: { $cond: [{ $eq: ["$type", "post_view"] }, 1, 0] } },
101:         comments: { $sum: { $cond: [{ $eq: ["$type", "comment_created"] }, 1, 0] } },
102:       } },
103:       { $sort: { views: -1, comments: -1 } }, { $limit: 5 },
104:     ]).toArray(),
105:     col.find({}).sort({ occurredAt: -1 }).limit(12).toArray(),
106:   ])
107: 
108:   const dayMap = new Map(byDay.map((row) => [`${row._id.date}:${row._id.type}`, row.count]))
109:   const dayRows = Array.from({ length: days }, (_, index) => {
110:     const key = shiftSiteDateKey(firstDateKey, index)
111:     return { date: key, views: dayMap.get(`${key}:post_view`) ?? 0, comments: dayMap.get(`${key}:comment_created`) ?? 0 }
112:   })
113: 
114:   return {
115:     totals: { views: totalsRow?.views ?? 0, comments: totalsRow?.comments ?? 0, visitors: totalsRow?.visitors.length ?? 0, authenticated: totalsRow?.authenticated ?? 0 },
116:     days: dayRows,
117:     topPosts: topPosts.map((row) => ({ publicId: row._id, slug: row.slug, title: row.title, views: row.views, comments: row.comments })),
118:     recent: recent.map((event) => ({ id: event._id.toString(), type: event.type, occurredAt: event.occurredAt.toISOString(), isAuthenticated: event.isAuthenticated, userName: event.userName, postSlug: event.postSlug, postTitle: event.postTitle, locale: event.locale })),
119:   }
120: }
</file>

<file path="src/lib/db/push-subscriptions.ts">
  1: import "server-only"
  2: 
  3: import { createHash, randomBytes, timingSafeEqual } from "node:crypto"
  4: import { ObjectId } from "mongodb"
  5: import { getDb } from "./client"
  6: import {
  7:   normalizeAdminPushTopics,
  8:   type AdminPushTopic,
  9: } from "../notification-events"
 10: 
 11: export const PUSH_TOPICS = ["posts", "notes"] as const
 12: export type PushTopic = (typeof PUSH_TOPICS)[number]
 13: 
 14: export type StoredPushSubscription = {
 15:   _id: ObjectId
 16:   endpoint: string
 17:   expirationTime: number | null
 18:   keys: { p256dh: string; auth: string }
 19:   authHash?: string
 20:   topics: PushTopic[]
 21:   status?: "pending" | "active"
 22:   challengeTokenHash?: string
 23:   challengeExpiresAt?: Date
 24:   verifiedAt?: Date
 25:   adminEvents: boolean
 26:   adminTopics?: AdminPushTopic[]
 27:   adminUserId?: string
 28:   adminVerifiedAt?: Date
 29:   messageEvents: boolean
 30:   messageUserId?: string
 31:   messageVerifiedAt?: Date
 32:   userAgent?: string
 33:   failureCount: number
 34:   lastSuccessAt?: Date
 35:   createdAt: Date
 36:   updatedAt: Date
 37:   retentionUntil: Date
 38: }
 39: 
 40: export type PushCampaign = {
 41:   _id: ObjectId
 42:   dedupeKey: string
 43:   source: "automatic" | "manual"
 44:   topic: PushTopic
 45:   contentType: "post" | "note"
 46:   contentId: string
 47:   title: string
 48:   body: string
 49:   url: string
 50:   status: "sending" | "sent" | "failed"
 51:   sentCount: number
 52:   failedCount: number
 53:   createdAt: Date
 54:   completedAt?: Date
 55:   retentionUntil: Date
 56: }
 57: 
 58: const SUBSCRIPTION_RETENTION_MS = 365 * 24 * 60 * 60_000
 59: const PENDING_SUBSCRIPTION_RETENTION_MS = 24 * 60 * 60_000
 60: const PUSH_CHALLENGE_TTL_MS = 10 * 60_000
 61: const CAMPAIGN_RETENTION_MS = 180 * 24 * 60 * 60_000
 62: 
 63: function retentionDate(duration: number) {
 64:   return new Date(Date.now() + duration)
 65: }
 66: 
 67: let subscriptionIndexes: Promise<unknown> | undefined
 68: let campaignIndexes: Promise<unknown> | undefined
 69: 
 70: async function subscriptions() {
 71:   const col = (await getDb()).collection<StoredPushSubscription>("push_subscriptions")
 72:   subscriptionIndexes ??= Promise.all([
 73:     col.createIndex({ endpoint: 1 }, { unique: true }),
 74:     col.createIndex({ topics: 1, updatedAt: -1 }),
 75:     col.createIndex({ adminEvents: 1, adminUserId: 1 }),
 76:     col.createIndex({ adminTopics: 1, adminUserId: 1 }),
 77:     col.createIndex({ messageEvents: 1, messageUserId: 1 }),
 78:     col.createIndex({ retentionUntil: 1 }, { expireAfterSeconds: 0 }),
 79:     col.createIndex({ status: 1, challengeExpiresAt: 1 }),
 80:     col.updateMany(
 81:       { status: { $exists: false } },
 82:       { $set: { status: "active", verifiedAt: new Date() } }
 83:     ),
 84:     col.updateMany(
 85:       { retentionUntil: { $exists: false } },
 86:       { $set: { retentionUntil: retentionDate(SUBSCRIPTION_RETENTION_MS) } }
 87:     ),
 88:   ])
 89:   await subscriptionIndexes
 90:   return col
 91: }
 92: 
 93: async function campaigns() {
 94:   const col = (await getDb()).collection<PushCampaign>("push_campaigns")
 95:   campaignIndexes ??= Promise.all([
 96:     col.createIndex({ dedupeKey: 1 }, { unique: true }),
 97:     col.createIndex({ createdAt: -1 }),
 98:     col.createIndex({ retentionUntil: 1 }, { expireAfterSeconds: 0 }),
 99:     col.updateMany(
100:       { retentionUntil: { $exists: false } },
101:       { $set: { retentionUntil: retentionDate(CAMPAIGN_RETENTION_MS) } }
102:     ),
103:   ])
104:   await campaignIndexes
105:   return col
106: }
