<file path="src/lib/post-reading-position.ts">
 1: export type ReadingPosition = {
 2:   contentOffset: number
 3:   progress: number
 4: }
 5: 
 6: export const POST_READING_POSITION_STORAGE_PREFIX = "domenyk:post-reading-position:"
 7: export const POST_READING_POSITION_SKIP_RESTORE_KEY = "domenyk:post-reading-position:skip-restore"
 8: export const READING_COMPLETION_THRESHOLD = 0.96
 9: 
10: const minimumReadingOffset = 320
11: const maximumReadingOffset = 560
12: const viewportReadingRatio = 0.5
13: 
14: export function getMinimumRestorableOffset(viewportHeight: number) {
15:   const safeViewportHeight = Number.isFinite(viewportHeight) && viewportHeight > 0
16:     ? viewportHeight
17:     : 0
18: 
19:   return Math.max(
20:     minimumReadingOffset,
21:     Math.min(maximumReadingOffset, safeViewportHeight * viewportReadingRatio)
22:   )
23: }
24: 
25: export function isRestorableReadingPosition(position: ReadingPosition, viewportHeight: number) {
26:   return Number.isFinite(position.contentOffset)
27:     && Number.isFinite(position.progress)
28:     && position.contentOffset >= getMinimumRestorableOffset(viewportHeight)
29:     && position.progress >= 0
30:     && position.progress < READING_COMPLETION_THRESHOLD
31: }
</file>

