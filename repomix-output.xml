405: export const FLOW_IMAGE_TRANSFORMER: ElementTransformer = {
406:   dependencies: [ImageNode],
407:   export: (node) => {
408:     const image = imageNodeFromTransformerTarget(node)
409:     if (!image || image.getLayout() === "block") return null
410:     if (Object.keys(image.__formatting).length || image.getCaption()) return HTML_IMAGE_TRANSFORMER.export(image, () => "")
411: 
412:     const side = image.getLayout() === "flow-right" ? "right" : "left"
413:     const theme = image.getThemeMode() === "adaptive-monochrome"
414:       ? ' data-image-theme="adaptive"'
