22: export function EditorialControls({ variant = "default" }: { variant?: "default" | "compact" | "comment" }) {
23:   const [editor] = useLexicalComposerContext()
24:   const [value, setValue] = useState(DEFAULT_EDITORIAL_TEXT)
25:   const selectionRef = useRef<RangeSelection | null>(null)
26: 
27:   useEffect(() => editor.registerUpdateListener(({ editorState }) => {
28:     editorState.read(() => {
29:       const selection = $getSelection()
30:       if (!$isRangeSelection(selection)) return
31:       selectionRef.current = selection.clone()
32:       const first = selectedBlocks(selection)[0]
33:       if (first) setValue(editorialTextFromStyle(first.getStyle(), first.getFormatType()))
34:     })
35:   }), [editor])
36: 
37:   function update(patch: Partial<EditorialText>) {
38:     editor.update(() => {
39:       const current = $getSelection()
40:       const selection = $isRangeSelection(current) ? current : selectionRef.current
41:       if (!selection) return
42:       $setSelection(selection.clone())
43:       for (const block of selectedBlocks(selection)) {
44:         const next = { ...editorialTextFromStyle(block.getStyle(), block.getFormatType()), ...patch }
45:         block.setFormat(next.align as ElementFormatType)
46:         block.setStyle(editorialTextStyle(next))
47:         setValue(next)
48:       }
49:     })
50:   }
51: 
52:   const AlignmentIcon = value.align === "right" ? Bars3BottomRightIcon : value.align === "center" ? Bars2Icon : value.align === "justify" ? Bars3Icon : Bars3BottomLeftIcon
53:   const choices = (values: readonly string[], unit: string) => values.map(n => ({ value: n, label: n === "auto" ? "Padrão" : `${n}${unit}` }))
54: 
55:   return <div className="editorial-toolbar-group editor-toolbar-section inline-flex min-w-0 max-w-full flex-wrap items-center gap-0.5 border-r border-neutral-500/15 px-0.5 dark:border-white/10" role="group" aria-label="Formatação de parágrafo">
56:     <EditorToolbarMenu accessibleLabel="Tamanho do texto" label={value.size === "auto" ? "Tamanho" : `${value.size}px`} value={value.size} onChange={size => update({ size })} options={choices(TEXT_SIZES, " px")} variant={variant} />
57:     <EditorToolbarMenu accessibleLabel="Alinhamento do texto" icon={<AlignmentIcon className="size-4" />} label="Alinhar" value={value.align} onChange={align => update({ align })} options={[
58:       { value: "left", label: "Esquerda", icon: <Bars3BottomLeftIcon className="size-4" /> },
59:       { value: "center", label: "Centralizado", icon: <Bars2Icon className="size-4" /> },
60:       { value: "right", label: "Direita", icon: <Bars3BottomRightIcon className="size-4" /> },
61:       { value: "justify", label: "Justificado", icon: <Bars3Icon className="size-4" /> },
62:     ]} variant={variant} />
63:     <EditorToolbarMenu accessibleLabel="Entrelinha" icon={<ArrowsUpDownIcon className="size-4" />} label="Entrelinha" value={value.leading} onChange={leading => update({ leading })} options={choices(TEXT_LEADING, "")} variant={variant} />
64:     <EditorToolbarMenu accessibleLabel="Espaço após o parágrafo" icon={<Bars3Icon className="size-4" />} label="Espaço" value={value.spacing} onChange={spacing => update({ spacing })} options={choices(TEXT_SPACING, " px")} variant={variant} />
65:     <EditorToolbarMenu accessibleLabel="Cor de fundo do parágrafo" icon={<PaintBrushIcon className="size-4" />} label="Fundo" value={value.tone} onChange={tone => update({ tone })} options={[
66:       { value: "none", label: "Sem fundo" }, { value: "neutral", label: "Neutro" }, { value: "sand", label: "Areia" }, { value: "rose", label: "Rosa" }, { value: "blue", label: "Azul" },
67:     ]} variant={variant} />
68:     <ToolbarButton variant={variant} title="Restaurar formatação do parágrafo" onClick={() => update(DEFAULT_EDITORIAL_TEXT)}>
69:       <BackspaceIcon className="size-4" aria-hidden />
70:     </ToolbarButton>
71:   </div>
72: }
