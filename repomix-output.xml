  8: import { DeleteActionMenu } from "@/components/actions/DeleteActionMenu"
  9: import type { CommentParentSummary, SerializedComment } from "@/lib/db/comments"
 10: 
 11: type AdminComment = SerializedComment & { parent: CommentParentSummary }
 12: type Filter = "all" | "post" | "note"
 13: 
 14: export function CommentsTable({ comments: initial }: { comments: AdminComment[] }) {
 15:   const [comments, setComments] = useState(initial)
 16:   const [query, setQuery] = useState("")
 17:   const [filter, setFilter] = useState<Filter>("all")
 18:   const [error, setError] = useState("")
 19:   const [detailId, setDetailId] = useState<string | null>(null)
 20:   const [detailRecord, setDetailRecord] = useState<Record<string, unknown> | null>(null)
 21:   const [detailLoading, setDetailLoading] = useState(false)
 22:   const [detailError, setDetailError] = useState("")
 23:   const detailRequest = useRef(0)
 24:   const filtered = useMemo(() => comments.filter((comment) => {
 25:     if (filter !== "all" && comment.parent.type !== filter) return false
 26:     const search = `${comment.authorName} ${comment.content} ${comment.parent.title}`.toLocaleLowerCase("pt-BR")
 27:     return search.includes(query.trim().toLocaleLowerCase("pt-BR"))
 28:   }), [comments, filter, query])
 29: 
 30:   async function remove(id: string) {
 31:     setError("")
 32:     const response = await fetch(`/api/admin/comments/${id}`, { method: "DELETE" })
 33:     if (response.ok) return setComments((current) => current.filter((comment) => comment._id !== id))
 34:     const message = "Não foi possível excluir o comentário."
 35:     setError(message)
 36:     throw new Error(message)
 37:   }
 38: 
 39:   async function toggleDetails(id: string) {
 40:     const request = ++detailRequest.current
 41:     if (detailId === id) {
 42:       setDetailId(null)
 43:       setDetailRecord(null)
 44:       setDetailError("")
 45:       return
 46:     }
 47: 
 48:     setDetailId(id)
 49:     setDetailRecord(null)
 50:     setDetailError("")
 51:     setDetailLoading(true)
 52:     const response = await fetch(`/api/admin/comments/${id}`, { cache: "no-store" })
 53:     const data = await response.json().catch(() => null) as { record?: Record<string, unknown>; error?: string } | null
 54:     if (request !== detailRequest.current) return
 55:     setDetailLoading(false)
 56:     if (!response.ok || !data?.record) return setDetailError(data?.error ?? "Não foi possível carregar os detalhes.")
 57:     setDetailRecord(data.record)
 58:   }
 59: 
 60:   function detailValue(value: unknown) {
 61:     if (value === null) return "null"
 62:     if (value === undefined) return "undefined"
 63:     if (typeof value === "string") return value
 64:     return JSON.stringify(value, null, 2)
 65:   }
 66: 
 67:   return <section className="admin-comments-workspace">
 68:     <div className="admin-records-toolbar">
 69:       <div className="admin-records-toolbar-row">
 70:         <div><strong>Comentários recentes</strong><small>{filtered.length} de {comments.length} registros</small></div>
 71:         <div className="admin-record-controls">
 72:         <label className="admin-control-search"><MagnifyingGlassIcon aria-hidden /><input value={query} onChange={(event) => setQuery(event.target.value)} placeholder="Buscar comentário, autor ou post" /></label>
 73:         <select className="admin-control" value={filter} onChange={(event) => setFilter(event.target.value as Filter)} aria-label="Filtrar pelo tipo de conteúdo">
 74:           <option value="all">Posts e notas</option><option value="post">Somente posts</option><option value="note">Somente notas</option>
 75:         </select>
 76:         </div>
 77:       </div>
 78:     </div>
 79:     {error && <p className="admin-form-error admin-comments-error" role="alert">{error}</p>}
 80:     {filtered.map((comment) => {
 81:       const publicHref = comment.parent.publicHref && comment.paragraphId
 82:         ? `${comment.parent.publicHref}#${comment.paragraphId}`
 83:         : comment.parent.publicHref
 84:       return <article key={comment._id} className="admin-comment-record">
 85:         <div className="admin-comment-message">
 86:           {comment.authorImageUrl ? <img src={comment.authorImageUrl} alt="" /> : <span className="admin-comment-avatar">{comment.authorName.slice(0, 1).toUpperCase()}</span>}
 87:           <div>
 88:             <header><strong>{comment.authorName}</strong>{comment.paragraphId && <span>Em um parágrafo</span>}</header>
 89:             <div className="note-content comment-content admin-comment-copy" dangerouslySetInnerHTML={{ __html: comment.contentHtml }} />
 90:           </div>
 91:         </div>
 92:         <div className="admin-comment-context">
 93:           <span>Em {comment.parent.type === "post" ? "post" : comment.parent.type === "note" ? "nota" : "conteúdo"}</span>
 94:           {comment.parent.adminHref ? <Link href={comment.parent.adminHref}>{comment.parent.title}</Link> : <strong>{comment.parent.title}</strong>}
 95:           {publicHref && <Link href={publicHref} target="_blank" className="admin-comment-public-link">Abrir conversa <ArrowTopRightOnSquareIcon /></Link>}
 96:         </div>
 97:         <div className="admin-comment-meta">
 98:           <time dateTime={comment.createdAt}>{formatDistanceToNow(new Date(comment.createdAt), { addSuffix: true, locale: ptBR })}</time>
 99:           <div className="admin-comment-actions"><button type="button" onClick={() => toggleDetails(comment._id)} aria-expanded={detailId === comment._id} aria-controls={`comment-details-${comment._id}`} className="admin-comment-details-button">{detailId === comment._id ? "Fechar" : "Detalhes"}</button><DeleteActionMenu title="Excluir comentário?" description={`O comentário de ${comment.authorName} será removido permanentemente.`} onDelete={() => remove(comment._id)} triggerAriaLabel={`Opções do comentário de ${comment.authorName}`} triggerClassName="admin-comment-delete" /></div>
100:         </div>
101:         {detailId === comment._id && <div id={`comment-details-${comment._id}`} className="admin-comment-details">
102:           <header><div><strong>Registro no banco de dados</strong><span>Leitura direta da coleção <code>comments</code></span></div><small>{detailRecord ? `${Object.keys(detailRecord).length} campos` : ""}</small></header>
103:           {detailLoading && <p className="admin-comment-details-state">Consultando o registro atual…</p>}
104:           {detailError && <p className="admin-form-error" role="alert">{detailError}</p>}
105:           {detailRecord && <div className="admin-comment-details-table-wrap"><table><thead><tr><th scope="col">Campo</th><th scope="col">Tipo</th><th scope="col">Valor armazenado</th></tr></thead><tbody>{Object.entries(detailRecord).map(([field, value]) => <tr key={field}><th scope="row">{field}</th><td>{value === null ? "null" : Array.isArray(value) ? "array" : typeof value}</td><td><pre>{detailValue(value)}</pre></td></tr>)}</tbody></table></div>}
106:         </div>}
107:       </article>
108:     })}
109:     {filtered.length === 0 && <p className="admin-empty">Nenhum comentário encontrado.</p>}
110:   </section>
111: }
</file>

