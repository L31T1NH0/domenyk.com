  3: import { useCallback, useEffect, useState } from "react"
  4: import { useUser } from "@clerk/nextjs"
  5: import { BellAlertIcon, BellSlashIcon } from "@heroicons/react/24/outline"
  6: import { applicationServerKey, pushStatusFor, waitForPushVerification } from "@/lib/client-push"
  7: import { ADMIN_PUSH_TOPIC_OPTIONS, type AdminPushTopic } from "@/lib/notification-events"
  8: 
  9: type Topic = "posts" | "notes"
 10: type State = "loading" | "ready" | "saving" | "enabled" | "denied" | "unsupported" | "unconfigured" | "error"
 11: 
 12: export function PushSubscriptionManager({
 13:   showAdminEvents = false,
 14:   compact = false,
 15: }: {
 16:   showAdminEvents?: boolean
 17:   compact?: boolean
 18: }) {
 19:   const { isLoaded, isSignedIn, user } = useUser()
 20:   const [state, setState] = useState<State>("loading")
 21:   const [publicKey, setPublicKey] = useState("")
 22:   const [subscription, setSubscription] = useState<PushSubscription | null>(null)
 23:   const [topics, setTopics] = useState<Topic[]>([])
 24:   const [adminTopics, setAdminTopics] = useState<AdminPushTopic[]>([])
 25:   const [messageEvents, setMessageEvents] = useState(false)
 26:   const [message, setMessage] = useState("")
 27: 
 28:   const load = useCallback(async () => {
 29:     if (!("serviceWorker" in navigator) || !("PushManager" in window) || !("Notification" in window)) {
 30:       setState("unsupported")
 31:       return
 32:     }
 33:     if (Notification.permission === "denied") {
 34:       setState("denied")
 35:       return
 36:     }
 37:     try {
 38:       const response = await fetch("/api/push/config", { cache: "no-store" })
 39:       const config = await response.json() as { configured?: boolean; publicKey?: string | null }
 40:       if (!config.configured || !config.publicKey) {
 41:         setState("unconfigured")
 42:         return
 43:       }
 44:       setPublicKey(config.publicKey)
 45:       const registration = await navigator.serviceWorker.register("/push-service-worker.js", { scope: "/" })
 46:       const current = await registration.pushManager.getSubscription()
 47:       setSubscription(current)
 48:       if (!current) {
 49:         setState("ready")
 50:         return
 51:       }
 52:       const status = await pushStatusFor(current)
 53:       setTopics(status.topics ?? [])
 54:       setAdminTopics(status.adminTopics)
 55:       setMessageEvents(status.messageEvents === true)
 56:       setState("enabled")
 57:     } catch {
 58:       setState("error")
 59:       setMessage("Não foi possível consultar as notificações neste dispositivo.")
 60:     }
 61:   }, [])
 62: 
 63:   useEffect(() => {
 64:     const timer = window.setTimeout(() => void load(), 0)
 65:     const refresh = () => void load()
 66:     window.addEventListener("push:preferences-changed", refresh)
 67:     return () => {
 68:       window.clearTimeout(timer)
 69:       window.removeEventListener("push:preferences-changed", refresh)
 70:     }
 71:   }, [load, user?.id])
 72: 
 73:   async function persist(
 74:     current: PushSubscription,
 75:     nextTopics: Topic[],
 76:     nextAdminTopics: AdminPushTopic[],
 77:     nextMessageEvents: boolean
 78:   ) {
 79:     const json = current.toJSON()
 80:     const response = await fetch("/api/push/subscriptions", {
 81:       method: "POST",
 82:       headers: { "Content-Type": "application/json" },
 83:       body: JSON.stringify({
 84:         ...json,
 85:         topics: nextTopics,
 86:         adminEvents: nextAdminTopics.length > 0,
 87:         adminTopics: nextAdminTopics,
 88:         messageEvents: nextMessageEvents,
 89:       }),
 90:     })
 91:     if (!response.ok) {
 92:       const data = await response.json().catch(() => null) as { error?: string } | null
 93:       throw new Error(data?.error || "Não foi possível salvar suas preferências.")
 94:     }
 95:     const result = await response.json().catch(() => null) as { pending?: boolean } | null
 96:     if (result?.pending) await waitForPushVerification(current)
 97:   }
 98: 
 99:   async function enable() {
100:     setState("saving")
101:     setMessage("")
102:     try {
103:       const permission = await Notification.requestPermission()
104:       if (permission !== "granted") {
105:         setState(permission === "denied" ? "denied" : "ready")
106:         return
107:       }
108:       const registration = await navigator.serviceWorker.ready
109:       const current = await registration.pushManager.subscribe({
110:         userVisibleOnly: true,
111:         applicationServerKey: applicationServerKey(publicKey),
112:       })
113:       const nextTopics: Topic[] = ["posts", "notes"]
114:       const nextAdminTopics: AdminPushTopic[] = []
115:       const nextMessageEvents = false
116:       await persist(current, nextTopics, nextAdminTopics, nextMessageEvents)
117:       setSubscription(current)
118:       setTopics(nextTopics)
119:       setAdminTopics(nextAdminTopics)
120:       setMessageEvents(nextMessageEvents)
121:       setState("enabled")
122:       setMessage("Notificações ativadas neste dispositivo.")
123:     } catch (error) {
124:       setState("error")
125:       setMessage(error instanceof Error ? error.message : "Não foi possível ativar as notificações.")
126:     }
127:   }
128: 
129:   async function updatePreferences(
130:     nextTopics: Topic[],
131:     nextAdminTopics: AdminPushTopic[],
132:     nextMessageEvents: boolean
133:   ) {
134:     if (!subscription) return
135:     setState("saving")
136:     setMessage("")
137:     try {
138:       await persist(subscription, nextTopics, nextAdminTopics, nextMessageEvents)
139:       setTopics(nextTopics)
140:       setAdminTopics(nextAdminTopics)
141:       setMessageEvents(nextMessageEvents)
142:       setState("enabled")
143:       setMessage("Preferências salvas.")
144:     } catch (error) {
145:       setState("enabled")
146:       setMessage(error instanceof Error ? error.message : "Não foi possível salvar suas preferências.")
147:     }
148:   }
149: 
150:   function updateReaderPreference(topic: Topic, checked: boolean) {
151:     const nextTopics = checked
152:       ? Array.from(new Set([...topics, topic]))
153:       : topics.filter((item) => item !== topic)
154:     return updatePreferences(nextTopics, adminTopics, messageEvents)
155:   }
156: 
157:   function updateAdminPreference(topic: AdminPushTopic, checked: boolean) {
158:     const nextAdminTopics = checked
159:       ? Array.from(new Set([...adminTopics, topic]))
160:       : adminTopics.filter((item) => item !== topic)
161:     return updatePreferences(topics, nextAdminTopics, messageEvents)
162:   }
163: 
164:   async function disable() {
165:     if (!subscription) return
166:     setState("saving")
167:     setMessage("")
168:     try {
169:       await fetch("/api/push/subscriptions", {
170:         method: "DELETE",
171:         headers: { "Content-Type": "application/json" },
172:         body: JSON.stringify(subscription.toJSON()),
173:       })
174:       await subscription.unsubscribe()
175:       setSubscription(null)
176:       setTopics([])
177:       setAdminTopics([])
178:       setMessageEvents(false)
179:       setState("ready")
180:       setMessage("Notificações desativadas neste dispositivo.")
181:     } catch {
182:       setState("enabled")
