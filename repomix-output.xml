 56: function decodeCursor(cursor?: string) {
 57:   if (!cursor) return null
 58:   const separator = cursor.lastIndexOf("_")
 59:   if (separator < 1) return null
 60:   const updatedAt = new Date(cursor.slice(0, separator))
 61:   const _id = toObjectId(cursor.slice(separator + 1))
 62:   return _id && !Number.isNaN(updatedAt.getTime()) ? { updatedAt, _id } : null
 63: }
