155: export class ImageNode extends DecoratorNode<React.ReactNode> {
156:   __formatting: ImageFormatting = {}
157:   __src: string
158:   __alt: string
159:   __layout: ImageLayout
160:   __flowWidth: ImageFlowWidth
161:   __themeMode: ImageThemeMode
162:   __blockWidth: number
163:   __alignment: "left" | "center" | "right"
164:   __caption: string
165: 
166:   static getType() { return "image" }
167: 
168:   static clone(node: ImageNode) {
169:     const clone = new ImageNode(
170:       node.__src,
171:       node.__alt,
172:       node.__layout,
173:       node.__flowWidth,
174:       node.__themeMode,
175:       node.__blockWidth, node.__alignment, node.__caption,
176:       node.__key
177:     )
178:     clone.__formatting = { ...node.__formatting }
