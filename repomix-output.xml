102:     }
103: 
104:     function closeFromOutside(event: PointerEvent) {
105:       if (!rootRef.current?.contains(event.target as Node)) dismissMenu()
106:     }
107: 
108:     function closeFromKeyboard(event: globalThis.KeyboardEvent) {
109:       if (event.key !== "Escape") return
