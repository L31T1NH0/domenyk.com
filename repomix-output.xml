221: export type NotificationActionType = "copied_link" | "commented" | "sent_message"
222: 
223: export async function appendNotificationAction(id: string, type: NotificationActionType) {
224:   const validSince = new Date(Date.now() - ENGAGEMENT_TOKEN_TTL_MS)
225:   const action = { type, occurredAt: new Date() }
226:   const result = await (await getDb()).collection("notifications").updateOne(
227:     {
228:       occurrences: {
229:         $elemMatch: {
230:           id,
231:           occurredAt: { $gte: validSince },
232:           "actions.type": { $ne: type },
233:         },
234:       },
235:     },
236:     [{
237:       $set: {
238:         occurrences: {
239:           $map: {
240:             input: "$occurrences",
241:             as: "occurrence",
242:             in: {
243:               $cond: [
244:                 { $eq: ["$$occurrence.id", id] },
245:                 {
246:                   $mergeObjects: [
247:                     "$$occurrence",
248:                     { actions: { $concatArrays: [{ $ifNull: ["$$occurrence.actions", []] }, [action]] } },
249:                   ],
250:                 },
251:                 "$$occurrence",
252:               ],
253:             },
254:           },
255:         },
256:       },
257:     }]
258:   )
259:   return result.modifiedCount > 0
260: }
261: 
262: export function serializeNotification(notification: Notification) {
263:   return {
264:     ...notification,
265:     _id: notification._id.toString(),
266:     createdAt: notification.createdAt.toISOString(),
267:     updatedAt: notification.updatedAt.toISOString(),
268:     occurrences: notification.occurrences?.map((occurrence) => occurrence instanceof Date
269:       ? { occurredAt: occurrence.toISOString() }
270:       : {
271:           ...occurrence,
272:           occurredAt: occurrence.occurredAt.toISOString(),
273:           reading: occurrence.reading
274:             ? { ...occurrence.reading, completedAt: occurrence.reading.completedAt.toISOString() }
275:             : undefined,
276:           actions: occurrence.actions?.map((action) => ({
277:             ...action,
278:             occurredAt: action.occurredAt.toISOString(),
279:           })),
280:         }),
281:     readAt: notification.readAt?.toISOString(),
282:   }
283: }
