366: function nextParagraphId(text: string, usedIds: Set<string>, collisionCounts: Map<string, number>): string {
367:   const legacyId = legacyParagraphId(text)
368:   if (!usedIds.has(legacyId)) {
369:     usedIds.add(legacyId)
370:     return legacyId
371:   }
372: 
373:   const collisionBase = `${legacyId}-${paragraphFingerprint(text)}`
374:   let occurrence = collisionCounts.get(collisionBase) ?? 0
375:   let candidate = collisionBase
376: 
377:   while (usedIds.has(candidate)) {
378:     occurrence += 1
379:     candidate = `${collisionBase}-${occurrence + 1}`
380:   }
381: 
382:   collisionCounts.set(collisionBase, occurrence)
383:   usedIds.add(candidate)
384:   return candidate
385: }
