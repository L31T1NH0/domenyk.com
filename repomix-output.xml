 65: 
 66: async function topicsSitemap(): Promise<MetadataRoute.Sitemap> {
 67:   const themes = await getActiveThemeUpdates()
 68:   return themes.map(({ slug, updatedAt }) => ({
 69:     url: absoluteUrl(`/temas/${encodeURIComponent(slug)}`),
 70:     lastModified: updatedAt,
 71:     changeFrequency: "monthly" as const,
 72:     priority: 0.6,
 73:   }))
 74: }
 75: 
 76: async function seriesSitemap(): Promise<MetadataRoute.Sitemap> {
 77:   const series = await getPublishedSeriesUpdates()
 78:   return series.map(({ slug, updatedAt }) => ({
 79:     url: absoluteUrl(`/series/${encodeURIComponent(slug)}`),
 80:     lastModified: updatedAt,
 81:     changeFrequency: "monthly" as const,
 82:     priority: 0.75,
 83:   }))
 84: }
 85: 
 86: async function postsSitemap(page: number): Promise<MetadataRoute.Sitemap> {
 87:   const posts = await getPostsWithPublishedVersions({ page: page + 1, limit: SITEMAP_PAGE_SIZE })
 88:   return posts.flatMap((post) => {
 89:     const locales = POST_LOCALES.filter((locale) => (
 90:       locale === "pt" ? post.published : post.translations?.[locale]?.published === true
 91:     ))
 92:     const languages = Object.fromEntries(locales.map((locale) => [
 93:       POST_LOCALE_DETAILS[locale].htmlLang,
 94:       absoluteUrl(localizedPostPath(post, locale)),
 95:     ]))
 96:     if (post.published) languages["x-default"] = absoluteUrl(localizedPostPath(post, "pt"))
 97: 
 98:     return locales.map((locale) => {
 99:       const translation = locale === "pt" ? undefined : post.translations?.[locale]
100:       return {
101:         url: absoluteUrl(localizedPostPath(post, locale)),
102:         lastModified: translation?.updatedAt ?? post.updatedAt,
103:         changeFrequency: "monthly" as const,
104:         priority: post.pinned ? 0.9 : 0.8,
105:         images: preferredContentImages({
106:           cover: post.cover?.url,
107:           markdown: locale === "pt" ? post.content : translation?.content,
108:         }).map(absoluteUrl),
109:         alternates: { languages },
110:       }
111:     })
112:   })
113: }
114: 
115: export default async function sitemap({ id }: { id: Promise<string> }): Promise<MetadataRoute.Sitemap> {
116:   const sitemapId = await id
117:   if (sitemapId === "index") return indexSitemap()
118:   if (sitemapId === "topics") return topicsSitemap()
119:   if (sitemapId === "series") return seriesSitemap()
120: 
121:   const match = /^posts-(\d+)$/.exec(sitemapId)
122:   if (!match) return []
123: 
124:   return postsSitemap(Number(match[1]))
125: }
