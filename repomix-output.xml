<file path="src/app/api/admin/notes/[id]/route.ts">
 1: import { after, NextRequest, NextResponse } from "next/server"
 2: import { deleteNote, normalizeNoteContent, serializeNote, updateNote } from "@/lib/db/notes"
 3: import { adminOnly } from "@/lib/auth"
 4: import { asString, asTrustedImageUrlArray, toObjectId } from "@/lib/validation"
 5: import { deleteCommentsForParent, getCommentsForParent } from "@/lib/db/comments"
 6: import { deleteCommentImagesFromContents, queueCommentImagesForCleanup } from "@/lib/db/comment-uploads"
 7: import { notifyIndexNow } from "@/lib/indexnow"
 8: import { invalidatePublicContentCache } from "@/lib/public-content-cache"
 9: import { MAX_RICH_CONTENT_LENGTH } from "@/lib/content-format"
10: 
11: export async function PATCH(req: NextRequest, { params }: { params: Promise<{ id: string }> }) {
12:   const unauthorized = await adminOnly()
13:   if (unauthorized) return unauthorized
14: 
15:   const { id } = await params
16:   if (!toObjectId(id)) return NextResponse.json({ error: "ID inválido" }, { status: 400 })
17: 
18:   const body = await req.json().catch(() => null) as { title?: unknown; seoTitle?: unknown; seoDescription?: unknown; content?: unknown; images?: unknown } | null
19:   const title = body && "title" in body ? asString(body.title, 120)?.trim() || null : undefined
20:   const seoTitle = body && "seoTitle" in body ? asString(body.seoTitle, 120)?.trim() || null : undefined
21:   const seoDescription = body && "seoDescription" in body ? asString(body.seoDescription, 300)?.trim() || null : undefined
22:   const content = asString(body?.content, MAX_RICH_CONTENT_LENGTH) ?? ""
23:   const normalizedContent = normalizeNoteContent(content)
24: 
25:   if (!normalizedContent) {
26:     return NextResponse.json({ error: "content é obrigatório" }, { status: 400 })
27:   }
28: 
29:   const images = body && "images" in body ? asTrustedImageUrlArray(body.images, 6) : undefined
30:   const note = await updateNote(id, { title, seoTitle, seoDescription, content: normalizedContent, images })
31: 
32:   if (!note) return NextResponse.json({ error: "Nota não encontrada" }, { status: 404 })
33: 
34:   invalidatePublicContentCache()
35:   after(() => notifyIndexNow([`/notes/${id}`]))
36: 
37:   return NextResponse.json(serializeNote(note))
38: }
39: 
40: export async function DELETE(_req: NextRequest, { params }: { params: Promise<{ id: string }> }) {
41:   const unauthorized = await adminOnly()
42:   if (unauthorized) return unauthorized
43: 
44:   const { id } = await params
45:   if (!toObjectId(id)) return NextResponse.json({ error: "ID inválido" }, { status: 400 })
46: 
47:   // Delete the primary record first. Comment/image/cache cleanup is auxiliary
48:   // and must not prevent or misreport the note deletion.
49:   let result: Awaited<ReturnType<typeof deleteNote>>
50:   try {
51:     result = await deleteNote(id)
52:   } catch (error) {
53:     console.error("Failed to delete primary note record", { noteId: id, error })
54:     const databaseCode = typeof error === "object" && error && "code" in error
55:       ? String(error.code)
56:       : null
57:     return NextResponse.json(
58:       { error: `Falha ao excluir a nota no banco de dados${databaseCode ? ` (código ${databaseCode})` : ""}.` },
59:       { status: 500 }
60:     )
61:   }
62:   if (!result.deleted) return NextResponse.json({ ok: true, thread: [] })
63: 
64:   let contents: string[] = []
65:   try {
66:     const comments = await getCommentsForParent(id)
67:     contents = comments.map((comment) => comment.content)
68:   } catch (error) {
69:     console.error("Failed to read comments while deleting note", { noteId: id, error })
70:   }
71: 
72:   if (contents.length > 0) {
73:     await queueCommentImagesForCleanup(contents).catch((error) => {
74:       console.error("Failed to queue comment images while deleting note", { noteId: id, error })
75:     })
76:   }
77:   await deleteCommentsForParent(id).catch((error) => {
78:     console.error("Failed to delete comments while deleting note", { noteId: id, error })
79:   })
80:   if (contents.length > 0) {
81:     await deleteCommentImagesFromContents(contents).catch((error) => {
82:       console.error("Failed to delete comment images while deleting note", { noteId: id, error })
83:     })
84:   }
85: 
86:   try {
87:     invalidatePublicContentCache()
88:   } catch (error) {
89:     console.error("Failed to invalidate public cache after deleting note", { noteId: id, error })
90:   }
91:   after(() => notifyIndexNow([`/notes/${id}`]))
92:   let serializedThread: ReturnType<typeof serializeNote>[] = []
93:   try {
94:     serializedThread = result.thread.map(serializeNote)
95:   } catch (error) {
96:     console.error("Failed to serialize repaired note thread after deletion", { noteId: id, error })
97:   }
98:   return NextResponse.json({ ok: true, thread: serializedThread })
99: }
</file>

