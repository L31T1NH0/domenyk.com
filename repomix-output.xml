 23: const MAX_IMAGE_INPUT_PIXELS = 16_000_000
 24: const MAX_IMAGE_INPUT_DIMENSION = 12_000
 25: const MAX_IMAGE_OUTPUT_DIMENSION = 3_840
 26: const IMAGE_PROCESSING_TIMEOUT_SECONDS = 8
