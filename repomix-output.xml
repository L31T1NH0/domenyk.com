145: export async function getCommentsPage(
146:   postId: string,
147:   opts: { paragraphId?: string; limit?: number; cursor?: string } = {}
148: ): Promise<{ comments: Comment[]; hasMore: boolean; nextCursor: string | null; total: number }> {
149:   const { paragraphId, limit = MAX_COMMENTS_PER_RESPONSE, cursor } = opts
150:   const objectId = toObjectId(postId)
151:   if (!objectId) return { comments: [], hasMore: false, nextCursor: null, total: 0 }
152: 
153:   const col = await collection()
154:   const baseFilter: Record<string, unknown> = { postId: objectId }
155:   if (paragraphId !== undefined) baseFilter.paragraphId = paragraphId
156:   else baseFilter.$or = [{ paragraphId: { $exists: false } }, { paragraphId: null }]
157:   const filter: Record<string, unknown> = { ...baseFilter }
158:   if (cursor) {
159:     const cursorId = toObjectId(cursor)
160:     if (!cursorId) return { comments: [], hasMore: false, nextCursor: null, total: 0 }
161:     filter._id = { $lt: cursorId }
162:   }
163:   const boundedLimit = Math.max(1, Math.min(limit, MAX_COMMENTS_PER_RESPONSE))
164:   const [comments, total] = await Promise.all([
165:     col.find(filter).sort({ _id: -1 }).limit(boundedLimit + 1).toArray(),
166:     col.countDocuments(baseFilter),
167:   ])
168:   const hasMore = comments.length > boundedLimit
169:   if (hasMore) comments.pop()
170:   const nextCursor = hasMore && comments.length > 0 ? comments[comments.length - 1]._id.toString() : null
171:   comments.reverse()
172:   return { comments: comments.map(normalizeComment), hasMore, nextCursor, total }
173: }
