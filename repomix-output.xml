167:   const source = editor.getEditorState().read(() => $getState($getRoot(), publicationHtmlSourceState))
168:   if (source === null) return
169:   if (!canEditHtmlVisually(source)) throw new Error("Este HTML contém recursos que o editor visual não representa. Continue no modo código; a prévia mostra a publicação.")
