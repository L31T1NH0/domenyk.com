120: function initialDrafts(post?: PostData): Record<PostLocale, LocalizedDraft> {
121:   const drafts: Record<PostLocale, LocalizedDraft> = {
122:     pt: {
123:       title: post?.title ?? "",
124:       seoTitle: post?.seoTitle ?? "",
125:       seoDescription: post?.seoDescription ?? "",
126:       localizedSlug: post?.slug ?? "",
127:       subtitle: post?.subtitle ?? "",
128:       excerpt: post?.excerpt ?? "",
129:       coverAlt: post?.cover?.alt ?? "",
130:       tags: post?.tags.join(", ") ?? "",
131:       sources: sourcesToText(post?.sources),
132:       content: post?.content ?? "",
133:     },
134:     en: emptyDraft(),
135:     de: emptyDraft(),
136:     id: emptyDraft(),
137:   }
138: 
139:   for (const locale of ["en", "de", "id"] as const) {
140:     const translation = post?.translations?.[locale]
141:     if (!translation) continue
142:     drafts[locale] = {
143:       title: translation.title,
144:       seoTitle: translation.seoTitle ?? "",
145:       seoDescription: translation.seoDescription ?? "",
146:       localizedSlug: translation.slug ?? "",
147:       subtitle: translation.subtitle ?? "",
148:       excerpt: translation.excerpt ?? "",
149:       coverAlt: translation.coverAlt ?? "",
150:       tags: translation.tags?.join(", ") ?? "",
151:       sources: sourcesToText(translation.sources),
152:       content: translation.content,
153:     }
154:   }
155: 
156:   return drafts
157: }
