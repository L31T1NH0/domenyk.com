  1: function isEscaped(value: string, index: number): boolean {
  2:   let backslashes = 0
  3:   for (let cursor = index - 1; cursor >= 0 && value[cursor] === "\\"; cursor -= 1) {
  4:     backslashes += 1
  5:   }
  6:   return backslashes % 2 === 1
  7: }
  8: 
  9: function closingMathDelimiter(
 10:   markdown: string,
 11:   start: number,
 12:   delimiterLength: 1 | 2
 13: ): number {
 14:   for (let index = start; index < markdown.length; index += 1) {
 15:     if (delimiterLength === 1 && markdown[index] === "\n") return -1
 16:     if (markdown[index] !== "$" || isEscaped(markdown, index)) continue
 17: 
 18:     let dollars = 1
 19:     while (markdown[index + dollars] === "$") dollars += 1
 20:     if (
 21:       (delimiterLength === 1 && dollars === 1) ||
 22:       (delimiterLength === 2 && dollars >= 2)
 23:     ) {
 24:       return index
 25:     }
 26:     index += dollars - 1
 27:   }
 28:   return -1
 29: }
 30: 
 31: // Applies a narrowly scoped transformation to complete math regions while
 32: // leaving Markdown code and unmatched dollar signs byte-for-byte unchanged.
 33: function transformLatexRegions(
 34:   markdown: string,
 35:   transform: (value: string) => string
 36: ): string {
 37:   let output = ""
 38:   let index = 0
 39:   let inlineCodeTicks = 0
 40:   let fence: { marker: "`" | "~"; length: number } | null = null
 41: 
 42:   while (index < markdown.length) {
 43:     const lineStart = index === 0 || markdown[index - 1] === "\n"
 44:     if (lineStart) {
 45:       const lineEnd = markdown.indexOf("\n", index)
 46:       const end = lineEnd === -1 ? markdown.length : lineEnd
 47:       const line = markdown.slice(index, end)
 48:       const fenceMatch = line.match(/^ {0,3}(`{3,}|~{3,})(.*)$/)
 49: 
 50:       if (fenceMatch) {
 51:         const marker = fenceMatch[1][0] as "`" | "~"
 52:         const markerLength = fenceMatch[1].length
 53:         const remainder = fenceMatch[2]
 54:         if (!fence) {
 55:           fence = { marker, length: markerLength }
 56:         } else if (
 57:           marker === fence.marker &&
 58:           markerLength >= fence.length &&
 59:           remainder.trim() === ""
 60:         ) {
 61:           fence = null
 62:         }
 63:         output += markdown.slice(index, lineEnd === -1 ? end : end + 1)
 64:         index = lineEnd === -1 ? end : end + 1
 65:         continue
 66:       }
 67: 
 68:       if (fence) {
 69:         output += markdown.slice(index, lineEnd === -1 ? end : end + 1)
 70:         index = lineEnd === -1 ? end : end + 1
 71:         continue
 72:       }
 73:     }
 74: 
 75:     if (markdown[index] === "`") {
 76:       let ticks = 1
 77:       while (markdown[index + ticks] === "`") ticks += 1
 78:       if (inlineCodeTicks === 0) inlineCodeTicks = ticks
 79:       else if (ticks === inlineCodeTicks) inlineCodeTicks = 0
 80:       output += markdown.slice(index, index + ticks)
 81:       index += ticks
 82:       continue
 83:     }
 84: 
 85:     if (inlineCodeTicks === 0 && markdown[index] === "$" && !isEscaped(markdown, index)) {
 86:       let dollars = 1
 87:       while (markdown[index + dollars] === "$") dollars += 1
 88:       const delimiterLength: 1 | 2 = dollars >= 2 ? 2 : 1
 89:       const contentStart = index + delimiterLength
 90:       const close = closingMathDelimiter(markdown, contentStart, delimiterLength)
 91: 
 92:       if (close >= contentStart) {
 93:         output += markdown.slice(index, contentStart)
 94:         output += transform(markdown.slice(contentStart, close))
 95:         output += markdown.slice(close, close + delimiterLength)
 96:         index = close + delimiterLength
 97:         continue
 98:       }
 99:     }
100: 
101:     output += markdown[index]
102:     index += 1
103:   }
104: 
105:   return output
106: }
107: 
108: /**
109:  * Protects LaTeX syntax from Lexical's Markdown unescaping during import.
110:  * Doubling here is reversed by Lexical before the text reaches the editor.
111:  */
112: export function prepareLatexForLexicalImport(markdown: string): string {
113:   return transformLatexRegions(
114:     markdown,
115:     (value) => value.replace(/\\+/g, (run) => run + run)
116:   )
117: }
118: 
119: /**
120:  * Reverses Lexical's Markdown escaping only inside complete `$…$` and `$$…$$`
121:  * regions. Code spans, fenced code blocks, ordinary Markdown, and unmatched
122:  * dollar signs are left untouched.
123:  *
124:  * This function expects the direct result of `$convertToMarkdownString` and is
125:  * intentionally not idempotent.
126:  */
127: export function restoreLatexAfterLexicalExport(markdown: string): string {
128:   return transformLatexRegions(
129:     markdown,
130:     // Lexical doubles every literal backslash while exporting a plain
131:     // TextNode. Restore the exact number that was present in the editor.
132:     (value) => value.replace(
133:       /\\+/g,
134:       (run) => "\\".repeat(Math.ceil(run.length / 2))
135:     )
136:   )
137: }
</file>

<file path="src/components/editor/PublicationStylePlugin.tsx">
 1: "use client"
 2: 
 3: import { useEffect, useId, useState } from "react"
 4: import { useLexicalComposerContext } from "@lexical/react/LexicalComposerContext"
 5: import { $getRoot, $getState } from "lexical"
 6: import { publicationCssState } from "./html-content"
 7: import { compilePublicationCss } from "@/lib/publication-css"
 8: 
 9: export function PublicationStylePlugin() {
10:   const [editor] = useLexicalComposerContext()
11:   const id = useId().replace(/[^a-zA-Z0-9_-]/g, "")
12:   const [css, setCss] = useState("")
13:   useEffect(() => {
14:     const refresh = () => editor.getEditorState().read(() => {
15:       try { setCss(compilePublicationCss($getState($getRoot(), publicationCssState), `[data-visual-publication="${id}"]`)) }
16:       catch { setCss("") }
17:     })
18:     refresh()
19:     const unregisterUpdate = editor.registerUpdateListener(refresh)
20:     const unregisterRoot = editor.registerRootListener((root, previous) => {
21:       previous?.removeAttribute("data-visual-publication")
22:       root?.setAttribute("data-visual-publication", id)
23:     })
24:     return () => { unregisterUpdate(); unregisterRoot() }
25:   }, [editor, id])
26:   return css ? <style>{css}</style> : null
27: }
