50:     const separator = declaration.indexOf(':')
51:     const key = declaration.slice(0, separator).trim().toLowerCase()
52:     const value = declaration.slice(separator + 1).trim()
53:     const rule = Object.hasOwn(rules, key) ? rules[/** @type {keyof typeof rules} */ (key)] : null
54:     return separator > 0 && rule?.test(value) ? [`${key}: ${value}`] : []
55:   }).join('; ')
56: }
