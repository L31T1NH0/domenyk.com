 398: function useTimelineSwipeNavigation(mode: FeedMode, switchMode: (mode: FeedMode) => void) {
 399:   const pointerStartRef = useRef<{ id: number; x: number; y: number; active: boolean } | null>(null)
 400:   const suppressNextClickRef = useRef(false)
 401:   const [swipeOffset, setSwipeOffset] = useState(0)
 402:   const [isSwipeSettling, setIsSwipeSettling] = useState(false)
 403: 
 404:   function handlePointerDown(event: PointerEvent<HTMLElement>) {
 405:     if (event.pointerType !== "touch") return
 406:     if (window.matchMedia("(min-width: 640px)").matches) return
 407:     if (isInteractiveTarget(event.target)) return
 408: 
 409:     pointerStartRef.current = { id: event.pointerId, x: event.clientX, y: event.clientY, active: false }
 410:     try {
 411:       event.currentTarget.setPointerCapture(event.pointerId)
 412:     } catch {
 413:       // Some synthetic/browser-dispatched pointer events are not capturable.
 414:     }
 415:     setIsSwipeSettling(false)
 416:   }
 417: 
 418:   function handlePointerMove(event: PointerEvent<HTMLElement>) {
 419:     const start = pointerStartRef.current
 420:     if (!start || start.id !== event.pointerId) return
 421:     if (window.matchMedia("(min-width: 640px)").matches) return
 422: 
 423:     const deltaX = event.clientX - start.x
 424:     const deltaY = event.clientY - start.y
 425:     const absX = Math.abs(deltaX)
 426:     const absY = Math.abs(deltaY)
 427: 
 428:     if (!start.active) {
 429:       if (absY > 18 && absY > absX * 1.15) {
 430:         pointerStartRef.current = null
 431:         if (event.currentTarget.hasPointerCapture(event.pointerId)) {
 432:           event.currentTarget.releasePointerCapture(event.pointerId)
 433:         }
 434:         return
 435:       }
 436:       if (absX < 10 || absX < absY * 0.9) return
 437:       start.active = true
 438:     }
 439: 
 440:     const hasAdjacentMode = Boolean(getAdjacentMode(deltaX, mode))
 441:     const resistance = hasAdjacentMode ? 0.82 : 0.2
 442:     const offset = Math.max(-SWIPE_MAX_OFFSET, Math.min(SWIPE_MAX_OFFSET, deltaX * resistance))
 443:     setSwipeOffset(offset)
 444:   }
 445: 
 446:   function handlePointerUp(event: PointerEvent<HTMLElement>) {
 447:     const start = pointerStartRef.current
 448:     if (start && start.id !== event.pointerId) return
 449:     pointerStartRef.current = null
 450:     if (event.currentTarget.hasPointerCapture(event.pointerId)) {
 451:       event.currentTarget.releasePointerCapture(event.pointerId)
 452:     }
 453: 
 454:     if (!start || window.matchMedia("(min-width: 640px)").matches) {
 455:       setSwipeOffset(0)
 456:       return
 457:     }
 458: 
 459:     const deltaX = event.clientX - start.x
 460:     const deltaY = event.clientY - start.y
 461:     setIsSwipeSettling(true)
 462:     if (!start.active || Math.abs(deltaX) < SWIPE_THRESHOLD || Math.abs(deltaX) < Math.abs(deltaY) * 0.9) {
 463:       setSwipeOffset(0)
 464:       return
 465:     }
 466: 
 467:     const nextMode = getAdjacentMode(deltaX, mode)
 468:     if (!nextMode) {
 469:       setSwipeOffset(0)
 470:       return
 471:     }
 472: 
 473:     switchMode(nextMode)
 474:     suppressNextClickRef.current = true
 475:     window.setTimeout(() => {
 476:       suppressNextClickRef.current = false
 477:     }, 350)
 478:     setSwipeOffset(0)
 479:   }
 480: 
 481:   function handlePointerCancel(event: PointerEvent<HTMLElement>) {
 482:     const start = pointerStartRef.current
 483:     if (start && start.id !== event.pointerId) return
 484:     pointerStartRef.current = null
 485:     if (event.currentTarget.hasPointerCapture(event.pointerId)) {
 486:       event.currentTarget.releasePointerCapture(event.pointerId)
 487:     }
 488:     setIsSwipeSettling(true)
 489:     setSwipeOffset(0)
 490:   }
 491: 
 492:   function handleClickCapture(event: MouseEvent<HTMLElement>) {
 493:     if (!suppressNextClickRef.current) return
 494:     suppressNextClickRef.current = false
 495:     event.preventDefault()
 496:     event.stopPropagation()
 497:   }
 498: 
 499:   return {
 500:     swipeOffset,
 501:     isSwipeSettling,
 502:     handlePointerDown,
 503:     handlePointerMove,
 504:     handlePointerUp,
 505:     handlePointerCancel,
 506:     handleClickCapture,
 507:   }
 508: }
