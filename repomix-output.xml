462:         .filter((prefix): prefix is AllowedImagePrefix => prefix !== null)
463:     : []
464:   const maxImages = policy.mode === "allowlist" && Number.isFinite(policy.maxImages)
465:     ? Math.max(0, Math.floor(policy.maxImages))
