20: export async function POST(req: NextRequest, { params }: { params: Promise<{ id: string }> }) {
21:   const user = await getAuthUser()
22:   if (!user) return NextResponse.json({ error: "Unauthorized" }, { status: 401 })
23:   const { id } = await params
24:   const admin = await isAdmin()
25:   const thread = admin ? await getMessageThread(id) : await getMessageThreadForOwner(id, user.id)
26:   if (!thread) return NextResponse.json({ error: "Not found" }, { status: 404 })
27:   if (!(await rateLimit(`message-reply:${user.id}`, { limit: 12, windowMs: 60_000 }))) return NextResponse.json({ error: "Muitas respostas em pouco tempo." }, { status: 429 })
28:   const identity = requestIdentity(req)
29:   const [withinDailyUserLimit, withinDailyIpLimit] = await Promise.all([
30:     rateLimit(`message-reply-daily-user:${user.id}`, { limit: 100, windowMs: 24 * 60 * 60_000 }),
31:     rateLimit(`message-reply-daily-ip:${identity}`, { limit: 150, windowMs: 24 * 60 * 60_000 }),
32:   ])
33:   if (!withinDailyUserLimit || !withinDailyIpLimit) return NextResponse.json({ error: "Limite diário de respostas atingido." }, { status: 429 })
34:   const json = await req.json().catch(() => null) as { body?: unknown } | null
35:   const body = typeof json?.body === "string" ? json.body.trim().slice(0, 5000) : ""
36:   if (body.length < 2) return NextResponse.json({ error: "Resposta muito curta." }, { status: 400 })
37:   if (thread.status === "closed") return NextResponse.json({ error: "Esta conversa está encerrada." }, { status: 409 })
38:   const updated = await addMessageReply(id, { authorId: user.id, authorName: user.name, body, isAdmin: admin, ownerId: admin ? undefined : user.id })
39:   if (!updated) return NextResponse.json({ error: "Esta conversa atingiu o limite de respostas." }, { status: 409 })
40:   const recipientId = admin ? null : getAdminUserId()
41:   if (recipientId) await createNotification({ recipientId, actorId: user.id, actorImageUrl: user.imageUrl, kind: "reply", title: `Resposta em: ${thread.subject}`, description: `${user.name} respondeu à mensagem.`, href: `/admin/messages#${id}` }, "message_replies").catch(() => null)
42:   if (admin) {
43:     await sendMessageReplyPush(thread.ownerId, {
44:       title: `Domenyk respondeu: ${thread.subject}`,
45:       body: "Abra a conversa para ler a resposta.",
46:       url: `/fale-comigo#${id}`,
