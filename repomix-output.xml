11: 
12: function selectedBlocks(selection: RangeSelection): ElementNode[] {
13:   const found = new Map<string, ElementNode>()
14:   for (const selected of [...selection.getNodes(), selection.anchor.getNode()]) {
15:     let node = $isElementNode(selected) ? selected : selected.getParent()
16:     while (node && !$isParagraphNode(node) && !$isHeadingNode(node) && !$isQuoteNode(node)) node = node.getParent()
17:     if (node) found.set(node.getKey(), node)
18:   }
19:   return [...found.values()]
20: }
