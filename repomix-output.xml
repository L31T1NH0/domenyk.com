 253: function modeHref(mode: FeedMode, searchQuery: string) {
 254:   const params = new URLSearchParams()
 255:   if (mode !== "all") params.set("mode", mode)
 256:   if (searchQuery) params.set("q", searchQuery)
 257:   const query = params.toString()
 258:   return query ? `/?${query}` : "/"
 259: }
