121:         description="O post e seus comentários serão apagados permanentemente."
122:         onDelete={() => onRemove(post._id)}
123:         triggerAriaLabel={`Opções de ${post.title}`}
124:         triggerClassName="admin-record-icon-action"
125:       />
126:     </div>
127:   )
128: }
