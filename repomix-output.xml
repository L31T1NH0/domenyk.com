<file path="src/lib/datetime.ts">
  1: export const SITE_TIME_ZONE = "America/Fortaleza"
  2: 
  3: type DateInput = Date | string | number
  4: 
  5: type SiteDateParts = {
  6:   year: number
  7:   month: number
  8:   day: number
  9: }
 10: 
 11: const dateKeyFormatter = new Intl.DateTimeFormat("en-US", {
 12:   year: "numeric",
 13:   month: "2-digit",
 14:   day: "2-digit",
 15:   timeZone: SITE_TIME_ZONE,
 16: })
 17: 
 18: function toDate(value: DateInput): Date {
 19:   const date = value instanceof Date ? value : new Date(value)
 20:   if (Number.isNaN(date.getTime())) throw new RangeError("Data inválida")
 21:   return date
 22: }
 23: 
 24: function dateParts(value: DateInput): SiteDateParts {
 25:   const parts = dateKeyFormatter.formatToParts(toDate(value))
 26:   const part = (type: Intl.DateTimeFormatPartTypes) => {
 27:     const value = parts.find((item) => item.type === type)?.value
 28:     if (!value) throw new RangeError("Não foi possível interpretar a data")
 29:     return Number(value)
 30:   }
 31: 
 32:   return { year: part("year"), month: part("month"), day: part("day") }
 33: }
 34: 
 35: function dateKeyFromParts({ year, month, day }: SiteDateParts): string {
 36:   return `${String(year).padStart(4, "0")}-${String(month).padStart(2, "0")}-${String(day).padStart(2, "0")}`
 37: }
 38: 
 39: export function siteDateKey(value: DateInput = new Date()): string {
 40:   return dateKeyFromParts(dateParts(value))
 41: }
 42: 
 43: export function shiftSiteDateKey(dateKey: string, days: number): string {
 44:   const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateKey)
 45:   if (!match) throw new RangeError("Data de calendário inválida")
 46: 
 47:   const date = new Date(Date.UTC(Number(match[1]), Number(match[2]) - 1, Number(match[3])))
 48:   if (
 49:     date.getUTCFullYear() !== Number(match[1])
 50:     || date.getUTCMonth() !== Number(match[2]) - 1
 51:     || date.getUTCDate() !== Number(match[3])
 52:   ) {
 53:     throw new RangeError("Data de calendário inválida")
 54:   }
 55:   date.setUTCDate(date.getUTCDate() + days)
 56:   return date.toISOString().slice(0, 10)
 57: }
 58: 
 59: function timeZoneOffsetMs(value: Date): number {
 60:   const formatter = new Intl.DateTimeFormat("en-US", {
 61:     year: "numeric",
 62:     month: "2-digit",
 63:     day: "2-digit",
 64:     hour: "2-digit",
 65:     minute: "2-digit",
 66:     second: "2-digit",
 67:     hourCycle: "h23",
 68:     timeZone: SITE_TIME_ZONE,
 69:   })
 70:   const parts = formatter.formatToParts(value)
 71:   const part = (type: Intl.DateTimeFormatPartTypes) => Number(parts.find((item) => item.type === type)?.value)
 72:   const representedAsUtc = Date.UTC(
 73:     part("year"),
 74:     part("month") - 1,
 75:     part("day"),
 76:     part("hour"),
 77:     part("minute"),
 78:     part("second")
 79:   )
 80:   return representedAsUtc - Math.floor(value.getTime() / 1000) * 1000
 81: }
 82: 
 83: export function siteDateKeyToInstant(dateKey: string): Date {
 84:   const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateKey)
 85:   if (!match) throw new RangeError("Data de calendário inválida")
 86:   const year = Number(match[1])
 87:   const month = Number(match[2])
 88:   const day = Number(match[3])
 89:   const wallClockUtc = Date.UTC(year, month - 1, day)
 90:   const calendarDate = new Date(wallClockUtc)
 91:   if (
 92:     calendarDate.getUTCFullYear() !== year
 93:     || calendarDate.getUTCMonth() !== month - 1
 94:     || calendarDate.getUTCDate() !== day
 95:   ) {
 96:     throw new RangeError("Data de calendário inválida")
 97:   }
 98: 
 99:   let instant = new Date(wallClockUtc)
100:   for (let attempt = 0; attempt < 2; attempt += 1) {
101:     instant = new Date(wallClockUtc - timeZoneOffsetMs(instant))
102:   }
103:   return instant
104: }
105: 
106: export function startOfSiteDay(value: DateInput = new Date(), dayOffset = 0): Date {
107:   return siteDateKeyToInstant(shiftSiteDateKey(siteDateKey(value), dayOffset))
108: }
109: 
110: export function siteCalendarYear(value: DateInput = new Date()): number {
111:   return dateParts(value).year
112: }
113: 
114: export function formatSiteDate(
115:   value: DateInput,
116:   options: Intl.DateTimeFormatOptions,
117:   locale = "pt-BR"
118: ): string {
119:   return new Intl.DateTimeFormat(locale, { ...options, timeZone: SITE_TIME_ZONE }).format(toDate(value))
120: }
</file>

