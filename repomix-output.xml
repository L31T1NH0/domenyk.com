173:     const css = $getState(root, publicationCssState)
174:     const nodes = $generateNodesFromDOM(editor, document)
175:     root.clear().append(...nodes)
176:     $setState(root, publicationCssState, css)
177:     $setState(root, publicationHtmlSourceState, null)
