55: 
56: export async function aggregateNotification(
57:   data: AggregateNotificationInput,
58:   topic: AdminPushTopic,
59:   occurrenceDetails: NotificationOccurrenceDetails = {}
60: ) {
61:   const aggregateKey = await storeAggregateNotification(data, occurrenceDetails)
62:   const aggregateHash = createHash("sha256").update(aggregateKey).digest("hex").slice(0, 20)
63:   if (await rateLimit(`notification-push:${topic}:${aggregateHash}`, {
64:     limit: 1,
65:     windowMs: AGGREGATE_PUSH_WINDOW_MS,
66:   })) {
67:     await sendAdminPush(topic, {
68:       ...pushPayload(data),
69:       tag: `admin-${topic}-${aggregateHash}`,
70:     }).catch(() => undefined)
71:   }
72:   return aggregateKey
73: }
74: 
75: export async function notifySiteVisit(input: {
76:   data: AggregateNotificationInput
77:   occurrenceDetails?: NotificationOccurrenceDetails
78:   storeInHistory: boolean
79:   sendPush: boolean
80: }) {
81:   await Promise.all([
82:     input.storeInHistory
83:       ? storeAggregateNotification(input.data, input.occurrenceDetails).catch(() => undefined)
84:       : Promise.resolve(),
85:     input.sendPush
86:       ? sendAdminPush("site_visits", {
87:           ...pushPayload(input.data),
88:           tag: `admin-site-visit-${randomUUID()}`,
89:         }).catch(() => undefined)
90:       : Promise.resolve(),
91:   ])
92: }
