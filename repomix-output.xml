 77: export function normalizeNoteContent(content: string): string {
 78:   if (isHtmlContent(content)) return content.trim()
 79:   const { protected: protected_, images } = protectImages(content)
 80:   const result = protected_
 81:     .replace(/\r\n?/g, "\n")
 82:     .split(/\n\s*\n/)
 83:     .map((block) => {
 84:       const nb = block.split("\n").map((l) => l.trim()).filter(Boolean).join("\n")
 85:       if (shouldPreserveLineBreaks(nb)) return nb
 86:       return nb.replace(/\s*\n\s*/g, " ").replace(/[ \t]{2,}/g, " ")
 87:     })
 88:     .filter(Boolean)
 89:     .join("\n\n")
 90:     .replace(/\n{3,}/g, "\n\n")
 91:     .trim()
 92:   return restoreImages(result, images)
 93: }
