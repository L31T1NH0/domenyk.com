 60: function collectInlineSources(paragraph: HTMLParagraphElement): { items: RichInlineItem[]; sources: InlineSource[] } | null {
 61:   if (!isSupportedParagraph(paragraph)) return null
 62:   const items: RichInlineItem[] = []
 63:   const sources: InlineSource[] = []
 64:   const walker = document.createTreeWalker(paragraph, NodeFilter.SHOW_TEXT)
 65:   let node = walker.nextNode()
 66:   while (node) {
 67:     const textNode = node as Text
 68:     if (textNode.data.length > 0) {
 69:       const parent = textNode.parentElement
 70:       if (!parent) return null
 71:       const style = window.getComputedStyle(parent)
 72:       const letterSpacing = parsePixelValue(style.letterSpacing, Number.NaN)
 73:       items.push({
 74:         text: textNode.data,
 75:         font: canvasFont(style),
 76:         letterSpacing: Number.isFinite(letterSpacing) ? letterSpacing : undefined,
 77:       })
 78:       sources.push({ node: textNode, text: textNode.data })
 79:     }
 80:     node = walker.nextNode()
 81:   }
 82:   return items.length ? { items, sources } : null
 83: }
