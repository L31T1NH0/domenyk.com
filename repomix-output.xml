 2: import { asString, asTrustedImageUrlArray, toObjectId } from "@/lib/validation"
 3: import { MAX_RICH_CONTENT_LENGTH } from "@/lib/content-format"
 4: 
 5: export class NoteInputError extends Error {
 6:   constructor(message: string, readonly status = 400) {
 7:     super(message)
 8:   }
 9: }
10: 
11: export type NoteInputBody = {
12:   title?: unknown
13:   content?: unknown
14:   images?: unknown
15:   continueFromNoteId?: unknown
16: }
17: 
18: export async function createSerializedNoteFromBody(body: NoteInputBody | null) {
19:   const title = asString(body?.title, 120)?.trim() || undefined
20:   const content = asString(body?.content, MAX_RICH_CONTENT_LENGTH) ?? ""
21:   const normalizedContent = normalizeNoteContent(content)
22: 
23:   if (!normalizedContent) {
24:     throw new NoteInputError("content é obrigatório")
25:   }
