  1: "use client"
  2: 
  3: import { useCallback, useEffect, useMemo, useRef, useState } from "react"
  4: import type { CSSProperties, KeyboardEvent as ReactKeyboardEvent, MouseEvent } from "react"
  5: import { XMarkIcon } from "@heroicons/react/24/solid"
  6: import { DEFAULT_READING_METRICS, effectiveReadingMetrics } from "@/lib/reading-preferences"
  7: import { useReadingPreferences } from "./ReadingPreferencesContext"
  8: import { usePretextImageFlow } from "./usePretextImageFlow"
  9: 
 10: type Props = {
 11:   html: string
 12:   className?: string
 13:   variant?: "default" | "editorial"
 14: }
 15: 
 16: type ActiveImage = {
 17:   src: string
 18:   alt: string
 19: }
 20: 
 21: type ReadingContentStyle = CSSProperties & {
 22:   "--reading-line-height": number
 23:   "--reading-lead-line-height": number
 24:   "--reading-quote-line-height": number
 25:   "--reading-block-spacing": string
 26: }
 27: 
 28: export function PostContentShell({ html, className }: Props) {
 29:   const ref = useRef<HTMLDivElement>(null)
 30:   const contentMarkup = useMemo(() => ({ __html: html }), [html])
 31:   usePretextImageFlow(ref, html)
 32:   const autoFontSize = DEFAULT_READING_METRICS.autoFontSize
 33:   const { preferences, setMetrics } = useReadingPreferences()
 34:   const baseLineHeight = DEFAULT_READING_METRICS.baseLineHeight
 35:   const baseBlockSpacing = DEFAULT_READING_METRICS.baseBlockSpacing
 36:   const readingMetrics = effectiveReadingMetrics(preferences, {
 37:     autoFontSize,
 38:     baseLineHeight,
 39:     baseBlockSpacing,
 40:   })
 41:   const readingStyle: ReadingContentStyle = {
 42:     fontSize: readingMetrics.fontSize,
 43:     gap: `${readingMetrics.blockSpacing}rem`,
 44:     letterSpacing: `${readingMetrics.letterSpacing}em`,
 45:     "--reading-line-height": readingMetrics.lineHeight,
 46:     "--reading-lead-line-height": preferences.lineHeight ?? baseLineHeight,
 47:     "--reading-quote-line-height": preferences.lineHeight ?? baseLineHeight,
 48:     "--reading-block-spacing": `${readingMetrics.blockSpacing}rem`,
 49:   }
 50:   const [activeImage, setActiveImage] = useState<ActiveImage | null>(null)
 51:   const [visible, setVisible] = useState(false)
 52:   const dialogRef = useRef<HTMLDialogElement>(null)
 53:   const closeButtonRef = useRef<HTMLButtonElement>(null)
 54:   const openerRef = useRef<HTMLElement | null>(null)
 55:   const touchStartRef = useRef(0)
 56:   const activeImageTimerRef = useRef<ReturnType<typeof setTimeout> | null>(null)
 57:   const threshold = 80
 58: 
 59:   useEffect(() => {
 60:     setMetrics({ autoFontSize, baseLineHeight, baseBlockSpacing })
 61:   }, [autoFontSize, baseLineHeight, baseBlockSpacing, setMetrics])
 62: 
 63:   useEffect(() => () => setMetrics(DEFAULT_READING_METRICS), [setMetrics])
 64: 
 65:   const close = useCallback(() => {
 66:     if (activeImageTimerRef.current) clearTimeout(activeImageTimerRef.current)
 67:     setVisible(false)
 68:     const closeDelay = window.matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 250
 69:     activeImageTimerRef.current = setTimeout(() => {
 70:       if (dialogRef.current?.open) dialogRef.current.close()
 71:       setActiveImage(null)
 72:       openerRef.current?.focus()
 73:       openerRef.current = null
 74:       activeImageTimerRef.current = null
 75:     }, closeDelay)
 76:   }, [])
 77: 
 78:   useEffect(() => {
 79:     const content = ref.current
 80:     if (!content) return
 81: 
 82:     const images = Array.from(content.querySelectorAll("img"))
 83:       .filter((image) => !image.closest('[data-role="author-reference"]'))
 84: 
 85:     for (const image of images) {
 86:       image.tabIndex = 0
 87:       image.setAttribute("role", "button")
 88:       image.setAttribute("aria-label", image.alt ? `Ampliar imagem: ${image.alt}` : "Ampliar imagem")
 89:     }
 90: 
 91:     return () => {
 92:       for (const image of images) {
 93:         image.removeAttribute("tabindex")
 94:         image.removeAttribute("role")
 95:         image.removeAttribute("aria-label")
 96:       }
 97:     }
 98:   }, [html])
 99: 
100:   useEffect(() => {
101:     if (!activeImage) return
102:     const dialog = dialogRef.current
103:     if (!dialog) return
104: 
105:     if (!dialog.open) dialog.showModal()
106:     let frame = requestAnimationFrame(() => {
107:       frame = requestAnimationFrame(() => {
108:         setVisible(true)
109:         closeButtonRef.current?.focus()
110:       })
111:     })
112: 
113:     const previousOverflow = document.body.style.overflow
114:     document.body.style.overflow = "hidden"
115: 
116:     const onWheel = (event: WheelEvent) => {
117:       if (Math.abs(event.deltaY) > threshold) close()
118:     }
119:     const onTouchStart = (event: TouchEvent) => {
120:       touchStartRef.current = event.touches[0]?.clientY ?? 0
121:     }
122:     const onTouchMove = (event: TouchEvent) => {
123:       const delta = Math.abs((event.touches[0]?.clientY ?? 0) - touchStartRef.current)
124:       if (delta > threshold) close()
125:     }
126: 
127:     dialog.addEventListener("wheel", onWheel, { passive: true })
128:     dialog.addEventListener("touchstart", onTouchStart, { passive: true })
129:     dialog.addEventListener("touchmove", onTouchMove, { passive: true })
130: 
131:     return () => {
132:       cancelAnimationFrame(frame)
133:       document.body.style.overflow = previousOverflow
134:       dialog.removeEventListener("wheel", onWheel)
135:       dialog.removeEventListener("touchstart", onTouchStart)
136:       dialog.removeEventListener("touchmove", onTouchMove)
137:       if (activeImageTimerRef.current) {
138:         clearTimeout(activeImageTimerRef.current)
139:         activeImageTimerRef.current = null
140:       }
141:       if (dialog.open) dialog.close()
142:     }
143:   }, [activeImage, close])
144: 
145:   function handleClick(event: MouseEvent<HTMLDivElement>) {
146:     const image = (event.target as HTMLElement).closest("img")
147:     if (image && ref.current?.contains(image)) {
148:       if (image.closest('[data-role="author-reference"]')) return
149:       openerRef.current = image
150:       setActiveImage({
151:         src: image.getAttribute("src") ?? "",
152:         alt: image.getAttribute("alt") ?? "",
153:       })
154:       return
155:     }
156: 
157:     const anchor = (event.target as HTMLElement).closest("a")
158:     if (!anchor || !ref.current?.contains(anchor)) return
159: 
160:     const href = anchor.getAttribute("href")
161:     if (!href?.includes("#")) return
162: 
163:     let targetUrl: URL
164:     try {
165:       targetUrl = new URL(href, window.location.href)
166:     } catch {
167:       return
168:     }
169:     const isSamePage =
170:       targetUrl.origin === window.location.origin &&
171:       targetUrl.pathname === window.location.pathname &&
172:       targetUrl.search === window.location.search
173:     let targetId = ""
174:     try {
175:       targetId = decodeURIComponent(targetUrl.hash.slice(1))
176:     } catch {
177:       return
178:     }
179:     const target = isSamePage && targetId ? document.getElementById(targetId) : null
180: 
181:     if (!target) return
182: 
183:     event.preventDefault()
184:     const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches
185:     target.scrollIntoView({
186:       behavior: prefersReducedMotion ? "auto" : "smooth",
187:       block: "start",
188:     })
189:     window.history.pushState(null, "", targetUrl.hash)
190:   }
191: 
192:   function handleKeyDown(event: ReactKeyboardEvent<HTMLDivElement>) {
193:     if (event.key !== "Enter" && event.key !== " ") return
194:     const image = (event.target as HTMLElement).closest("img")
195:     if (!image || !ref.current?.contains(image)) return
196:     if (image.closest('[data-role="author-reference"]')) return
197: 
198:     const src = image.getAttribute("src") ?? ""
199:     if (!src) return
200: 
201:     event.preventDefault()
202:     openerRef.current = image
203:     setActiveImage({ src, alt: image.getAttribute("alt") ?? "" })
204:   }
205: 
206:   return (
207:     <>
208:       <div
209:         ref={ref}
210:         data-post-content
211:         className={["post-content flex flex-col gap-3.5", className].filter(Boolean).join(" ")}
212:         style={readingStyle}
213:         onClick={handleClick}
214:         onKeyDown={handleKeyDown}
215:         dangerouslySetInnerHTML={contentMarkup}
216:       />
217:       {activeImage && (
218:         <dialog
219:           ref={dialogRef}
220:           aria-label={activeImage.alt ? `Imagem ampliada: ${activeImage.alt}` : "Imagem ampliada"}
221:           onCancel={(event) => {
222:             event.preventDefault()
223:             close()
224:           }}
225:           onClick={(event) => {
226:             if (event.target === event.currentTarget) close()
227:           }}
228:           className="fixed inset-0 m-0 flex h-dvh max-h-none w-screen max-w-none items-center justify-center border-0 bg-transparent p-4 backdrop:bg-transparent motion-reduce:!transition-none"
229:           style={{
230:             backgroundColor: `rgba(0,0,0,${visible ? 0.92 : 0})`,
231:             backdropFilter: `blur(${visible ? 8 : 0}px)`,
232:             transition: "background-color 250ms ease, backdrop-filter 250ms ease",
233:           }}
234:         >
235:           <button
236:             ref={closeButtonRef}
237:             type="button"
238:             onClick={close}
239:             aria-label="Fechar imagem ampliada"
240:             className="absolute right-4 top-4 z-10 grid size-10 place-items-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white motion-reduce:!transition-none"
241:             style={{ opacity: visible ? 1 : 0, transition: "opacity 250ms ease" }}
242:           >
243:             <XMarkIcon className="h-5 w-5" aria-hidden />
244:           </button>
245:           <img
246:             src={activeImage.src}
247:             alt={activeImage.alt}
248:             className="max-h-[90vh] max-w-[90vw] rounded-lg object-contain shadow-2xl motion-reduce:!transform-none motion-reduce:!transition-none"
249:             style={{
250:               filter: "grayscale(0)",
251:               opacity: visible ? 1 : 0,
252:               transform: visible ? "scale(1)" : "scale(0.92)",
253:               transition: "opacity 250ms ease, transform 250ms ease",
254:             }}
255:           />
256:           <span
257:             className="pointer-events-none absolute bottom-6 left-1/2 -translate-x-1/2 rounded-full bg-black/70 px-3 py-1 text-xs font-medium text-white motion-reduce:!transition-none"
258:             style={{ opacity: visible ? 1 : 0, transition: "opacity 400ms ease" }}
259:           >
260:             Role, deslize ou pressione Esc para fechar
261:           </span>
262:         </dialog>
263:       )}
264:     </>
265:   )
266: }
