180:   }
181: 
182:   constructor(
183:     src: string,
184:     alt = "",
185:     layout: ImageLayout = "block",
186:     flowWidth: ImageFlowWidth = DEFAULT_FLOW_WIDTH,
187:     themeMode: ImageThemeMode = "original",
188:     blockWidth = 100,
189:     alignment: "left" | "center" | "right" = "center",
190:     caption = "",
191:     key?: NodeKey
192:   ) {
193:     super(key)
194:     this.__src = src
195:     this.__alt = alt
196:     this.__layout = normalizeLayout(layout)
197:     this.__flowWidth = normalizeFlowWidth(flowWidth)
198:     this.__themeMode = normalizeThemeMode(themeMode)
199:     this.__blockWidth = imageNumber(blockWidth, 100, 100)
200:     this.__alignment = alignment === "left" || alignment === "right" ? alignment : "center"
