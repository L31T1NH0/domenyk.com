360: export function LexicalEditor({
361:   outputFormat,
362:   initialMarkdown,
363:   onChange,
364:   namespace = "PostEditor",
365:   placeholder = "Escreva o post aqui...",
366:   editorClassName = "min-h-64",
367:   shellClassName = "min-h-64 p-4",
368:   placeholderClassName = "top-4 left-4 text-sm",
369:   toolbarVariant = "default",
370:   toolbarPlacement = "top",
371:   toolbarTrailingContent,
372:   imageUploadEndpoint,
373:   imageAssetsEndpoint,
374:   allowImageAssetLibrary,
375:   allowImages = true,
376:   onChangeDelayMs = 0,
377:   editorRef,
378: }: Props) {
379:   const changeTimerRef = useRef<ReturnType<typeof setTimeout> | null>(null)
380:   const [contentFormat, setContentFormat] = useState<ContentFormat>(() => (
381:     outputFormat ?? (initialMarkdown && isHtmlContent(initialMarkdown) ? "html" : "markdown")
382:   ))
383:   const [htmlSourceMode, setHtmlSourceMode] = useState(() => Boolean(initialMarkdown && isHtmlContent(initialMarkdown)))
384: 
385:   useEffect(() => {
386:     return () => {
387:       if (changeTimerRef.current) clearTimeout(changeTimerRef.current)
388:     }
389:   }, [])
390: 
391:   const initialConfig = useMemo(() => ({
392:     namespace,
393:     theme,
394:     nodes: EDITOR_NODES,
395:     html: editorialHtmlConfig,
396:     onError: (error: Error) => console.error(error),
397:     editorState: initialMarkdown
398:       ? (editor: LexicalEditorInstance) => isHtmlContent(initialMarkdown)
399:         ? importHtmlIntoEditor(editor, initialMarkdown)
400:         : $convertFromMarkdownString(
401:           prepareLatexForLexicalImport(initialMarkdown),
402:           MARKDOWN_TRANSFORMERS
403:         )
404:       : undefined,
405:   }), [initialMarkdown, namespace])
406: 
407:   const handleChange = useCallback(
408:     (state: EditorState, editor: LexicalEditorInstance) => {
409:       if (changeTimerRef.current) clearTimeout(changeTimerRef.current)
410: 
411:       const emitChange = () => {
412:         if (contentFormat === "html") onChange(readHtmlFromEditor(editor))
413:         else state.read(() => onChange(restoreLatexAfterLexicalExport(
414:           $convertToMarkdownString(MARKDOWN_TRANSFORMERS)
415:         ).trim()))
416:       }
417: 
418:       if (onChangeDelayMs > 0) {
419:         changeTimerRef.current = setTimeout(() => {
420:           changeTimerRef.current = null
421:           emitChange()
422:         }, onChangeDelayMs)
423:         return
424:       }
425: 
426:       emitChange()
427:     },
428:     [contentFormat, onChange, onChangeDelayMs]
429:   )
430: 
431:   const handleContentFormatChange = useCallback((format: ContentFormat, editor: LexicalEditorInstance) => {
432:     if (format === contentFormat) return
433:     if (changeTimerRef.current) {
434:       clearTimeout(changeTimerRef.current)
435:       changeTimerRef.current = null
436:     }
437:     setContentFormat(format)
438:     onChange(serializeEditor(editor, format))
439:   }, [contentFormat, onChange])
440: 
441:   return (
442:     <LexicalComposer initialConfig={initialConfig}>
443:       <EditorRefPlugin editorRef={editorRef} />
444:       <PublicationStylePlugin />
445:       {toolbarPlacement === "top" && (
446:         <ToolbarPlugin
447:           allowContentFormatChoice={!outputFormat}
448:           allowDocumentCss={contentFormat === "html"}
449:           contentFormat={contentFormat}
450:           htmlSourceMode={htmlSourceMode}
451:           onContentFormatChange={handleContentFormatChange}
452:           onHtmlSourceModeChange={setHtmlSourceMode}
453:           variant={toolbarVariant}
454:           placement="top"
455:           imageUploadEndpoint={imageUploadEndpoint}
456:           imageAssetsEndpoint={imageAssetsEndpoint}
457:           allowImageAssetLibrary={allowImageAssetLibrary}
458:           allowImages={allowImages}
459:           trailingContent={toolbarTrailingContent}
460:         />
461:       )}
462:       <div className={`relative ${shellClassName}`}>
463:         {htmlSourceMode
464:           ? <HtmlSourceEditor className={editorClassName} />
465:           : <RichTextPlugin
466:               contentEditable={
467:                 <ContentEditable className={`image-flow-editor outline-none text-sm leading-relaxed focus:outline-none ${editorClassName}`} />
468:               }
469:               placeholder={
470:                 <div className={`pointer-events-none absolute select-none text-neutral-500 dark:text-neutral-400 ${placeholderClassName}`}>
471:                   {placeholder}
472:                 </div>
473:               }
474:               ErrorBoundary={({ children }) => <>{children}</>}
475:             />}
476:         <HistoryPlugin />
477:         <MarkdownShortcutPlugin transformers={MARKDOWN_TRANSFORMERS} />
478:         <MarkdownPastePlugin />
479:         <FloatingSelectionToolbarPlugin />
480:         <OnChangePlugin onChange={handleChange} ignoreSelectionChange />
481:       </div>
482:       {toolbarPlacement === "bottom" && (
483:         <ToolbarPlugin
484:           allowContentFormatChoice={!outputFormat}
485:           allowDocumentCss={contentFormat === "html"}
486:           contentFormat={contentFormat}
487:           htmlSourceMode={htmlSourceMode}
488:           onContentFormatChange={handleContentFormatChange}
489:           onHtmlSourceModeChange={setHtmlSourceMode}
490:           variant={toolbarVariant}
491:           placement="bottom"
492:           imageUploadEndpoint={imageUploadEndpoint}
493:           imageAssetsEndpoint={imageAssetsEndpoint}
494:           allowImageAssetLibrary={allowImageAssetLibrary}
495:           allowImages={allowImages}
496:           trailingContent={toolbarTrailingContent}
497:         />
498:       )}
499:     </LexicalComposer>
500:   )
501: }
