19:   const year = Number(request.nextUrl.searchParams.get("year"))
20:   const month = Number(request.nextUrl.searchParams.get("month"))
21:   const category = request.nextUrl.searchParams.get("category")?.trim() ?? ""
22:   const rawOffset = Number(request.nextUrl.searchParams.get("offset") ?? 0)
23:   const offset = Number.isInteger(rawOffset) && rawOffset >= 0 ? Math.min(rawOffset, 10_000) : 0
24:   const search = request.nextUrl.searchParams.get("q")?.trim().replace(/\s+/g, " ") ?? ""
25:   const rawMode = request.nextUrl.searchParams.get("mode") ?? "all"
26:   const mode = FEED_MODES.has(rawMode as "all" | "posts" | "notes")
27:     ? rawMode as "all" | "posts" | "notes"
28:     : "all"
29: 
30:   if (search.length > 120) {
