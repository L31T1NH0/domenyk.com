458: export async function getNoteThreadPage({
459:   page = 1,
460:   limit = 10,
461:   search,
462: }: {
463:   page?: number
464:   limit?: number
465:   search?: string
466: } = {}): Promise<NoteThreadPage> {
467:   const normalizedSearch = search?.trim()
468:   const boundedLimit = Math.max(1, Math.min(Math.floor(limit), 50))
469:   const boundedPage = Math.max(1, Math.floor(page))
470:   const db = await getDb()
471:   const match: Document = {
472:     deleting: { $ne: true },
473:     threadRootId: { $exists: true },
474:     ...(normalizedSearch ? { $text: { $search: normalizedSearch } } : {}),
475:   }
476:   const [result] = await db.collection("notes").aggregate<{
477:     roots: Array<{ _id: ObjectId; latestAt: Date }>
478:     count: Array<{ total: number }>
479:   }>([
480:     { $match: match },
481:     {
482:       $group: {
483:         _id: "$threadRootId",
484:         latestAt: { $max: { $ifNull: ["$publishedAt", "$createdAt"] } },
485:       },
486:     },
487:     { $sort: { latestAt: -1, _id: -1 } },
488:     {
489:       $facet: {
490:         roots: [
491:           { $skip: (boundedPage - 1) * boundedLimit },
492:           { $limit: boundedLimit },
493:         ],
494:         count: [{ $count: "total" }],
495:       },
496:     },
497:   ]).toArray()
498: 
499:   const roots = result?.roots ?? []
500:   if (roots.length === 0) {
501:     return { threads: [], total: result?.count[0]?.total ?? 0 }
502:   }
503: 
504:   const notes = await db.collection<Note>("notes")
505:     .find({
506:       deleting: { $ne: true },
507:       threadRootId: { $in: roots.map((root) => root._id) },
508:     })
509:     .sort({ threadRootId: 1, threadPosition: 1, _id: 1 })
510:     .toArray()
511:   const notesByRoot = new Map<string, Note[]>()
512:   for (const note of notes) {
513:     const rootId = note.threadRootId?.toString()
514:     if (!rootId) continue
515:     const group = notesByRoot.get(rootId)
516:     if (group) group.push(note)
517:     else notesByRoot.set(rootId, [note])
518:   }
519: 
520:   return {
521:     threads: roots.flatMap((root) => {
522:       const thread = notesByRoot.get(root._id.toString())
523:       return thread && thread.length > 1 ? [thread] : []
524:     }),
525:     total: result?.count[0]?.total ?? 0,
526:   }
527: }
