142: async function ensurePostIndexes(col: Awaited<ReturnType<typeof collectionRaw>>): Promise<void> {
143:   const existingIndexes = await col.listIndexes().toArray().catch((error: unknown) => {
144:     if (typeof error === "object" && error && "code" in error && error.code === 26) return []
145:     throw error
146:   })
147:   const textIndex = existingIndexes.find(index => index.key._fts === "text")
148:   
149:   if (textIndex && textIndex.name !== "title_text_content_text_tags_text") {
150:     await col.dropIndex(textIndex.name).catch((error: unknown) => {
151:       if (!(typeof error === "object" && error && "code" in error && error.code === 27)) throw error
152:     })
153:   }
154: 
155:   await Promise.all([
156:     col.createIndex({ publicId: 1 }, { unique: true, sparse: true }),
157:     col.createIndex({ slug: 1 }, { unique: true }),
158:     col.createIndex({ published: 1, publishedAt: -1 }),
159:     col.createIndex({ title: "text", content: "text", tags: "text" }),
