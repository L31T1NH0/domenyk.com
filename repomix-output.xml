108: export async function upsertPushSubscription(data: {
109:   endpoint: string
110:   expirationTime: number | null
111:   keys: { p256dh: string; auth: string }
112:   topics: PushTopic[]
113:   userAgent?: string
114:   admin?: { topics: AdminPushTopic[]; userId: string }
115:   messages?: { enabled: boolean; userId: string }
116: }): Promise<{ subscription: StoredPushSubscription; challengeToken: string | null }> {
117:   const col = await subscriptions()
118:   const existing = await col.findOne({ endpoint: data.endpoint })
119:   const now = new Date()
120:   const needsChallenge = existing?.status !== "active"
121:   const challengeToken = needsChallenge ? randomBytes(32).toString("base64url") : null
122:   const $set: Record<string, unknown> = {
123:     expirationTime: data.expirationTime,
124:     keys: data.keys,
125:     authHash: pushAuthHash(data.keys.auth),
126:     topics: data.topics,
127:     status: needsChallenge ? "pending" : "active",
128:     userAgent: data.userAgent,
129:     failureCount: 0,
130:     updatedAt: now,
131:     retentionUntil: retentionDate(
132:       needsChallenge ? PENDING_SUBSCRIPTION_RETENTION_MS : SUBSCRIPTION_RETENTION_MS
133:     ),
134:   }
135:   const $unset: Record<string, ""> = {}
136:   const $setOnInsert: Record<string, unknown> = {
137:     _id: new ObjectId(),
138:     endpoint: data.endpoint,
139:     createdAt: now,
140:   }
141: 
142:   if (challengeToken) {
143:     $set.challengeTokenHash = pushChallengeHash(challengeToken)
144:     $set.challengeExpiresAt = new Date(now.getTime() + PUSH_CHALLENGE_TTL_MS)
145:     $unset.verifiedAt = ""
146:   }
147: 
148:   if (data.admin) {
149:     $set.adminTopics = data.admin.topics
150:     $set.adminEvents = data.admin.topics.length > 0
151:     if (data.admin.topics.length > 0) {
152:       $set.adminUserId = data.admin.userId
153:       $set.adminVerifiedAt = now
154:     } else {
155:       $unset.adminUserId = ""
156:       $unset.adminVerifiedAt = ""
157:     }
158:   } else {
159:     $set.adminEvents = false
160:     $unset.adminTopics = ""
161:     $unset.adminUserId = ""
162:     $unset.adminVerifiedAt = ""
163:   }
164: 
165:   if (data.messages) {
166:     $set.messageEvents = data.messages.enabled
167:     if (data.messages.enabled) {
168:       $set.messageUserId = data.messages.userId
169:       $set.messageVerifiedAt = now
170:     } else {
171:       $unset.messageUserId = ""
172:       $unset.messageVerifiedAt = ""
173:     }
174:   } else {
175:     $set.messageEvents = false
176:     $unset.messageUserId = ""
177:     $unset.messageVerifiedAt = ""
178:   }
179: 
180:   const subscription = await col.findOneAndUpdate(
181:     { endpoint: data.endpoint },
182:     {
183:       $set,
184:       $setOnInsert,
185:       ...(Object.keys($unset).length ? { $unset } : {}),
186:     },
187:     { upsert: true, returnDocument: "after" }
188:   )
189:   if (!subscription) throw new Error("Não foi possível salvar a inscrição Push.")
190:   return { subscription, challengeToken }
191: }
192: 
193: function pushAuthHash(auth: string): string {
194:   return createHash("sha256").update("domenyk:push-auth:v1\0").update(auth).digest("hex")
195: }
196: 
197: function pushChallengeHash(token: string): string {
198:   return createHash("sha256").update("domenyk:push-challenge:v1\0").update(token).digest("hex")
199: }
200: 
201: function equalHex(left: string, right: string): boolean {
202:   if (!/^[a-f0-9]{64}$/i.test(left) || !/^[a-f0-9]{64}$/i.test(right)) return false
203:   return timingSafeEqual(Buffer.from(left, "hex"), Buffer.from(right, "hex"))
204: }
205: 
206: export function pushCapabilityMatches(subscription: StoredPushSubscription, auth: string): boolean {
207:   const expected = subscription.authHash ?? pushAuthHash(subscription.keys.auth)
208:   return equalHex(expected, pushAuthHash(auth))
209: }
210: 
211: export async function verifyPushSubscriptionChallenge(
212:   endpoint: string,
213:   auth: string,
214:   challengeToken: string
215: ): Promise<boolean> {
216:   const col = await subscriptions()
217:   const subscription = await col.findOne({ endpoint, status: "pending" })
218:   if (
219:     !subscription ||
220:     !pushCapabilityMatches(subscription, auth) ||
221:     !subscription.challengeTokenHash ||
222:     !equalHex(subscription.challengeTokenHash, pushChallengeHash(challengeToken))
223:   ) return false
224: 
225:   const now = new Date()
226:   if (!subscription.challengeExpiresAt || subscription.challengeExpiresAt <= now) return false
227: 
228:   const result = await col.updateOne(
229:     {
230:       _id: subscription._id,
231:       status: "pending",
232:       challengeTokenHash: subscription.challengeTokenHash,
233:       challengeExpiresAt: { $gt: now },
234:     },
235:     {
236:       $set: {
237:         status: "active",
238:         verifiedAt: now,
239:         updatedAt: now,
240:         retentionUntil: retentionDate(SUBSCRIPTION_RETENTION_MS),
241:       },
242:       $unset: { challengeTokenHash: "", challengeExpiresAt: "" },
243:     }
244:   )
245:   return result.modifiedCount === 1
246: }
247: 
248: export async function getPushSubscription(endpoint: string) {
249:   return (await subscriptions()).findOne({ endpoint })
250: }
