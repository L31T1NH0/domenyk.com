<file path="src/components/comments/useComments.ts">
  1: "use client"
  2: 
  3: import { useCallback, useEffect, useRef, useState } from "react"
  4: import { recordCurrentPostAction } from "@/lib/post-engagement"
  5: 
  6: export type Comment = {
  7:   _id: string
  8:   authorName: string
  9:   authorImageUrl: string
 10:   canDelete: boolean
 11:   content: string
 12:   contentHtml?: string
 13:   createdAt: string
 14: }
 15: 
 16: type UseCommentsOptions = {
 17:   enabled?: boolean
 18: }
 19: 
 20: function commentTotalFromResponse(response: Response, fallback: number): number {
 21:   const value = response.headers.get("X-Comments-Total")
 22:   if (value === null) return fallback
 23:   const total = Number(value)
 24:   return Number.isSafeInteger(total) && total >= 0 ? total : fallback
 25: }
 26: 
 27: export function useComments(endpoint: string, { enabled = true }: UseCommentsOptions = {}) {
 28:   const [comments, setComments] = useState<Comment[]>([])
 29:   const [draft, setDraft] = useState("")
 30:   const [loading, setLoading] = useState(false)
 31:   const [loaded, setLoaded] = useState(false)
 32:   const [submitting, setSubmitting] = useState(false)
 33:   const [loadingOlder, setLoadingOlder] = useState(false)
 34:   const [nextCursor, setNextCursor] = useState<string | null>(null)
 35:   const [totalCount, setTotalCount] = useState(0)
 36:   const [error, setError] = useState("")
 37:   const loadingRef = useRef(false)
 38:   const loadedRef = useRef(false)
 39: 
 40:   useEffect(() => {
 41:     loadingRef.current = false
 42:     loadedRef.current = false
 43:     queueMicrotask(() => {
 44:       setComments([])
 45:       setDraft("")
 46:       setLoading(false)
 47:       setLoaded(false)
 48:       setSubmitting(false)
 49:       setLoadingOlder(false)
 50:       setNextCursor(null)
 51:       setTotalCount(0)
 52:       setError("")
 53:     })
 54:   }, [endpoint])
 55: 
 56:   const load = useCallback(async (signal?: AbortSignal) => {
 57:     if (loadingRef.current || loadedRef.current) return
 58: 
 59:     loadingRef.current = true
 60:     setLoading(true)
 61:     setError("")
 62:     try {
 63:       const response = await fetch(endpoint, { signal })
 64:       if (!response.ok) {
 65:         const body = await response.json().catch(() => null) as { error?: string } | null
 66:         throw new Error(body?.error ?? "Não foi possível carregar os comentários.")
 67:       }
 68: 
 69:       const next = await response.json() as Comment[]
 70:       setComments(next)
 71:       setNextCursor(response.headers.get("X-Comments-Next-Cursor"))
 72:       setTotalCount(commentTotalFromResponse(response, next.length))
 73:       loadedRef.current = true
 74:       setLoaded(true)
 75:     } catch (error: unknown) {
 76:       if (error instanceof DOMException && error.name === "AbortError") return
 77:       setError(error instanceof Error ? error.message : "Não foi possível carregar os comentários.")
 78:     } finally {
 79:       loadingRef.current = false
 80:       setLoading(false)
 81:     }
 82:   }, [endpoint])
 83: 
 84:   const loadOlder = useCallback(async () => {
 85:     if (!nextCursor || loadingOlder) return
 86:     setLoadingOlder(true)
 87:     setError("")
 88:     try {
 89:       const separator = endpoint.includes("?") ? "&" : "?"
 90:       const response = await fetch(`${endpoint}${separator}cursor=${encodeURIComponent(nextCursor)}`)
 91:       if (!response.ok) {
 92:         const body = await response.json().catch(() => null) as { error?: string } | null
 93:         throw new Error(body?.error ?? "Não foi possível carregar comentários anteriores.")
 94:       }
 95:       const older = await response.json() as Comment[]
 96:       setComments((current) => [
 97:         ...older,
 98:         ...current.filter((comment) => !older.some((item) => item._id === comment._id)),
 99:       ])
100:       setNextCursor(response.headers.get("X-Comments-Next-Cursor"))
101:       setTotalCount((current) => commentTotalFromResponse(response, current))
102:     } catch (error: unknown) {
103:       setError(error instanceof Error ? error.message : "Não foi possível carregar comentários anteriores.")
104:     } finally {
105:       setLoadingOlder(false)
106:     }
107:   }, [endpoint, loadingOlder, nextCursor])
108: 
109:   useEffect(() => {
110:     if (!enabled) return
111: 
112:     const controller = new AbortController()
113:     queueMicrotask(() => {
114:       void load(controller.signal)
115:     })
116: 
117:     return () => {
118:       controller.abort()
119:     }
120:   }, [enabled, load])
121: 
122:   const submit = useCallback(async (nextContent?: string) => {
123:     const content = (nextContent ?? draft).trim()
124:     if (!content || submitting) return
125: 
126:     setSubmitting(true)
127:     setError("")
128:     try {
129:       const response = await fetch(endpoint, {
130:         method: "POST",
131:         headers: { "Content-Type": "application/json" },
132:         body: JSON.stringify({ content }),
133:       })
134: 
135:       if (!response.ok) {
136:         const body = await response.json().catch(() => null) as { error?: string } | null
137:         throw new Error(body?.error ?? "Não foi possível publicar o comentário.")
138:       }
139: 
140:       const comment = await response.json() as Comment
141:       setComments((current) => [...current, comment])
142:       setTotalCount((current) => current + 1)
143:       loadedRef.current = true
144:       setLoaded(true)
145:       setDraft("")
146:       void recordCurrentPostAction("commented")
147:       return true
148:     } catch (error: unknown) {
149:       setError(error instanceof Error ? error.message : "Não foi possível publicar o comentário.")
150:       return false
151:     } finally {
152:       setSubmitting(false)
153:     }
154:   }, [draft, endpoint, submitting])
155: 
156:   const remove = useCallback(async (id: string) => {
157:     setError("")
158:     try {
159:       const response = await fetch(`/api/comments/by-id/${id}`, { method: "DELETE" })
160:       if (!response.ok) {
161:         const body = await response.json().catch(() => null) as { error?: string } | null
162:         throw new Error(body?.error ?? "Não foi possível excluir o comentário.")
163:       }
164:       setComments((current) => current.filter((comment) => comment._id !== id))
165:       setTotalCount((current) => Math.max(0, current - 1))
166:       return true
167:     } catch (error: unknown) {
168:       setError(error instanceof Error ? error.message : "Não foi possível excluir o comentário.")
169:       return false
170:     }
171:   }, [])
172: 
173:   return {
174:     comments,
175:     draft,
176:     loading,
177:     loaded,
178:     totalCount,
179:     submitting,
180:     hasMore: Boolean(nextCursor),
181:     loadingOlder,
182:     error,
183:     setComments,
184:     setDraft,
185:     load,
186:     loadOlder,
187:     submit,
188:     remove,
189:   }
190: }
</file>

<file path="src/components/notes/NoteViewTracker.tsx">
 1: "use client"
 2: 
 3: import { useEffect } from "react"
 4: import { NOTE_VIEW_TTL_MS } from "@/lib/note-views"
 5: import { viewClientContext } from "@/lib/view-referrer"
 6: 
 7: const pendingDirectViews = new Set<string>()
 8: 
 9: export function NoteViewTracker({ noteId }: { noteId: string }) {
10:   useEffect(() => {
11:     const storageKey = `note-viewed:direct:${noteId}`
12:     const now = Date.now()
13:     try {
14:       const previous = Number(localStorage.getItem(storageKey) ?? 0)
15:       if (previous && now - previous < NOTE_VIEW_TTL_MS) return
16:     } catch {}
17:     if (pendingDirectViews.has(noteId)) return
18: 
19:     let cancelled = false
20:     pendingDirectViews.add(noteId)
21:     fetch(`/api/notes/${noteId}/view`, {
22:       method: "POST",
23:       cache: "no-store",
24:       headers: { "Content-Type": "application/json" },
25:       body: JSON.stringify({ source: "direct", ...viewClientContext() }),
26:     }).then((response) => {
27:       if (!cancelled && response.ok) {
28:         try { localStorage.setItem(storageKey, String(Date.now())) } catch {}
29:       }
30:     }).catch(() => undefined).finally(() => pendingDirectViews.delete(noteId))
31: 
32:     return () => {
33:       cancelled = true
34:     }
35:   }, [noteId])
36: 
37:   return null
38: }
</file>

<file path="src/components/post/EditorialSectionNav.tsx">
  1: "use client"
  2: 
  3: import { useEffect, useState } from "react"
  4: 
  5: type HeadingEntry = {
  6:   id: string
  7:   text: string
  8:   level: number
  9: }
 10: 
 11: type Props = {
 12:   label: string
 13: }
 14: 
 15: function slugify(text: string) {
 16:   return text
 17:     .normalize("NFD")
 18:     .replace(/[\u0300-\u036f]/g, "")
 19:     .toLowerCase()
 20:     .replace(/[^a-z0-9]+/g, "-")
 21:     .replace(/^-|-$/g, "") || "secao"
 22: }
 23: 
 24: export function EditorialSectionNav({ label }: Props) {
 25:   const [headings, setHeadings] = useState<HeadingEntry[]>([])
 26:   const [activeId, setActiveId] = useState<string | null>(null)
 27: 
 28:   useEffect(() => {
 29:     const content = document.querySelector<HTMLElement>("[data-post-content]")
 30:     if (!content) return
 31: 
 32:     const usedIds = new Set<string>()
 33:     const entries = Array.from(content.querySelectorAll<HTMLHeadingElement>("h2, h3"))
 34:       .map((heading) => {
 35:         const text = heading.textContent?.trim() ?? ""
 36:         if (!text) return null
 37: 
 38:         let id = heading.id || slugify(text)
 39:         let suffix = 2
 40:         while (usedIds.has(id)) id = `${slugify(text)}-${suffix++}`
 41:         heading.id = id
 42:         usedIds.add(id)
 43: 
 44:         return { id, text, level: Number(heading.tagName.slice(1)) }
 45:       })
 46:       .filter((heading): heading is HeadingEntry => heading !== null)
 47: 
 48:     if (entries.length === 0) return
 49: 
 50:     let frame = window.requestAnimationFrame(() => {
 51:       frame = 0
 52:       setHeadings(entries)
 53:       setActiveId(entries[0].id)
 54:     })
 55:     const updateActiveHeading = () => {
 56:       frame = 0
 57:       const focusLine = window.scrollY + Math.min(180, window.innerHeight * 0.28)
 58:       let next = entries[0].id
 59: 
 60:       for (const entry of entries) {
 61:         const element = document.getElementById(entry.id)
 62:         if (element && element.getBoundingClientRect().top + window.scrollY <= focusLine) {
 63:           next = entry.id
 64:         }
 65:       }
 66:       setActiveId(next)
 67:     }
 68:     const scheduleUpdate = () => {
 69:       if (frame) return
 70:       frame = window.requestAnimationFrame(updateActiveHeading)
 71:     }
 72: 
 73:     window.addEventListener("scroll", scheduleUpdate, { passive: true })
 74:     window.addEventListener("resize", scheduleUpdate)
 75:     return () => {
 76:       if (frame) window.cancelAnimationFrame(frame)
 77:       window.removeEventListener("scroll", scheduleUpdate)
 78:       window.removeEventListener("resize", scheduleUpdate)
 79:     }
 80:   }, [])
 81: 
 82:   if (headings.length === 0) return null
 83: 
 84:   return (
 85:     <nav className="editorial-section-nav" aria-label={label}>
 86:       <p>{label}</p>
 87:       <div className="editorial-section-links">
 88:         {headings.map((heading, index) => (
 89:           <a
 90:             key={heading.id}
 91:             href={`#${encodeURIComponent(heading.id)}`}
 92:             aria-current={activeId === heading.id ? "location" : undefined}
 93:             data-level={heading.level}
 94:             onClick={(event) => {
 95:               const target = document.getElementById(heading.id)
 96:               if (!target) return
 97:               event.preventDefault()
 98:               target.scrollIntoView({
 99:                 behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
100:                 block: "start",
101:               })
102:               window.history.replaceState(null, "", `#${encodeURIComponent(heading.id)}`)
103:             }}
104:           >
105:             <span>{String(index + 1).padStart(2, "0")}</span>
106:             <span>{heading.text}</span>
107:           </a>
108:         ))}
109:       </div>
110:     </nav>
111:   )
112: }
</file>

