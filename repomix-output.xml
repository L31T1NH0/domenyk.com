263: export async function linkNoteToThread(sourceNoteId: string, targetNoteId: string): Promise<Note[]> {
264:   const sourceId = toObjectId(sourceNoteId)
265:   const targetId = toObjectId(targetNoteId)
266:   if (!sourceId || !targetId) throw new NoteThreadError("Nota inválida.")
267:   if (sourceId.equals(targetId)) throw new NoteThreadError("Escolha outra nota para completar a thread.")
268: 
269:   const col = await collection()
270:   const [source, target] = await Promise.all([
271:     col.findOne({ _id: sourceId, deleting: { $ne: true } }),
272:     col.findOne({ _id: targetId, deleting: { $ne: true } }),
273:   ])
274:   if (!source) throw new NoteThreadError("A thread selecionada não existe mais.")
275:   if (!target) throw new NoteThreadError("A nota que seria vinculada não existe mais.")
276: 
277:   const selectedRootId = source.threadRootId ?? source._id
278:   if (target.threadRootId) {
279:     if (source.threadRootId && target.threadRootId.equals(source.threadRootId)) {
280:       return col.find({
281:         threadRootId: source.threadRootId,
282:         deleting: { $ne: true },
283:       }).sort({ threadPosition: 1, _id: 1 }).toArray()
284:     }
285:     throw new NoteThreadError("Essa nota já pertence a outra thread.")
286:   }
287: 
288:   const now = new Date()
289:   let initializedRoot = false
290:   let previousNoteId = source._id
291:   let threadPosition = 2
292: 
293:   if (source.threadRootId) {
294:     const lastNote = await col.find({
295:       threadRootId: source.threadRootId,
296:       deleting: { $ne: true },
297:     }).sort({ threadPosition: -1, _id: -1 }).limit(1).next()
298:     if (!lastNote?.threadPosition) throw new NoteThreadError("A thread está inconsistente.")
299:     previousNoteId = lastNote._id
300:     threadPosition = lastNote.threadPosition + 1
301:   } else {
302:     const initialized = await col.updateOne(
303:       { _id: source._id, deleting: { $ne: true }, threadRootId: { $exists: false } },
304:       { $set: { threadRootId: source._id, threadPosition: 1, updatedAt: now } }
305:     )
306:     if (initialized.matchedCount !== 1) {
307:       throw new NoteThreadError("A thread mudou enquanto as notas eram vinculadas. Tente novamente.")
308:     }
309:     initializedRoot = true
310:   }
311: 
312:   try {
313:     const linked = await col.updateOne(
314:       { _id: target._id, deleting: { $ne: true }, threadRootId: { $exists: false } },
315:       {
316:         $set: {
317:           threadRootId: selectedRootId,
318:           previousNoteId,
319:           threadPosition,
320:           updatedAt: now,
321:         },
322:       }
323:     )
324:     if (linked.matchedCount !== 1) {
325:       throw new NoteThreadError("A nota mudou enquanto era vinculada. Tente novamente.")
326:     }
327:   } catch (error) {
328:     if (initializedRoot) {
329:       const members = await col.countDocuments({ threadRootId: selectedRootId })
330:       if (members === 1) {
331:         await col.updateOne(
332:           { _id: selectedRootId },
333:           { $unset: { threadRootId: "", threadPosition: "" } }
334:         )
335:       }
336:     }
337:     throw error
338:   }
339: 
340:   return col.find({
341:     threadRootId: selectedRootId,
342:     deleting: { $ne: true },
343:   }).sort({ threadPosition: 1, _id: 1 }).toArray()
344: }
345: 
346: export async function updateNote(id: string, data: { title?: string | null; seoTitle?: string | null; seoDescription?: string | null; content: string; images?: string[] }): Promise<Note | null> {
347:   const objectId = toObjectId(id)
348:   if (!objectId) return null
349: 
350:   const update: Partial<Note> = { content: normalizeNoteContent(data.content), updatedAt: new Date() }
351:   if (data.title) update.title = data.title
352:   if (data.seoTitle) update.seoTitle = data.seoTitle
353:   if (data.seoDescription) update.seoDescription = data.seoDescription
354:   if (data.images !== undefined) update.images = data.images
355: 
356:   const $unset: Record<string, ""> = {}
357:   if (data.title === null) $unset.title = ""
358:   if (data.seoTitle === null) $unset.seoTitle = ""
359:   if (data.seoDescription === null) $unset.seoDescription = ""
360: 
361:   return (await collection()).findOneAndUpdate(
362:     { _id: objectId },
363:     Object.keys($unset).length > 0 ? { $set: update, $unset } : { $set: update },
364:     { returnDocument: "after" }
365:   )
366: }
367: 
368: export async function updateNoteSeo(id: string, data: { seoTitle: string; seoDescription: string }): Promise<Note | null> {
369:   const objectId = toObjectId(id)
370:   if (!objectId) return null
371:   return (await collection()).findOneAndUpdate(
372:     { _id: objectId, deleting: { $ne: true } },
373:     { $set: { seoTitle: data.seoTitle, seoDescription: data.seoDescription, updatedAt: new Date() } },
374:     { returnDocument: "after" }
375:   )
376: }
377: 
378: export async function deleteNote(id: string): Promise<{ deleted: boolean; thread: Note[] }> {
379:   const objectId = toObjectId(id)
380:   if (!objectId) return { deleted: false, thread: [] }
381:   const col = await collection()
382:   const note = await col.findOne({ _id: objectId })
383:   if (!note) return { deleted: false, thread: [] }
384:   const result = await col.deleteOne({ _id: objectId })
385:   let repairedThread: Note[] = []
386:   if (result.deletedCount === 1 && note.threadRootId) {
387:     try {
388:       const remaining = await col.find({
389:         threadRootId: note.threadRootId,
390:         deleting: { $ne: true },
391:       }).sort({ threadPosition: 1, _id: 1 }).toArray()
392: 
393:       if (remaining.length === 1) {
394:         await col.updateOne(
395:           { _id: remaining[0]._id },
396:           { $unset: { threadRootId: "", previousNoteId: "", threadPosition: "" } }
397:         )
398:         const standalone = await col.findOne({ _id: remaining[0]._id })
399:         if (standalone) repairedThread = [standalone]
400:       } else if (remaining.length > 1) {
401:         const nextRootId = remaining[0]._id
402:         await col.bulkWrite(remaining.map((member, index) => ({
403:           updateOne: {
404:             filter: { _id: member._id },
405:             update: index === 0
406:               ? {
407:                   $set: { threadRootId: nextRootId, threadPosition: 1 },
408:                   $unset: { previousNoteId: "" },
409:                 }
410:               : {
411:                   $set: {
412:                     threadRootId: nextRootId,
413:                     previousNoteId: remaining[index - 1]._id,
414:                     threadPosition: index + 1,
415:                   },
416:                 },
417:           },
418:         })))
419:         repairedThread = await col.find({
420:           threadRootId: nextRootId,
421:           deleting: { $ne: true },
422:         }).sort({ threadPosition: 1, _id: 1 }).toArray()
423:       }
424:     } catch (error) {
425:       console.error("Failed to repair note thread after deletion", { noteId: id, error })
426:     }
427:   }
428:   if (result.deletedCount === 1) {
429:     // Metrics are auxiliary. A cleanup failure must not turn a completed note
430:     // deletion into an HTTP 500 or leave the admin UI reporting false failure.
431:     await deleteNoteMetrics(id).catch((error) => {
432:       console.error("Failed to delete note metrics", { noteId: id, error })
433:     })
434:   }
435:   return { deleted: result.deletedCount === 1, thread: repairedThread }
436: }
437: 
438: export async function markNoteDeleting(id: string): Promise<boolean> {
439:   const objectId = toObjectId(id)
440:   if (!objectId) return false
441:   const result = await (await collection()).updateOne(
442:     { _id: objectId },
443:     { $set: { deleting: true, updatedAt: new Date() } }
444:   )
445:   return result.matchedCount === 1
446: }
</file>

