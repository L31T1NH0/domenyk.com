 1: export type NoteSeoImportItem = {
 2:   id: string
 3:   seoTitle: string
 4:   seoDescription: string
 5: }
 6: 
 7: export type NoteSeoImportBundle = {
 8:   version: 1
 9:   kind: "domenyk_note_seo_import"
10:   notes: NoteSeoImportItem[]
11: }
12: 
13: function isRecord(value: unknown): value is Record<string, unknown> {
14:   return typeof value === "object" && value !== null && !Array.isArray(value)
15: }
16: 
17: function requiredString(value: unknown, field: string, maxLength: number): string {
18:   if (typeof value !== "string") throw new Error(`${field} deve ser texto.`)
19:   const result = value.trim()
20:   if (!result) throw new Error(`${field} não pode ficar vazio.`)
21:   if (result.length > maxLength) throw new Error(`${field} excede o limite de ${maxLength} caracteres.`)
22:   return result
23: }
24: 
25: export function validateNoteSeoImportBundle(value: unknown): NoteSeoImportBundle {
26:   if (!isRecord(value) || value.version !== 1 || value.kind !== "domenyk_note_seo_import") {
27:     throw new Error("Arquivo SEO inválido. Use o formato descrito no guia.")
28:   }
29:   if (!Array.isArray(value.notes) || value.notes.length === 0 || value.notes.length > 500) {
30:     throw new Error("O arquivo deve conter entre 1 e 500 notas.")
31:   }
32: 
33:   const ids = new Set<string>()
34:   const notes = value.notes.map((raw, index) => {
35:     if (!isRecord(raw)) throw new Error(`A nota ${index + 1} é inválida.`)
36:     const id = requiredString(raw.id, `notes[${index}].id`, 24)
37:     if (!/^[a-f\d]{24}$/i.test(id)) throw new Error(`notes[${index}].id não é um ObjectId válido.`)
38:     if (ids.has(id)) throw new Error(`O ID ${id} aparece mais de uma vez.`)
39:     ids.add(id)
40:     return {
41:       id,
42:       seoTitle: requiredString(raw.seoTitle, `notes[${index}].seoTitle`, 120),
43:       seoDescription: requiredString(raw.seoDescription, `notes[${index}].seoDescription`, 300),
44:     }
45:   })
46: 
47:   return { version: 1, kind: "domenyk_note_seo_import", notes }
48: }
