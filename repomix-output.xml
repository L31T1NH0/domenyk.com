159: function initialVersionStates(post?: PostData): VersionStates {
160:   const states: VersionStates = {
161:     pt: {
162:       exists: Boolean(post?.id),
163:       published: post?.published === true,
164:       publishedAt: post?.publishedAt,
165:       updatedAt: post?.originalContentUpdatedAt,
166:     },
167:     en: { exists: false, published: false },
168:     de: { exists: false, published: false },
169:     id: { exists: false, published: false },
170:   }
171: 
172:   for (const locale of ["en", "de", "id"] as const) {
173:     const translation = post?.translations?.[locale]
174:     if (!translation) continue
175:     states[locale] = {
176:       exists: true,
177:       published: translation.published,
178:       publishedAt: translation.publishedAt,
179:       sourceUpdatedAt: translation.sourceUpdatedAt,
180:       updatedAt: translation.updatedAt,
181:     }
182:   }
183: 
184:   return states
185: }
