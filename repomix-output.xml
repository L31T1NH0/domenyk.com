1070:   async function handleLinkToThread(note: SerializedNote) {
1071:     if (!threadParent || linkingNoteId) return
1072:     setLinkingNoteId(note._id)
1073:     setNoteError("")
1074: 
1075:     try {
1076:       const response = await fetch(`/api/admin/notes/${note._id}/thread`, {
1077:         method: "POST",
1078:         headers: { "Content-Type": "application/json" },
1079:         body: JSON.stringify({ sourceNoteId: threadParent._id }),
1080:       })
1081:       const data = await response.json().catch(() => null) as { error?: string; thread?: SerializedNote[] } | null
1082:       if (!response.ok || !Array.isArray(data?.thread)) {
1083:         throw new Error(data?.error ?? "Não foi possível linkar a nota à thread.")
1084:       }
1085:       setNotes((current) => mergeNotesById(current, data.thread!))
1086:       setDesktopRailNotes((current) => mergeNotesById(current, data.thread!))
1087:       const linkedIds = new Set(data.thread.map((threadNote) => threadNote._id))
1088:       setDesktopTimelineNotes((current) => current.filter((existing) => !linkedIds.has(existing._id)))
1089:       setDesktopTimelineNoteCount((current) => Math.max(0, current - (threadParent.thread ? 1 : 2)))
1090:       if (!threadParent.thread) setDesktopRailThreadCount((current) => current + 1)
1091:       setThreadParent(null)
1092:     } catch (caughtError) {
1093:       setNoteError(caughtError instanceof Error ? caughtError.message : "Não foi possível linkar a nota à thread.")
1094:     } finally {
1095:       setLinkingNoteId(null)
1096:     }
1097:   }
