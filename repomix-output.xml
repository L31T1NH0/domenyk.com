<file path="scripts/migrate-legacy-post-dates.mjs">
 1: import { MongoClient } from "mongodb"
 2: import { backupDatabase, backupPassphrase } from "./secure-mongo-backup.mjs"
 3: import { siteDateKeyToInstant } from "../src/lib/datetime.ts"
 4: 
 5: const uri = process.env.MONGODB_URI
 6: if (!uri) throw new Error("MONGODB_URI não definida")
 7: 
 8: const apply = process.argv.includes("--apply")
 9: const confirmed = process.argv.includes("--confirm=CORRIGIR-DATAS-LEGADAS")
10: const backupArg = process.argv.find((argument) => argument.startsWith("--backup-dir="))?.slice("--backup-dir=".length)
11: 
12: if (apply && !confirmed) throw new Error("Use --confirm=CORRIGIR-DATAS-LEGADAS junto com --apply.")
13: if (apply && !backupArg) throw new Error("Use --backup-dir=/caminho/fora/do/repositorio junto com --apply.")
14: 
15: const client = new MongoClient(uri)
16: const LEGACY_DATE_CUTOFF = new Date("2026-01-01T00:00:00.000Z")
17: 
18: function isUtcMidnight(date) {
19:   return date.getUTCHours() === 0
20:     && date.getUTCMinutes() === 0
21:     && date.getUTCSeconds() === 0
22:     && date.getUTCMilliseconds() === 0
23: }
24: 
25: function correctedInstant(date) {
26:   return siteDateKeyToInstant(date.toISOString().slice(0, 10))
27: }
28: 
29: async function main() {
30:   await client.connect()
31:   const db = client.db("blog")
32:   const posts = db.collection("posts")
33:   const rows = await posts.find(
34:     { publishedAt: { $type: "date" }, createdAt: { $type: "date" } },
35:     { projection: { title: 1, publishedAt: 1, createdAt: 1 } }
36:   ).toArray()
37: 
38:   const candidates = rows
39:     .filter((post) => (
40:       post.publishedAt < LEGACY_DATE_CUTOFF
41:       && post.publishedAt.getTime() === post.createdAt.getTime()
42:       && isUtcMidnight(post.publishedAt)
43:     ))
44:     .map((post) => ({
45:       ...post,
46:       correctedPublishedAt: correctedInstant(post.publishedAt),
47:       correctedCreatedAt: correctedInstant(post.createdAt),
48:     }))
49: 
50:   console.log(JSON.stringify({
51:     mode: apply ? "apply" : "dry-run",
52:     inspected: rows.length,
53:     candidates: candidates.length,
54:     posts: candidates.map((post) => ({
55:       id: post._id.toString(),
56:       title: post.title,
57:       publishedAt: { from: post.publishedAt.toISOString(), to: post.correctedPublishedAt.toISOString() },
58:       createdAt: { from: post.createdAt.toISOString(), to: post.correctedCreatedAt.toISOString() },
59:     })),
60:   }, null, 2))
61: 
62:   if (!apply || candidates.length === 0) return
63: 
64:   const passphrase = backupPassphrase()
65:   const backup = await backupDatabase(db, backupArg, passphrase)
66:   const result = await posts.bulkWrite(candidates.map((post) => ({
67:     updateOne: {
68:       filter: { _id: post._id, publishedAt: post.publishedAt, createdAt: post.createdAt },
69:       update: { $set: { publishedAt: post.correctedPublishedAt, createdAt: post.correctedCreatedAt } },
70:     },
71:   })), { ordered: true })
72: 
73:   if (result.matchedCount !== candidates.length || result.modifiedCount !== candidates.length) {
74:     throw new Error(`Concorrência detectada: ${result.matchedCount} encontrados e ${result.modifiedCount} corrigidos de ${candidates.length}.`)
75:   }
76:   console.log(JSON.stringify({ corrected: result.modifiedCount, encryptedBackup: backup.target }, null, 2))
77: }
78: 
79: main()
80:   .catch((error) => {
81:     console.error(error)
82:     process.exitCode = 1
83:   })
84:   .finally(() => client.close())
</file>

<file path="scripts/migrate-notification-days.mjs">
  1: import { MongoClient, ObjectId } from "mongodb"
  2: 
  3: import { dailyNotificationAggregateKey, notificationDay } from "../src/lib/notification-aggregation.ts"
  4: 
  5: const DAILY_KEY_SUFFIX = /:day:\d{4}-\d{2}-\d{2}$/
  6: const LEGACY_AGGREGATE_KEY = /^(?:view:|note-view:)/
  7: const MAX_NOTIFICATION_OCCURRENCES = 200
  8: 
  9: function occurrenceDate(occurrence) {
 10:   if (occurrence instanceof Date) return occurrence
 11:   return occurrence?.occurredAt instanceof Date ? occurrence.occurredAt : null
 12: }
 13: 
 14: function notificationOccurrences(notification) {
 15:   const stored = (notification.occurrences ?? []).filter((occurrence) => occurrenceDate(occurrence))
 16:   if (stored.length > 0) return stored
 17:   if (notification.count > 1 && notification.createdAt.getTime() !== notification.updatedAt.getTime()) {
 18:     return [{ occurredAt: notification.createdAt }, { occurredAt: notification.updatedAt }]
 19:   }
 20:   return [{ occurredAt: notification.updatedAt }]
 21: }
 22: 
 23: function splitNotification(notification) {
 24:   const grouped = new Map()
 25:   const occurrences = notificationOccurrences(notification)
 26: 
 27:   for (const occurrence of occurrences) {
 28:     const day = notificationDay(occurrenceDate(occurrence))
 29:     const group = grouped.get(day) ?? []
 30:     group.push(occurrence)
 31:     grouped.set(day, group)
 32:   }
 33: 
 34:   const groups = [...grouped]
 35:     .sort(([left], [right]) => left.localeCompare(right))
 36:     .map(([day, groupOccurrences]) => {
 37:       const dates = groupOccurrences.map(occurrenceDate)
 38:       const aggregateKey = notification.aggregateKey
 39:       const shared = { ...notification }
 40:       delete shared._id
 41:       delete shared.aggregateKey
 42:       delete shared.count
 43:       delete shared.occurrences
 44:       delete shared.createdAt
 45:       delete shared.updatedAt
 46:       return {
 47:         ...shared,
 48:         aggregateKey: dailyNotificationAggregateKey(aggregateKey, dates[0]),
 49:         count: groupOccurrences.length,
 50:         occurrences: groupOccurrences,
 51:         createdAt: new Date(Math.min(...dates.map((date) => date.getTime()))),
 52:         updatedAt: new Date(Math.max(...dates.map((date) => date.getTime()))),
 53:         day,
 54:       }
 55:     })
 56: 
 57:   const missingOccurrences = Math.max(0, notification.count - occurrences.length)
 58:   if (groups[0]) groups[0].count += missingOccurrences
 59:   return groups
 60: }
 61: 
 62: function mergeNotifications(existing, incoming) {
 63:   const existingOccurrences = notificationOccurrences(existing)
 64:   const combinedOccurrences = [...existingOccurrences, ...incoming.occurrences]
 65:     .sort((left, right) => occurrenceDate(left).getTime() - occurrenceDate(right).getTime())
 66:     .slice(-MAX_NOTIFICATION_OCCURRENCES)
 67:   const incomingIsNewer = incoming.updatedAt >= existing.updatedAt
 68:   const newer = incomingIsNewer ? incoming : existing
 69:   const readAt = existing.readAt && incoming.readAt
 70:     ? new Date(Math.max(existing.readAt.getTime(), incoming.readAt.getTime()))
 71:     : undefined
 72:   const incomingDocument = { ...incoming }
 73:   const newerDocument = { ...newer }
 74:   delete incomingDocument.day
 75:   delete incomingDocument._id
 76:   delete newerDocument.day
 77: 
 78:   const merged = {
 79:     ...incomingDocument,
 80:     ...newerDocument,
 81:     _id: existing._id,
 82:     aggregateKey: incoming.aggregateKey,
 83:     count: existing.count + incoming.count,
 84:     occurrences: combinedOccurrences,
 85:     createdAt: new Date(Math.min(existing.createdAt.getTime(), incoming.createdAt.getTime())),
 86:     updatedAt: new Date(Math.max(existing.updatedAt.getTime(), incoming.updatedAt.getTime())),
 87:   }
 88:   if (readAt) merged.readAt = readAt
 89:   else delete merged.readAt
 90:   return merged
 91: }
 92: 
 93: function legacyQuery() {
 94:   return {
 95:     aggregateKey: { $regex: LEGACY_AGGREGATE_KEY, $not: DAILY_KEY_SUFFIX },
 96:     kind: "view",
 97:   }
 98: }
 99: 
100: const apply = process.argv.includes("--apply")
101: const uri = process.env.MONGODB_URI
102: if (!uri) throw new Error("MONGODB_URI is not set")
103: 
104: const client = new MongoClient(uri)
105: await client.connect()
106: 
107: try {
108:   const notifications = client.db("blog").collection("notifications")
109:   const legacyNotifications = await notifications.find(legacyQuery()).sort({ updatedAt: 1 }).toArray()
110:   const plannedGroups = legacyNotifications.flatMap((notification) => splitNotification(notification))
111: 
112:   console.log(JSON.stringify({
113:     mode: apply ? "apply" : "dry-run",
114:     legacyNotifications: legacyNotifications.length,
115:     resultingDailyNotifications: plannedGroups.length,
116:     groups: legacyNotifications.map((notification) => ({
117:       id: notification._id.toString(),
118:       aggregateKey: notification.aggregateKey,
119:       count: notification.count,
120:       days: splitNotification(notification).map((group) => ({ day: group.day, count: group.count })),
121:     })),
122:   }, null, 2))
123: 
124:   if (!apply || legacyNotifications.length === 0) process.exitCode = 0
125:   else {
126:     const session = client.startSession()
127:     try {
128:       await session.withTransaction(async () => {
129:         for (const candidate of legacyNotifications) {
130:           const source = await notifications.findOne({ _id: candidate._id, ...legacyQuery() }, { session })
131:           if (!source) continue
132: 
133:           const groups = splitNotification(source)
134:           await notifications.deleteOne({ _id: source._id }, { session })
135: 
136:           let sourceIdAvailable = true
137:           for (const group of groups) {
138:             const dailyDocument = { ...group }
139:             delete dailyDocument.day
140:             const existing = await notifications.findOne({
141:               recipientId: source.recipientId,
142:               aggregateKey: dailyDocument.aggregateKey,
143:             }, { session })
144: 
145:             if (existing) {
146:               await notifications.replaceOne(
147:                 { _id: existing._id },
148:                 mergeNotifications(existing, dailyDocument),
149:                 { session }
150:               )
151:               continue
152:             }
153: 
154:             const _id = sourceIdAvailable ? source._id : new ObjectId()
155:             sourceIdAvailable = false
156:             await notifications.insertOne({ _id, ...dailyDocument }, { session })
157:           }
158:         }
159:       })
160:     } finally {
161:       await session.endSession()
162:     }
163: 
164:     const remaining = await notifications.countDocuments(legacyQuery())
165:     console.log(JSON.stringify({ migrated: legacyNotifications.length, remainingLegacyNotifications: remaining }))
166:     if (remaining !== 0) process.exitCode = 1
167:   }
168: } finally {
169:   await client.close()
170: }
</file>

