 65: function shouldPreserveLineBreaks(block: string): boolean {
 66:   const lines = block.split("\n")
 67:   return lines.some(
 68:     (line) =>
 69:       /^(```|~~~)/.test(line) ||
 70:       /^\s*([-*+]|\d+\.)\s+/.test(line) ||
 71:       /^\s*>/.test(line) ||
 72:       /^\s*#{1,6}\s+/.test(line) ||
 73:       /^\s*\|.*\|\s*$/.test(line)
 74:   )
 75: }
