219: export function NotificationList() {
220:   const [items, setItems] = useState<Item[] | null>(null)
221:   const [error, setError] = useState("")
222:   const [expandedId, setExpandedId] = useState<string | null>(null)
223:   const [expandedAnchor, setExpandedAnchor] = useState<HTMLButtonElement | null>(null)
224:   const expandedItem = items?.find((item) => item._id === expandedId) ?? null
225: 
226:   const closeDropdown = useCallback(() => {
227:     setExpandedId(null)
228:     setExpandedAnchor(null)
229:   }, [])
230: 
231:   useEffect(() => {
232:     fetch("/api/notifications", { cache: "no-store" })
233:       .then((response) => response.ok ? response.json() : { items: [] })
234:       .then((data) => setItems(data.items))
235:   }, [])
236: 
237:   async function read(item: Item) {
238:     if (item.readAt) return
239:     const response = await fetch("/api/notifications", {
240:       method: "PATCH",
241:       headers: { "Content-Type": "application/json" },
242:       body: JSON.stringify({ id: item._id }),
243:     })
244:     if (!response.ok) return
245:     setItems((current) => current?.map((value) => value._id === item._id
246:       ? { ...value, readAt: new Date().toISOString() }
247:       : value) ?? [])
248:     notifyCountChanged()
249:   }
250: 
251:   async function readAll() {
252:     const response = await fetch("/api/notifications", {
253:       method: "PATCH",
254:       headers: { "Content-Type": "application/json" },
255:       body: JSON.stringify({ all: true }),
256:     })
257:     if (!response.ok) return
258:     setItems((current) => current?.map((item) => ({
259:       ...item,
260:       readAt: item.readAt ?? new Date().toISOString(),
261:     })) ?? [])
262:     notifyCountChanged()
263:   }
264: 
265:   async function remove(item: Item) {
266:     setError("")
267:     const response = await fetch("/api/notifications", {
268:       method: "DELETE",
269:       headers: { "Content-Type": "application/json" },
270:       body: JSON.stringify({ id: item._id }),
271:     })
272:     if (!response.ok) {
273:       const message = "Não foi possível excluir a notificação. Tente novamente."
274:       setError(message)
275:       throw new Error(message)
276:     }
277:     setItems((current) => current?.filter((value) => value._id !== item._id) ?? [])
278:     if (expandedId === item._id) closeDropdown()
279:     notifyCountChanged()
280:   }
281: 
282:   function toggle(item: Item, anchor: HTMLButtonElement) {
283:     if (expandedId === item._id) closeDropdown()
284:     else {
285:       setExpandedId(item._id)
286:       setExpandedAnchor(anchor)
287:     }
288:     void read(item)
289:   }
290: 
291:   return (
292:     <div id="notifications-content-boundary" className="py-10 sm:py-16">
293:       <div className="flex items-center justify-between gap-4">
294:         <h1 className="text-3xl font-semibold tracking-tight">Notificações</h1>
295:         <button
296:           type="button"
297:           onClick={() => void readAll()}
298:           disabled={!items?.some((item) => !item.readAt)}
299:           className="text-sm text-zinc-600 underline-offset-4 hover:underline disabled:cursor-default disabled:opacity-40 dark:text-zinc-400"
300:         >
301:           Marcar todas como lidas
302:         </button>
303:       </div>
304: 
305:       {error && <p role="alert" className="mt-5 text-sm text-red-700 dark:text-red-400">{error}</p>}
306: 
307:       {items === null ? (
308:         <p className="mt-8 text-sm text-zinc-500">Carregando…</p>
309:       ) : items.length === 0 ? (
310:         <p className="mt-8 text-sm text-zinc-500">Nenhuma notificação.</p>
311:       ) : (
312:         <ol className="mt-8 border-t border-zinc-300 dark:border-zinc-800">
313:           {items.map((item) => {
314:             const expanded = expandedId === item._id
315:             const expandable = item.count > 1 || item.kind === "view" || item.kind === "site_visit"
316:             const content = (
317:               <>
318:                 {item.actorImageUrl ? (
319:                   <span className="relative mt-0.5 size-8 shrink-0" aria-hidden>
320:                     <img src={item.actorImageUrl} alt="" className="size-8 rounded-full object-cover !grayscale-0" />
321:                     {!item.readAt && <span className="absolute -right-0.5 -top-0.5 size-2.5 rounded-full bg-red-600 ring-2 ring-[#f4f4f4] dark:ring-[#040404]" />}
322:                   </span>
323:                 ) : (
324:                   <span
325:                     aria-hidden
326:                     className={`mt-1.5 size-2 shrink-0 rounded-full ${item.readAt ? "bg-transparent" : "bg-red-600"}`}
327:                   />
328:                 )}
329:                 <span className="min-w-0 flex-1">
330:                   <span className="flex flex-wrap items-center gap-2 text-sm font-medium">
331:                     <span>{item.title}</span>
332:                     {item.count > 1 && (
