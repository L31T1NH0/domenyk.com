 7: export function stabilizePaintedLine(fragments: PaintedLineFragment[]) {
 8:   let previousRight = -Infinity
 9:   return fragments.map((fragment, index) => {
10:     const left = index === 0
11:       ? fragment.left
12:       : Math.max(fragment.left, previousRight + Math.max(0, fragment.gapBefore))
13:     previousRight = left + Math.max(0, fragment.width)
14:     return left
15:   })
