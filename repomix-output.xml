 87: export function normalizeEditorialImportContent(content: string) {
 88:   return String(content || "")
 89:     .replace(/\r\n?/g, "\n")
 90:     .split(/\n\s*\n/)
 91:     .map((block) => block.split("\n").map((line) => line.trim()).filter(Boolean).join("\n"))
 92:     .filter(Boolean)
 93:     .join("\n\n")
 94:     .trim()
 95: }
