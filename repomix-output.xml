 3: import { getAuthUserId, isAdmin } from "@/lib/auth"
 4: import { rateLimit } from "@/lib/rate-limit"
 5: import { requestIdentity } from "@/lib/request-identity"
 6: import { getCachedPublicPosts } from "@/lib/public-content-cache"
 7: 
 8: const PUBLIC_CACHE_HEADERS = { "Cache-Control": "public, max-age=0, s-maxage=60, stale-while-revalidate=300" }
 9: const PRIVATE_CACHE_HEADERS = { "Cache-Control": "private, no-store, max-age=0", Vary: "Cookie" }
10: 
11: export async function GET(req: NextRequest) {
12:   const { searchParams } = req.nextUrl
13:   const pageParam = Number(searchParams.get("page") ?? 1)
14:   const page = Number.isInteger(pageParam) && pageParam > 0 ? Math.min(pageParam, 500) : 1
15:   const rawSearch = searchParams.get("search")?.trim()
16:   if (rawSearch && rawSearch.length > 120) {
17:     return NextResponse.json({ error: "A busca deve ter no máximo 120 caracteres." }, { status: 400 })
18:   }
19:   const search = rawSearch || undefined
20:   const identity = requestIdentity(req)
21:   if (!(await rateLimit(`post-read:${identity}`, { limit: 120, windowMs: 60_000 }))) {
22:     return NextResponse.json({ error: "Muitas requisições." }, { status: 429 })
23:   }
24:   if (search && !(await rateLimit(
25:     `post-search:${identity}`,
26:     { limit: 30, windowMs: 60_000 }
27:   ))) {
28:     return NextResponse.json({ error: "Muitas buscas. Tente novamente em instantes." }, { status: 429 })
29:   }
30:   const userId = await getAuthUserId()
31:   const admin = userId ? await isAdmin() : false
32: 
33:   if (!admin && !search) {
34:     const result = await getCachedPublicPosts(page, 10)
35:     return NextResponse.json(result, { headers: userId ? PRIVATE_CACHE_HEADERS : PUBLIC_CACHE_HEADERS })
36:   }
37: 
38:   const { posts, total } = await getPosts({ page, search, includeUnpublished: admin, excludeHiddenFromTimeline: !admin })
39: 
40:   return NextResponse.json(
41:     { posts: posts.map((post) => serializePostSummary(post)), total },
42:     { headers: userId ? PRIVATE_CACHE_HEADERS : PUBLIC_CACHE_HEADERS }
43:   )
44: }
</file>

