 39: export function absoluteUrl(path = "/") {
 40:   if (/^https?:\/\//.test(path)) return path
 41:   return `${siteConfig.url}${path.startsWith("/") ? path : `/${path}`}`
 42: }
 43: 
 44: function decodeHtmlEntities(value: string): string {
 45:   const codePoint = (raw: string, radix: number) => {
 46:     const parsed = Number.parseInt(raw, radix)
 47:     return Number.isInteger(parsed) && parsed >= 0 && parsed <= 0x10ffff
 48:       ? String.fromCodePoint(parsed)
 49:       : " "
 50:   }
 51: 
 52:   return value
 53:     .replace(/&nbsp;/gi, " ")
 54:     .replace(/&amp;/gi, "&")
 55:     .replace(/&quot;/gi, '"')
 56:     .replace(/&#(?:0*39|x0*27);/gi, "'")
 57:     .replace(/&lt;/gi, "<")
 58:     .replace(/&gt;/gi, ">")
 59:     .replace(/&#(\d+);/g, (_match, code) => codePoint(code, 10))
 60:     .replace(/&#x([a-f\d]+);/gi, (_match, code) => codePoint(code, 16))
 61: }
 62: 
 63: export function descriptionFromMarkdown(markdown: string, maxLength = 155): string {
 64:   const text = decodeHtmlEntities(stripInlineCssHookSyntax(markdown)
 65:     .replace(/```[\s\S]*?```/g, " ")
 66:     .replace(/^:::editor [^\n]+$|^:::$/gm, " ")
 67:     .replace(/`[^`]*`/g, " ")
 68:     .replace(/!\[[^\]]*]\([^)]*\)/g, " ")
 69:     .replace(/\[([^\]]+)]\([^)]*\)/g, "$1")
 70:     .replace(/<[^>]+>/g, " ")
 71:     .replace(/[#>*_~\-]+/g, " ")
 72:     .replace(/\s+/g, " ")
 73:     .trim())
 74: 
 75:   if (text.length <= maxLength) return text
 76:   const truncated = text.slice(0, maxLength + 1)
 77:   return `${truncated.slice(0, truncated.lastIndexOf(" ") || maxLength).trim()}...`
 78: }
 79: 
 80: export function metadataDescription(value: string, maxLength = 160): string {
 81:   return descriptionFromMarkdown(value, maxLength) || siteConfig.description
 82: }
 83: 
 84: export function wordCountFromMarkdown(markdown: string): number {
 85:   const text = descriptionFromMarkdown(markdown, Number.MAX_SAFE_INTEGER)
 86:   return text ? text.split(/\s+/).length : 0
 87: }
 88: 
 89: export function titleFromMarkdown(markdown: string, maxLength = 68): string {
 90:   const description = descriptionFromMarkdown(markdown, maxLength)
 91:   if (!description) return ""
 92:   return description.replace(/\.\.\.$/, "").trim()
 93: }
 94: 
 95: export function noteDisplayTitle(note: { title?: string; content: string }): string {
 96:   return note.title?.trim() || titleFromMarkdown(note.content) || "Nota de Domenyk"
 97: }
 98: 
 99: export function imageUrlsFromMarkdown(markdown: string): string[] {
100:   const urls = new Set<string>()
101:   const imagePattern = /!\[[^\]]*]\(([^)\s]+)(?:\s+"[^"]*")?\)/g
102:   const htmlImagePattern = /<img\b[^>]*\bsrc=(?:"([^"]+)"|'([^']+)')[^>]*>/gi
103:   let match: RegExpExecArray | null
104: 
105:   while ((match = imagePattern.exec(markdown)) !== null) {
106:     urls.add(match[1])
107:   }
108: 
109:   while ((match = htmlImagePattern.exec(markdown)) !== null) {
110:     const url = decodeHtmlEntities(match[1] ?? match[2] ?? "")
111:     if (url) urls.add(url)
112:   }
113: 
114:   return [...urls]
115: }
116: 
117: export function preferredContentImages({
118:   cover,
119:   images,
120:   markdown,
121: }: {
122:   cover?: string
123:   images?: string[]
124:   markdown?: string
125: }): string[] {
126:   const urls = new Set<string>()
127:   if (cover) urls.add(cover)
128:   images?.forEach((image) => urls.add(image))
129:   if (markdown) imageUrlsFromMarkdown(markdown).forEach((image) => urls.add(image))
130:   return [...urls]
131: }
