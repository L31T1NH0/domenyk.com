41: export async function createNotificationOnce(
42:   data: NotificationInput & { aggregateKey: string },
43:   topic: AdminPushTopic,
44:   occurrenceDetails: NotificationOccurrenceDetails = {}
45: ) {
46:   const notificationId = await storeNotificationOnce(data, occurrenceDetails)
47:   if (!notificationId) return null
48: 
49:   await sendAdminPush(topic, {
50:     ...pushPayload(data),
51:     tag: `admin-${topic}-${notificationId.toString()}`,
52:   }).catch(() => undefined)
53:   return notificationId
