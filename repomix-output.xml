  1: const baseUrl = new URL(process.argv[2] ?? "http://localhost:3000")
  2: 
  3: function allMatches(value, pattern) {
  4:   return [...value.matchAll(pattern)].map((match) => match[1])
  5: }
  6: 
  7: function decoded(value = "") {
  8:   return value
  9:     .replaceAll("&amp;", "&")
 10:     .replaceAll("&quot;", '"')
 11:     .replaceAll("&#x27;", "'")
 12:     .replaceAll("&lt;", "<")
 13:     .replaceAll("&gt;", ">")
 14: }
 15: 
 16: const issues = []
 17: const robotsResponse = await fetch(new URL("/robots.txt", baseUrl))
 18: const robotsText = await robotsResponse.text()
 19: for (const userAgent of ["OAI-SearchBot", "GPTBot", "ChatGPT-User"]) {
 20:   if (!robotsText.includes(`User-Agent: ${userAgent}`)) {
 21:     issues.push({ url: "/robots.txt", message: `política explícita ausente para ${userAgent}` })
 22:   }
 23: }
 24: 
 25: const llmsResponse = await fetch(new URL("/llms.txt", baseUrl))
 26: const llmsText = await llmsResponse.text()
 27: if (!llmsResponse.ok) {
 28:   issues.push({ url: "/llms.txt", message: `arquivo respondeu ${llmsResponse.status}` })
 29: } else {
 30:   if (!llmsResponse.headers.get("content-type")?.includes("text/markdown")) {
 31:     issues.push({ url: "/llms.txt", message: "Content-Type não é text/markdown" })
 32:   }
 33:   if (!/^#\s+\S+/m.test(llmsText)) {
 34:     issues.push({ url: "/llms.txt", message: "título H1 ausente" })
 35:   }
 36:   if (!llmsText.includes("/sitemap/index.xml")) {
 37:     issues.push({ url: "/llms.txt", message: "sitemap não referenciado" })
 38:   }
 39:   if (allMatches(llmsText, /^\s*-\s+\[[^\]]+\]\((https?:\/\/[^)]+)\)/gm).length === 0) {
 40:     issues.push({ url: "/llms.txt", message: "nenhum link de conteúdo encontrado" })
 41:   }
 42: }
 43: const sitemapPaths = robotsText.split("\n")
 44:   .map((line) => line.match(/^Sitemap:\s*(\S+)/i)?.[1])
 45:   .filter(Boolean)
 46:   .map((value) => new URL(value).pathname)
 47: 
 48: const sitemapUrls = new Set()
 49: for (const path of sitemapPaths) {
 50:   const response = await fetch(new URL(path, baseUrl))
 51:   if (!response.ok) {
 52:     issues.push({ url: path, message: `sitemap respondeu ${response.status}` })
 53:     continue
 54:   }
 55:   const xml = await response.text()
 56:   for (const url of allMatches(xml, /<loc>([^<]+)<\/loc>/g)) sitemapUrls.add(decoded(url))
 57: }
 58: 
 59: const results = []
 60: for (const publicUrl of sitemapUrls) {
 61:   const requested = new URL(publicUrl)
 62:   const localUrl = new URL(`${requested.pathname}${requested.search}`, baseUrl)
 63:   const response = await fetch(localUrl, { redirect: "manual" })
 64:   const result = { url: publicUrl, status: response.status }
 65:   results.push(result)
 66:   if (response.status !== 200) {
 67:     issues.push({ url: publicUrl, message: `página respondeu ${response.status}` })
 68:     continue
 69:   }
 70: 
 71:   const html = await response.text()
 72:   const title = decoded(html.match(/<title>([\s\S]*?)<\/title>/i)?.[1]?.trim())
 73:   const description = decoded(html.match(/<meta[^>]*name="description"[^>]*content="([^"]*)"/i)?.[1] ?? "")
 74:   const canonical = html.match(/<link[^>]*rel="canonical"[^>]*href="([^"]+)"/i)?.[1]
 75:   const robots = html.match(/<meta[^>]*name="robots"[^>]*content="([^"]+)"/i)?.[1]
 76:   const h1Count = (html.match(/<h1\b/gi) ?? []).length
 77:   const missingImageAltCount = allMatches(html, /<img\b([^>]*)>/gi)
 78:     .filter((attributes) => !/\balt="[^"]*"/i.test(attributes)).length
 79:   const structuredTypes = new Set()
 80: 
 81:   if (!title) issues.push({ url: publicUrl, message: "title ausente" })
 82:   if (!description) issues.push({ url: publicUrl, message: "meta description ausente" })
 83:   if (!canonical) issues.push({ url: publicUrl, message: "canonical ausente" })
 84:   else if (new URL(canonical).pathname !== requested.pathname) {
 85:     issues.push({ url: publicUrl, message: `canonical divergente: ${canonical}` })
 86:   }
 87:   if (!robots?.includes("index") || !robots?.includes("follow")) {
 88:     issues.push({ url: publicUrl, message: `robots inesperado: ${robots ?? "ausente"}` })
 89:   }
 90:   if (h1Count !== 1) issues.push({ url: publicUrl, message: `quantidade de H1: ${h1Count}` })
 91:   if (missingImageAltCount > 0) issues.push({ url: publicUrl, message: `${missingImageAltCount} imagem(ns) sem atributo alt` })
 92: 
 93:   for (const payload of allMatches(html, /<script[^>]*type="application\/ld\+json"[^>]*>([\s\S]*?)<\/script>/gi)) {
 94:     try {
 95:       const data = JSON.parse(payload)
 96:       const nodes = Array.isArray(data?.["@graph"]) ? data["@graph"] : [data]
 97:       for (const node of nodes) {
 98:         const types = Array.isArray(node?.["@type"]) ? node["@type"] : [node?.["@type"]]
 99:         for (const type of types.filter(Boolean)) structuredTypes.add(type)
100:       }
101:     } catch {
102:       issues.push({ url: publicUrl, message: "JSON-LD inválido" })
103:     }
104:   }
105: 
106:   if (requested.pathname === "/") {
107:     for (const type of ["WebSite", "Person", "Blog"]) {
108:       if (!structuredTypes.has(type)) issues.push({ url: publicUrl, message: `JSON-LD ${type} ausente` })
109:     }
110:   }
111:   if (/\/(?:[a-z]{2}\/)?posts\//.test(requested.pathname) && !structuredTypes.has("BlogPosting")) {
112:     issues.push({ url: publicUrl, message: "JSON-LD BlogPosting ausente" })
113:   }
114: }
115: 
116: for (const path of sitemapPaths) {
117:   const publicSitemap = new URL(path, "https://domenyk.com").toString()
118:   if (!robotsText.includes(`Sitemap: ${publicSitemap}`)) {
119:     issues.push({ url: "/robots.txt", message: `sitemap não declarado: ${publicSitemap}` })
120:   }
121: }
122: 
123: console.log(JSON.stringify({
124:   summary: {
125:     sitemaps: sitemapPaths.length,
126:     pages: results.length,
127:     successfulPages: results.filter((result) => result.status === 200).length,
128:     llmsTxt: llmsResponse.status,
129:     issues: issues.length,
130:   },
131:   issues,
132: }, null, 2))
133: if (issues.length > 0) process.exitCode = 1
