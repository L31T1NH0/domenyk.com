213: function styleSignature(container: HTMLElement, figure: HTMLElement, paragraphs: HTMLParagraphElement[]) {
214:   const style = window.getComputedStyle(container)
215:   return [
216:     container.clientWidth,
217:     figure.getBoundingClientRect().width,
218:     style.fontSize,
219:     style.lineHeight,
220:     style.letterSpacing,
221:     style.getPropertyValue("--reading-block-spacing"),
222:     document.documentElement.className,
223:     ...paragraphs.flatMap(paragraph => {
224:       const paragraphStyle = window.getComputedStyle(paragraph)
225:       return [paragraphStyle.font, paragraphStyle.fontFamily, paragraphStyle.fontSize, paragraphStyle.fontWeight, paragraphStyle.lineHeight, paragraphStyle.letterSpacing]
226:     }),
227:   ].join("\u0000")
228: }
