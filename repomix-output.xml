 3: import { useRef, useState } from "react"
 4: import type { LexicalEditor as EditorInstance } from "lexical"
 5: import { assertPublicationCssIsValid, LexicalEditor, readHtmlFromEditor } from "@/components/editor/LexicalEditor"
 6: import { RICH_COMPOSER_FRAME_CLASS_NAME, RICH_COMPOSER_DEFAULT_BORDER_CLASS_NAME, RICH_COMPOSER_SUBMIT_CLASS_NAME } from "@/components/editor/composerStyles"
 7: import type { PersonalUpdate } from "@/lib/personal-timeline"
 8: import { MAX_RICH_CONTENT_LENGTH } from "@/lib/content-format"
 9: 
10: export default function PersonalUpdateComposer({ item, onSaved, onCancel }: {
11:   item?: PersonalUpdate
12:   onSaved: (item: PersonalUpdate) => void
13:   onCancel?: () => void
14: }) {
15:   const editor = useRef<EditorInstance | null>(null)
16:   const [content, setContent] = useState(item?.content ?? "")
17:   const [version, setVersion] = useState(0)
18:   const [pending, setPending] = useState(false)
19:   const [error, setError] = useState("")
20: 
21:   async function submit() {
22:     if (pending) return
23:     setError("")
24:     try {
25:       if (editor.current) assertPublicationCssIsValid(editor.current)
26:       const nextContent = editor.current ? readHtmlFromEditor(editor.current).trim() : content.trim()
27:       if (!nextContent || nextContent.length > MAX_RICH_CONTENT_LENGTH) {
28:         setError("A publicação ultrapassou o limite de 300.000 caracteres.")
29:         return
30:       }
31:       setPending(true)
32:       editor.current?.setEditable(false)
33:       const response = await fetch(item ? `/api/mural/${item._id}` : "/api/mural", {
34:         method: item ? "PATCH" : "POST",
35:         headers: { "Content-Type": "application/json" },
36:         body: JSON.stringify({ content: nextContent }),
37:       })
38:       const data = await response.json().catch(() => null)
39:       if (!response.ok) throw new Error(data?.error ?? "Não foi possível publicar. Tente novamente.")
40:       onSaved(data)
41:       setContent("")
42:       setVersion(value => value + 1)
43:     } catch (error) {
44:       setError(error instanceof Error ? error.message : "Não foi possível publicar.")
45:     } finally {
46:       editor.current?.setEditable(true)
47:       setPending(false)
48:     }
49:   }
50: 
51:   return (
52:     <div>
53:       <div className={`${RICH_COMPOSER_FRAME_CLASS_NAME} ${RICH_COMPOSER_DEFAULT_BORDER_CLASS_NAME}`} onKeyDown={event => {
54:         if (event.key === "Enter" && (event.ctrlKey || event.metaKey)) {
55:           event.preventDefault()
56:           void submit()
57:         }
58:       }}>
59:         <fieldset disabled={pending} className="min-w-0" aria-label={item ? "Editar publicação" : "Nova publicação"}>
60:           <LexicalEditor
61:             key={version}
62:             namespace={`Mural-${item?._id ?? "new"}`}
63:             initialMarkdown={item?.content ?? ""}
64:             onChange={setContent}
65:             editorRef={editor}
66:             placeholder="O que você quer compartilhar?"
67:             shellClassName="min-h-28 px-3 py-3"
68:             editorClassName="min-h-28 text-sm"
69:             placeholderClassName="left-3 top-3 text-sm"
70:             toolbarVariant="comment"
71:             toolbarPlacement="bottom"
72:             imageUploadEndpoint="/api/mural/media"
73:             toolbarTrailingContent={(
74:               <button type="button" disabled={pending || !content.trim()} className={RICH_COMPOSER_SUBMIT_CLASS_NAME} onClick={() => void submit()}>
75:                 {pending ? "Salvando…" : item ? "Salvar" : "Publicar"}
76:               </button>
77:             )}
78:           />
79:         </fieldset>
80:       </div>
81:       {onCancel && <button type="button" disabled={pending} onClick={onCancel} className="personal-timeline-action mt-2">Cancelar edição</button>}
82:       {error && <p role="alert" className="mt-2 text-sm text-red-700 dark:text-red-300">{error}</p>}
83:     </div>
84:   )
85: }
</file>

<file path="src/components/ScrollProgressEffect.tsx">
 1: "use client"
 2: 
 3: import { useEffect } from "react"
 4: import { usePathname } from "next/navigation"
 5: 
 6: function setScrollVariables(progress: number, visible: boolean) {
 7:   const root = document.documentElement
 8:   root.style.setProperty("--scroll-progress", visible ? `${(progress * 100).toFixed(3)}%` : "0%")
 9:   root.style.setProperty("--scroll-progress-visible", visible ? "1" : "0")
10: }
11: 
12: function hasTopicMinimap(content: HTMLElement) {
13:   return content.querySelector("h1, h2, h3, h4, h5, h6") !== null
14: }
15: 
16: export function ScrollProgressEffect() {
17:   const pathname = usePathname()
18: 
19:   useEffect(() => {
20:     const container = document.querySelector<HTMLElement>("[data-scroll-progress-root]")
21:     if (!container) { setScrollVariables(0, false); return }
22: 
23:     const content = container.querySelector<HTMLElement>("[data-post-content]")
24:     if (!content) { setScrollVariables(0, false); return }
25: 
26:     let animationFrame = 0
27:     const desktopMinimapMedia = window.matchMedia("(min-width: 80rem)")
28: 
29:     const update = () => {
30:       animationFrame = 0
31:       const contentTop = content.getBoundingClientRect().top + window.scrollY
32:       const totalScrollable = Math.max(content.scrollHeight - window.innerHeight, 0)
33:       if (totalScrollable <= 0) { setScrollVariables(0, false); return }
34:       const progress = Math.min(1, Math.max(0, (window.scrollY - contentTop) / totalScrollable))
35:       const minimapVisible = desktopMinimapMedia.matches && hasTopicMinimap(content)
36:       setScrollVariables(progress, !minimapVisible)
37:     }
38: 
39:     const requestUpdate = () => {
40:       if (animationFrame) return
41:       animationFrame = window.requestAnimationFrame(update)
42:     }
43: 
44:     update()
45:     window.addEventListener("scroll", requestUpdate, { passive: true })
46:     window.addEventListener("resize", requestUpdate)
47:     window.addEventListener("load", requestUpdate)
48:     window.visualViewport?.addEventListener("resize", requestUpdate)
49:     window.visualViewport?.addEventListener("scroll", requestUpdate)
50:     desktopMinimapMedia.addEventListener("change", requestUpdate)
51: 
52:     const resizeObserver = new ResizeObserver(requestUpdate)
53:     resizeObserver.observe(content)
54:     const mutationObserver = new MutationObserver(requestUpdate)
55:     mutationObserver.observe(content, { childList: true, subtree: true })
56: 
57:     return () => {
58:       window.removeEventListener("scroll", requestUpdate)
59:       window.removeEventListener("resize", requestUpdate)
60:       window.removeEventListener("load", requestUpdate)
61:       window.visualViewport?.removeEventListener("resize", requestUpdate)
62:       window.visualViewport?.removeEventListener("scroll", requestUpdate)
63:       desktopMinimapMedia.removeEventListener("change", requestUpdate)
64:       resizeObserver.disconnect()
65:       mutationObserver.disconnect()
66:       if (animationFrame) cancelAnimationFrame(animationFrame)
67:       setScrollVariables(0, false)
68:     }
69:   }, [pathname])
70: 
71:   return null
72: }
</file>

<file path="src/components/ThemeSwitcher.tsx">
 1: "use client"
 2: 
 3: import { useSyncExternalStore } from "react"
 4: 
 5: const THEME_CHANGE_EVENT = "themechange"
 6: let volatileDarkMode: boolean | null = null
 7: 
 8: function getDarkModeSnapshot() {
 9:   if (volatileDarkMode !== null) return volatileDarkMode
10:   try {
11:     const storedTheme = localStorage.getItem("theme")
12:     if (storedTheme === "light") return false
13:     if (storedTheme === "dark") return true
14:     return !document.documentElement.classList.contains("light-mode")
15:   } catch {
16:     return !document.documentElement.classList.contains("light-mode")
17:   }
18: }
19: 
20: function getServerDarkModeSnapshot() {
21:   return true
22: }
23: 
24: function subscribeToThemeChange(callback: () => void) {
25:   const onStorage = (event: StorageEvent) => {
26:     if (event.key !== "theme" && event.key !== null) return
27:     volatileDarkMode = null
28:     callback()
29:   }
30: 
31:   window.addEventListener("storage", onStorage)
32:   window.addEventListener(THEME_CHANGE_EVENT, callback)
33:   return () => {
34:     window.removeEventListener("storage", onStorage)
35:     window.removeEventListener(THEME_CHANGE_EVENT, callback)
36:   }
37: }
38: 
39: function applyTheme(darkMode: boolean) {
40:   document.documentElement.classList.toggle("dark-mode", darkMode)
41:   document.documentElement.classList.toggle("light-mode", !darkMode)
42: }
43: 
44: export function useThemeSwitcher() {
45:   const darkMode = useSyncExternalStore(
46:     subscribeToThemeChange,
47:     getDarkModeSnapshot,
48:     getServerDarkModeSnapshot
49:   )
50: 
51:   function toggleTheme() {
52:     const next = !darkMode
53:     volatileDarkMode = next
54:     applyTheme(next)
55:     try {
56:       localStorage.setItem("theme", next ? "dark" : "light")
57:     } catch {
58:       // The theme still applies for this page when storage is unavailable.
59:     }
60:     try {
61:       document.cookie = `theme=${next ? "dark" : "light"}; Path=/; Max-Age=31536000; SameSite=Lax${location.protocol === "https:" ? "; Secure" : ""}`
62:     } catch {
63:       // The server will fall back to dark mode when cookies are unavailable.
64:     }
65:     window.dispatchEvent(new Event(THEME_CHANGE_EVENT))
66:   }
67: 
68:   return { darkMode, toggleTheme }
69: }
</file>

