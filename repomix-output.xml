 81: function NotificationDropdown({ item, anchor, onClose }: { item: Item; anchor: HTMLButtonElement; onClose: () => void }) {
 82:   const panelRef = useRef<HTMLDivElement>(null)
 83:   const occurrenceItems = occurrences(item).toReversed()
 84:   const hasCompleteHistory = occurrenceItems.length === item.count
 85:   const [position, setPosition] = useState({ left: 8, top: 8, width: 320, maxHeight: 480 })
 86: 
 87:   useLayoutEffect(() => {
 88:     function updatePosition() {
 89:       const rect = anchor.getBoundingClientRect()
 90:       if (rect.bottom < 0 || rect.top > window.innerHeight) return onClose()
 91: 
 92:       const viewportGap = 8
 93:       const width = Math.min(480, Math.max(280, Math.min(rect.width, window.innerWidth - viewportGap * 2)))
 94:       const left = Math.max(viewportGap, Math.min(rect.left, window.innerWidth - width - viewportGap))
 95:       const panelHeight = Math.min(panelRef.current?.scrollHeight ?? 420, window.innerHeight * 0.7)
 96:       const belowSpace = window.innerHeight - rect.bottom - viewportGap * 2
 97:       const openAbove = belowSpace < Math.min(panelHeight, 300) && rect.top > belowSpace
 98:       const top = openAbove
 99:         ? Math.max(viewportGap, rect.top - panelHeight - 6)
100:         : rect.bottom + 6
101:       const maxHeight = openAbove
102:         ? Math.max(160, rect.top - viewportGap * 2)
103:         : Math.max(160, window.innerHeight - top - viewportGap)
104: 
105:       setPosition({ left, top, width, maxHeight })
106:     }
107: 
108:     function handlePointerDown(event: PointerEvent) {
109:       const target = event.target as Node
110:       if (!panelRef.current?.contains(target) && !anchor.contains(target)) onClose()
111:     }
112: 
113:     function handleKeyDown(event: KeyboardEvent) {
114:       if (event.key !== "Escape") return
115:       event.preventDefault()
116:       onClose()
117:       anchor.focus()
118:     }
119: 
120:     updatePosition()
121:     document.addEventListener("pointerdown", handlePointerDown)
122:     document.addEventListener("keydown", handleKeyDown)
123:     window.addEventListener("resize", updatePosition)
124:     window.addEventListener("scroll", updatePosition, true)
125:     return () => {
126:       document.removeEventListener("pointerdown", handlePointerDown)
127:       document.removeEventListener("keydown", handleKeyDown)
128:       window.removeEventListener("resize", updatePosition)
129:       window.removeEventListener("scroll", updatePosition, true)
130:     }
131:   }, [anchor, onClose])
132: 
133:   return createPortal(
134:     <div
135:       ref={panelRef}
136:       id={`notification-occurrences-${item._id}`}
137:       role="dialog"
138:       aria-label={`Detalhes da notificação: ${item.title}`}
139:       className="fixed z-50 overflow-y-auto rounded-xl border border-zinc-200 bg-[#f4f4f4] shadow-[0_4px_8px_rgba(0,0,0,0.12)] dark:border-zinc-800 dark:bg-[#111] dark:shadow-[0_4px_8px_rgba(0,0,0,0.4)]"
140:       style={position}
141:     >
