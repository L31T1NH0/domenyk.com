  1: import "server-only"
  2: 
  3: import { ObjectId, type Document } from "mongodb"
  4: import { getDb } from "./client"
  5: import { renderMarkdownSync } from "../mdx"
  6: import type { PersonalUpdate, PersonalTimelinePage, PersonalUpdateOrderDirection } from "../personal-timeline"
  7: 
  8: type PersonalUpdateDocument = {
  9:   _id: ObjectId
 10:   content: string
 11:   sortOrder?: number
 12:   createdAt: Date
 13:   updatedAt: Date
 14: }
 15: 
 16: type OrderedPersonalUpdateDocument = PersonalUpdateDocument & {
 17:   effectiveSortOrder: number
 18: }
 19: 
 20: async function collection() {
 21:   return (await getDb()).collection<PersonalUpdateDocument>("personal_updates")
 22: }
 23: 
 24: function serialize(item: PersonalUpdateDocument): PersonalUpdate {
 25:   return {
 26:     _id: item._id.toHexString(),
 27:     content: item.content,
 28:     contentHtml: renderMarkdownSync(item.content),
 29:     createdAt: item.createdAt.toISOString(),
 30:     updatedAt: item.updatedAt.toISOString(),
 31:   }
 32: }
 33: 
 34: export async function getPersonalUpdates(cursor?: string): Promise<PersonalTimelinePage> {
 35:   const updates = await collection()
 36:   const pipeline: Document[] = [
 37:     { $set: { effectiveSortOrder: { $ifNull: ["$sortOrder", { $toLong: "$createdAt" }] } } },
 38:   ]
 39:   if (cursor) {
 40:     const cursorId = new ObjectId(cursor)
 41:     const cursorItem = await updates.findOne({ _id: cursorId })
 42:     if (!cursorItem) return { items: [], nextCursor: null }
 43:     const cursorOrder = cursorItem.sortOrder ?? cursorItem.createdAt.getTime()
 44:     pipeline.push({
 45:       $match: {
 46:         $or: [
 47:           { effectiveSortOrder: { $lt: cursorOrder } },
 48:           { effectiveSortOrder: cursorOrder, _id: { $lt: cursorId } },
 49:         ],
 50:       },
 51:     })
 52:   }
 53:   pipeline.push(
 54:     { $sort: { effectiveSortOrder: -1, _id: -1 } },
 55:     { $limit: 21 },
 56:   )
 57:   const items = await updates.aggregate<OrderedPersonalUpdateDocument>(pipeline).toArray()
 58:   return {
 59:     items: items.slice(0, 20).map(serialize),
 60:     nextCursor: items.length > 20 ? items[19]._id.toHexString() : null,
 61:   }
 62: }
 63: 
 64: export async function createPersonalUpdate(content: string) {
 65:   const now = new Date()
 66:   const item = { _id: new ObjectId(), content, sortOrder: now.getTime(), createdAt: now, updatedAt: now }
 67:   await (await collection()).insertOne(item)
 68:   return serialize(item)
 69: }
 70: 
 71: export async function movePersonalUpdate(id: string, direction: PersonalUpdateOrderDirection) {
 72:   const updates = await collection()
 73:   const ordered = await updates.aggregate<OrderedPersonalUpdateDocument>([
 74:     { $set: { effectiveSortOrder: { $ifNull: ["$sortOrder", { $toLong: "$createdAt" }] } } },
 75:     { $sort: { effectiveSortOrder: -1, _id: -1 } },
 76:   ]).toArray()
 77:   const currentIndex = ordered.findIndex(item => item._id.equals(id))
 78:   if (currentIndex < 0) return "not-found" as const
 79:   const targetIndex = currentIndex + (direction === "up" ? -1 : 1)
 80:   if (targetIndex < 0 || targetIndex >= ordered.length) return "unchanged" as const
 81: 
 82:   const target = ordered[targetIndex]
 83:   const uniqueOrders = new Set(ordered.map(item => item.effectiveSortOrder))
 84:   const needsNormalization = uniqueOrders.size !== ordered.length || ordered.some(item => !Number.isFinite(item.sortOrder))
 85:   if (needsNormalization) {
 86:     const [current] = ordered.splice(currentIndex, 1)
 87:     ordered.splice(targetIndex, 0, current)
 88:     await updates.bulkWrite(ordered.map((item, index) => ({
 89:       updateOne: {
 90:         filter: { _id: item._id },
 91:         update: { $set: { sortOrder: ordered.length - index } },
 92:       },
 93:     })))
 94:   } else {
 95:     await updates.bulkWrite([
 96:       { updateOne: { filter: { _id: ordered[currentIndex]._id }, update: { $set: { sortOrder: target.effectiveSortOrder } } } },
 97:       { updateOne: { filter: { _id: target._id }, update: { $set: { sortOrder: ordered[currentIndex].effectiveSortOrder } } } },
 98:     ])
 99:   }
100:   return "moved" as const
101: }
102: 
103: export async function editPersonalUpdate(id: string, content: string) {
104:   const item = await (await collection()).findOneAndUpdate(
105:     { _id: new ObjectId(id) },
106:     { $set: { content, updatedAt: new Date() } },
107:     { returnDocument: "after" },
108:   )
109:   return item ? serialize(item) : null
110: }
111: 
112: export async function deletePersonalUpdate(id: string) {
113:   return (await (await collection()).deleteOne({ _id: new ObjectId(id) })).deletedCount > 0
114: }
</file>

