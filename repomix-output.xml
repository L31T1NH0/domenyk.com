<file path="src/lib/push.ts">
  1: import "server-only"
  2: 
  3: import webPush from "web-push"
  4: import { getAdminUserId } from "@/lib/auth"
  5: import {
  6:   claimPushCampaign,
  7:   completePushCampaign,
  8:   deletePushSubscriptions,
  9:   listAdminPushSubscriptions,
 10:   listMessagePushSubscriptions,
 11:   listPushSubscriptionsForTopic,
 12:   recordPushFailure,
 13:   recordPushSuccess,
 14:   type PushTopic,
 15:   type StoredPushSubscription,
 16: } from "@/lib/db/push-subscriptions"
 17: import type { AdminPushTopic } from "@/lib/notification-events"
 18: 
 19: export type PushPayload = {
 20:   title: string
 21:   body: string
 22:   url: string
 23:   tag: string
 24:   kind: "post" | "note" | "admin" | "message"
 25: }
 26: 
 27: function vapidConfig() {
 28:   const publicKey = process.env.VAPID_PUBLIC_KEY?.trim()
 29:   const privateKey = process.env.VAPID_PRIVATE_KEY?.trim()
 30:   const subject = process.env.VAPID_SUBJECT?.trim()
 31:   if (!publicKey || !privateKey || !subject) return null
 32:   return { publicKey, privateKey, subject }
 33: }
 34: 
 35: export function publicVapidKey() {
 36:   return vapidConfig()?.publicKey ?? null
 37: }
 38: 
 39: function configureWebPush() {
 40:   const config = vapidConfig()
 41:   if (!config) return false
 42:   webPush.setVapidDetails(config.subject, config.publicKey, config.privateKey)
 43:   return true
 44: }
 45: 
 46: function asWebPushSubscription(subscription: StoredPushSubscription): webPush.PushSubscription {
 47:   return {
 48:     endpoint: subscription.endpoint,
 49:     keys: subscription.keys,
 50:   }
 51: }
 52: 
 53: export async function sendPushSubscriptionChallenge(
 54:   subscription: StoredPushSubscription,
 55:   challengeToken: string
 56: ): Promise<boolean> {
 57:   if (!configureWebPush()) return false
 58:   try {
 59:     await webPush.sendNotification(
 60:       asWebPushSubscription(subscription),
 61:       JSON.stringify({ kind: "verification", challengeToken }),
 62:       { TTL: 5 * 60 }
 63:     )
 64:     return true
 65:   } catch {
 66:     return false
 67:   }
 68: }
 69: 
 70: async function deliver(subscriptions: StoredPushSubscription[], payload: PushPayload) {
 71:   if (!configureWebPush()) return { configured: false, sentCount: 0, failedCount: 0 }
 72:   let sentCount = 0
 73:   let failedCount = 0
 74:   const expired: string[] = []
 75:   const message = JSON.stringify(payload)
 76: 
 77:   for (let index = 0; index < subscriptions.length; index += 20) {
 78:     const batch = subscriptions.slice(index, index + 20)
 79:     await Promise.all(batch.map(async (subscription) => {
 80:       try {
 81:         await webPush.sendNotification(asWebPushSubscription(subscription), message, { TTL: 60 * 60 * 24 })
 82:         sentCount += 1
 83:         await recordPushSuccess(subscription.endpoint)
 84:       } catch (error) {
 85:         failedCount += 1
 86:         const statusCode = typeof error === "object" && error && "statusCode" in error
 87:           ? Number(error.statusCode)
 88:           : undefined
 89:         if (statusCode === 404 || statusCode === 410) expired.push(subscription.endpoint)
 90:         else {
 91:           const removed = await recordPushFailure(subscription.endpoint).catch(() => false)
 92:           if (removed) expired.push(subscription.endpoint)
 93:         }
 94:       }
 95:     }))
 96:   }
 97: 
 98:   await deletePushSubscriptions(expired)
 99:   return { configured: true, sentCount, failedCount }
100: }
101: 
102: export async function sendReaderPush(input: {
103:   dedupeKey: string
104:   source: "automatic" | "manual"
105:   topic: PushTopic
106:   contentType: "post" | "note"
107:   contentId: string
108:   title: string
109:   body: string
110:   url: string
111: }) {
112:   if (!vapidConfig()) return { configured: false, deduplicated: false, sentCount: 0, failedCount: 0 }
113:   const campaign = await claimPushCampaign(input)
114:   if (!campaign) return { configured: true, deduplicated: true, sentCount: 0, failedCount: 0 }
115: 
116:   const result = await deliver(await listPushSubscriptionsForTopic(input.topic), {
117:     title: input.title,
118:     body: input.body,
119:     url: input.url,
120:     tag: `reader-${campaign._id.toString()}`,
121:     kind: input.contentType,
122:   })
123:   await completePushCampaign(campaign._id, result)
124:   return { ...result, deduplicated: false }
125: }
126: 
127: export async function sendAdminPush(
128:   topic: AdminPushTopic,
129:   payload: Omit<PushPayload, "kind" | "tag"> & { tag?: string }
130: ) {
131:   const adminId = getAdminUserId()
132:   if (!adminId) return { configured: Boolean(vapidConfig()), sentCount: 0, failedCount: 0 }
133:   return deliver(await listAdminPushSubscriptions(adminId, topic), {
134:     ...payload,
135:     kind: "admin",
136:     tag: payload.tag ?? `admin-${Date.now()}`,
137:   })
138: }
139: 
140: export async function sendMessageReplyPush(userId: string, payload: Omit<PushPayload, "kind" | "tag"> & { tag?: string }) {
141:   return deliver(await listMessagePushSubscriptions(userId), {
142:     ...payload,
143:     kind: "message",
144:     tag: payload.tag ?? `message-${Date.now()}`,
145:   })
146: }
</file>

<file path="src/lib/rate-limit.ts">
 1: import "server-only"
 2: 
 3: import { getDb } from "@/lib/db/client"
 4: 
 5: type RateLimitBucket = {
 6:   _id: string
 7:   count: number
 8:   expiresAt: Date
 9: }
10: 
11: let indexesPromise: Promise<void> | undefined
12: 
13: async function collection() {
14:   const db = await getDb()
15:   const col = db.collection<RateLimitBucket>("rate_limits")
16:   indexesPromise ??= col.createIndex({ expiresAt: 1 }, { expireAfterSeconds: 0 }).then(() => undefined)
17:   await indexesPromise
18:   return col
19: }
20: 
21: function isDuplicateKeyError(error: unknown) {
22:   return typeof error === "object" && error !== null && "code" in error && error.code === 11000
23: }
24: 
25: export async function rateLimit(
26:   key: string,
27:   opts: { limit: number; windowMs: number }
28: ): Promise<boolean> {
29:   const now = Date.now()
30:   const windowStart = Math.floor(now / opts.windowMs) * opts.windowMs
31:   const bucketId = `${key}:${windowStart}`
32:   const expiresAt = new Date(windowStart + opts.windowMs * 2)
33:   const col = await collection()
34:   let bucket: RateLimitBucket | null
35:   try {
36:     bucket = await col.findOneAndUpdate(
37:       { _id: bucketId },
38:       {
39:         $inc: { count: 1 },
40:         $setOnInsert: { expiresAt },
41:       },
42:       { upsert: true, returnDocument: "after" }
43:     )
44:   } catch (error) {
45:     if (!isDuplicateKeyError(error)) throw error
46:     bucket = await col.findOneAndUpdate(
47:       { _id: bucketId },
48:       { $inc: { count: 1 } },
49:       { returnDocument: "after" }
50:     )
51:   }
52: 
53:   return Boolean(bucket && bucket.count <= opts.limit)
54: }
55: 
56: /**
57:  * Atomically claims a rolling window for a key. Unlike rateLimit, the window
58:  * starts at the accepted request instead of at a fixed clock boundary.
59:  */
60: export async function claimOncePerWindow(key: string, windowMs: number): Promise<boolean> {
61:   const now = new Date()
62:   const expiresAt = new Date(now.getTime() + windowMs)
63: 
64:   try {
65:     const result = await (await collection()).updateOne(
66:       { _id: key, expiresAt: { $lte: now } },
67:       { $set: { count: 1, expiresAt } },
68:       { upsert: true }
69:     )
70:     return result.upsertedCount === 1 || result.modifiedCount === 1
71:   } catch (error) {
72:     // An unexpired document does not match the filter. Its attempted upsert
73:     // collides with the existing _id, which means another visit owns the window.
74:     if (isDuplicateKeyError(error)) return false
75:     throw error
76:   }
77: }
</file>

