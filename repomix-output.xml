 1: import { NextRequest, NextResponse } from "next/server"
 2: import { ObjectId } from "mongodb"
 3: import { adminOnly } from "@/lib/auth"
 4: import { getDb } from "@/lib/db/client"
 5: import type { Post } from "@/lib/db/posts"
 6: import { siteDateKey } from "@/lib/datetime"
 7: 
 8: function frontMatterValue(value: string) {
 9:   return JSON.stringify(value)
10: }
11: 
12: function postToMarkdown(post: Post) {
13:   const publishedAt = post.publishedAt?.toISOString() ?? ""
14:   const tags = post.tags.length > 0 ? post.tags.map((tag) => `  - ${tag}`).join("\n") : "  []"
15: 
16:   return [
17:     "---",
18:     `title: ${frontMatterValue(post.title)}`,
19:     `slug: ${frontMatterValue(post.slug)}`,
20:     `publicId: ${frontMatterValue(post.publicId)}`,
21:     `published: ${post.published}`,
22:     publishedAt ? `publishedAt: ${frontMatterValue(publishedAt)}` : undefined,
23:     "tags:",
24:     tags,
25:     "---",
26:     "",
27:     post.content,
28:   ]
29:     .filter((line): line is string => line !== undefined)
30:     .join("\n")
31: }
32: 
33: export async function POST(req: NextRequest) {
34:   const unauthorized = await adminOnly()
35:   if (unauthorized) return unauthorized
36: 
37:   const body = (await req.json().catch(() => null)) as { ids?: unknown } | null
38:   const ids = Array.isArray(body?.ids) ? body.ids.filter((id): id is string => typeof id === "string") : []
39:   if (ids.length > 100) {
40:     return NextResponse.json({ error: "Selecione no máximo 100 posts por exportação." }, { status: 400 })
41:   }
42:   if (ids.some((id) => !ObjectId.isValid(id))) {
43:     return NextResponse.json({ error: "Lista contém IDs inválidos." }, { status: 400 })
44:   }
45: 
46:   const objectIds = ids.map((id) => new ObjectId(id))
47: 
48:   if (objectIds.length === 0) {
49:     return NextResponse.json({ error: "Nenhum post selecionado." }, { status: 400 })
50:   }
51: 
52:   const db = await getDb()
53:   const posts = await db
54:     .collection<Post>("posts")
55:     .find({ _id: { $in: objectIds } })
56:     .sort({ publishedAt: -1, createdAt: -1 })
57:     .toArray()
58: 
59:   const markdown = posts.map(postToMarkdown).join("\n\n---\n\n")
60: 
61:   return new NextResponse(markdown, {
62:     headers: {
63:       "Content-Type": "text/markdown; charset=utf-8",
64:       "Content-Disposition": `attachment; filename="posts-${siteDateKey()}.md"`,
65:     },
66:   })
67: }
