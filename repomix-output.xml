57:   if (!user || !(await isAdmin())) return NextResponse.json({ error: "Forbidden" }, { status: 403 })
58:   const { id } = await params
59:   const json = await req.json().catch(() => null) as { status?: unknown; archived?: unknown } | null
60:   if (typeof json?.archived === "boolean") {
61:     const updated = await setMessageThreadArchived(id, json.archived)
62:     if (!updated) return NextResponse.json({ error: "Not found" }, { status: 404 })
63:     return NextResponse.json(serializeMessageThread(updated, user.id))
64:   }
65:   if (typeof json?.status !== "string" || !ALLOWED_STATUSES.has(json.status as MessageThread["status"])) {
66:     return NextResponse.json({ error: "Estado inválido." }, { status: 400 })
67:   }
68:   const updated = await setMessageThreadStatus(id, json.status as MessageThread["status"])
69:   if (!updated) return NextResponse.json({ error: "Not found" }, { status: 404 })
70:   return NextResponse.json(serializeMessageThread(updated, user.id))
