 38: type StoredComment = Partial<Comment> & {
 39:   _id: ObjectId
 40:   content?: unknown
 41:   nome?: unknown
 42:   text?: unknown
 43:   body?: unknown
 44:   comentario?: unknown
 45:   message?: unknown
