685: function createProcessor(
686:   options: MarkdownRenderOptions = {},
687:   onParagraphId?: (paragraphId: string) => void,
688:   html = false,
689: ) {
690:   const processor = unified()
691:   if (html) {
692:     processor.use(function () {
693:       this.parser = value => {
694:         const tree = fromHtml(value, { fragment: true })
695:         const document = tree.children.find((node): node is Element => node.type === "element" && node.properties.dataEditorDocument === "html")
696:         if (!document) return tree
697:         const escapedSource = escapedHtmlSource(document)
698:         return escapedSource
699:           ? fromHtml(escapedSource, { fragment: true })
700:           : { type: "root", children: document.children }
701:       }
702:     })
703:   } else {
704:     processor
705:     .use(remarkParse)
706:     .use(remarkGfm)
707:     .use(remarkMath)
708:     .use(remarkEditorialText)
709:     .use(remarkAuthorReferences, options)
710:     .use(remarkRehype, { allowDangerousHtml: true })
711:     .use(rehypeRaw)
712:   }
713:   if (html) processor.use(rehypeInlineCssHooks)
714:   processor
715:     .use(function () { return rehypeSafeEditorialStyles(html, false) })
716:     .use(function () { return rehypeYouTubeEmbeds(html) })
717:     .use(rehypeNormalizeFlowImages)
718:     .use(rehypeRestrictImages, options.imagePolicy)
719:     .use(rehypeImageAltFallback, options.defaultImageAlt)
720:     .use(rehypeParagraphIds, onParagraphId)
721:   // Keep existing HTML paragraph anchors stable when formulas become markup.
722:   if (html) processor.use(rehypeHtmlMath)
723:   // The page title already owns h1. Keep authored HTML on the same heading
724:   // scale and outline as the equivalent Markdown body (`#` also becomes h2).
725:   processor.use(rehypeDemoteBodyH1)
726:   return processor
727:     .use(rehypeSlug)
728:     .use(rehypeAutolinkHeadings, { behavior: "wrap" })
729:     .use(rehypePrefixFragmentLinks)
730:     .use(rehypeHardenExternalLinks, options.externalLinkRel)
731:     .use(rehypeMarkNoteSourceLinks)
732:     .use(rehypeSanitize, markdownSanitizeSchema)
733:     .use(function () { return rehypeSafeEditorialStyles(html, true) })
734:     // KaTeX runs after untrusted HTML is sanitized. It emits complete HTML and
735:     // MathML on the server, so formulas need no JavaScript in the browser.
736:     .use(rehypeKatex, {
737:       maxExpand: 1000,
738:       maxSize: 20,
739:       strict: "error",
740:     })
741:     .use(rehypeFlowImageStyles)
742:     .use(rehypeEditorialTextStyles)
743:     .use(rehypeStringify)
744: }
