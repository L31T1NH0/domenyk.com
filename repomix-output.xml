119: async function syncSeriesMembership(series: EditorialSeries) {
120:   const db = await getDb()
121:   const seriesCol = db.collection<EditorialSeries>("series")
122:   const postsCol = db.collection<Post>("posts")
123:   const now = new Date()
124:   const selectedIds = new Set(series.postIds.map((id) => id.toString()))
125:   const competingSeries = series.postIds.length > 0
126:     ? await seriesCol.find({ _id: { $ne: series._id }, postIds: { $in: series.postIds } }).toArray()
127:     : []
128: 
129:   if (series.postIds.length > 0) {
130:     await Promise.all(series.postIds.map((postId) => seriesCol.updateMany(
131:       { _id: { $ne: series._id }, postIds: postId },
132:       { $pull: { postIds: postId }, $set: { updatedAt: now } }
133:     )))
134:   }
135: 
136:   await postsCol.updateMany(
137:     {
138:       "series.id": series.publicId,
139:       ...(series.postIds.length > 0 ? { _id: { $nin: series.postIds } } : {}),
140:     },
141:     { $unset: { series: "" } }
142:   )
143: 
144:   const membershipWrites = [
145:     ...series.postIds.map((postId, index) => ({
146:       updateOne: {
147:         filter: { _id: postId, deleting: { $ne: true } },
148:         update: {
149:           $set: {
150:             series: {
151:               id: series.publicId,
152:               slug: series.slug,
153:               title: series.title,
154:               position: index + 1,
155:               published: series.published,
156:             },
157:           },
158:         },
159:       },
160:     })),
161:     ...competingSeries.flatMap((competing) => competing.postIds
162:       .filter((postId) => !selectedIds.has(postId.toString()))
163:       .map((postId, index) => ({
164:         updateOne: {
165:           filter: { _id: postId, deleting: { $ne: true } },
166:           update: {
167:             $set: {
168:               series: {
169:                 id: competing.publicId,
170:                 slug: competing.slug,
171:                 title: competing.title,
172:                 position: index + 1,
173:                 published: competing.published,
174:               },
175:             },
176:           },
177:         },
178:       }))),
179:   ]
180:   if (membershipWrites.length > 0) await postsCol.bulkWrite(membershipWrites)
181: }
