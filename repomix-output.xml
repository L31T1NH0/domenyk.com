230: export function usePretextImageFlow(containerRef: RefObject<HTMLElement | null>, contentKey: string) {
231:   useEffect(() => {
232:     const container = containerRef.current
233:     if (!container) return
234: 
235:     const figures = Array.from(container.querySelectorAll<HTMLElement>(":scope > figure[data-flow-image]"))
236:     const figure = figures[0]
237:     const image = figure?.querySelector<HTMLImageElement>(":scope > img")
238:     const sideValue = figure?.dataset.flowImage
239:     const side: FlowSide | null = sideValue === "left" || sideValue === "right" ? sideValue : null
240:     if (!figure || !image || !side || figures.length !== 1 || figure.querySelector("figcaption")) return
241:     const paragraphs = directFlowParagraphs(figure)
242:     if (!paragraphs.length || paragraphs.some(paragraph => !isSupportedParagraph(paragraph))) return
243:     const templates = paragraphs.map(element => ({ element, nodes: cloneNodes(Array.from(element.childNodes)) }))
244:     const abortController = new AbortController()
245:     let disposed = false
246:     let geometry: FlowImageAlphaGeometry | null = null
247:     let scheduledFrame = 0
248:     let lastSignature = ""
249:     const restore = () => {
250:       for (const template of templates) restoreParagraph(template)
251:       delete container.dataset.pretextFlowActive
252:       container.style.removeProperty("--pretext-flow-min-height")
253:       figure.style.removeProperty("--pretext-flow-image-top")
254:     }
255: 
256:     const render = (force = false) => {
257:       if (disposed || !geometry) {
258:         restore()
259:         return
260:       }
261:       const signature = styleSignature(container, figure, paragraphs)
262:       if (!force && signature === lastSignature) return
263:       lastSignature = signature
264:       restore()
265: 
266:       const containerWidth = container.clientWidth
267:       const containerRect = container.getBoundingClientRect()
268:       const authoredImageRect = image.getBoundingClientRect()
269:       const authoredImageWidth = authoredImageRect.width
270:       if (!containerWidth || !authoredImageWidth) return restore()
271:       const outerOffset = authoredImageWidth * geometry[side]
272:       figure.style.setProperty("--flow-image-outer-alpha-offset", `${outerOffset.toFixed(2)}px`)
273:       const authoredImageTop = authoredImageRect.top - containerRect.top
274:       const shapeMargin = parsePixelValue(window.getComputedStyle(figure).shapeMargin, 12)
275:       container.dataset.pretextFlowActive = "true"
276:       figure.style.setProperty("--pretext-flow-image-top", `${authoredImageTop.toFixed(2)}px`)
277: 
278:       // The active CSS can move the figure beyond the reading column to hide
279:       // transparent outer pixels. Measure the image again after that CSS has
280:       // taken effect so Pretext reserves the pixels where the image is
281:       // actually painted instead of relying on a duplicated position formula.
282:       const activeContainerRect = container.getBoundingClientRect()
283:       const activeImageRect = image.getBoundingClientRect()
284:       const imageTop = activeImageRect.top - activeContainerRect.top
285:       const imageLeft = activeImageRect.left - activeContainerRect.left
286:       const imageWidth = activeImageRect.width
287:       const imageHeight = activeImageRect.height || imageWidth * (geometry.height / geometry.width)
288:       if (!imageWidth || !imageHeight) return restore()
289:       for (const template of templates) {
290:         if (!layoutParagraph({
291:           paragraph: template.element,
292:           geometry,
293:           side,
294:           containerWidth,
295:           imageTop,
296:           imageHeight,
297:           imageLeft,
298:           imageWidth,
299:           shapeMargin,
300:         })) {
301:           restore()
302:           return
303:         }
304:       }
305:       container.style.setProperty("--pretext-flow-min-height", `${Math.ceil(imageTop + imageHeight)}px`)
306:     }
307: 
308:     const scheduleRender = (force = false) => {
309:       if (scheduledFrame) cancelAnimationFrame(scheduledFrame)
310:       scheduledFrame = requestAnimationFrame(() => {
311:         scheduledFrame = 0
312:         render(force)
313:       })
314:     }
315:     const onFontsLoaded = () => scheduleRender(true)
316:     const onPreferencesChange = () => scheduleRender(true)
317:     const resizeObserver = new ResizeObserver(() => scheduleRender())
318:     resizeObserver.observe(container)
319:     resizeObserver.observe(figure)
320:     const themeObserver = new MutationObserver(() => scheduleRender(true))
321:     themeObserver.observe(document.documentElement, { attributeFilter: ["class"], attributes: true })
322:     document.fonts.addEventListener("loadingdone", onFontsLoaded)
323:     window.addEventListener("readingpreferenceschange", onPreferencesChange)
324:     void measureFlowImageAlpha(image.currentSrc || image.src, abortController.signal).then(measuredGeometry => {
325:       if (disposed || !measuredGeometry) return
326:       geometry = measuredGeometry
327:       scheduleRender(true)
328:     })
329:     return () => {
330:       disposed = true
331:       abortController.abort()
332:       if (scheduledFrame) cancelAnimationFrame(scheduledFrame)
333:       resizeObserver.disconnect()
334:       themeObserver.disconnect()
335:       document.fonts.removeEventListener("loadingdone", onFontsLoaded)
336:       window.removeEventListener("readingpreferenceschange", onPreferencesChange)
337:       restore()
338:     }
339:   }, [containerRef, contentKey])
340: }
