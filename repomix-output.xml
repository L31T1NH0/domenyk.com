 41:   const paragraphs: HTMLParagraphElement[] = []
 42:   let sibling = figure.nextElementSibling
 43:   while (sibling instanceof HTMLParagraphElement) {
 44:     paragraphs.push(sibling)
 45:     sibling = sibling.nextElementSibling
 46:   }
 47:   return paragraphs
