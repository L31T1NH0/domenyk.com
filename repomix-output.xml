<file path="src/app/admin/notes/EditorialImport.tsx">
  1: "use client"
  2: 
  3: import { useRef, useState } from "react"
  4: import { useRouter } from "next/navigation"
  5: 
  6: type PreviewItem = {
  7:   editorialId: string
  8:   title: string
  9:   action: "keep" | "update" | "archive"
 10:   position: number
 11:   status: "matched" | "unchanged" | "missing" | "ambiguous" | "duplicate"
 12:   detail?: string
 13: }
 14: 
 15: type Preview = {
 16:   canApply: boolean
 17:   counts: {
 18:     units: number
 19:     archive: number
 20:     update: number
 21:     unchanged: number
 22:     missing: number
 23:     ambiguous: number
 24:     duplicate: number
 25:   }
 26:   items: PreviewItem[]
 27: }
 28: 
 29: function actionLabel(action: PreviewItem["action"]) {
 30:   return action === "archive" ? "Excluir" : action === "update" ? "Atualizar" : "Manter"
 31: }
 32: 
 33: function statusLabel(status: PreviewItem["status"]) {
 34:   return status === "matched" ? "Encontrada" : status === "unchanged" ? "Sem mudança" : status === "missing" ? "Ausente" : status === "ambiguous" ? "Ambígua" : "Duplicada"
 35: }
 36: 
 37: export function EditorialImport() {
 38:   const router = useRouter()
 39:   const inputRef = useRef<HTMLInputElement>(null)
 40:   const [fileName, setFileName] = useState("")
 41:   const [bundle, setBundle] = useState<unknown>(null)
 42:   const [preview, setPreview] = useState<Preview | null>(null)
 43:   const [confirming, setConfirming] = useState(false)
 44:   const [busy, setBusy] = useState(false)
 45:   const [message, setMessage] = useState("")
 46:   const [error, setError] = useState("")
 47: 
 48:   async function inspectFile(file: File) {
 49:     setBusy(true); setError(""); setMessage(""); setPreview(null); setConfirming(false); setFileName(file.name)
 50:     try {
 51:       const parsed: unknown = JSON.parse(await file.text())
 52:       setBundle(parsed)
 53:       const response = await fetch("/api/admin/notes/editorial-import", {
 54:         method: "POST",
 55:         headers: { "Content-Type": "application/json" },
 56:         body: JSON.stringify({ mode: "preview", bundle: parsed }),
 57:       })
 58:       const data = await response.json() as Preview & { error?: string }
 59:       if (!response.ok) throw new Error(data.error ?? "Não foi possível ler o pacote.")
 60:       setPreview(data)
 61:     } catch (cause) {
 62:       setBundle(null)
 63:       setError(cause instanceof Error ? cause.message : "Não foi possível ler o pacote.")
 64:     } finally {
 65:       setBusy(false)
 66:     }
 67:   }
 68: 
 69:   async function apply() {
 70:     if (!bundle || !preview?.canApply) return
 71:     setBusy(true); setError(""); setMessage("")
 72:     try {
 73:       const response = await fetch("/api/admin/notes/editorial-import", {
 74:         method: "POST",
 75:         headers: { "Content-Type": "application/json" },
 76:         body: JSON.stringify({ mode: "apply", bundle }),
 77:       })
 78:       const data = await response.json() as { error?: string; applied?: number }
 79:       if (!response.ok) throw new Error(data.error ?? "Não foi possível aplicar o pacote.")
 80:       setMessage(`${data.applied ?? 0} nota(s) aplicada(s).`)
 81:       setPreview(null); setBundle(null); setFileName(""); setConfirming(false)
 82:       if (inputRef.current) inputRef.current.value = ""
 83:       router.refresh()
 84:     } catch (cause) {
 85:       setError(cause instanceof Error ? cause.message : "Não foi possível aplicar o pacote.")
 86:     } finally {
 87:       setBusy(false)
 88:     }
 89:   }
 90: 
 91:   const unresolved = preview ? preview.counts.missing + preview.counts.ambiguous + preview.counts.duplicate : 0
 92:   return <section className="admin-section" aria-labelledby="editorial-import-title">
 93:     <header>
 94:       <div>
 95:         <h2 id="editorial-import-title">Importar revisão editorial</h2>
 96:         <p>Carregue o pacote gerado pela Mesa Editorial. A prévia encontra as notas pelo conteúdo antes de alterar o site.</p>
 97:       </div>
 98:       {preview && <span className={`admin-record-status ${preview.canApply ? "is-live" : "is-review"}`}>{preview.canApply ? "Pronto para aplicar" : "Bloqueado"}</span>}
 99:     </header>
100: 
101:     <div className="admin-form-grid">
102:       <label className="admin-field admin-field-wide">
103:         <span>Pacote JSON <small>gerado pela Mesa Editorial</small></span>
104:         <input ref={inputRef} type="file" accept=".json,application/json" disabled={busy} onChange={(event) => { const file = event.target.files?.[0]; if (file) void inspectFile(file) }} />
105:       </label>
106: 
107:       {fileName && <p className="admin-page-note admin-field-wide">Arquivo carregado: <strong>{fileName}</strong></p>}
108:       {error && <p className="admin-form-error admin-field-wide" role="alert">{error}</p>}
109:       {message && <p className="admin-form-success admin-field-wide" role="status">{message}</p>}
110: 
111:       {preview && <>
112:         <dl className="admin-note-metrics admin-field-wide">
113:           <div><dt>Unidades</dt><dd>{preview.counts.units}</dd></div>
114:           <div><dt>Atualizar</dt><dd>{preview.counts.update}</dd></div>
115:           <div><dt>Excluir</dt><dd>{preview.counts.archive}</dd></div>
116:           <div><dt>Sem mudança</dt><dd>{preview.counts.unchanged}</dd></div>
117:         </dl>
118: 
119:         <div className="admin-field-wide">
120:           <p className="admin-page-note">A aplicação exige correspondência única para cada nota. {unresolved ? `${unresolved} item(ns) precisam de correção antes da aplicação.` : "Nenhuma correspondência insegura foi encontrada."}</p>
121:           <ul className="admin-pick-list">
122:             {preview.items.filter((item) => item.status !== "unchanged").slice(0, 30).map((item) => <li key={`${item.editorialId}:${item.position}`}>
123:               <span><strong>{item.title}</strong><small>Parte {item.position} · {actionLabel(item.action)}{item.detail ? ` · ${item.detail}` : ""}</small></span>
124:               <span className={`admin-record-status ${item.status === "matched" ? "is-live" : item.status === "unchanged" ? "is-muted" : "is-review"}`}>{statusLabel(item.status)}</span>
125:             </li>)}
126:           </ul>
127:         </div>
128: 
129:         <div className="admin-editor-actions admin-field-wide">
130:           {!confirming ? <button type="button" className="admin-button-primary" disabled={busy || !preview.canApply} onClick={() => setConfirming(true)}>Preparar aplicação</button> : <>
131:             <button type="button" className="admin-button-secondary" disabled={busy} onClick={() => setConfirming(false)}>Voltar</button>
132:             <button type="button" className="admin-button-danger" disabled={busy} onClick={() => void apply()}>Confirmar alterações e exclusões</button>
133:           </>}
134:         </div>
135:       </>}
136:     </div>
137:   </section>
138: }
</file>

