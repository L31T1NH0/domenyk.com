37: export function parseCommentContent(
38:   value: unknown,
39:   { allowImages = false }: { allowImages?: boolean } = {}
40: ): string | null {
41:   const content = asString(value, MAX_COMMENT_CONTENT_LENGTH) ?? ""
42:   const normalized = normalizeNoteContent(content)
43:   return normalized && hasOnlyAllowedCommentImages(normalized, allowImages) ? normalized : null
