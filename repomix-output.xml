14:   const [fileName, setFileName] = useState("")
15:   const [preview, setPreview] = useState<Preview | null>(null)
16:   const [busy, setBusy] = useState(false)
17:   const [confirming, setConfirming] = useState(false)
18:   const [message, setMessage] = useState("")
19:   const [error, setError] = useState("")
20: 
21:   async function inspect(file: File) {
22:     setBusy(true); setError(""); setMessage(""); setPreview(null); setConfirming(false); setFileName(file.name)
23:     try {
24:       const parsed = JSON.parse(await file.text())
25:       setBundle(parsed)
26:       const response = await fetch("/api/admin/notes/seo-import", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ mode: "preview", bundle: parsed }) })
27:       const data = await response.json() as Preview & { error?: string }
28:       if (!response.ok) throw new Error(data.error ?? "Não foi possível ler o arquivo.")
29:       setPreview(data)
30:     } catch (cause) {
31:       setBundle(null); setError(cause instanceof Error ? cause.message : "Não foi possível ler o arquivo.")
32:     } finally { setBusy(false) }
33:   }
34: 
35:   async function apply() {
36:     if (!bundle || !preview?.canApply) return
37:     setBusy(true); setError(""); setMessage("")
38:     try {
39:       const response = await fetch("/api/admin/notes/seo-import", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ mode: "apply", bundle }) })
40:       const data = await response.json() as { error?: string; applied?: number }
41:       if (!response.ok) throw new Error(data.error ?? "Não foi possível aplicar o SEO.")
42:       setMessage(`${data.applied ?? 0} nota(s) atualizada(s).`); setBundle(null); setPreview(null); setFileName(""); setConfirming(false)
43:       if (inputRef.current) inputRef.current.value = ""
44:       router.refresh()
45:     } catch (cause) { setError(cause instanceof Error ? cause.message : "Não foi possível aplicar o SEO.")
46:     } finally { setBusy(false) }
47:   }
48: 
49:   return <section className="admin-section" aria-labelledby="seo-import-title">
50:     <header>
51:       <div><h2 id="seo-import-title">Importar dados SEO</h2><p>Atualize título e descrição SEO de várias notas usando os IDs do arquivo.</p></div>
52:       <Link className="admin-button-secondary" href="/api/admin/notes/seo-import" prefetch={false} download>Baixar guia do formato</Link>
53:     </header>
54:     <div className="admin-form-grid">
55:       <label className="admin-field admin-field-wide"><span>Arquivo JSON</span><input ref={inputRef} type="file" accept=".json,application/json" disabled={busy} onChange={(event) => { const file = event.target.files?.[0]; if (file) void inspect(file) }} /></label>
56:       {fileName && <p className="admin-page-note admin-field-wide">Arquivo carregado: <strong>{fileName}</strong></p>}
57:       {error && <p className="admin-form-error admin-field-wide" role="alert">{error}</p>}
58:       {message && <p className="admin-form-success admin-field-wide" role="status">{message}</p>}
59:       {preview && <>
60:         <dl className="admin-note-metrics admin-field-wide"><div><dt>Total</dt><dd>{preview.counts.total}</dd></div><div><dt>Atualizar</dt><dd>{preview.counts.update}</dd></div><div><dt>Sem mudança</dt><dd>{preview.counts.unchanged}</dd></div><div><dt>Ausentes</dt><dd>{preview.counts.missing}</dd></div></dl>
61:         <ul className="admin-pick-list admin-field-wide">{preview.items.slice(0, 30).map((item) => <li key={item.id}><span><strong>{item.seoTitle}</strong><small>{item.id}{item.detail ? ` · ${item.detail}` : ""}</small></span><span className={`admin-record-status ${item.status === "missing" ? "is-review" : item.status === "unchanged" ? "is-muted" : "is-live"}`}>{item.status === "update" ? "Atualizar" : item.status === "unchanged" ? "Sem mudança" : "Ausente"}</span></li>)}</ul>
62:         <div className="admin-editor-actions admin-field-wide">{!confirming ? <button type="button" className="admin-button-primary" disabled={busy || !preview.canApply} onClick={() => setConfirming(true)}>Preparar importação</button> : <><button type="button" className="admin-button-secondary" disabled={busy} onClick={() => setConfirming(false)}>Voltar</button><button type="button" className="admin-button-primary" disabled={busy} onClick={() => void apply()}>Confirmar importação</button></>}</div>
63:       </>}
64:     </div>
65:   </section>
66: }
