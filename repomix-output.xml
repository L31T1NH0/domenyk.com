<file path="src/components/editor/editorial-transformer.ts">
 1: import { $convertFromMarkdownString, type MultilineElementTransformer, type Transformer } from "@lexical/markdown"
 2: import { $createParagraphNode, $isElementNode, $isParagraphNode, type ElementFormatType } from "lexical"
 3: import { $isHeadingNode, $isQuoteNode } from "@lexical/rich-text"
 4: import { editorialTextFromStyle, editorialTextStyle, normalizeEditorialText } from "@/lib/editorial-text"
 5: 
 6: export function createEditorialTextTransformer(base: Transformer[]): MultilineElementTransformer {
 7:   return {
 8:     type: "multiline-element",
 9:     dependencies: [],
10:     regExpStart: /^:::editor (left|center|right|justify) ([\w.]+) ([\w.]+) ([\w.]+) (\w+)$/,
11:     regExpEnd: /^:::$/,
12:     export(node, children) {
13:       if (!$isParagraphNode(node) && !$isHeadingNode(node) && !$isQuoteNode(node)) return null
14:       // Lexical separates empty paragraphs with a single newline. Wrapping
15:       // them would join adjacent closing/opening directives into plain text.
16:       if (!node.getTextContent().trim()) return null
17:       // Image paragraphs use the image transformers, not text wrappers.
18:       if (node.getChildren().some(child => child.getType() === "image")) return null
19:       const p = editorialTextFromStyle(node.getStyle(), node.getFormatType())
20:       if (p.align === "left" && p.size === "auto" && p.leading === "auto" && p.spacing === "auto" && p.tone === "none") return null
21:       let content = children(node)
22:       if ($isHeadingNode(node)) content = `${"#".repeat(Number(node.getTag().slice(1)))} ${content}`
23:       if ($isQuoteNode(node)) content = content.split("\n").map(line => `> ${line}`).join("\n")
24:       return `:::editor ${p.align} ${p.size} ${p.leading} ${p.spacing} ${p.tone}\n\n${content}\n\n:::`
25:     },
26:     replace(root, _children, match, _end, lines) {
27:       if (!lines) return false
28:       const [, align, size, leading, spacing, tone] = match
29:       const p = normalizeEditorialText({ align, size, leading, spacing, tone })
30:       const temporary = $createParagraphNode()
31:       $convertFromMarkdownString(lines.join("\n"), base, temporary)
32:       for (const child of temporary.getChildren()) {
33:         if ($isElementNode(child)) {
34:           child.setFormat(p.align as ElementFormatType)
35:           child.setStyle(editorialTextStyle(p))
36:         }
37:         root.append(child)
38:       }
39:     },
40:   }
41: }
</file>

