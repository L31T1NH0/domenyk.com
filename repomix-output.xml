598:     const root = document.documentElement;
599:     const response = document.querySelector(".response");
600:     const buttons = Array.from(document.querySelectorAll("[data-response]"));
601:     const responseCopy = {
602:       discordo: "posição registrada: discordância",
603:       duvida: "posição registrada: dúvida preservada",
604:       concordo: "posição registrada: concordância"
605:     };
606: 
607:     function updateProgress() {
608:       const max = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
609:       root.style.setProperty("--progress", `${Math.min(100, (window.scrollY / max) * 100)}%`);
610:     }
