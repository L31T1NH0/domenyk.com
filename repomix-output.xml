 6: } from "@/lib/db/notifications"
 7: import { rateLimit } from "@/lib/rate-limit"
 8: import { requestIdentity } from "@/lib/request-identity"
 9: 
10: const ACTIONS = new Set<NotificationActionType>(["copied_link", "commented", "sent_message"])
11: 
12: function validToken(value: unknown): value is string {
13:   return typeof value === "string" && /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(value)
14: }
15: 
16: export async function PATCH(req: NextRequest) {
17:   if (!(await rateLimit(`engagement:${requestIdentity(req)}`, { limit: 20, windowMs: 60_000 }))) {
18:     return NextResponse.json({ error: "Muitas requisições." }, { status: 429 })
19:   }
20: 
21:   const body = await req.json().catch(() => null) as {
22:     token?: unknown
23:     event?: unknown
24:     action?: unknown
25:     activeSeconds?: unknown
26:     progress?: unknown
27:   } | null
28: 
29:   if (!validToken(body?.token)) return NextResponse.json({ error: "Token inválido." }, { status: 400 })
30: 
31:   if (body.event === "reading_completed") {
32:     const activeSeconds = Math.min(24 * 60 * 60, Math.max(1, Math.round(Number(body.activeSeconds))))
33:     const progress = Math.min(100, Math.max(0, Math.round(Number(body.progress))))
34:     if (!Number.isFinite(activeSeconds) || !Number.isFinite(progress)) {
35:       return NextResponse.json({ error: "Métricas inválidas." }, { status: 400 })
36:     }
37:     const updated = await completeNotificationReading(body.token, activeSeconds, progress)
38:     if (!updated) return NextResponse.json({ error: "Token expirado ou evento já registrado." }, { status: 410 })
39:     return NextResponse.json({ ok: true })
40:   }
41: 
42:   if (body.event === "action" && typeof body.action === "string" && ACTIONS.has(body.action as NotificationActionType)) {
43:     const updated = await appendNotificationAction(body.token, body.action as NotificationActionType)
44:     if (!updated) return NextResponse.json({ error: "Token expirado ou ação já registrada." }, { status: 410 })
45:     return NextResponse.json({ ok: true })
46:   }
47: 
48:   return NextResponse.json({ error: "Evento inválido." }, { status: 400 })
49: }
