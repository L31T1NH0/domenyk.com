60:     const content = post.contentMarkdown ?? post.htmlContent ?? post.content ?? ""
61:     const publishedAt = legacyPublishedAt(post.date)
62: 
63:     const newDoc = {
64:       publicId: post.publicId ?? randomUUID(),
65:       slug,
66:       title: post.title ?? "",
67:       content,
68:       excerpt: extractExcerpt(content),
69:       cover: post.cape ? { url: post.cape } : undefined,
70:       audioUrl: typeof post.audioUrl === "string" && post.audioUrl.trim() ? post.audioUrl.trim() : undefined,
71:       background: undefined,
72:       tags: post.tags ?? [],
73:       pinned: post.pinnedOrder != null,
74:       published: post.hidden !== true,
75:       publishedAt,
76:       readingTimeMinutes: calcReadingTime(content),
77:       style: "standard",
78:       createdAt: publishedAt,
79:       updatedAt: publishedAt,
80:     }
81: 
82:     const concurrencyFilter = Object.hasOwn(post, "postId")
83:       ? { _id: post._id, postId: post.postId }
84:       : { _id: post._id, postId: { $exists: false } }
85:     const result = await col.replaceOne(concurrencyFilter, newDoc)
86:     if (result.matchedCount !== 1) throw new Error(`O post ${post._id} mudou durante a migração.`)
87:     console.log(`  [ok] ${post.title}`)
88:     migrated++
89:   }
90: 
91:   console.log(`\nMigração concluída: ${migrated} migrados, ${skipped} ignorados`)
92:   await client.close()
93: }
94: 
95: main().catch(async (e) => { console.error(e); await client.close().catch(() => undefined); process.exit(1) })
</file>

