 1: import type { ObjectId } from "mongodb"
 2: 
 3: export type NoteThreadFields = {
 4:   threadRootId?: ObjectId
 5:   previousNoteId?: ObjectId
 6:   threadPosition?: number
 7: }
 8: 
 9: export type SerializedNoteThread = {
10:   rootId: string
11:   previousId?: string
12:   position: number
13: }
14: 
15: export function serializeNoteThread(fields: NoteThreadFields): SerializedNoteThread | undefined {
16:   if (!fields.threadRootId || !fields.threadPosition) return undefined
17:   return {
18:     rootId: fields.threadRootId.toString(),
19:     ...(fields.previousNoteId ? { previousId: fields.previousNoteId.toString() } : {}),
20:     position: fields.threadPosition,
21:   }
22: }
23: 
24: export function groupNotesByThread<T extends { _id: string; thread?: SerializedNoteThread }>(notes: T[]): T[][] {
25:   const grouped = new Map<string, T[]>()
26:   const order: string[] = []
27: 
28:   for (const note of notes) {
29:     const key = note.thread?.rootId ?? note._id
30:     const existing = grouped.get(key)
31:     if (existing) {
32:       existing.push(note)
33:     } else {
34:       grouped.set(key, [note])
35:       order.push(key)
36:     }
37:   }
38: 
39:   return order.map((key) => {
40:     const group = grouped.get(key) ?? []
41:     return group.length > 1
42:       ? [...group].sort((a, b) => (a.thread?.position ?? 1) - (b.thread?.position ?? 1))
43:       : group
44:   })
45: }
46: 
47: export function mergeNotesById<T extends { _id: string }>(current: T[], updates: T[]): T[] {
48:   const updateMap = new Map(updates.map((note) => [note._id, note]))
49:   const currentIds = new Set(current.map((note) => note._id))
50:   return [
51:     ...current.map((note) => updateMap.get(note._id) ?? note),
52:     ...updates.filter((note) => !currentIds.has(note._id)),
53:   ]
54: }
</file>

