16:     if (!allowImages) return false
17:     count += 1
18:     if (count > MAX_COMMENT_IMAGES) return false
19:     const source = match[1] ?? match[2] ?? match[3] ?? match[4] ?? ""
20:     try {
21:       const url = new URL(source)
22:       if (
23:         url.protocol !== "https:" ||
24:         !isProjectBlobHostname(url.hostname) ||
25:         !url.pathname.startsWith("/comments/")
26:       ) {
27:         return false
28:       }
29:     } catch {
30:       return false
31:     }
32:   }
33: 
34:   return true
35: }
