 28: 
 29: const navItems = [
 30:   { href: "/admin", label: "Visão geral", icon: ChartBarSquareIcon },
 31:   { href: "/admin/escrevendo", label: "O que estou escrevendo", icon: PencilSquareIcon },
 32:   { href: "/admin/posts", label: "Posts", icon: DocumentTextIcon },
 33:   { href: "/admin/series", label: "Séries", icon: RectangleStackIcon },
 34:   { href: "/admin/notes", label: "Notas", icon: PencilSquareIcon },
 35:   { href: "/admin/temas", label: "Temas", icon: TagIcon },
 36:   { href: "/admin/comments", label: "Comentários", icon: ChatBubbleLeftRightIcon },
 37:   { href: "/admin/messages", label: "Mensagens", icon: NewspaperIcon },
 38:   { href: "/admin/notificacoes", label: "Notificações", icon: BellAlertIcon },
 39:   { href: "/admin/media", label: "Mídia", icon: FolderIcon },
