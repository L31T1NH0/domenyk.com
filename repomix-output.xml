146: function normalizedYouTubeEmbedSource(source: unknown): string | null {
147:   if (typeof source !== "string") return null
148: 
149:   try {
150:     const sourceUrl = new URL(source)
151:     const allowedHost = YOUTUBE_EMBED_HOSTNAMES.includes(sourceUrl.hostname as typeof YOUTUBE_EMBED_HOSTNAMES[number])
152:     const match = sourceUrl.pathname.match(/^\/embed\/([A-Za-z0-9_-]{11})$/)
153:     if (!allowedHost || !match || sourceUrl.username || sourceUrl.password || sourceUrl.port || sourceUrl.hash) return null
154: 
155:     const embedUrl = new URL(`${YOUTUBE_EMBED_ORIGIN}/embed/${match[1]}`)
156:     embedUrl.searchParams.set("controls", "0")
157:     embedUrl.searchParams.set("iv_load_policy", "3")
158:     embedUrl.searchParams.set("rel", "0")
159:     embedUrl.searchParams.set("playsinline", "1")
160:     for (const key of ["start", "end"]) {
161:       const value = sourceUrl.searchParams.get(key)
162:       if (!value || !/^\d+$/.test(value)) continue
163:       const seconds = Number(value)
164:       if (Number.isSafeInteger(seconds) && seconds >= 0) embedUrl.searchParams.set(key, String(seconds))
165:     }
166:     return embedUrl.toString()
167:   } catch {
168:     return null
169:   }
170: }
