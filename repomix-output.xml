<file path="src/components/post/ReadingPreferencesContext.tsx">
  1: "use client"
  2: 
  3: import {
  4:   createContext,
  5:   useCallback,
  6:   useContext,
  7:   useMemo,
  8:   useState,
  9:   useSyncExternalStore,
 10:   type CSSProperties,
 11:   type HTMLAttributes,
 12:   type ReactNode,
 13: } from "react"
 14: import { usePathname } from "next/navigation"
 15: import {
 16:   adjustReadingPreference,
 17:   DEFAULT_READING_PREFERENCE_PROFILES,
 18:   DEFAULT_READING_METRICS,
 19:   effectiveReadingMetrics,
 20:   LEGACY_READING_PREFERENCES_STORAGE_KEY,
 21:   normalizeReadingPreferenceProfiles,
 22:   readingPreferenceProfileForPathname,
 23:   READING_PREFERENCES_STORAGE_KEY,
 24:   resetReadingPreference,
 25:   type ReadingMetrics,
 26:   type ReadingPreferenceKey,
 27:   type ReadingPreferences,
 28:   type ReadingPreferenceProfiles,
 29: } from "@/lib/reading-preferences"
 30: 
 31: type ReadingPreferencesContextValue = {
 32:   preferences: ReadingPreferences
 33:   metrics: ReadingMetrics
 34:   adjustPreference: (key: ReadingPreferenceKey, direction: -1 | 1) => void
 35:   resetPreference: (key: ReadingPreferenceKey) => void
 36:   resetPreferences: () => void
 37:   setMetrics: (metrics: ReadingMetrics) => void
 38: }
 39: 
 40: const ReadingPreferencesContext = createContext<ReadingPreferencesContextValue | null>(null)
 41: const READING_PREFERENCES_CHANGE_EVENT = "readingpreferenceschange"
 42: const NOTE_READING_LINE_HEIGHT = 1.4
 43: const DEFAULT_READING_PREFERENCE_PROFILES_SERIALIZED = JSON.stringify(DEFAULT_READING_PREFERENCE_PROFILES)
 44: let volatileReadingPreferences: string | null = null
 45: 
 46: function getReadingPreferencesSnapshot() {
 47:   if (volatileReadingPreferences !== null) return volatileReadingPreferences
 48:   try {
 49:     const storedProfiles = window.localStorage.getItem(READING_PREFERENCES_STORAGE_KEY)
 50:     if (storedProfiles) return storedProfiles
 51: 
 52:     const legacyPreferences = window.localStorage.getItem(LEGACY_READING_PREFERENCES_STORAGE_KEY)
 53:     return legacyPreferences
 54:       ? JSON.stringify(normalizeReadingPreferenceProfiles(JSON.parse(legacyPreferences)))
 55:       : DEFAULT_READING_PREFERENCE_PROFILES_SERIALIZED
 56:   } catch {
 57:     return DEFAULT_READING_PREFERENCE_PROFILES_SERIALIZED
 58:   }
 59: }
 60: 
 61: function getServerReadingPreferencesSnapshot() {
 62:   return DEFAULT_READING_PREFERENCE_PROFILES_SERIALIZED
 63: }
 64: 
 65: function readCurrentReadingPreferenceProfiles() {
 66:   try {
 67:     return normalizeReadingPreferenceProfiles(JSON.parse(getReadingPreferencesSnapshot()))
 68:   } catch {
 69:     return { ...DEFAULT_READING_PREFERENCE_PROFILES }
 70:   }
 71: }
 72: 
 73: function subscribeToReadingPreferences(callback: () => void) {
 74:   const onStorage = (event: StorageEvent) => {
 75:     if (event.key !== READING_PREFERENCES_STORAGE_KEY && event.key !== null) return
 76:     volatileReadingPreferences = null
 77:     callback()
 78:   }
 79: 
 80:   window.addEventListener("storage", onStorage)
 81:   window.addEventListener(READING_PREFERENCES_CHANGE_EVENT, callback)
 82:   return () => {
 83:     window.removeEventListener("storage", onStorage)
 84:     window.removeEventListener(READING_PREFERENCES_CHANGE_EVENT, callback)
 85:   }
 86: }
 87: 
 88: function storeReadingPreferenceProfiles(profiles: ReadingPreferenceProfiles) {
 89:   const serialized = JSON.stringify(profiles)
 90:   volatileReadingPreferences = serialized
 91:   try {
 92:     window.localStorage.setItem(READING_PREFERENCES_STORAGE_KEY, serialized)
 93:   } catch {
 94:     // Preferences still apply for the current page when storage is unavailable.
 95:   }
 96:   window.dispatchEvent(new Event(READING_PREFERENCES_CHANGE_EVENT))
 97: }
 98: 
 99: export function ReadingPreferencesProvider({ children }: { children: ReactNode }) {
100:   const pathname = usePathname()
101:   const serializedPreferences = useSyncExternalStore(
102:     subscribeToReadingPreferences,
103:     getReadingPreferencesSnapshot,
104:     getServerReadingPreferencesSnapshot
105:   )
106:   const profiles = useMemo(() => {
107:     try {
108:       return normalizeReadingPreferenceProfiles(JSON.parse(serializedPreferences))
109:     } catch {
110:       return { ...DEFAULT_READING_PREFERENCE_PROFILES }
111:     }
112:   }, [serializedPreferences])
113:   const preferenceProfile = readingPreferenceProfileForPathname(pathname)
114:   const preferences = profiles[preferenceProfile]
115:   const [metrics, setMetrics] = useState<ReadingMetrics>(DEFAULT_READING_METRICS)
116:   const routeMetrics = useMemo(() => (
117:     pathname === "/" || pathname === "/notes"
118:       ? { autoFontSize: 15, baseLineHeight: NOTE_READING_LINE_HEIGHT, baseBlockSpacing: 0.5 }
119:       : /^\/notes\/[^/]+$/.test(pathname)
120:         ? { autoFontSize: 17, baseLineHeight: NOTE_READING_LINE_HEIGHT, baseBlockSpacing: 0.5 }
121:         : metrics
122:   ), [pathname, metrics])
123: 
124:   const adjustPreference = useCallback((key: ReadingPreferenceKey, direction: -1 | 1) => {
125:     const currentProfiles = readCurrentReadingPreferenceProfiles()
126:     storeReadingPreferenceProfiles({
127:       ...currentProfiles,
128:       [preferenceProfile]: adjustReadingPreference(
129:         currentProfiles[preferenceProfile],
130:         routeMetrics,
131:         key,
132:         direction
133:       ),
134:     })
135:   }, [preferenceProfile, routeMetrics])
136: 
137:   const resetPreference = useCallback((key: ReadingPreferenceKey) => {
138:     const currentProfiles = readCurrentReadingPreferenceProfiles()
139:     storeReadingPreferenceProfiles({
140:       ...currentProfiles,
141:       [preferenceProfile]: resetReadingPreference(currentProfiles[preferenceProfile], key),
142:     })
143:   }, [preferenceProfile])
144: 
145:   const resetPreferences = useCallback(() => {
146:     const currentProfiles = readCurrentReadingPreferenceProfiles()
147:     storeReadingPreferenceProfiles({
148:       ...currentProfiles,
149:       [preferenceProfile]: { ...DEFAULT_READING_PREFERENCE_PROFILES[preferenceProfile] },
150:     })
151:   }, [preferenceProfile])
152: 
153:   const value = useMemo(() => ({
154:     preferences,
155:     metrics: routeMetrics,
156:     adjustPreference,
157:     resetPreference,
158:     resetPreferences,
159:     setMetrics,
160:   }), [preferences, routeMetrics, adjustPreference, resetPreference, resetPreferences])
161: 
162:   return (
163:     <ReadingPreferencesContext.Provider value={value}>
164:       {children}
165:     </ReadingPreferencesContext.Provider>
166:   )
167: }
168: 
169: type ReadingPreferencesScopeStyle = CSSProperties & {
170:   "--reading-font-size": string
171:   "--reading-line-height": number
172:   "--reading-letter-spacing": string
173:   "--reading-block-spacing": string
174: }
175: 
176: export function ReadingPreferencesScope({ style, ...props }: HTMLAttributes<HTMLDivElement>) {
177:   const { preferences, metrics } = useReadingPreferences()
178:   const readingMetrics = effectiveReadingMetrics(preferences, metrics)
179:   const readingStyle: ReadingPreferencesScopeStyle = {
180:     ...style,
181:     "--reading-font-size": `${readingMetrics.fontSize}px`,
182:     "--reading-line-height": readingMetrics.lineHeight,
183:     "--reading-letter-spacing": `${readingMetrics.letterSpacing}em`,
184:     "--reading-block-spacing": `${readingMetrics.blockSpacing}rem`,
185:   }
186: 
187:   return <div {...props} style={readingStyle} />
188: }
189: 
190: export function useReadingPreferences() {
191:   const context = useContext(ReadingPreferencesContext)
192:   if (!context) throw new Error("useReadingPreferences must be used inside ReadingPreferencesProvider")
193:   return context
194: }
</file>

