<file path="src/components/editor/PublicationPreview.tsx">
 1: "use client"
 2: 
 3: import { useEffect, useState } from "react"
 4: import { YOUTUBE_EMBED_ORIGIN } from "@/lib/youtube-embed"
 5: 
 6: function attribute(value: string) {
 7:   return value.replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;")
 8: }
 9: 
10: /** Uses the publication renderer and the very same loaded application styles. */
11: export function PublicationPreview({ content }: { content: string }) {
12:   const [preview, setPreview] = useState("")
13:   const [error, setError] = useState("")
14:   useEffect(() => {
15:     const abort = new AbortController()
16:     const timer = setTimeout(async () => {
17:       try {
18:         const response = await fetch("/api/admin/content-preview", {
19:           method: "POST", headers: { "Content-Type": "application/json" },
20:           body: JSON.stringify({ content }), signal: abort.signal,
21:         })
22:         const result = await response.json()
23:         if (!response.ok) throw new Error(result.error || "Não foi possível gerar a prévia.")
24:         if (abort.signal.aborted) return
25:         const links = Array.from(document.querySelectorAll<HTMLLinkElement>('link[rel="stylesheet"]')).map(link => `<link rel="stylesheet" href="${attribute(link.href)}">`).join("")
26:         const theme = document.documentElement.className
27:         setPreview(`<!doctype html><html class="${attribute(theme)}"><head><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; frame-src ${YOUTUBE_EMBED_ORIGIN}; img-src https: http:; style-src 'unsafe-inline' ${location.origin}; font-src ${location.origin} data:">${links}<style>html,body{margin:0;padding:0;min-height:0;background:transparent}body{padding:16px}</style></head><body><div data-public-shell><div class="post-content">${result.html}</div></div></body></html>`)
28:         setError("")
29:       } catch (error) {
30:         if (!abort.signal.aborted) setError(error instanceof Error ? error.message : "Não foi possível gerar a prévia.")
31:       }
32:     }, 250)
33:     return () => { clearTimeout(timer); abort.abort() }
34:   }, [content])
35:   return <div className="publication-preview">
36:     {error && <p role="alert" className="publication-css-error">{error}</p>}
37:     {!preview && !error && <p role="status">Preparando prévia…</p>}
38:     {preview && <iframe title="Prévia da publicação" sandbox="allow-scripts allow-same-origin allow-presentation" allow="encrypted-media; picture-in-picture; fullscreen" allowFullScreen srcDoc={preview} className="h-96 w-full border border-neutral-200 dark:border-white/10" />}
39:   </div>
40: }
</file>

<file path="src/components/post/FlowImageAlphaOffset.tsx">
  1: "use client"
  2: 
  3: import { useEffect } from "react"
  4: import {
  5:   geometryFromAlphaPixels,
  6:   MAX_FLOW_ALPHA_SAMPLE_DIMENSION,
  7:   type FlowImageAlphaGeometry,
  8: } from "./flow-image-alpha"
  9: 
 10: export type { FlowImageAlphaGeometry } from "./flow-image-alpha"
 11: 
 12: type FlowSide = "left" | "right"
 13: type TrackedImage = {
 14:   abortController: AbortController
 15:   alphaInsets: FlowImageAlphaGeometry | null
 16:   resizeObserver: ResizeObserver
 17:   side: FlowSide
 18:   source: string
 19: }
 20: type CacheHost = typeof globalThis & {
 21:   __domenykFlowImageAlphaCache?: Map<string, Promise<FlowImageAlphaGeometry | null>>
 22: }
 23: 
 24: const MAX_CACHE_ENTRIES = 32
 25: const WORKER_TIMEOUT_MS = 10_000
 26: 
 27: function cache() {
 28:   const host = globalThis as CacheHost
 29:   host.__domenykFlowImageAlphaCache ??= new Map()
 30:   return host.__domenykFlowImageAlphaCache
 31: }
 32: 
 33: function sampleDimensions(width: number, height: number) {
 34:   const scale = Math.min(1, MAX_FLOW_ALPHA_SAMPLE_DIMENSION / Math.max(width, height))
 35:   return {
 36:     width: Math.max(1, Math.round(width * scale)),
 37:     height: Math.max(1, Math.round(height * scale)),
 38:   }
 39: }
 40: 
 41: async function measureWithWorker(source: string): Promise<FlowImageAlphaGeometry> {
 42:   if (typeof Worker === "undefined" || typeof OffscreenCanvas === "undefined" || typeof createImageBitmap === "undefined") {
 43:     throw new Error("Worker image measurement is unavailable")
 44:   }
 45:   const response = await fetch(source, { credentials: "omit", mode: "cors" })
 46:   if (!response.ok) throw new Error("Image could not be fetched")
 47:   const bitmap = await createImageBitmap(await response.blob())
 48:   const naturalWidth = bitmap.width
 49:   const naturalHeight = bitmap.height
 50:   if (!naturalWidth || !naturalHeight) {
 51:     bitmap.close()
 52:     throw new Error("Image has invalid dimensions")
 53:   }
 54:   const sample = sampleDimensions(naturalWidth, naturalHeight)
 55:   return new Promise((resolve, reject) => {
 56:     const worker = new Worker(new URL("./flow-image-alpha.worker.ts", import.meta.url), { type: "module" })
 57:     const timeout = window.setTimeout(() => {
 58:       worker.terminate()
 59:       reject(new Error("Alpha measurement timed out"))
 60:     }, WORKER_TIMEOUT_MS)
 61:     const finish = () => {
 62:       window.clearTimeout(timeout)
 63:       worker.terminate()
 64:     }
 65:     worker.addEventListener("error", () => {
 66:       finish()
 67:       reject(new Error("Alpha measurement failed"))
 68:     }, { once: true })
 69:     worker.addEventListener("message", (event: MessageEvent<{ geometry?: FlowImageAlphaGeometry; error?: string }>) => {
 70:       finish()
 71:       if (event.data.geometry) resolve(event.data.geometry)
 72:       else reject(new Error(event.data.error ?? "Alpha measurement failed"))
 73:     }, { once: true })
 74:     worker.postMessage({
 75:       bitmap,
 76:       naturalHeight,
 77:       naturalWidth,
 78:       sampleHeight: sample.height,
 79:       sampleWidth: sample.width,
 80:     }, [bitmap])
 81:   })
 82: }
 83: 
 84: function measureOnMainThread(source: string): Promise<FlowImageAlphaGeometry | null> {
 85:   return new Promise(resolve => {
 86:     const probe = new Image()
 87:     probe.crossOrigin = "anonymous"
 88:     probe.decoding = "async"
 89:     probe.addEventListener("error", () => resolve(null), { once: true })
 90:     probe.addEventListener("load", () => {
 91:       try {
 92:         if (!probe.naturalWidth || !probe.naturalHeight) return resolve(null)
 93:         const sample = sampleDimensions(probe.naturalWidth, probe.naturalHeight)
 94:         const canvas = document.createElement("canvas")
 95:         canvas.width = sample.width
 96:         canvas.height = sample.height
 97:         const context = canvas.getContext("2d", { willReadFrequently: true })
 98:         if (!context) return resolve(null)
 99:         context.drawImage(probe, 0, 0, sample.width, sample.height)
100:         resolve(geometryFromAlphaPixels(
101:           context.getImageData(0, 0, sample.width, sample.height).data,
102:           sample.width,
103:           sample.height,
104:           probe.naturalWidth,
105:           probe.naturalHeight
106:         ))
107:       } catch {
108:         resolve(null)
109:       }
110:     }, { once: true })
111:     probe.src = source
112:   })
113: }
114: 
115: function startMeasurement(source: string) {
116:   return measureWithWorker(source).catch(() => measureOnMainThread(source))
117: }
118: 
119: export function measureFlowImageAlpha(source: string, signal?: AbortSignal) {
120:   const entries = cache()
121:   let promise = entries.get(source)
122:   if (!promise) {
123:     promise = startMeasurement(source).then(geometry => {
124:       if (!geometry) entries.delete(source)
125:       return geometry
126:     }, () => {
127:       entries.delete(source)
128:       return null
129:     })
130:     entries.set(source, promise)
131:     while (entries.size > MAX_CACHE_ENTRIES) entries.delete(entries.keys().next().value as string)
132:   }
133:   if (!signal) return promise
134:   if (signal.aborted) return Promise.resolve(null)
135:   return new Promise<FlowImageAlphaGeometry | null>(resolve => {
136:     const abort = () => resolve(null)
137:     signal.addEventListener("abort", abort, { once: true })
138:     void promise!.then(geometry => {
139:       signal.removeEventListener("abort", abort)
140:       if (!signal.aborted) resolve(geometry)
141:     })
142:   })
143: }
144: 
145: function flowSideForImage(image: HTMLImageElement): FlowSide | null {
146:   const side = image.closest<HTMLElement>("figure[data-flow-image]")?.dataset.flowImage
147:   return side === "left" || side === "right" ? side : null
148: }
149: 
150: function applyOuterOffset(image: HTMLImageElement, side: FlowSide, alphaInsets: FlowImageAlphaGeometry | null) {
151:   const offset = Math.max(0, image.getBoundingClientRect().width * (alphaInsets?.[side] ?? 0))
152:   const figure = image.closest<HTMLElement>("figure[data-flow-image]")
153:   image.style.setProperty("--flow-image-outer-alpha-offset", `${offset.toFixed(2)}px`)
154:   figure?.style.setProperty("--flow-image-outer-alpha-offset", `${offset.toFixed(2)}px`)
155:   image.dataset.flowAlphaMeasured = alphaInsets ? "true" : "unavailable"
156: }
157: 
158: /** Keeps the original alpha-edge offset working even when Pretext cannot own a paragraph. */
159: export function FlowImageAlphaOffset() {
160:   useEffect(() => {
161:     const root = document.querySelector<HTMLElement>("[data-public-shell]")
162:     if (!root) return
163:     const trackedImages = new Map<HTMLImageElement, TrackedImage>()
164:     let disposed = false
165: 
166:     const untrack = (image: HTMLImageElement) => {
167:       const tracked = trackedImages.get(image)
168:       if (!tracked) return
169:       tracked.abortController.abort()
170:       tracked.resizeObserver.disconnect()
171:       image.style.removeProperty("--flow-image-outer-alpha-offset")
172:       image.closest<HTMLElement>("figure[data-flow-image]")?.style.removeProperty("--flow-image-outer-alpha-offset")
173:       delete image.dataset.flowAlphaMeasured
174:       trackedImages.delete(image)
175:     }
176:     const track = (image: HTMLImageElement) => {
177:       const side = flowSideForImage(image)
178:       const source = image.currentSrc || image.src
179:       const current = trackedImages.get(image)
180:       if (!side || !source) return untrack(image)
181:       if (current?.side === side && current.source === source) return
182:       untrack(image)
183:       const tracked: TrackedImage = {
184:         abortController: new AbortController(),
185:         alphaInsets: null,
186:         side,
187:         source,
188:         resizeObserver: new ResizeObserver(() => applyOuterOffset(image, tracked.side, tracked.alphaInsets)),
189:       }
190:       trackedImages.set(image, tracked)
191:       tracked.resizeObserver.observe(image)
192:       void measureFlowImageAlpha(source, tracked.abortController.signal).then(alphaInsets => {
193:         if (disposed || trackedImages.get(image) !== tracked) return
194:         tracked.alphaInsets = alphaInsets
195:         applyOuterOffset(image, side, alphaInsets)
196:       })
197:     }
198:     const scan = () => {
199:       for (const image of root.querySelectorAll<HTMLImageElement>("figure[data-flow-image] > img")) track(image)
200:       for (const image of trackedImages.keys()) {
201:         if (!image.isConnected || !root.contains(image)) untrack(image)
202:       }
203:     }
204:     const mutationObserver = new MutationObserver(scan)
205:     mutationObserver.observe(root, {
206:       attributeFilter: ["data-flow-image", "src", "srcset"],
207:       attributes: true,
208:       childList: true,
209:       subtree: true,
210:     })
211:     scan()
212:     return () => {
213:       disposed = true
214:       mutationObserver.disconnect()
215:       for (const image of [...trackedImages.keys()]) untrack(image)
216:     }
217:   }, [])
218: 
219:   return null
220: }
</file>

