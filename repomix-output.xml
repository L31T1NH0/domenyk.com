774: export function renderMarkdownSync(content: string, options: MarkdownRenderOptions = {}): string {
775:   const html = isHtmlContent(content)
776:   const result = createProcessor(options, undefined, html).processSync(content)
777:   return withPublicationCss(String(result), content, html)
778: }
