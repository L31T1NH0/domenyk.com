41:     'padding': /^1em$/,
42:     'font-weight': /^(?:normal|bold|[1-9]00)$/,
43:     'font-style': /^(?:normal|italic)$/,
44:     'text-decoration': /^(?:none|underline|line-through|underline line-through)$/,
