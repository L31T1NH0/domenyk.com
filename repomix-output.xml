 45: export async function createMessageThread(data: { ownerId: string; ownerName: string; subject: string; body: string; category: MessageThread["category"] }) {
 46:   const now = new Date()
 47:   const thread: MessageThread = {
 48:     _id: new ObjectId(), ownerId: data.ownerId, ownerName: data.ownerName,
 49:     subject: data.subject, category: data.category, status: "open", createdAt: now, updatedAt: now,
 50:     entries: [{ _id: new ObjectId(), authorId: data.ownerId, authorName: data.ownerName, body: data.body, createdAt: now }],
