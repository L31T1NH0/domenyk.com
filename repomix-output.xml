 1: import "server-only"
 2: 
 3: import { revalidateTag, unstable_cache } from "next/cache"
 4: import type { AnyBulkWriteOperation } from "mongodb"
 5: import { getDb } from "@/lib/db/client"
 6: 
 7: // Keep the existing key so current installations preserve their preference.
 8: const SITE_VISIT_PUSH_KEY = "notifications.site-visits.enabled"
 9: const SITE_VISIT_STORE_KEY = "notifications.site-visits.store"
10: const NOTIFICATION_SETTINGS_CACHE_TAG = "notification-settings"
11: 
12: type BooleanSetting = {
13:   _id: string
14:   value: boolean
15:   updatedAt: Date
16: }
17: 
18: export type SiteVisitNotificationSettings = {
19:   pushEnabled: boolean
20:   storeInHistory: boolean
21: }
22: 
23: async function readSiteVisitNotificationSettings(): Promise<SiteVisitNotificationSettings> {
24:   const documents = await (await getDb()).collection<BooleanSetting>("settings").find({
25:     _id: { $in: [SITE_VISIT_PUSH_KEY, SITE_VISIT_STORE_KEY] },
26:   }).toArray()
27:   const settings = new Map(documents.map((document) => [document._id, document.value]))
28:   return {
29:     pushEnabled: settings.get(SITE_VISIT_PUSH_KEY) === true,
30:     storeInHistory: settings.get(SITE_VISIT_STORE_KEY) === true,
31:   }
32: }
33: 
34: export const getSiteVisitNotificationSettings = unstable_cache(
35:   readSiteVisitNotificationSettings,
36:   ["site-visit-notification-settings"],
37:   { tags: [NOTIFICATION_SETTINGS_CACHE_TAG], revalidate: 60 }
38: )
39: 
40: export async function setSiteVisitNotificationSettings(
41:   input: Partial<SiteVisitNotificationSettings>
42: ): Promise<SiteVisitNotificationSettings> {
43:   const now = new Date()
44:   const operations: AnyBulkWriteOperation<BooleanSetting>[] = []
45:   if (typeof input.pushEnabled === "boolean") {
46:     operations.push({
47:       updateOne: {
48:         filter: { _id: SITE_VISIT_PUSH_KEY },
49:         update: { $set: { value: input.pushEnabled, updatedAt: now } },
50:         upsert: true,
51:       },
52:     })
53:   }
54:   if (typeof input.storeInHistory === "boolean") {
55:     operations.push({
56:       updateOne: {
57:         filter: { _id: SITE_VISIT_STORE_KEY },
58:         update: { $set: { value: input.storeInHistory, updatedAt: now } },
59:         upsert: true,
60:       },
61:     })
62:   }
63:   if (operations.length > 0) {
64:     await (await getDb()).collection<BooleanSetting>("settings").bulkWrite(operations)
65:     revalidateTag(NOTIFICATION_SETTINGS_CACHE_TAG, { expire: 0 })
66:   }
67:   return readSiteVisitNotificationSettings()
68: }
