<file path="src/lib/request-identity.ts">
 1: import "server-only"
 2: 
 3: import { createHash, createHmac } from "crypto"
 4: import type { NextRequest } from "next/server"
 5: 
 6: type HeaderReader = Pick<Headers, "get">
 7: 
 8: function firstHeaderIp(value: string | null): string | null {
 9:   const ip = value?.split(",").at(-1)?.trim()
10:   return ip || null
11: }
12: 
13: function clientIpFromHeaders(headers: HeaderReader): string {
14:   return (
15:     firstHeaderIp(headers.get("x-vercel-forwarded-for")) ??
16:     firstHeaderIp(headers.get("cf-connecting-ip")) ??
17:     firstHeaderIp(headers.get("true-client-ip")) ??
18:     firstHeaderIp(headers.get("x-real-ip")) ??
19:     firstHeaderIp(headers.get("x-forwarded-for")) ??
20:     "unknown"
21:   )
22: }
23: 
24: function clientIp(req: NextRequest): string {
25:   return clientIpFromHeaders(req.headers)
26: }
27: 
28: function identityForIp(ip: string): string {
29:   const secret = process.env.REQUEST_IDENTITY_SECRET ?? process.env.CLERK_SECRET_KEY
30: 
31:   if (secret) {
32:     return createHmac("sha256", secret)
33:       .update("domenyk:request-identity:v1\0")
34:       .update(ip)
35:       .digest("hex")
36:       .slice(0, 32)
37:   }
38: 
39:   if (process.env.NODE_ENV === "production") {
40:     throw new Error("REQUEST_IDENTITY_SECRET ou CLERK_SECRET_KEY deve estar configurado")
41:   }
42: 
43:   return createHash("sha256").update(ip).digest("hex").slice(0, 32)
44: }
45: 
46: export function requestIdentity(req: NextRequest): string {
47:   return identityForIp(clientIp(req))
48: }
49: 
50: export function requestIdentityFromHeaders(headers: HeaderReader): string {
51:   return identityForIp(clientIpFromHeaders(headers))
52: }
