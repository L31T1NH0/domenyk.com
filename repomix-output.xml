146:       getStandaloneTimelinePage({ page, limit, mode }),
147:       mode === "notes" ? Promise.resolve(0) : countPosts({ excludeHiddenFromTimeline: true }),
148:       mode === "posts" ? Promise.resolve(0) : countStandaloneNotes(),
149:       mode === "posts" ? Promise.resolve({ threads: [], total: 0 }) : getNoteThreadPage({ page, limit }),
150:     ])
