 99: type PostRowActionsProps = {
100:   post: SerializedPostSummary
101:   compact?: boolean
102:   onTogglePublish: (post: SerializedPostSummary) => void
103:   onTogglePin: (post: SerializedPostSummary) => void
104:   onRemove: (id: string) => Promise<void>
105: }
106: 
107: function PostRowActions({ post, compact = false, onTogglePublish, onTogglePin, onRemove }: PostRowActionsProps) {
108:   return (
109:     <div className={`admin-record-actions ${compact ? "is-compact" : ""}`}>
110:       <button type="button" onClick={() => onTogglePublish(post)} className="admin-record-action">
111:         {post.published ? "Despublicar" : "Publicar"}
112:       </button>
113:       <button type="button" onClick={() => onTogglePin(post)} className="admin-record-action">
114:         {post.pinned ? "Desafixar" : "Fixar"}
115:       </button>
116:       <Link href={`/admin/posts/${post._id}/edit`} className="admin-record-icon-action" aria-label={`Editar ${post.title}`}>
117:         <PencilSquareIcon aria-hidden />
118:       </Link>
