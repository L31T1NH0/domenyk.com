 3: import { useEffect } from "react"
 4: import { usePathname } from "next/navigation"
 5: import { viewClientContext } from "@/lib/view-referrer"
 6: 
 7: let lastReportedPath = ""
 8: let disabledForSession = false
 9: 
10: export function SiteVisitTracker() {
11:   const pathname = usePathname()
12: 
13:   useEffect(() => {
14:     if (disabledForSession || !pathname || pathname === lastReportedPath) return
15:     lastReportedPath = pathname
16: 
17:     fetch("/api/site-visits", {
18:       method: "POST",
19:       headers: { "Content-Type": "application/json" },
20:       body: JSON.stringify({ path: pathname, ...viewClientContext() }),
21:       keepalive: true,
22:     }).then((response) => {
23:       if (response.status === 204) disabledForSession = true
24:     }).catch(() => undefined)
25:   }, [pathname])
26: 
27:   return null
28: }
</file>

