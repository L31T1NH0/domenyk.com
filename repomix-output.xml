613:       button.addEventListener("click", () => {
614:         buttons.forEach((candidate) => candidate.setAttribute("aria-pressed", String(candidate === button)));
615:         response.textContent = responseCopy[button.dataset.response];
616:       });
617:     });
618: 
619:     updateProgress();
620:     window.addEventListener("scroll", updateProgress, { passive: true });
621:     window.addEventListener("resize", updateProgress);
622:   </script>
