 3: const PUBLICATION_CSS_TEMPLATE = /<template\s+data-editor-css=(?:"([^"]*)"|'([^']*)')\s*>\s*<\/template>/i
 4: 
 5: /** @param {string} content */
 6: export function extractPublicationCss(content) {
 7:   const match = content.match(PUBLICATION_CSS_TEMPLATE)
 8:   const encoded = match?.[1] ?? match?.[2] ?? ""
 9:   if (!encoded) return ""
10: 
11:   try {
12:     return decodeURIComponent(encoded)
13:   } catch {
14:     return ""
15:   }
16: }
17: 
18: /** Keep stylesheet rules local: global registries and external imports are not
19:  * part of a publication stylesheet. Every authored selector receives the
20:  * publication surface prefix before the stylesheet reaches the browser. */
21: /** @param {string} source @param {string} selector */
22: export function compilePublicationCss(source, selector) {
23:   if (!source.trim()) return ""
24:   let sheet
25:   try { sheet = postcss.parse(source) } catch {
26:     throw new Error("O CSS está incompleto. Confira as chaves e os valores.")
27:   }
28:   sheet.walkAtRules(rule => {
29:     if (!["media", "supports", "container"].includes(rule.name.toLowerCase())) {
30:       throw new Error(`@${rule.name} não está disponível no CSS da publicação.`)
31:     }
32:   })
33:   sheet.walkDecls(declaration => {
34:     const globalProperty = /^(?:behavior|-moz-binding|anchor-name|anchor-scope|view-transition-name|timeline-scope|scroll-timeline-name|view-timeline-name)$/i.test(declaration.prop)
35:     const externalValue = /url\s*\(|expression\s*\(/i.test(declaration.value)
36:     if (declaration.prop.toLowerCase() === "display" && /\bcontents\b/i.test(declaration.value)) {
37:       throw new Error("display: contents removeria o limite visual da publicação.")
38:     }
39:     if (globalProperty || externalValue) {
40:       throw new Error(`A propriedade ${declaration.prop} contém um recurso externo ou global.`)
41:     }
42:   })
43:   sheet.walkRules(rule => {
44:     rule.selectors = rule.selectors.map(authoredSelector => {
45:       const authored = authoredSelector.trim()
46:       if (authored.includes("&")) {
47:         throw new Error("Use seletores completos; o aninhamento com & não está disponível.")
48:       }
49:       if (authored === ":scope") return selector
50:       if (authored.startsWith(":scope")) {
51:         const descendant = authored.slice(6)
52:         if (/^(?:\s+|>)/.test(descendant)) return `${selector}${descendant}`
53:         throw new Error("Depois de :scope, use um espaço ou > para selecionar apenas conteúdo interno.")
54:       }
55:       if (authored.includes(":scope")) {
56:         throw new Error("Use :scope somente no início do seletor.")
57:       }
58:       return `${selector} ${authored}`
59:     })
60:   })
61:   // The impossible double-id inside :not() gives the boundary enough cascade
62:   // weight to survive ordinary :scope selectors, including authored !important.
63:   const boundarySelector = `${selector}:not(#publication-css-boundary#publication-css-surface)`
64:   const boundaryRule = `${boundarySelector} { ${PUBLICATION_BOUNDARY_STYLE} }`
65:   return `${sheet.toString()}\n${boundaryRule}`.replace(/<\/style/gi, "\\3c /style")
66: }
67: 
68: // These belong to the publication boundary, not to the authored stylesheet.
69: // Keep the boundary inside its column and clip authored layout to that box.
70: export const PUBLICATION_BOUNDARY_STYLE = [
71:   "contain: paint style", "isolation: isolate", "overflow: hidden", "overflow: clip",
72:   "position: relative", "float: none", "box-sizing: border-box",
73:   "max-width: 100%", "min-width: 0",
74:   "margin: 0",
75:   "inset: auto", "transform: none", "translate: none", "rotate: none", "scale: none",
76:   "z-index: auto", "filter: none", "backdrop-filter: none", "box-shadow: none", "outline: none",
77: ].map(value => `${value} !important`).join("; ")
</file>

