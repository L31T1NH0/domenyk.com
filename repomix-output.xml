187: function draftsMatch(left: LocalizedDraft, right: LocalizedDraft): boolean {
188:   return left.title === right.title &&
189:     left.seoTitle === right.seoTitle &&
190:     left.seoDescription === right.seoDescription &&
191:     left.localizedSlug === right.localizedSlug &&
192:     left.subtitle === right.subtitle &&
193:     left.excerpt === right.excerpt &&
194:     left.coverAlt === right.coverAlt &&
195:     left.tags === right.tags &&
196:     left.sources === right.sources &&
197:     left.content === right.content
198: }
