 42: 
 43:   function ensureAudioGraph() {
 44:     if (audioContextRef.current) return true
 45:     const audio = audioRef.current
 46:     if (!audio || typeof window === "undefined") return false
 47: 
 48:     const AudioContextClass =
 49:       window.AudioContext ||
 50:       (window as typeof window & { webkitAudioContext?: typeof AudioContext }).webkitAudioContext
 51: 
 52:     if (!AudioContextClass) {
 53:       setBoostAvailable(false)
 54:       return false
 55:     }
 56: 
 57:     try {
 58:       const context = new AudioContextClass()
 59:       const source = context.createMediaElementSource(audio)
 60:       const gainNode = context.createGain()
 61: 
 62:       source.connect(gainNode)
 63:       gainNode.connect(context.destination)
 64:       audio.volume = 1
 65:       gainNode.gain.value = volume * (isBoosted ? BOOST_MULTIPLIER : 1)
 66: 
 67:       audioContextRef.current = context
 68:       gainNodeRef.current = gainNode
 69:       sourceRef.current = source
 70:       setBoostAvailable(true)
 71:       return true
 72:     } catch {
 73:       setBoostAvailable(false)
 74:       return false
 75:     }
 76:   }
 77: 
 78:   async function togglePlayPause() {
 79:     const audio = audioRef.current
 80:     if (!audio) return
 81: 
 82:     if (isPlaying) {
 83:       audio.pause()
 84:       return
 85:     }
 86: 
 87:     setError("")
 88:     try {
 89:       ensureAudioGraph()
 90:       await audioContextRef.current?.resume()
 91:       await audio.play()
 92:     } catch {
