  1: "use client"
  2: 
  3: import { useEffect, useRef, useState, type RefObject } from "react"
  4: import { layout, prepare } from "@chenglou/pretext"
  5: 
  6: type WhiteSpace = "normal" | "pre-wrap"
  7: 
  8: type TextFitOptions = {
  9:   minSize?: number
 10:   maxSize?: number
 11:   maxLines?: number
 12:   whiteSpace?: WhiteSpace
 13: }
 14: 
 15: type ContentFitOptions = {
 16:   minSize?: number
 17:   maxSize?: number
 18:   maxLinesPerBlock?: number
 19:   blockSelector?: string
 20:   whiteSpace?: WhiteSpace
 21: }
 22: 
 23: type TextLineOptions = {
 24:   maxLines?: number
 25:   whiteSpace?: WhiteSpace
 26: }
 27: 
 28: type PreparedBlock = {
 29:   text: string
 30:   lineHeightRatio: number
 31:   getPrepared: (fontSize: number) => ReturnType<typeof prepare>
 32: }
 33: 
 34: const MAX_LOCAL_PRETEXT_CACHE_ENTRIES = 128
 35: 
 36: function getLineHeightRatio(style: CSSStyleDeclaration, fallbackFontSize: number) {
 37:   const lineHeight = Number.parseFloat(style.lineHeight)
 38:   if (Number.isFinite(lineHeight) && fallbackFontSize > 0) return lineHeight / fallbackFontSize
 39:   return 1.5
 40: }
 41: 
 42: function getLetterSpacing(style: CSSStyleDeclaration) {
 43:   const letterSpacing = Number.parseFloat(style.letterSpacing)
 44:   return Number.isFinite(letterSpacing) ? letterSpacing : undefined
 45: }
 46: 
 47: function buildFont(style: CSSStyleDeclaration, fontSize: number) {
 48:   const variant = style.fontVariantCaps === "small-caps" ? "small-caps" : "normal"
 49:   return `${style.fontStyle || "normal"} ${variant} ${style.fontWeight || "400"} ${fontSize}px ${style.fontFamily || "sans-serif"}`
 50: }
 51: 
 52: function normalizeText(text: string, whiteSpace: WhiteSpace) {
 53:   return whiteSpace === "pre-wrap" ? text.replace(/\r\n?/g, "\n") : text.replace(/\s+/g, " ").trim()
 54: }
 55: 
 56: function rememberPrepared(
 57:   cache: Map<string, ReturnType<typeof prepare>>,
 58:   key: string,
 59:   value: ReturnType<typeof prepare>
 60: ) {
 61:   cache.set(key, value)
 62:   while (cache.size > MAX_LOCAL_PRETEXT_CACHE_ENTRIES) {
 63:     const oldest = cache.keys().next().value as string | undefined
 64:     if (!oldest) break
 65:     cache.delete(oldest)
 66:   }
 67:   return value
 68: }
 69: 
 70: export function usePretextTextFit(
 71:   ref: RefObject<HTMLElement | null>,
 72:   text: string,
 73:   options: TextFitOptions = {}
 74: ) {
 75:   const { minSize = 12, maxSize = 18, maxLines = 2, whiteSpace = "normal" } = options
 76:   const [fontSize, setFontSize] = useState(maxSize)
 77:   const cache = useRef<Map<string, ReturnType<typeof prepare>>>(new Map())
 78: 
 79:   useEffect(() => {
 80:     let cancelled = false
 81: 
 82:     const measure = () => {
 83:       const element = ref.current
 84:       const width = element?.clientWidth ?? 0
 85:       const normalizedText = normalizeText(text, whiteSpace)
 86:       if (!element || !width || !normalizedText || cancelled) return
 87: 
 88:       const style = window.getComputedStyle(element)
 89:       const baseFontSize = Number.parseFloat(style.fontSize) || maxSize
 90:       const lineHeightRatio = getLineHeightRatio(style, baseFontSize)
 91:       const letterSpacing = getLetterSpacing(style)
 92: 
 93:       const getPrepared = (size: number) => {
 94:         const font = buildFont(style, size)
 95:         const key = `${font}__${whiteSpace}__${letterSpacing ?? ""}__${normalizedText}`
 96:         if (!cache.current.has(key)) {
 97:           rememberPrepared(cache.current, key, prepare(normalizedText, font, { whiteSpace, letterSpacing }))
 98:         }
 99:         return cache.current.get(key)!
100:       }
101: 
102:       let lo = minSize
103:       let hi = maxSize
104:       let optimal = minSize
105:       while (lo <= hi) {
106:         const mid = Math.floor((lo + hi) / 2)
107:         const { lineCount } = layout(getPrepared(mid), width, mid * lineHeightRatio)
108:         if (lineCount <= maxLines) {
109:           optimal = mid
110:           lo = mid + 1
111:         } else {
112:           hi = mid - 1
113:         }
114:       }
115: 
116:       if (!cancelled) setFontSize(optimal)
117:     }
118: 
119:     document.fonts.ready.then(measure)
120:     const element = ref.current
121:     if (!element) return
122: 
123:     const observer = new ResizeObserver(measure)
124:     observer.observe(element)
125:     return () => {
126:       cancelled = true
127:       observer.disconnect()
128:     }
129:   }, [ref, text, minSize, maxSize, maxLines, whiteSpace])
130: 
131:   return fontSize
132: }
133: 
134: export function usePretextLineMetrics(
135:   ref: RefObject<HTMLElement | null>,
136:   text: string,
137:   options: TextLineOptions = {}
138: ) {
139:   const { maxLines = 3, whiteSpace = "normal" } = options
140:   const [lineCount, setLineCount] = useState(0)
141:   const cache = useRef<Map<string, ReturnType<typeof prepare>>>(new Map())
142: 
143:   useEffect(() => {
144:     let cancelled = false
145: 
146:     const measure = () => {
147:       const element = ref.current
148:       const width = element?.clientWidth ?? 0
149:       const normalizedText = normalizeText(text, whiteSpace)
150:       if (!element || !width || !normalizedText || cancelled) {
151:         if (!cancelled) setLineCount(0)
152:         return
153:       }
154: 
155:       const style = window.getComputedStyle(element)
156:       const fontSize = Number.parseFloat(style.fontSize) || 14
157:       const lineHeightRatio = getLineHeightRatio(style, fontSize)
158:       const font = buildFont(style, fontSize)
159:       const letterSpacing = getLetterSpacing(style)
160:       const key = `${font}__${whiteSpace}__${letterSpacing ?? ""}__${normalizedText}`
161:       if (!cache.current.has(key)) {
162:         rememberPrepared(cache.current, key, prepare(normalizedText, font, { whiteSpace, letterSpacing }))
163:       }
164: 
165:       const next = layout(cache.current.get(key)!, width, fontSize * lineHeightRatio).lineCount
166:       if (!cancelled) setLineCount(next)
167:     }
168: 
169:     document.fonts.ready.then(measure)
170:     const element = ref.current
171:     if (!element) return
172: 
173:     const observer = new ResizeObserver(measure)
174:     observer.observe(element)
175:     return () => {
176:       cancelled = true
177:       observer.disconnect()
178:     }
179:   }, [ref, text, maxLines, whiteSpace])
180: 
181:   return { lineCount, overflows: lineCount > maxLines }
182: }
183: 
184: export function usePretextContentFontSize(
185:   containerRef: RefObject<HTMLElement | null>,
186:   options: ContentFitOptions = {}
187: ) {
188:   const {
189:     minSize = 12,
190:     maxSize = 18,
191:     maxLinesPerBlock = 6,
192:     blockSelector = "p",
193:     whiteSpace = "normal",
194:   } = options
195:   const [fontSize, setFontSize] = useState(maxSize)
196:   const cache = useRef<Map<string, ReturnType<typeof prepare>>>(new Map())
197: 
198:   useEffect(() => {
199:     let cancelled = false
200: 
201:     const measure = () => {
202:       const container = containerRef.current
203:       const width = container?.clientWidth ?? 0
204:       if (!container || !width || cancelled) return
205: 
206:       const blocks: PreparedBlock[] = Array.from(container.querySelectorAll<HTMLElement>(blockSelector))
207:         .map((el) => {
208:           const text = normalizeText(el.textContent ?? "", whiteSpace)
209:           if (!text) return null
210:           const style = window.getComputedStyle(el)
211:           const baseFontSize = Number.parseFloat(style.fontSize) || maxSize
212:           const letterSpacing = getLetterSpacing(style)
213:           return {
214:             text,
215:             lineHeightRatio: getLineHeightRatio(style, baseFontSize),
216:             getPrepared(size: number) {
217:               const font = buildFont(style, size)
218:               const key = `${font}__${whiteSpace}__${letterSpacing ?? ""}__${text}`
219:               if (!cache.current.has(key)) {
220:                 rememberPrepared(cache.current, key, prepare(text, font, { whiteSpace, letterSpacing }))
221:               }
222:               return cache.current.get(key)!
223:             },
224:           }
225:         })
226:         .filter((block): block is PreparedBlock => block !== null)
227: 
228:       if (!blocks.length) return
229: 
230:       let lo = minSize
231:       let hi = maxSize
232:       let optimal = minSize
233:       while (lo <= hi) {
234:         const mid = Math.floor((lo + hi) / 2)
235:         const totalLines = blocks.reduce((sum, block) => {
236:           const { lineCount } = layout(block.getPrepared(mid), width, mid * block.lineHeightRatio)
237:           return sum + lineCount
238:         }, 0)
239:         if (totalLines / blocks.length <= maxLinesPerBlock) {
240:           optimal = mid
241:           lo = mid + 1
242:         } else {
243:           hi = mid - 1
244:         }
245:       }
246: 
247:       if (!cancelled) setFontSize(optimal)
248:     }
249: 
250:     document.fonts.ready.then(measure)
251:     const container = containerRef.current
252:     if (!container) return
253: 
254:     const resizeObserver = new ResizeObserver(measure)
255:     resizeObserver.observe(container)
256:     const mutationObserver = new MutationObserver(measure)
257:     mutationObserver.observe(container, { childList: true, subtree: true, characterData: true })
258: 
259:     return () => {
260:       cancelled = true
261:       resizeObserver.disconnect()
262:       mutationObserver.disconnect()
263:     }
264:   }, [containerRef, minSize, maxSize, maxLinesPerBlock, blockSelector, whiteSpace])
265: 
266:   return fontSize
267: }
</file>

