232: export async function getHomeTimelinePage({
233:   page,
234:   mode,
235:   limit,
236:   search,
237: }: {
238:   page: number
239:   mode: PublicFeedMode
240:   limit: number
241:   search?: string
242: }): Promise<HomeTimelinePage> {
243:   const normalizedSearch = search?.trim()
244: 
245:   if (!normalizedSearch) {
246:     const [feed, desktop] = await Promise.all([
247:       getCachedHomeFeed(page, mode, limit),
248:       getCachedDesktopHomeFeed(page, mode, limit),
249:     ])
