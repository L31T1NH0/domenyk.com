251:   }
252: 
253:   static importDOM(): DOMConversionMap {
254:     return {
255:       figure: element => element.querySelector("img") ? {
256:         priority: 4,
257:         conversion: dom => {
258:           const img = dom.querySelector("img")!
259:           const side = dom.dataset.flowImage
260:           const node = new ImageNode(
261:             img.getAttribute("src") ?? "", img.alt,
262:             side === "left" ? "flow-left" : side === "right" ? "flow-right" : "block",
263:             normalizeFlowWidth(Number(dom.dataset.flowWidth)),
264:             dom.dataset.imageTheme === "adaptive" ? "adaptive-monochrome" : "original",
265:             dom.dataset.editorWidth ? Number(dom.dataset.editorWidth) : 100,
266:             dom.dataset.editorImage as "left" | "center" | "right",
267:             dom.querySelector("figcaption")?.textContent ?? "",
268:           )
269:           const caption = dom.querySelector("figcaption")
270:           node.setFormatting({
271:             width: imageNumber(dom.dataset.imageWidth ?? (side ? dom.dataset.flowWidth : dom.dataset.editorWidth), side ? 42 : 100),
272:             unit: dom.dataset.imageUnit === "px" ? "px" : "%", gap: imageNumber(dom.dataset.imageGap, 16, 256),
273:             figureClass: dom.className, figureStyle: dom.getAttribute("style") ?? "",
274:             imageClass: img.className, imageStyle: `${img.getAttribute("width") ? `width:${img.getAttribute("width")}px;` : ""}${img.getAttribute("height") ? `height:${img.getAttribute("height")}px;` : ""}${img.getAttribute("style") ?? ""}`,
275:             captionClass: caption?.className, captionStyle: caption?.getAttribute("style") ?? "",
276:           })
277:           return { node, forChild: () => null }
278:         },
279:       } : null,
280:       img: () => ({ priority: 1, conversion: dom => {
281:         const node = $createImageNode(dom.getAttribute("src") ?? "", dom.getAttribute("alt") ?? "")
282:         node.setFormatting({ imageClass: dom.className, imageStyle: `${dom.getAttribute("width") ? `width:${dom.getAttribute("width")}px;` : ""}${dom.getAttribute("height") ? `height:${dom.getAttribute("height")}px;` : ""}${dom.getAttribute("style") ?? ""}` })
283:         return { node }
284:       } }),
285:     }
286:   }
287: 
288:   static importJSON(serialized: SerializedImageNode): ImageNode {
289:     const node = new ImageNode(
290:       serialized.src,
291:       serialized.alt,
292:       normalizeLayout(serialized.layout),
293:       normalizeFlowWidth(serialized.flowWidth),
294:       normalizeThemeMode(serialized.themeMode),
295:       serialized.blockWidth, serialized.alignment, serialized.caption
296:     )
297:     node.setFormatting(serialized.formatting ?? {})
298:     return node
299:   }
300: 
301:   exportJSON(): SerializedImageNode {
302:     return {
303:       src: this.__src,
304:       alt: this.__alt,
305:       layout: this.__layout,
306:       flowWidth: this.__flowWidth,
307:       themeMode: this.__themeMode,
308:       type: "image",
309:       version: 5,
310:       formatting: { ...this.__formatting },
