 57: function normalizeComment(comment: StoredComment): Comment {
 58:   const content =
 59:     typeof comment.content === "string" ? comment.content :
 60:     typeof comment.comentario === "string" ? comment.comentario :
 61:     typeof comment.text === "string" ? comment.text :
 62:     typeof comment.body === "string" ? comment.body :
 63:     typeof comment.message === "string" ? comment.message :
 64:     ""
 65:   const authorName =
 66:     typeof comment.authorName === "string" ? comment.authorName :
 67:     typeof comment.nome === "string" ? comment.nome :
 68:     "Anônimo"
 69:   const createdAt = toDate(comment.createdAt)
 70:   const updatedAt = toDate(comment.updatedAt, createdAt)
 71: 
 72:   const normalized: Comment = {
 73:     _id: comment._id,
 74:     postId: comment.postId ?? new ObjectId(),
 75:     authorId: comment.authorId ?? "",
 76:     authorName,
 77:     authorImageUrl: comment.authorImageUrl ?? "",
 78:     content,
 79:     createdAt,
 80:     updatedAt,
 81:   }
 82:   if (typeof comment.paragraphId === "string") normalized.paragraphId = comment.paragraphId
 83:   return normalized
 84: }
