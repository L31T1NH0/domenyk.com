24: }
25: 
26: function sourceLabel(rawReferrer: string | null, siteOrigin: string) {
27:   const referrer = rawReferrer?.trim().slice(0, 2048)
28:   if (!referrer) return "Acesso direto"
29: 
30:   try {
31:     const url = new URL(referrer)
32:     if (url.origin === siteOrigin) {
33:       if (url.pathname === "/") return "Página inicial"
34:       if (url.pathname === "/notes" || url.pathname.startsWith("/notes/")) return "Página de notas"
35:       return "Navegação interna"
36:     }
37:     return url.hostname.replace(/^www\./, "")
38:   } catch {
39:     return "Origem desconhecida"
40:   }
41: }
42: 
43: function text(value: unknown, maxLength: number) {
44:   return typeof value === "string" ? value.trim().slice(0, maxLength) : ""
45: }
46: 
47: function locationLabel(req: NextRequest) {
48:   const country = text(req.headers.get("x-vercel-ip-country") ?? req.headers.get("cf-ipcountry"), 12)
49:   const rawCity = text(req.headers.get("x-vercel-ip-city"), 100)
50:   let city = rawCity
51:   try { city = decodeURIComponent(rawCity) } catch {}
52:   return [city, country].filter(Boolean).join(", ") || "Localização indisponível"
53: }
54: 
55: export function viewRequestDetails(req: NextRequest, client: ViewClientContext): NotificationOccurrenceDetails {
56:   const agent = userAgent(req)
57:   const deviceType = agent.device.type ?? "desktop"
58:   const deviceLabel = DEVICE_LABELS[deviceType] ?? "Computador"
59:   const device = (agent.device.model ? `${deviceLabel} · ${agent.device.model}` : deviceLabel).slice(0, 100)
60:   const browser = agent.browser.name
61:     ? [agent.browser.name, agent.browser.version].filter(Boolean).join(" ")
62:     : agent.isBot ? "Robô" : "Navegador desconhecido"
63:   const os = [agent.os.name, agent.os.version].filter(Boolean).join(" ") || "Sistema desconhecido"
64:   const campaignParts = [
65:     text(client.utmSource, 100),
66:     text(client.utmMedium, 100),
67:     text(client.utmCampaign, 150),
68:   ].filter(Boolean)
69: 
70:   return {
71:     source: sourceLabel(text(client.referrer, 2048), req.nextUrl.origin),
72:     device,
73:     browser: browser.slice(0, 100),
74:     os: os.slice(0, 100),
75:     location: locationLabel(req),
76:     campaign: campaignParts.length ? campaignParts.join(" · ") : "Sem campanha",
77:     landingPage: text(client.landingPage, 500) || "Página de entrada desconhecida",
78:     language: text(client.language, 35) || "Idioma desconhecido",
79:     visitorType: text(client.visitorType, 30) || "Recorrência desconhecida",
80:     trafficType: agent.isBot ? "Bot" : "Pessoa",
81:   }
82: }
</file>

