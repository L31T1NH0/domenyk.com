 86: export function serializeComment(comment: Comment, canDelete = false): SerializedComment {
 87:   return {
 88:     _id: comment._id.toString(),
 89:     postId: comment.postId.toString(),
 90:     paragraphId: comment.paragraphId,
 91:     authorName: comment.authorName,
 92:     authorImageUrl: comment.authorImageUrl,
 93:     content: comment.content,
 94:     createdAt: comment.createdAt.toISOString(),
 95:     updatedAt: comment.updatedAt.toISOString(),
 96:     contentHtml: renderMarkdownSync(comment.content, commentMarkdownOptions(comment.content)),
 97:     canDelete,
 98:   }
 99: }
