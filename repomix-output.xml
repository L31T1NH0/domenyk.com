126: export async function sanitizeImageUpload(
127:   filename: string,
128:   data: ArrayBuffer,
129:   declaredType: string
130: ): Promise<{ filename: string; data: Buffer; contentType: string }> {
131:   const buffer = Buffer.from(data)
132:   if (buffer.length === 0 || buffer.length > MAX_IMAGE_UPLOAD_BYTES) {
133:     throw new Error("Invalid image")
134:   }
135: 
136:   const detectedType = detectImageType(buffer)
137:   const normalizedDeclaredType = declaredType.toLowerCase()
138: 
139:   if (!detectedType || !isAllowedImageType(detectedType) || detectedType !== normalizedDeclaredType) {
140:     throw new Error("Invalid image")
141:   }
142: 
143:   if (detectedType === "image/svg+xml") {
144:     const sharp = await loadSharpForSvg()
145:     const sanitized = sanitizeSvg(buffer)
146:     const metadata = await sharp(sanitized, {
147:       animated: false,
148:       failOn: "error",
149:       limitInputPixels: MAX_IMAGE_INPUT_PIXELS,
150:     }).timeout({ seconds: IMAGE_PROCESSING_TIMEOUT_SECONDS }).metadata()
151:     if (
152:       !metadata.width ||
153:       !metadata.height ||
154:       metadata.width > MAX_IMAGE_INPUT_DIMENSION ||
155:       metadata.height > MAX_IMAGE_INPUT_DIMENSION ||
156:       metadata.width * metadata.height > MAX_IMAGE_INPUT_PIXELS
157:     ) {
158:       throw new Error("Invalid SVG dimensions")
159:     }
160:     return {
161:       filename: svgFilename(filename),
162:       data: sanitized,
163:       contentType: "image/svg+xml",
164:     }
165:   }
166: 
167:   const sharp = await loadSharp()
168:   const image = sharp(buffer, {
169:     animated: false,
170:     failOn: "error",
171:     limitInputPixels: MAX_IMAGE_INPUT_PIXELS,
172:     sequentialRead: true,
173:   })
174:   const metadata = await image.timeout({ seconds: IMAGE_PROCESSING_TIMEOUT_SECONDS }).metadata()
175: 
176:   if (
177:     !metadata.width ||
178:     !metadata.height ||
179:     metadata.width > MAX_IMAGE_INPUT_DIMENSION ||
180:     metadata.height > MAX_IMAGE_INPUT_DIMENSION ||
181:     metadata.width * metadata.height > MAX_IMAGE_INPUT_PIXELS ||
182:     (metadata.pages && metadata.pages > 1)
183:   ) {
184:     throw new Error("Invalid image")
185:   }
186: 
187:   const encode = (quality: number) => sharp(buffer, {
188:     animated: false,
189:     failOn: "error",
190:     limitInputPixels: MAX_IMAGE_INPUT_PIXELS,
191:     sequentialRead: true,
192:   })
193:     .rotate()
194:     .resize({
195:       width: MAX_IMAGE_OUTPUT_DIMENSION,
196:       height: MAX_IMAGE_OUTPUT_DIMENSION,
197:       fit: "inside",
198:       withoutEnlargement: true,
199:       fastShrinkOnLoad: false,
200:     })
201:     .webp({
202:       quality,
203:       alphaQuality: 100,
204:       effort: 4,
205:       smartSubsample: true,
206:       smartDeblock: true,
207:     })
208:     .timeout({ seconds: IMAGE_PROCESSING_TIMEOUT_SECONDS })
209:     .toBuffer()
210: 
211:   let sanitized = await encode(IMAGE_WEBP_QUALITY)
212:   if (sanitized.length > MAX_SANITIZED_IMAGE_BYTES) {
213:     sanitized = await encode(IMAGE_WEBP_FALLBACK_QUALITY)
214:   }
215:   if (sanitized.length > MAX_SANITIZED_IMAGE_BYTES) {
216:     throw new Error("Image output is too large")
217:   }
218: 
219:   return {
220:     filename: webpFilename(filename),
221:     data: sanitized,
222:     contentType: "image/webp",
223:   }
224: }
