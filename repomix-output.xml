 34:   if (!toObjectId(id)) return NextResponse.json({ error: "ID inválido" }, { status: 400 })
 35: 
 36:   const body = await req.json().catch(() => null) as Record<string, unknown> | null
 37:   if (!body) return NextResponse.json({ error: "JSON inválido" }, { status: 400 })
 38:   const existingPost = await getPostById(id)
 39:   if (!existingPost) return NextResponse.json({ error: "Post não encontrado" }, { status: 404 })
 40: 
 41:   try {
 42:     if (typeof body.locale === "string" && body.locale !== "pt") {
 43:       if (!isTranslationLocale(body.locale)) {
 44:         return NextResponse.json({ error: "Idioma inválido" }, { status: 400 })
 45:       }
 46: 
 47:       const parsed = parsePostTranslation(body)
 48:       const existingTranslation = existingPost.translations?.[body.locale]
 49:       if (parsed.slug && parsed.slug !== existingTranslation?.slug) {
 50:         const conflict = await getPostByLocalizedSlug(body.locale, parsed.slug)
 51:         if (conflict && !conflict._id.equals(existingPost._id)) {
 52:           return NextResponse.json({ error: "Slug ou alias traduzido já existe." }, { status: 409 })
 53:         }
 54:       }
 55:       const translation = await updatePostTranslation(
 56:         id,
 57:         body.locale,
 58:         {
 59:           ...parsed,
 60:           published: "published" in body ? body.published === true : undefined,
 61:         },
 62:         getOriginalContentUpdatedAt(existingPost),
 63:         existingTranslation
 64:       )
 65:       invalidatePublicContentCache()
 66: 
 67:       if (translation.published || existingTranslation?.published) {
 68:         const paths = [
 69:           postPath(translation.slug!, body.locale),
 70:           ...(existingTranslation?.slug && existingTranslation.slug !== translation.slug
 71:             ? [postPath(existingTranslation.slug, body.locale)]
 72:             : []),
 73:         ]
 74:         after(() => notifyIndexNow(paths))
 75:       }
 76: 
 77:       return NextResponse.json({
 78:         ok: true,
 79:         locale: body.locale,
 80:         translation: serializePostTranslation(translation),
 81:       })
 82:     }
 83: 
 84:     const data = parsePostPatch(body)
 85:     if (body.cover === null) data.showCoverInTimeline = false
 86:     const seriesSelectionChanged = "seriesPublicId" in body
 87:     const seriesPublicId = seriesSelectionChanged ? asOptionalString(body.seriesPublicId, 80) ?? null : null
 88:     if (seriesPublicId && !(await getSeriesByPublicId(seriesPublicId))) {
 89:       return NextResponse.json({ error: "Série inválida." }, { status: 400 })
 90:     }
 91: 
 92:     if (data.slug && data.slug !== existingPost.slug) {
 93:       const conflictingPost = await getPostBySlug(data.slug)
 94:       if (conflictingPost && !conflictingPost._id.equals(existingPost._id)) {
 95:         return NextResponse.json({ error: "Slug ou alias já existe." }, { status: 409 })
 96:       }
 97:       data.slugAliases = preservedSlugAliases(existingPost.slug, existingPost.slugAliases, data.slug)
 98:     }
 99: 
100:     const originalChanged = (["title", "seoTitle", "seoDescription", "content", "excerpt", "subtitle", "sources"] as const).some((field) => (
101:       field in data && data[field] !== existingPost[field]
102:     )) || (
103:       "cover" in data && data.cover?.alt !== existingPost.cover?.alt
104:     ) || (
105:       "tags" in data && JSON.stringify(data.tags) !== JSON.stringify(existingPost.tags)
106:     )
107:     if (originalChanged) data.originalContentUpdatedAt = new Date()
108: 
109:     if ("published" in body) {
110:       const published = body.published === true
111:       data.published = published
112:       if (published && !existingPost.published) data.publishedAt = new Date()
113:       if (!published) data.publishedAt = undefined
114:     }
115: 
116:     if (Object.keys(data).length > 0) {
117:       await updatePost(id, data)
118:       invalidatePublicContentCache()
119:     }
120:     const seriesMembership = seriesSelectionChanged
121:       ? await setSeriesForPost(existingPost._id, seriesPublicId)
122:       : existingPost.series ?? null
123:     if (seriesSelectionChanged) invalidatePublicContentCache()
124: 
125:     if (existingPost.published || data.published === true) {
126:       const paths = [
127:         `/posts/${data.slug ?? existingPost.slug}`,
128:         ...(data.slug && data.slug !== existingPost.slug ? [`/posts/${existingPost.slug}`] : []),
129:       ]
130:       after(() => notifyIndexNow(paths))
131:     }
132: 
133:     if (data.published === true && !existingPost.published) {
134:       const title = data.title ?? existingPost.title
135:       const content = data.content ?? existingPost.content
136:       const excerpt = data.excerpt ?? existingPost.excerpt
137:       const slug = data.slug ?? existingPost.slug
138:       after(() => sendReaderPush({
139:         dedupeKey: `post:published:${id}:pt`,
140:         source: "automatic",
141:         topic: "posts",
142:         contentType: "post",
143:         contentId: id,
144:         title: seriesMembership?.published ? `Novo capítulo de ${seriesMembership.title}: ${title}` : `Novo post: ${title}`,
145:         body: excerpt?.trim() || descriptionFromMarkdown(content, 180),
146:         url: `/posts/${slug}`,
147:       }).catch(() => undefined))
148:     }
149: 
150:     return NextResponse.json({
151:       ok: true,
152:       locale: "pt",
153:       published: data.published ?? existingPost.published,
154:       publishedAt: data.publishedAt?.toISOString() ?? (
155:         data.published === false ? undefined : existingPost.publishedAt?.toISOString()
156:       ),
157:       originalContentUpdatedAt: (
158:         data.originalContentUpdatedAt ?? getOriginalContentUpdatedAt(existingPost)
159:       ).toISOString(),
160:       series: seriesMembership,
161:     })
162:   } catch (err) {
163:     if (err instanceof Error && err.message.includes("inválido")) {
164:       return NextResponse.json({ error: err.message }, { status: 400 })
165:     }
166:     if (err instanceof Error && err.message.includes("duplicate key")) {
167:       return NextResponse.json({ error: "Slug ou publicId já existe." }, { status: 409 })
168:     }
169:     throw err
170:   }
171: }
