257: export async function setSeriesForPost(
258:   postId: ObjectId,
259:   seriesPublicId: string | null
260: ): Promise<PostSeriesMembership | null> {
261:   const col = await collection()
262:   const currentSeries = await col.find({ postIds: postId }).toArray()
263:   const target = seriesPublicId ? await col.findOne({ publicId: seriesPublicId }) : null
264:   if (seriesPublicId && !target) throw new Error("Série inválida.")
265: 
266:   const currentTarget = target && currentSeries.find((series) => series._id.equals(target._id))
267:   if (currentTarget && currentSeries.length === 1) {
268:     return {
269:       id: currentTarget.publicId,
270:       slug: currentTarget.slug,
271:       title: currentTarget.title,
272:       position: currentTarget.postIds.findIndex((id) => id.equals(postId)) + 1,
273:       published: currentTarget.published,
274:     }
275:   }
276: 
277:   const now = new Date()
278:   if (currentSeries.length > 0) {
279:     await col.updateMany(
280:       { postIds: postId },
281:       { $pull: { postIds: postId }, $set: { updatedAt: now } }
282:     )
283:   }
284: 
285:   const postsCol = (await getDb()).collection<Post>("posts")
286:   await postsCol.updateOne({ _id: postId }, { $unset: { series: "" } })
287: 
288:   const oldMembershipWrites = currentSeries.flatMap((series) => series.postIds
289:     .filter((id) => !id.equals(postId))
290:     .map((id, index) => ({
291:       updateOne: {
292:         filter: { _id: id, deleting: { $ne: true } },
293:         update: {
294:           $set: {
295:             series: {
296:               id: series.publicId,
297:               slug: series.slug,
298:               title: series.title,
299:               position: index + 1,
300:               published: series.published,
301:             },
302:           },
303:         },
304:       },
305:     })))
306:   if (oldMembershipWrites.length > 0) await postsCol.bulkWrite(oldMembershipWrites)
307:   if (!target) return null
308: 
309:   const updatedTarget = await col.findOneAndUpdate(
310:     { _id: target._id },
311:     { $addToSet: { postIds: postId }, $set: { updatedAt: now } },
312:     { returnDocument: "after" }
313:   )
314:   if (!updatedTarget) throw new Error("Série inválida.")
315:   const membership: PostSeriesMembership = {
316:     id: updatedTarget.publicId,
317:     slug: updatedTarget.slug,
318:     title: updatedTarget.title,
319:     position: updatedTarget.postIds.length,
320:     published: updatedTarget.published,
321:   }
322:   await postsCol.updateOne({ _id: postId }, { $set: { series: membership } })
323:   return membership
324: }
