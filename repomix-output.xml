410: function parseAllowedImagePrefix(value: string): AllowedImagePrefix | null {
411:   try {
412:     const url = new URL(value)
413:     if (
414:       (url.protocol !== "https:" && url.protocol !== "http:") ||
415:       url.username ||
416:       url.password ||
417:       url.search ||
418:       url.hash
419:     ) {
420:       return null
421:     }
422: 
423:     return { origin: url.origin, pathname: url.pathname }
424:   } catch {
425:     return null
426:   }
