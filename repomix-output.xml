<file path="src/app/admin/notificacoes/ManualPushComposer.tsx">
  1: "use client"
  2: 
  3: import { useMemo, useState } from "react"
  4: import { BellAlertIcon, PaperAirplaneIcon } from "@heroicons/react/24/outline"
  5: 
  6: export type PushContentOption = {
  7:   id: string
  8:   type: "post" | "note"
  9:   title: string
 10:   description: string
 11:   href: string
 12: }
 13: 
 14: export function ManualPushComposer({ content }: { content: PushContentOption[] }) {
 15:   const [selectedValue, setSelectedValue] = useState(content[0] ? `${content[0].type}:${content[0].id}` : "")
 16:   const selected = useMemo(() => content.find((item) => `${item.type}:${item.id}` === selectedValue), [content, selectedValue])
 17:   const [title, setTitle] = useState(content[0] ? `Vale a leitura: ${content[0].title}` : "")
 18:   const [message, setMessage] = useState(content[0]?.description ?? "")
 19:   const [confirming, setConfirming] = useState(false)
 20:   const [sending, setSending] = useState(false)
 21:   const [requestId, setRequestId] = useState<string | null>(null)
 22:   const [result, setResult] = useState("")
 23:   const [error, setError] = useState("")
 24: 
 25:   function select(value: string) {
 26:     const item = content.find((candidate) => `${candidate.type}:${candidate.id}` === value)
 27:     setSelectedValue(value)
 28:     setTitle(item ? `Vale a leitura: ${item.title}` : "")
 29:     setMessage(item?.description ?? "")
 30:     setConfirming(false)
 31:     setRequestId(null)
 32:     setResult("")
 33:     setError("")
 34:   }
 35: 
 36:   function review() {
 37:     if (!selected || !title.trim() || !message.trim()) return
 38:     setRequestId(crypto.randomUUID())
 39:     setConfirming(true)
 40:     setResult("")
 41:     setError("")
 42:   }
 43: 
 44:   async function send() {
 45:     if (!selected || !requestId) return
 46:     setSending(true)
 47:     setError("")
 48:     try {
 49:       const response = await fetch("/api/admin/push/send", {
 50:         method: "POST",
 51:         headers: { "Content-Type": "application/json" },
 52:         body: JSON.stringify({
 53:           contentType: selected.type,
 54:           contentId: selected.id,
 55:           title: title.trim(),
 56:           message: message.trim(),
 57:           requestId,
 58:         }),
 59:       })
 60:       const data = await response.json().catch(() => null) as { sent?: number; failed?: number; error?: string } | null
 61:       if (!response.ok) throw new Error(data?.error || "Não foi possível enviar a notificação.")
 62:       setResult(`Disparo concluído: ${data?.sent ?? 0} dispositivo(s) avisado(s)${data?.failed ? ` e ${data.failed} falha(s)` : ""}.`)
 63:       setConfirming(false)
 64:       setRequestId(null)
 65:     } catch (cause) {
 66:       setError(cause instanceof Error ? cause.message : "Não foi possível enviar a notificação.")
 67:     } finally {
 68:       setSending(false)
 69:     }
 70:   }
 71: 
 72:   const posts = content.filter((item) => item.type === "post")
 73:   const notes = content.filter((item) => item.type === "note")
 74: 
 75:   return (
 76:     <section className="admin-notification-composer">
 77:       <header className="admin-workspace-header"><div><h2>Disparo editorial</h2><p>Destaque um conteúdo já publicado</p></div></header>
 78:       <div className="admin-push-grid">
 79:         <div className="admin-push-fields">
 80:           <label className="admin-field">
 81:             <span>Conteúdo</span>
 82:             <select value={selectedValue} onChange={(event) => select(event.target.value)}>
 83:               {posts.length > 0 && <optgroup label="Posts">{posts.map((item) => <option key={`post:${item.id}`} value={`post:${item.id}`}>{item.title}</option>)}</optgroup>}
 84:               {notes.length > 0 && <optgroup label="Notas">{notes.map((item) => <option key={`note:${item.id}`} value={`note:${item.id}`}>{item.title}</option>)}</optgroup>}
 85:             </select>
 86:           </label>
 87:           <label className="admin-field">
 88:             <span>Título da notificação</span>
 89:             <input value={title} maxLength={120} onChange={(event) => { setTitle(event.target.value); setConfirming(false) }} />
 90:           </label>
 91:           <label className="admin-field">
 92:             <span>Mensagem</span>
 93:             <textarea value={message} maxLength={240} rows={4} onChange={(event) => { setMessage(event.target.value); setConfirming(false) }} />
 94:             <small>{message.length}/240</small>
 95:           </label>
 96:         </div>
 97: 
 98:         <div className="admin-push-preview">
 99:           <p>Prévia no dispositivo</p>
100:           <div className="admin-push-notification">
101:             <div>
102:               <span><BellAlertIcon aria-hidden /></span>
103:               <div><strong>{title.trim() || "Título da notificação"}</strong><p>{message.trim() || "A mensagem aparecerá aqui."}</p><small>domenyk.com{selected?.href}</small></div>
104:             </div>
105:           </div>
106:           <p>O disparo vai apenas para quem escolheu receber {selected?.type === "note" ? "notas" : "posts"}. Abrir a notificação leva diretamente ao conteúdo.</p>
107:         </div>
108: 
109:         <div className="admin-push-submit">
110:           {confirming ? (
111:             <div className="admin-push-confirm">
112:               <p>Confirmar este disparo para os leitores inscritos?</p>
113:               <div>
114:                 <button type="button" onClick={() => setConfirming(false)} disabled={sending} className="admin-button-secondary">Cancelar</button>
115:                 <button type="button" onClick={() => void send()} disabled={sending} className="admin-button-primary"><PaperAirplaneIcon aria-hidden /> {sending ? "Enviando…" : "Confirmar envio"}</button>
116:               </div>
117:             </div>
118:           ) : (
119:             <button type="button" onClick={review} disabled={!selected || !title.trim() || !message.trim()} className="admin-button-primary admin-push-review"><PaperAirplaneIcon aria-hidden /> Revisar disparo</button>
120:           )}
121:           {result && <p role="status" className="admin-form-success">{result}</p>}
122:           {error && <p role="alert" className="admin-form-error">{error}</p>}
123:         </div>
124:       </div>
125:     </section>
126:   )
127: }
</file>

