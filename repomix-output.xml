139: export async function getNotes(opts: { cursor?: string; page?: number; limit?: number; search?: string } = {}): Promise<{ notes: Note[]; nextCursor: string | null; total: number }> {
140:   const { cursor, page = 1, limit = 20, search } = opts
141:   const baseFilter: Record<string, unknown> = { deleting: { $ne: true } }
142:   if (search?.trim()) baseFilter.$text = { $search: search.trim() }
143:   const filter: Record<string, unknown> = { ...baseFilter }
144:   if (cursor) {
145:     const cursorId = toObjectId(cursor)
146:     if (!cursorId) return { notes: [], nextCursor: null, total: 0 }
147:     filter._id = { $lt: cursorId }
148:   }
149:   const col = await collection()
150:   const [notes, total] = await Promise.all([
151:     col.find(filter)
152:       .sort({ _id: -1 })
153:       .skip(cursor ? 0 : Math.max(0, page - 1) * limit)
154:       .limit(limit + 1)
155:       .toArray(),
156:     col.countDocuments(baseFilter),
157:   ])
158:   const hasMore = notes.length > limit
159:   if (hasMore) notes.pop()
160:   return { notes, nextCursor: hasMore ? notes[notes.length - 1]._id.toString() : null, total }
161: }
